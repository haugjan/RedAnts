@page "/"
@implements IDisposable
@inject ClockHub Hub
@inject ConfigStore Store
@inject TeamResolver Teams
@inject NavigationManager Navigation

<div class="screen @(state.IsBreak ? "pause" : "") @(Offline ? "offline" : "")">
    <div class="stage">
        <div class="time @(state.IsLastMinute && state.IsGameTime ? "last-minute" : "")"><ClockDigits Value="@state.Time" /></div>
        <div class="row">
            <PenaltyList Penalties="state.HomePenalties" Side="home" />
            <TeamBadge Team="Teams.Home(state)" Class="ra" />
            <span class="score">@state.HomeScore : @state.GuestScore</span>
            <TeamBadge Team="Teams.Guest(state)" />
            <PenaltyList Penalties="state.GuestPenalties" Side="guest" />
        </div>
        <div class="per @(state.Period is ClockState.Overtime or ClockState.Shootout && state.IsGameTime ? "extra" : "")">@state.PeriodLabel</div>
    </div>
    <div class="status"><i></i><span>@StatusText</span></div>
    <a class="gear" href="setup" title="Konfiguration">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm8.4-2.1.1-1.4-.1-1.4 2-1.5-2-3.4-2.3 1a7.6 7.6 0 0 0-2.4-1.4L15.3 2h-4l-.4 2.3a7.6 7.6 0 0 0-2.4 1.4l-2.3-1-2 3.4 2 1.5-.1 1.4.1 1.4-2 1.5 2 3.4 2.3-1a7.6 7.6 0 0 0 2.4 1.4l.4 2.3h4l.4-2.3a7.6 7.6 0 0 0 2.4-1.4l2.3 1 2-3.4-2-1.5Z" /></svg>
    </a>
</div>

@code {
    static readonly TimeSpan OfflineAfter = TimeSpan.FromSeconds(3);

    ClockState state = ClockState.Empty;
    Timer? watchdog;

    TimeSpan Age => DateTime.Now - state.Received;
    bool Offline => !state.HasData || Age > OfflineAfter;

    string StatusText => !state.HasData ? "Warte auf Matchuhr …"
        : Offline ? $"Keine Daten von der Matchuhr seit {Age.TotalSeconds:0} s"
        : "live";

    protected override void OnInitialized()
    {
        if (!Store.Current.Configured)
        {
            Navigation.NavigateTo("setup");
            return;
        }

        state = Hub.Current;
        Hub.Changed += OnChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Store.Current.Configured)
            watchdog = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    void OnChanged(ClockState next) => InvokeAsync(() =>
    {
        state = next;
        StateHasChanged();
    });

    public void Dispose()
    {
        Hub.Changed -= OnChanged;
        watchdog?.Dispose();
    }
}
