@page "/bord"
@using RedAnts.Show.Agent.Cloud
@using RedAnts.Show.Agent.Deck
@using RedAnts.Show.Agent.Music
@using RedAnts.Show.Agent.Web
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject PayloadStore Payload
@inject Deck Deck
@inject LiveGame Live
@inject ShowStates States
@inject IJSRuntime JS
@inject AgentConfig Config

<PageTitle>@Payload.Hall.Name</PageTitle>

<div class="hb">
<header class="bar">
    <span class="hall">@Payload.Hall.Name</span>
    <span class="lamp on"></span>
    @if (Payload.Hall.Offers.Clock)
    {
        <span class="score">@Live.HomeScore : @Live.AwayScore</span>
        <span class="time">@Live.Time</span>
        <span class="period">@Live.PeriodLabel</span>
    }
    <span class="spacer"></span>
    @foreach (var state in ShowStates.Known)
    {
        var value = States.Value(state.Id);
        <span class="pill @(value != state.First ? "on" : "")" @key="state.Id">@state.Name: @value</span>
    }
    @if (Payload.Hall.Offers.Vmix || Payload.Hall.Offers.Clock)
    {
        <a class="setup" href="/spiel" title="Spielkonfiguration auf diesem Rechner, läuft auch ohne Internet">⚙ Spiel</a>
    }
    <a class="setup" href="@CompanionDownload.Path" title="Companion-Modul fürs Streamdeck herunterladen (neuste Version)">⬇ Companion</a>
    <button class="panic" @onclick="PanicAsync">PANIC</button>
</header>

@if (Decks.Count == 0)
{
    <main><p class="hint">Diese Halle hat noch kein Deck eingerichtet.</p></main>
}
else
{
    <main>
        <div class="decklist">
            @foreach (var id in Decks)
            {
                var deckId = id;
                <section class="deck" @key="deckId">
                    <h2>@(Deck.Layout(deckId)?.Name ?? deckId)<span class="page"> · @Deck.Title(deckId)</span></h2>
                    <div class="grid" style="--cols:@(Deck.Layout(deckId)?.Columns ?? 8)">
                        @foreach (var slot in Deck.Slots(deckId))
                        {
                            var music = Payload.MusicOf(slot.MusicId);
                            <button class="key @(slot.Pressable ? "" : "flat") @(slot.Active ? "playing" : "") @(slot.Top.Length > 0 ? "split" : "")"
                                    style="background:@Hex(slot.Color); color:@Hex(slot.TextColor)"
                                    disabled="@(!slot.Pressable)"
                                    data-id="@(slot.MusicId is { Length: > 0 } tile ? tile : $"{deckId}:{slot.Number}")"
                                    data-play="@(music is null ? null : "songs")"
                                    data-songs="@music?.SongsJson"
                                    data-random="@(music is { Random: true } ? "1" : "0")"
                                    data-multi="@(music is { Songs: > 1 } ? "1" : null)"
                                    data-label="@slot.Label"
                                    @onclick="() => PressAsync(deckId, slot)"
                                    @key="slot.Number">
                                @if (slot.Top is { Length: > 0 } heading)
                                {
                                    <span class="split-top">@heading</span>
                                    <span class="split-bottom">@slot.Label</span>
                                }
                                else
                                {
                                    @if (DeckIcons.NameOf(slot.ImageKey) is { Length: > 0 } icon)
                                    {
                                        <img src="/icons/@(icon).png" alt="" />
                                    }
                                    else if (slot.Symbol is { Length: > 0 } symbol)
                                    {
                                        <span class="symbol">@symbol</span>
                                    }
                                    <span class="label">
                                        @foreach (var line in slot.Label.Split(NewLine))
                                        {
                                            <span>@line</span>
                                        }
                                    </span>
                                    @if (slot.Subtitle is { Length: > 0 } subtitle)
                                    {
                                        <span class="sub">@subtitle</span>
                                    }
                                    @if (music is { Songs: > 1 })
                                    {
                                        <span class="badge">@music.Songs @(music.Random ? "🔀" : "🔁")</span>
                                    }
                                }
                                <em>@slot.Number</em>
                            </button>
                        }
                    </div>
                </section>
            }
        </div>
        <p class="hint">Musik spielt auf diesem Rechner, Tasten laufen in der Halle.</p>
    </main>

    <footer class="now">
        <span class="np">@(_playing is { Length: > 0 } playing ? playing : "keine Musik")</span>
        <button class="ctl" @onclick="@(() => Control("pause"))">Pause</button>
        <button class="ctl" @onclick="@(() => Control("previous"))">◀◀</button>
        <button class="ctl" @onclick="@(() => Control("next"))">▶▶</button>
        <button class="ctl" @onclick="@(() => Control("fade"))">Fade</button>
        <button class="ctl stop" @onclick="@(() => Control("stop"))">Stopp</button>
    </footer>
}
</div>

@code {
    private const char NewLine = '\n';

    private readonly string _board = Guid.NewGuid().ToString("N");
    private string? _playing;
    private long _version;
    private long _musicOrder = -1;
    private long _controlOrder = -1;
    private CancellationTokenSource? _watch;
    private DotNetObjectReference<Board>? _self;
    private bool _ready;

    private IReadOnlyList<string> Decks => Deck.Decks;

    protected override void OnInitialized()
    {
        _watch = new CancellationTokenSource();
        _ = WatchAsync(_watch.Token);
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        _self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("hallBoard.start", _self); }
        catch (JSException) { }
        Deck.Claim(_board);
        _musicOrder = Deck.MusicOrder;
        _controlOrder = Deck.ControlOrder;
        _ready = true;
    }

    [JSInvokable]
    public Task Playing(string label)
    {
        _playing = label.Length > 0 ? label : null;
        return InvokeAsync(StateHasChanged);
    }

    private async Task PressAsync(string deckId, DeckSlot slot)
    {
        Deck.Claim(_board);
        if (slot.MusicId is { Length: > 0 })
        {
            Deck.NoteFromBoard(slot.MusicId);
            return;
        }
        await Deck.PressAsync(deckId, slot.Number);
    }

    private Task PanicAsync()
    {
        Deck.Claim(_board);
        return Deck.PanicAsync(CancellationToken.None);
    }

    private Task Control(string what)
    {
        Deck.Claim(_board);
        return Deck.MusicControlAsync(what);
    }

    private async Task WatchAsync(CancellationToken stop)
    {
        while (!stop.IsCancellationRequested)
        {
            await Deck.WaitAsync(_version, TimeSpan.FromSeconds(20), stop);
            _version = Deck.Version;
            if (_ready) await FollowMusicAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FollowMusicAsync()
    {
        if (Deck.ControlOrder != _controlOrder)
        {
            _controlOrder = Deck.ControlOrder;
            if (Deck.ControlWanted is { Length: > 0 } what) await JS.InvokeVoidAsync("hallBoard.control", what);
        }
        if (Deck.MusicOrder == _musicOrder) return;
        _musicOrder = Deck.MusicOrder;
        if (Deck.MusicId.Length == 0 || !Deck.PlayedBy(_board))
        {
            await JS.InvokeVoidAsync("hallBoard.stop");
            return;
        }
        if (Payload.MusicOf(Deck.MusicId) is not { } music) return;
        await JS.InvokeVoidAsync("hallBoard.play", music.Id, music.SongsJson, music.Random, music.Display);
    }

    private static string Hex(int color) => "#" + color.ToString("X6");

    public async ValueTask DisposeAsync()
    {
        if (_watch is not null)
        {
            await _watch.CancelAsync();
            _watch.Dispose();
        }
        _self?.Dispose();
    }
}
