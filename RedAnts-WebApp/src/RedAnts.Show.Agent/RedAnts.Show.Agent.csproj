<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RedAnts.Show.Agent</RootNamespace>
    <AssemblyName>RedAnts.Show.Agent</AssemblyName>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>

  <Target Name="CopyBoardAssets" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="../RedAnts.Show/wwwroot/dj/soundboard.js" DestinationFolder="wwwroot/dj" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../RedAnts.Show/wwwroot/show/hallboard.js" DestinationFolder="wwwroot/show" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../RedAnts.Show/wwwroot/show/board.css" DestinationFolder="wwwroot/show" SkipUnchangedFiles="true" />
  </Target>


  <ItemGroup>
    <Content Include="Icons/*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
