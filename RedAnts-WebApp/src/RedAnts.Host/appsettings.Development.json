{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Azure": {
    "KeyVaultUri": "https://kv-redants-prod.vault.azure.net/"
  },
  "ConnectionStrings": {
    "_comment": "DSN comes from Azure Key Vault (secret 'ConnectionStrings--umbracoDbDSN') via DefaultAzureCredential. Run 'az login' once; the setup script writes the value. Fallback: dotnet user-secrets set ConnectionStrings:umbracoDbDSN '...'",
    "umbracoDbDSN": "",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "Umbraco": {
    "CMS": {
      "Runtime": {
        "Mode": "BackofficeDevelopment"
      },
      "Global": {
        "UseHttps": false
      },
      "Hosting": {
        "Debug": true
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Admin",
        "UnattendedUserEmail": "admin@localhost.dev",
        "UnattendedUserPassword": "Admin1234!"
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://localhost:44370"
      }
    }
  },
  "Turnstile": {
    "SiteKey": "1x00000000000000000000AA",
    "SecretKey": "1x0000000000000000000000000000000AA"
  },
  "Payrexx": {
    "Instance": "",
    "ApiSecret": ""
  },
  "Orders": {
    "NumberPrefix": "DEV-"
  },
  "Migrations": {
    "RunAtBoot": true
  },
  "Show": {
    "Storage": {
      "PublicBaseUrl": "https://stredantsdev.blob.core.windows.net/show"
    }
  }
}
