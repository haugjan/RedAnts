@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using RedAnts.Ticketing.Features.Catalog.Shop
@inject GetVenue.Handler VenueQuery
@{
    Layout = "~/Features/Shared/Views/_TicketsLayout.cshtml";
    ViewData["Title"] = Model.Name;
    ViewData["PlainLayout"] = true;
    var venue = await VenueQuery.HandleAsync(new GetVenue.Query(Model.Id));
    var name = venue?.Name ?? Model.Name;
    var image = venue?.ImageUrl;
    var description = venue?.Description;
    var geo = venue?.GoogleGeoId;
}

@if (!string.IsNullOrEmpty(image))
{
    <img src="@image" class="img-fluid rounded mt-2 mb-3" style="max-height:320px;width:100%;object-fit:cover;" alt="@name" />
}

<h1 class="mt-2 mb-2">@name</h1>

@if (!string.IsNullOrEmpty(description)) { @Html.Raw(description) }

@if (!string.IsNullOrEmpty(geo))
{
    <p class="mt-3">
        <a class="btn btn-outline-secondary btn-sm" target="_blank"
           href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(name)&query_place_id=@geo">
            Auf Google Maps öffnen
        </a>
    </p>
}
