@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using RedAnts.Ticketing.Domain
@using RedAnts.Ticketing.Features.Catalog.Shop
@inject GetSeasonForSale.Handler SeasonQuery
@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";

    var status = Model.Value<string>("status");
    var providedSecret = Context.Request.Query["secret"].ToString();
    var accessSecret = Model.Key.ToString().Split('-')[0];
    var statusEnum = Enum.TryParse<SeasonStatus>(status, out var st) ? st : SeasonStatus.Draft;
    var blocked = !AccessGate.SeasonOk(statusEnum, accessSecret, providedSecret);
    if (blocked) { Context.Response.StatusCode = 404; }

    ViewBag.PageTitle = Model.Name + " – Red Ants";
    ViewBag.TransparentNav = !blocked;

    var season = blocked ? null : await SeasonQuery.HandleAsync(new GetSeasonForSale.Query(Model.Id));
    var events = season?.Events ?? new List<UpcomingEvent>();
}

@if (blocked || season is null)
{
    <main class="flexpage-main" style="padding-top:66px;">
        <div style="max-width:900px;margin:3rem auto;padding:0 20px;color:#666;">
            Diese Saison ist nicht verfügbar.
        </div>
    </main>
}
else
{
    <main class="flexpage-main">
        <section class="page-header @(string.IsNullOrEmpty(season.ImageUrl) ? "page-header--plain" : "")"
                 style="@(string.IsNullOrEmpty(season.ImageUrl) ? "" : $"background-image:url('{season.ImageUrl}');")">
            @if (!string.IsNullOrEmpty(season.ImageUrl))
            {
                <div class="page-header-overlay"></div>
            }
            <div class="page-header-inner">
                <h1 class="page-header-title">@season.Name</h1>
                <p class="page-header-date">@season.StartDate.ToString("dd.MM.yyyy") – @season.EndDate.ToString("dd.MM.yyyy")</p>
            </div>
        </section>

        <section class="event-list">
            <div class="event-list-inner">
                <a class="page-back" href="/ticketing/">← Zurück zur Hauptübersicht</a>
                <h2 class="event-list-title">Anstehende Anlässe</h2>

                @if (events.Count == 0)
                {
                    <p class="event-list-empty">Zurzeit sind keine Anlässe im Verkauf.</p>
                }
                else
                {
                    <ul class="event-list-items">
                        @foreach (var evt in events)
                        {
                            var soldOut = evt.SoldOut;
                            <li class="event-item">
                                <a class="event-item-link @(soldOut ? "event-item-link--soldout" : "")" href="@(soldOut ? null : evt.Url)" aria-disabled="@(soldOut ? "true" : null)">
                                    @if (!string.IsNullOrEmpty(evt.HomeTeamLogoUrl) || !string.IsNullOrEmpty(evt.AwayTeamLogoUrl))
                                    {
                                        <span class="event-item-logos">
                                            @if (!string.IsNullOrEmpty(evt.HomeTeamLogoUrl)) { <img class="team-logo" src="@evt.HomeTeamLogoUrl" alt="Heimteam" /> }
                                            <span class="event-item-vs">vs</span>
                                            @if (!string.IsNullOrEmpty(evt.AwayTeamLogoUrl)) { <img class="team-logo" src="@evt.AwayTeamLogoUrl" alt="Auswärtsteam" /> }
                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(evt.ImageUrl))
                                    {
                                        <span class="event-item-thumb" style="background-image:url('@evt.ImageUrl');"></span>
                                    }
                                    <span class="event-item-body">
                                        <span class="event-item-date">@evt.Date.ToString("dd.MM.yyyy")@(evt.TimeUnknown ? "" : $" · {evt.StartTime:HH:mm} Uhr")</span>
                                        <span class="event-item-name">@evt.Name</span>
                                        @if (!string.IsNullOrEmpty(evt.VenueName)) { <span class="event-item-venue">@evt.VenueName</span> }
                                    </span>
                                    <span class="event-item-cta @(soldOut ? "event-item-cta--soldout" : "")">@(soldOut ? "Ausverkauft" : "Tickets →")</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    </main>

    <style>
        .page-header { position: relative; background-size: cover; background-position: center; min-height: 300px; display: flex; align-items: flex-end; }
        .page-header--plain { background: #101010; }
        .page-header-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16,16,16,.15) 0%, rgba(16,16,16,.75) 100%); }
        .page-header-inner { position: relative; z-index: 1; width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 24px 40px; }
        .page-header-title { font-family: 'Oswald', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: #fff; font-size: clamp(2.4rem, 6vw, 4.5rem); line-height: 1; margin: 0; }
        .page-header-title::after { content: ""; display: block; width: 64px; height: 5px; background: #C8102E; margin-top: 16px; }
        .page-header-date { color: rgba(255,255,255,.85); margin: 14px 0 0; font-size: .98rem; }

        .event-list { padding: 56px 20px; background: #f6f7f9; }
        .event-list-inner { max-width: 900px; margin: 0 auto; }
        .page-back { display: inline-block; margin-bottom: 18px; color: #666; text-decoration: none; font-weight: 700; font-size: .9rem; }
        .page-back:hover { color: #C8102E; }
        .event-list-title { font-family: 'Oswald', sans-serif; font-size: 2.4rem; text-transform: uppercase; letter-spacing: .5px; margin: 0 0 24px; color: #101010; }
        .event-list-empty { color: #666; }
        .event-list-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
        .event-item-link { display: flex; align-items: center; gap: 16px; background: #fff; border: 1px solid #e6e6e6; border-radius: 10px; padding: 14px 18px; text-decoration: none; color: inherit; transition: box-shadow .15s, transform .15s; }
        .event-item-link:hover { box-shadow: 0 6px 18px rgba(0,0,0,.08); transform: translateY(-1px); }
        .event-item-thumb { flex: 0 0 auto; width: 72px; height: 72px; border-radius: 8px; background-size: cover; background-position: center; }
        .event-item-logos { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; min-width: 72px; }
        .event-item-vs { font-family: 'Oswald', sans-serif; font-weight: 700; text-transform: uppercase; font-size: .85rem; color: #999; }
        .event-item-body { display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; }
        .event-item-date { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; color: #C8102E; }
        .event-item-name { font-family: 'Oswald', sans-serif; font-size: 1.5rem; line-height: 1.1; color: #101010; }
        .event-item-venue { font-size: .9rem; color: #666; }
        .event-item-cta { flex: 0 0 auto; font-weight: 700; color: #C8102E; white-space: nowrap; }
        .event-item-link--soldout { cursor: default; }
        .event-item-link--soldout:hover { box-shadow: none; transform: none; }
        .event-item-link--soldout .event-item-name, .event-item-link--soldout .event-item-logos, .event-item-link--soldout .event-item-thumb { opacity: .55; }
        .event-item-cta--soldout { color: #666; text-transform: uppercase; letter-spacing: .4px; font-size: .85rem; }
        @@media (max-width: 560px) { .event-item-cta:not(.event-item-cta--soldout) { display: none; } .event-item-thumb { width: 56px; height: 56px; } }
    </style>
}
