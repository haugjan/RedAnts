@using RedAnts.Show.Domain
@using RedAnts.Show.Features.Games
@using RedAnts.Show.Features.Music
@using RedAnts.Show.Features.TabBoards
@implements IDisposable
@inject GetTabBoard.Handler BoardQuery
@inject GetMusic.Handler MusicQuery
@inject GetGames.Handler GamesQuery
@inject GetGame.Handler GameQuery
@inject IJSRuntime JS

<div class="hb">
<header class="bar">
    @if (_started)
    {
        <button class="hall tw-change" @onclick="() => _started = false" title="Zurück zum Anfang: Halle, Liga und Funktionen neu wählen">@VenueName · @LeagueName ▾</button>
    }
    else
    {
        <span class="hall">Tab-Bord · Test im Web</span>
    }
    <span class="spacer"></span>
    @if (_started)
    {
    @if (_board.Decks.Count > 1)
    {
        <select class="pick" @bind="_deckId" title="Deck">
            @foreach (var deck in _board.Decks)
            {
                <option value="@deck.Id">@deck.Name</option>
            }
        </select>
    }
    }
    <button class="panic" @onclick="@(() => ControlAsync("stop"))">Stopp</button>
</header>

<p class="tw-warning">
    Testmodus im Web: Die Musik läuft in diesem Browser. Livestream (vMix) und LED-Wand werden nicht angesteuert,
    rechts siehst du nur eine Vorschau davon. Echt laufen sie nur auf dem Bord des Regie-PC.
</p>

@if (!_started)
{
    <main class="tw-start">
        <h2>1. Halle</h2>
        <div class="tw-choices">
            @foreach (var venue in _board.Venues)
            {
                var id = venue.Id;
                <button class="tw-choice @(id == _venue ? "on" : "")" @key="id" @onclick="() => ChooseVenue(id)">@venue.Name</button>
            }
        </div>

        @if (Venue is not null)
        {
            <h2>2. Liga</h2>
            <div class="tw-choices">
                @foreach (var league in _board.Leagues)
                {
                    var id = league.Id;
                    <button class="tw-choice @(id == _league ? "on" : "")" @key="id" @onclick="() => ChooseLeague(id)">@league.Name</button>
                }
            </div>
        }

        @if (Venue is { } venue2 && League is not null)
        {
            var available = BoardFunctions.Available(venue2);
            <h2>3. Funktionen</h2>
            <p class="hint">Vorgegeben von Halle und Liga, hier für dieses Spiel änderbar.</p>
            <div class="tw-functions">
                @foreach (var (id, label) in BoardFunctions.All)
                {
                    var function = id;
                    var possible = available.On(function);
                    <label class="tw-function @(possible ? "" : "off")" @key="function">
                        <input type="checkbox" checked="@_functions.On(function)" disabled="@(!possible)"
                               @onchange="e => _functions = _functions.With(function, e.Value is true)" />
                        @label
                        @if (!possible)
                        {
                            <span class="tw-why">gibt es in dieser Halle nicht</span>
                        }
                    </label>
                }
            </div>
            <h2>4. Spiel <span class="tw-why">für die Spielerinnen-Auswahl, freiwillig</span></h2>
            <select class="tw-game" @bind="_gameId">
                <option value="">Kein Spiel, Beispiel-Spielerinnen</option>
                @foreach (var game in _games)
                {
                    <option value="@game.Id">@GameLabel(game)</option>
                }
            </select>
            <button class="tw-go" @onclick="StartAsync">Starten</button>
        }
    </main>
}
else if (Deck is not { } current)
{
    <main><p class="hint">Auf dem Tab-Bord ist noch kein Deck eingerichtet.</p></main>
}
else
{
  <div class="tw-split">
   <div class="tw-board">
    <nav class="tw-tabs">
        @if (current.FollowsTab)
        {
            @foreach (var (id, name) in BoardTabs.All)
            {
                var tab = id;
                <button class="tw-tab @(tab == _tab ? "on" : "")" @key="tab" @onclick="() => _tab = tab">@name</button>
            }
        }
        else
        {
            <span class="tw-own">Eigene Seite, gleich auf jedem Tab</span>
        }
    </nav>

    <main>
        @if (_pick is { } pick)
        {
            <section class="tw-pick">
                <header>
                    <strong>@PickPrompt(pick)</strong>
                    <span class="spacer"></span>
                    <button class="tw-pick-done" @onclick="() => _pick = null">@(pick.Many ? "Fertig" : "Abbrechen")</button>
                </header>
                @if (pick.Action.Special is SpecialKey.PenaltyHome or SpecialKey.PenaltyAway)
                {
                    <div class="tw-penalties">
                        @foreach (var length in BoardPreview.Penalties)
                        {
                            var chosen = length;
                            <button class="tw-tab @(chosen == _penalty ? "on" : "")" @onclick="() => _penalty = chosen">@chosen</button>
                        }
                    </div>
                }
                @if (_roster.Count == 0)
                {
                    <p class="hint">Kein Spiel gewählt oder keine Spielerinnen erfasst. Auf dem Regie-PC kommen sie aus dem Spiel.</p>
                }
                <div class="tw-players">
                    @foreach (var player in Roster(pick))
                    {
                        var chosen = player;
                        <button class="tw-player @(pick.Done.Contains(chosen.Number) ? "done" : "")" @key="chosen.Number" @onclick="() => Pick(pick, chosen)">
                            <b>@(chosen.Number > 0 ? chosen.Number : "–")</b><span>@chosen.Name</span>
                        </button>
                    }
                </div>
            </section>
        }
        else
        {
        <section class="deck">
            <div class="grid" style="--cols:@current.Columns">
                @for (var n = 1; n <= current.Count; n++)
                {
                    var number = n;
                    var key = Keys.GetValueOrDefault(number);
                    var switchedOff = key is not null && !_functions.Runs(key.Action);
                    var web = key is null || switchedOff ? WebKey.Nothing : WebKey.Of(key.Action);
                    var music = web.MusicId is { } musicId ? _music.FirstOrDefault(m => m.Id == musicId) : null;
                    var reserved = current.Reserved(number);
                    var works = key is not null && !switchedOff;
                    <button class="key @(works ? "" : "flat") @(music is not null && music.Id == _playing ? "playing" : "")"
                            style="background:@(key?.Button.Color ?? (reserved ? "#3a3f47" : "#111"));color:#fff"
                            disabled="@(!works)"
                            title="@(switchedOff ? "Für dieses Spiel ausgeschaltet" : key is not null && !web.Works ? "Livestream und LED nur als Vorschau" : "")"
                            data-play="@(music is null ? null : "songs")"
                            data-label="@(key?.Button.Label)"
                            @onclick="() => PressAsync(key, web, music)"
                            @key="number">
                        @if (key is not null)
                        {
                            @if (key.Button.Icon is { Length: > 0 } icon && DeckIcons.Known(icon))
                            {
                                <img src="@DeckIcons.FileOf(icon)" alt="" />
                            }
                            else if (key.Button.Icon is { Length: > 0 } symbol)
                            {
                                <span class="symbol">@symbol</span>
                            }
                            <span class="label"><span>@(key.Position is { } position ? $"{position}. {key.Button.Label}" : key.Button.Label)</span></span>
                        }
                        else if (reserved)
                        {
                            <span class="label"><span>@(number == current.Panic ? "PANIC" : "Zurück")</span></span>
                        }
                        <em>@number</em>
                    </button>
                }
            </div>
        </section>
        }
    </main>

    <footer class="now">
        <span class="np">@(_label is { Length: > 0 } now ? now : "keine Musik")</span>
        <button class="ctl" @onclick="@(() => ControlAsync("pause"))">Pause</button>
        <button class="ctl" @onclick="@(() => ControlAsync("previous"))">◀◀</button>
        <button class="ctl" @onclick="@(() => ControlAsync("next"))">▶▶</button>
        <button class="ctl" @onclick="@(() => ControlAsync("fade"))">Fade</button>
        <button class="ctl stop" @onclick="@(() => ControlAsync("stop"))">Stopp</button>
    </footer>
   </div>
   <BoardPreviewPanel Preview="_preview" Functions="_functions" LedInHall="LedInHall" Playing="@(_playing is null ? null : _label)" />
  </div>
}
</div>

@code {
    private TabBoard _board = TabBoard.Empty;
    private IReadOnlyList<MusicItem> _music = [];
    private string _deckId = "";
    private string _league = "";
    private string _tab = BoardTabs.Before;
    private string _venue = "";
    private bool _started;
    private BoardFunctions _functions = new(true, true, true, true, true);

    private Venue? Venue => _board.Venues.FirstOrDefault(v => v.Id == _venue);

    private League? League => _board.Leagues.FirstOrDefault(l => l.Id == _league);

    private string VenueName => Venue?.Name ?? "Halle";

    private string LeagueName => League?.Name ?? "Liga";

    private void ChooseVenue(string id)
    {
        _venue = id;
        Defaults();
    }

    private void ChooseLeague(string id)
    {
        _league = id;
        Defaults();
    }

    private void Defaults()
    {
        if (Venue is { } venue && League is { } league) _functions = BoardFunctions.Defaults(venue, league);
    }

    private async Task StartAsync()
    {
        var game = _gameId.Length > 0 ? await GameQuery.HandleAsync(new GetGame.Query(_gameId)) : null;
        _game = game;
        _roster = game is null ? [] : PreviewTeams.Team(game, "home").Players.Concat(PreviewTeams.Team(game, "away").Players).ToList();
        _pick = null;
        if (Venue is { } venue) _functions = _functions.Within(BoardFunctions.Available(venue));
        _tab = BoardTabs.Before;
        _preview = BoardPreview.Start with { Names = game is null ? null : PreviewTeams.From(game) };
        _started = true;
    }
    private string? _playing;
    private BoardPreview _preview = BoardPreview.Start;
    private IReadOnlyList<GameRow> _games = [];
    private string _gameId = "";
    private Game? _game;
    private IReadOnlyList<Player> _roster = [];
    private PlayerPick? _pick;
    private string _penalty = "2'";

    private sealed record PlayerPick(ButtonAction Action, string Side, bool Many)
    {
        public HashSet<int> Done { get; } = [];
    }

    private static string GameLabel(GameRow game) =>
        $"{(game.Date is { } date ? date.ToString("dd.MM.yyyy") + " · " : "")}{game.Home} – {game.Away}";

    private string PickPrompt(PlayerPick pick) => pick.Action.Special switch
    {
        SpecialKey.GoalHome or SpecialKey.GoalAway => $"Torschützin {_preview.Teams.Of(pick.Side)}?",
        SpecialKey.PenaltyHome or SpecialKey.PenaltyAway => $"Strafe {_preview.Teams.Of(pick.Side)}: wer?",
        SpecialKey.BestPlayerHome or SpecialKey.BestPlayerAway => $"Best Player {_preview.Teams.Of(pick.Side)}?",
        SpecialKey.Starting6Home or SpecialKey.Starting6Away => $"Starting Six {_preview.Teams.Of(pick.Side)}: der Reihe nach antippen",
        _ => $"Spielerin {_preview.Teams.Of(pick.Side)}?",
    };

    private IReadOnlyList<Player> Roster(PlayerPick pick)
    {
        if (_game is not { } game) return [BoardPreview.SamplePlayer(pick.Side)];
        var team = PreviewTeams.Team(game, pick.Side);
        if (team.Players.Count == 0) return [BoardPreview.SamplePlayer(pick.Side)];
        var starting = pick.Action.Special is SpecialKey.Starting6Home or SpecialKey.Starting6Away && team.HasStarting6
            ? team.Starting6.Select(n => team.Find(n)!).ToList()
            : [];
        return starting.Count > 0 ? starting : team.Players.OrderBy(p => p.Number).ToList();
    }

    private void Pick(PlayerPick pick, Player player)
    {
        _preview = _preview.Picked(pick.Action, player, _functions, _penalty);
        pick.Done.Add(player.Number);
        if (!pick.Many) _pick = null;
    }
    private int _press;

    private bool LedInHall => Venue is not { } venue || BoardFunctions.Available(venue).Led;
    private string? _label;
    private DotNetObjectReference<TabBoardTestPage>? _self;

    private BoardDeck? Deck => _board.Deck(_deckId) ?? _board.Decks.FirstOrDefault();

    private IReadOnlyDictionary<int, ResolvedKey> Keys =>
        Deck is { } deck ? _board.Resolve(deck, _tab, _league).ToDictionary(k => k.Number) : new Dictionary<int, ResolvedKey>();

    protected override async Task OnInitializedAsync()
    {
        _board = await BoardQuery.HandleAsync(new GetTabBoard.Query());
        _music = await MusicQuery.HandleAsync(new GetMusic.Query());
        _games = (await GamesQuery.HandleAsync(new GetGames.Query())).Take(40).ToList();
        _deckId = _board.Decks.FirstOrDefault(d => d.FollowsTab)?.Id ?? _board.Decks.FirstOrDefault()?.Id ?? "";
        _league = "";
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        _self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("hallBoard.start", _self); }
        catch (JSException) { }
    }

    [JSInvokable]
    public Task Playing(string label)
    {
        _label = label.Length > 0 ? label : null;
        if (_label is null) _playing = null;
        return InvokeAsync(StateHasChanged);
    }

    private async Task PressAsync(ResolvedKey? key, WebKey web, MusicItem? music)
    {
        if (key is not null)
        {
            _ = PreviewAsync(key.Action);
            if (BoardPreview.Picks(key.Action) && _functions.Players)
            {
                _penalty = BoardPreview.Penalties[0];
                _pick = new PlayerPick(key.Action, BoardPreview.SideOf(key.Action),
                    key.Action.Special is SpecialKey.Starting6Home or SpecialKey.Starting6Away);
            }
        }
        if (music is not null)
        {
            if (_playing == music.Id)
            {
                await ControlAsync("fade");
                _playing = null;
                return;
            }
            _playing = music.Id;
            await JS.InvokeVoidAsync("hallBoard.play", music.Id, music.SongsJson, music.Random, music.Display);
            return;
        }
        if (web.Control is { } control) await ControlAsync(control);
    }

    private async Task ControlAsync(string what)
    {
        if (what == "stop") _playing = null;
        await JS.InvokeVoidAsync("hallBoard.control", what);
    }

    private async Task PreviewAsync(ButtonAction action)
    {
        var press = ++_press;
        _preview = _preview.Press(action, _functions);
        foreach (var (ms, steps) in BoardPreview.Phases(action).Skip(1))
        {
            await Task.Delay(ms);
            if (press != _press) return;
            _preview = _preview.Run(steps, _functions);
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _press++;
        _self?.Dispose();
    }
}
