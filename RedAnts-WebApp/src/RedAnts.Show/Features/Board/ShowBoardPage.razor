@using RedAnts.Show.Domain
@using RedAnts.Show.Features.Agents
@using RedAnts.Show.Features.Halls
@using RedAnts.Show.Features.Music
@implements IDisposable
@inject GetHalls.Handler HallsQuery
@inject GetHall.Handler HallQuery
@inject GetHallStatus.Handler StatusQuery
@inject GetDeckView.Handler DeckQuery
@inject GetSounds.Handler SoundsQuery
@inject PressDeckKey.Handler KeyPress
@inject PanicHall.Handler Panic
@inject NavigationManager Navigation
@inject ShowBoardFeed Feed

<div class="sb">
<header class="bar">
    @if (_halls.Count > 1)
    {
        <select class="pick" @bind="_hallId" @bind:after="SwitchAsync">
            @foreach (var row in _halls)
            {
                <option value="@row.Id">@row.Name</option>
            }
        </select>
    }
    else
    {
        <span class="hall">@(_hall?.Name ?? "keine Halle")</span>
    }
    <span class="lamp @(Connected ? "on" : "off")"></span>
    <span class="score">@Score(true) : @Score(false)</span>
    @if (_hall?.Offers.Clock == true)
    {
        <span class="time">@Time()</span>
        <span class="period">@Period()</span>
    }
    <span class="spacer"></span>
    @foreach (var state in DefaultStates.All.Where(s => Offered(s.Id)))
    {
        var value = StateValue(state);
        <span class="pill @(value != state.First ? "on" : "")" @key="state.Id">@state.Name: @value</span>
    }
    <button class="panic" @onclick="PanicAsync">PANIC</button>
</header>

@if (_hall is null)
{
    <main><p class="hint">Keine Halle eingerichtet.</p></main>
}
else
{
    @if (_hall.DeckLayouts.Count > 1)
    {
        <nav class="decks">
            @foreach (var tab in _hall.DeckLayouts)
            {
                <button class="tab @(tab.Id == _deck ? "active" : "")" @onclick="() => SelectDeckAsync(tab.Id)" @key="tab.Id">@tab.Name</button>
            }
        </nav>
    }

    <main>
        <h1>@(_view?.Title ?? "Bord")</h1>
        <div class="board" style="grid-template-columns: repeat(@Columns, minmax(0, 1fr))">
            @foreach (var key in Keys)
            {
                <button class="key @(key.Pressable ? "" : "flat")"
                        style="background:@key.Color;color:@key.TextColor"
                        disabled="@(!key.Pressable)"
                        @onclick="() => PressAsync(key)"
                        @key="key.Number">
                    @if (key.Icon is { Length: > 0 } icon)
                    {
                        <img src="/_content/RedAnts.Show/show/icons/@(icon).png" alt="" />
                    }
                    @foreach (var line in key.Label.Split(NewLine))
                    {
                        <span>@line</span>
                    }
                    <em>@key.Number</em>
                </button>
            }
        </div>

        @if (_note is { Length: > 0 } note)
        {
            <p class="note">@note</p>
        }
        @if (_playing is { } playing)
        {
            <p class="hint">Läuft: @playing</p>
        }
        @if (_playingUrl is { Length: > 0 } url)
        {
            <audio class="player" controls autoplay src="@url" @key="url"></audio>
        }
        <p class="hint">
            @(Connected
                ? "Agent verbunden: Tasten laufen in der Halle, Musik spielt in diesem Browser."
                : "Kein Agent verbunden: nur Musik spielt in diesem Browser, Uhr, vMix und LED bleiben still.")
        </p>
    </main>
}
</div>

@code {
    private const char NewLine = '\n';

    [Parameter] public string? HallId { get; set; }

    private string? _hallId;
    private string? _given;

    private IReadOnlyList<HallRow> _halls = [];
    private Hall? _hall;
    private HallStatus? _status;
    private DeckView? _view;
    private IReadOnlyList<SoundCommand> _sounds = [];
    private string _deck = DeckLayout.FieldDeck;
    private string? _note;
    private string? _playing;
    private string? _playingUrl;
    private long _soundOrder = -1;
    private Timer? _poll;

    private bool Connected => _status?.Connected == true;

    private int Columns => _view?.Columns ?? 8;

    private IReadOnlyList<DeckKeyRow> Keys => _view?.Keys ?? [];

    protected override async Task OnInitializedAsync()
    {
        _halls = await HallsQuery.HandleAsync(new GetHalls.Query());
        _given = HallId;
        var wanted = HallId ?? Query("halle");
        _hallId = _halls.FirstOrDefault(h => h.Id == wanted)?.Id ?? _halls.FirstOrDefault()?.Id;
        if (Query("deck") is { Length: > 0 } deck) _deck = deck;
        _sounds = await SoundsQuery.HandleAsync(new GetSounds.Query());
        await LoadHallAsync();
        Feed.Changed += OnFeed;
        _poll = new Timer(async _ => await RefreshAsync(), null, TimeSpan.Zero, TimeSpan.FromSeconds(5));
    }

    protected override async Task OnParametersSetAsync()
    {
        if (HallId == _given) return;
        _given = HallId;
        if (HallId is not { Length: > 0 }) return;
        _hallId = HallId;
        await SwitchAsync();
    }

    private async Task LoadHallAsync()
    {
        if (_hallId is not { Length: > 0 } id) return;
        _hall = await HallQuery.HandleAsync(new GetHall.Query(id));
        if (_hall is not null && _hall.DeckLayouts.All(d => d.Id != _deck)) _deck = _hall.DeckLayouts[0].Id;
    }

    private async Task SwitchAsync()
    {
        await LoadHallAsync();
        await RefreshAsync();
    }

    private async Task SelectDeckAsync(string deckId)
    {
        _deck = deckId;
        await RefreshAsync();
    }

    private void OnFeed(string hallId)
    {
        if (!string.Equals(hallId, _hallId, StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(async () =>
        {
            await ReadDeckAsync();
            StateHasChanged();
        });
    }

    private async Task ReadDeckAsync()
    {
        if (_hallId is not { Length: > 0 } id) return;
        _view = await DeckQuery.HandleAsync(new GetDeckView.Query(id, _deck));
        FollowSound();
    }

    private async Task RefreshAsync()
    {
        if (_hallId is not { Length: > 0 } id) return;
        _status = await StatusQuery.HandleAsync(new GetHallStatus.Query(id));
        await ReadDeckAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PressAsync(DeckKeyRow key)
    {
        _note = null;
        if (key.SoundId is { Length: > 0 } id && !Connected)
        {
            Play(_sounds.FirstOrDefault(s => s.Id == id));
            return;
        }
        if (_hallId is not { Length: > 0 } hall || !await KeyPress.HandleAsync(new PressDeckKey.Command(hall, _deck, key.Number)))
            _note = "Kein Agent verbunden.";
        await RefreshAsync();
    }

    private async Task PanicAsync()
    {
        Stop();
        if (_hallId is { Length: > 0 } id && !await Panic.HandleAsync(new PanicHall.Command(id)))
            _note = "Kein Agent verbunden.";
    }

    private void FollowSound()
    {
        if (_view?.Live is not { } live || live.SoundOrder == _soundOrder) return;
        _soundOrder = live.SoundOrder;
        if (live.SoundId.Length == 0) { Stop(); return; }
        Play(_sounds.FirstOrDefault(s => s.Id == live.SoundId));
    }

    private void Play(SoundCommand? sound)
    {
        if (sound is null) { _note = "Dieser Musik-Befehl fehlt."; return; }
        var track = sound.Tracks.FirstOrDefault();
        if (track is null) { _note = $"{sound.Label} hat noch keinen Song."; return; }
        if (track.IsSpotify) { _note = "Spotify spielt das Bord noch nicht ab."; return; }
        _playing = $"{sound.Label} · {track.Display}";
        _playingUrl = SoundMedia.Url(track);
    }

    private void Stop()
    {
        _playing = null;
        _playingUrl = null;
    }

    private bool Offered(string stateId)
    {
        if (_hall is null) return false;
        return stateId switch
        {
            DefaultStates.Music => _hall.Offers.Sound,
            DefaultStates.Led or DefaultStates.Sponsors => _hall.Offers.Led,
            DefaultStates.Light => _hall.Offers.Light,
            DefaultStates.Overlay => _hall.Offers.Vmix,
            DefaultStates.ClockVisible or DefaultStates.ClockRunning => _hall.Offers.Clock && _hall.Offers.Vmix,
            _ => true,
        };
    }

    private string Score(bool home)
    {
        if (_view?.Live is { } live) return home ? live.HomeScore : live.AwayScore;
        return Report(AgentReportKinds.Score, home ? "home" : "away", "–");
    }

    private string Time() => _view?.Live?.Time is { Length: > 0 } time ? time : Report(AgentReportKinds.Clock, "time", "--:--");

    private string Period() => _view?.Live?.PeriodLabel is { Length: > 0 } period ? period : Report(AgentReportKinds.Clock, "periodLabel", "");

    private string StateValue(ShowState state)
    {
        if (_view?.States is { } live && live.TryGetValue(state.Id, out var current) && current.Length > 0) return current;
        var json = _status?.Report(AgentReportKinds.Status)?.Json;
        if (json is null) return state.First;
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            return document.RootElement.TryGetProperty("states", out var states)
                   && states.ValueKind == System.Text.Json.JsonValueKind.Object
                   && states.TryGetProperty(state.Id, out var value)
                   && value.GetString() is { Length: > 0 } text
                ? text
                : state.First;
        }
        catch (System.Text.Json.JsonException) { return state.First; }
    }

    private string Report(string kind, string property, string fallback)
    {
        var json = _status?.Report(kind)?.Json;
        if (json is null) return fallback;
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            return document.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object
                   && document.RootElement.TryGetProperty(property, out var value)
                   && value.ToString() is { Length: > 0 } text
                ? text
                : fallback;
        }
        catch (System.Text.Json.JsonException) { return fallback; }
    }

    private string? Query(string name)
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        return query.TryGetValue(name, out var value) ? value.ToString() : null;
    }

    public void Dispose()
    {
        Feed.Changed -= OnFeed;
        _poll?.Dispose();
    }
}
