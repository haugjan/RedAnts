@using RedAnts.Show.Domain
@using RedAnts.Show.Features.Agents
@using RedAnts.Show.Features.Halls
@using RedAnts.Show.Features.Music
@implements IDisposable
@inject GetHalls.Handler HallsQuery
@inject GetHall.Handler HallQuery
@inject GetAgentPresence.Handler Presence
@inject GetDeckView.Handler DeckQuery
@inject GetSounds.Handler SoundsQuery
@inject PressDeckKey.Handler KeyPress
@inject PlayHallSound.Handler SoundPlay
@inject PanicHall.Handler Panic
@inject NavigationManager Navigation
@inject ShowBoardFeed Feed

<div class="sb">
<header class="bar">
    @if (_halls.Count > 1)
    {
        <select class="pick" @bind="_hallId" @bind:after="SwitchAsync">
            @foreach (var row in _halls)
            {
                <option value="@row.Id">@row.Name</option>
            }
        </select>
    }
    else
    {
        <span class="hall">@(_hall?.Name ?? "keine Halle")</span>
    }
    <span class="lamp @(Connected ? "on" : "off")"></span>
    <span class="score">@Score(true) : @Score(false)</span>
    @if (_hall?.Offers.Clock == true)
    {
        <span class="time">@Time()</span>
        <span class="period">@Period()</span>
    }
    <span class="spacer"></span>
    @foreach (var state in DefaultStates.All.Where(s => Offered(s.Id)))
    {
        var value = StateValue(state);
        <span class="pill @(value != state.First ? "on" : "")" @key="state.Id">@state.Name: @value</span>
    }
    <button class="panic" @onclick="PanicAsync">PANIC</button>
</header>

@if (_hall is null)
{
    <main><p class="hint">Keine Halle eingerichtet.</p></main>
}
else
{
    <nav class="decks">
        @foreach (var tab in _hall.DeckLayouts)
        {
            <button class="tab @(tab.Id == _tab ? "active" : "")" @onclick="() => SelectDeckAsync(tab.Id)" @key="tab.Id">@tab.Name</button>
        }
        @if (_hall.Offers.Sound)
        {
            <button class="tab @(_tab == MusicTab ? "active" : "")" @onclick="() => SelectDeckAsync(MusicTab)">Musik</button>
        }
    </nav>

    <main>
    @if (_tab == MusicTab)
    {
        <h1>Musik</h1>
        <nav class="crumbs">
            <button class="crumb" @onclick="() => OpenFolder(0)">Alle</button>
            @for (var level = 0; level < _folder.Count; level++)
            {
                var step = level + 1;
                <span class="sep">›</span>
                <button class="crumb" @onclick="() => OpenFolder(step)" @key="_folder[level]">@_folder[level]</button>
            }
        </nav>
        <div class="tiles">
            @foreach (var folder in Folders())
            {
                <button class="tile folder" @onclick="() => EnterFolder(folder)" @key="folder">
                    <span class="name">@folder</span>
                    <span class="count">@CountIn(folder) Befehle</span>
                </button>
            }
            @foreach (var sound in Leaves())
            {
                <button class="tile @(sound.Id == _queueId ? "active" : "")"
                        style="background:@sound.Color"
                        @onclick="() => PlayOrStopAsync(sound)"
                        @key="sound.Id">
                    <span class="name">@Leaf(sound)</span>
                    <span class="count">@(sound.Tracks.Count > 1 ? $"{sound.Tracks.Count} Songs {(sound.Random ? "zufällig" : "der Reihe nach")}" : "1 Song")</span>
                </button>
            }
            @if (!Folders().Any() && !Leaves().Any())
            {
                <p class="hint">Hier liegt noch keine Musik.</p>
            }
        </div>
    }
    else
    {
        <h1>@(_view?.Title ?? "Bord")</h1>
        <div class="board" style="grid-template-columns: repeat(@Columns, minmax(0, 160px))">
            @foreach (var key in Keys)
            {
                <button class="key @(key.Pressable ? "" : "flat")"
                        style="background:@key.Color;color:@key.TextColor"
                        disabled="@(!key.Pressable)"
                        @onclick="() => PressAsync(key)"
                        @key="key.Number">
                    @if (key.Icon is { Length: > 0 } icon)
                    {
                        <img src="/_content/RedAnts.Show/show/icons/@(icon).png" alt="" />
                    }
                    @foreach (var line in key.Label.Split(NewLine))
                    {
                        <span>@line</span>
                    }
                    <em>@key.Number</em>
                </button>
            }
        </div>
    }

        @if (_note is { Length: > 0 } note)
        {
            <p class="note">@note</p>
        }
        @if (_playing is { } playing)
        {
            <p class="hint">Läuft: @playing</p>
        }
        @if (_playingUrl is { Length: > 0 } url)
        {
            <audio class="player" controls autoplay src="@url" @key="url" @onended="Next"></audio>
        }
        <p class="hint">
            @(Connected
                ? "Agent verbunden: Tasten laufen in der Halle, Musik spielt in diesem Browser."
                : "Kein Agent verbunden: nur Musik spielt in diesem Browser, Uhr, vMix und LED bleiben still.")
        </p>
    </main>
}
</div>

@code {
    private const char NewLine = '\n';
    private const string MusicTab = "musik";
    private const string PathStep = " · ";

    [Parameter] public string? HallId { get; set; }

    private string? _hallId;
    private string? _given;

    private IReadOnlyList<HallRow> _halls = [];
    private Hall? _hall;
    private AgentPresence _agent = new(false, null, null);
    private DeckView? _view;
    private IReadOnlyList<SoundCommand> _sounds = [];
    private string _deck = DeckLayout.FieldDeck;
    private string _tab = DeckLayout.FieldDeck;
    private readonly List<string> _folder = [];
    private string? _note;
    private string? _playing;
    private string? _playingUrl;
    private IReadOnlyList<SoundTrack> _queue = [];
    private int _queueAt;
    private string _queueLabel = "";
    private string _queueId = "";
    private long _soundOrder = -1;
    private Timer? _poll;

    private bool Connected => _agent.Connected;

    private int Columns => _view?.Columns ?? 8;

    private IReadOnlyList<DeckKeyRow> Keys => _view?.Keys ?? [];

    protected override async Task OnInitializedAsync()
    {
        _halls = await HallsQuery.HandleAsync(new GetHalls.Query());
        _given = HallId;
        var wanted = HallId ?? Query("halle");
        _hallId = _halls.FirstOrDefault(h => h.Id == wanted)?.Id ?? _halls.FirstOrDefault()?.Id;
        if (Query("deck") is { Length: > 0 } deck) _deck = deck;
        _sounds = await SoundsQuery.HandleAsync(new GetSounds.Query());
        await LoadHallAsync();
        Feed.Changed += OnFeed;
        _poll = new Timer(async _ => await RefreshAsync(), null, TimeSpan.Zero, TimeSpan.FromSeconds(5));
    }

    protected override async Task OnParametersSetAsync()
    {
        if (HallId == _given) return;
        _given = HallId;
        if (HallId is not { Length: > 0 }) return;
        _hallId = HallId;
        await SwitchAsync();
    }

    private async Task LoadHallAsync()
    {
        if (_hallId is not { Length: > 0 } id) return;
        _hall = await HallQuery.HandleAsync(new GetHall.Query(id));
        if (_hall is not null && _hall.DeckLayouts.All(d => d.Id != _deck)) _deck = _hall.DeckLayouts[0].Id;
    }

    private async Task SwitchAsync()
    {
        await LoadHallAsync();
        await RefreshAsync();
    }

    private async Task SelectDeckAsync(string deckId)
    {
        _tab = deckId;
        if (deckId != MusicTab) _deck = deckId;
        await RefreshAsync();
    }

    private IReadOnlyList<string> Steps(SoundCommand sound) =>
        sound.Label.Split(PathStep, StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

    private bool InFolder(SoundCommand sound)
    {
        var steps = Steps(sound);
        if (steps.Count <= _folder.Count) return false;
        for (var i = 0; i < _folder.Count; i++)
            if (!string.Equals(steps[i], _folder[i], StringComparison.OrdinalIgnoreCase)) return false;
        return true;
    }

    private IEnumerable<string> Folders() =>
        _sounds.Where(s => InFolder(s) && Steps(s).Count > _folder.Count + 1)
            .Select(s => Steps(s)[_folder.Count])
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<SoundCommand> Leaves() =>
        _sounds.Where(s => InFolder(s) && Steps(s).Count == _folder.Count + 1);

    private int CountIn(string folder) =>
        _sounds.Count(s => InFolder(s) && Steps(s).Count > _folder.Count && string.Equals(Steps(s)[_folder.Count], folder, StringComparison.OrdinalIgnoreCase));

    private string Leaf(SoundCommand sound) => Steps(sound) is { Count: > 0 } steps ? steps[^1] : sound.Label;

    private void EnterFolder(string folder)
    {
        _folder.Add(folder);
        _note = null;
    }

    private void OpenFolder(int depth)
    {
        while (_folder.Count > depth) _folder.RemoveAt(_folder.Count - 1);
        _note = null;
    }

    private async Task PlayOrStopAsync(SoundCommand sound)
    {
        _note = null;
        if (!Connected)
        {
            if (sound.Id == _queueId) Stop();
            else Play(sound);
            return;
        }
        if (_hallId is not { Length: > 0 } hall || !await SoundPlay.HandleAsync(new PlayHallSound.Command(hall, sound.Id)))
            _note = "Kein Agent verbunden.";
    }

    private void OnFeed(string hallId)
    {
        if (!string.Equals(hallId, _hallId, StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(async () =>
        {
            await ReadDeckAsync();
            StateHasChanged();
        });
    }

    private async Task ReadDeckAsync()
    {
        if (_hallId is not { Length: > 0 } id) return;
        _view = await DeckQuery.HandleAsync(new GetDeckView.Query(id, _deck));
        FollowSound();
    }

    private async Task RefreshAsync()
    {
        if (_hallId is not { Length: > 0 } id) return;
        _agent = await Presence.HandleAsync(new GetAgentPresence.Query(id));
        await ReadDeckAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PressAsync(DeckKeyRow key)
    {
        _note = null;
        if (key.SoundId is { Length: > 0 } id && !Connected)
        {
            if (id == _queueId) Stop();
            else Play(_sounds.FirstOrDefault(s => s.Id == id));
            return;
        }
        if (_hallId is not { Length: > 0 } hall || !await KeyPress.HandleAsync(new PressDeckKey.Command(hall, _deck, key.Number)))
            _note = "Kein Agent verbunden.";
        await RefreshAsync();
    }

    private async Task PanicAsync()
    {
        Stop();
        if (_hallId is { Length: > 0 } id && !await Panic.HandleAsync(new PanicHall.Command(id)))
            _note = "Kein Agent verbunden.";
    }

    private void FollowSound()
    {
        if (_view?.Live is not { } live || live.SoundOrder == _soundOrder) return;
        _soundOrder = live.SoundOrder;
        if (live.SoundId.Length == 0) { Stop(); return; }
        Play(_sounds.FirstOrDefault(s => s.Id == live.SoundId));
    }

    private void Play(SoundCommand? sound)
    {
        if (sound is null) { _note = "Dieser Musik-Befehl fehlt."; return; }
        if (sound.Tracks.Count == 0) { _note = $"{sound.Label} hat noch keinen Song."; return; }
        var tracks = sound.Tracks.Where(t => !t.IsSpotify).ToList();
        if (tracks.Count == 0) { _note = "Spotify spielt das Bord noch nicht ab."; return; }
        _queue = sound.Random ? tracks.OrderBy(_ => Random.Shared.Next()).ToList() : tracks;
        _queueAt = 0;
        _queueLabel = sound.Label;
        _queueId = sound.Id;
        Announce();
    }

    private void Announce()
    {
        var track = _queue[_queueAt];
        var position = _queue.Count > 1 ? $" ({_queueAt + 1}/{_queue.Count})" : "";
        _playing = $"{_queueLabel} · {track.Display}{position}";
        _playingUrl = SoundMedia.Url(track);
    }

    private void Next()
    {
        if (_queue.Count < 2) { Stop(); return; }
        _queueAt = (_queueAt + 1) % _queue.Count;
        if (_queueAt == 0 && _queue.Count > 1) _queue = _queue.OrderBy(_ => Random.Shared.Next()).ToList();
        Announce();
    }

    private void Stop()
    {
        _playing = null;
        _playingUrl = null;
        _queue = [];
        _queueAt = 0;
        _queueId = "";
    }

    private bool Offered(string stateId)
    {
        if (_hall is null) return false;
        return stateId switch
        {
            DefaultStates.Music => _hall.Offers.Sound,
            DefaultStates.Led or DefaultStates.Sponsors => _hall.Offers.Led,
            DefaultStates.Light => _hall.Offers.Light,
            DefaultStates.Overlay => _hall.Offers.Vmix,
            DefaultStates.ClockVisible or DefaultStates.ClockRunning => _hall.Offers.Clock && _hall.Offers.Vmix,
            _ => true,
        };
    }

    private string Score(bool home)
    {
        if (_view?.Live is not { } live) return "–";
        return (home ? live.HomeScore : live.AwayScore) is { Length: > 0 } score ? score : "–";
    }

    private string Time() => _view?.Live?.Time is { Length: > 0 } time ? time : "--:--";

    private string Period() => _view?.Live?.PeriodLabel ?? "";

    private string StateValue(ShowState state) =>
        _view?.States is { } live && live.TryGetValue(state.Id, out var current) && current.Length > 0
            ? current
            : state.First;

    private string? Query(string name)
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        return query.TryGetValue(name, out var value) ? value.ToString() : null;
    }

    public void Dispose()
    {
        Feed.Changed -= OnFeed;
        _poll?.Dispose();
    }
}
