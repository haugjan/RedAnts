@using RedAnts.Show.Domain
@using RedAnts.Show.Features.Agents
@using RedAnts.Show.Features.Halls
@using RedAnts.Show.Features.Music
@using RedAnts.Show.Features.Setup
@implements IAsyncDisposable
@inject GetHalls.Handler HallsQuery
@inject GetHall.Handler HallQuery
@inject GetShowSetup.Handler SetupQuery
@inject GetAgentPresence.Handler Presence
@inject GetDeckView.Handler DeckQuery
@inject GetMusic.Handler MusicQuery
@inject PressDeckKey.Handler KeyPress
@inject PlayHallMusic.Handler MusicPlay
@inject PanicHall.Handler Panic
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ShowBoardFeed Feed
@inject ShowBoardMusic Playback

<div class="hb">
<header class="bar">
    @if (_halls.Count > 1)
    {
        <select class="pick" @bind="_hallId" @bind:after="SwitchAsync">
            @foreach (var row in _halls)
            {
                <option value="@row.Id">@row.Name</option>
            }
        </select>
    }
    else
    {
        <span class="hall">@(_hall?.Name ?? "keine Halle")</span>
    }
    <span class="lamp @(Connected ? "on" : "off")" title="@(Connected ? "Agent verbunden" : "kein Agent")"></span>
    @if (_hall?.Offers.Clock == true)
    {
        <span class="score">@Score(true) : @Score(false)</span>
        <span class="time">@Time()</span>
        <span class="period">@Period()</span>
    }
    <span class="spacer"></span>
    @foreach (var state in DefaultStates.All.Where(s => Offered(s.Id)))
    {
        var value = StateValue(state);
        <span class="pill @(state.IsOn(value) ? "on" : "")" @key="state.Id">@state.Name: @value</span>
    }
    @if (_hall is not null)
    {
        <button class="setup @(_setup ? "on" : "")" @onclick="() => _setup = !_setup" title="Spieltag und Spielkonfiguration">⚙ Spiel</button>
    }
    <button class="panic" @onclick="PanicAsync">PANIC</button>
</header>

@if (_hall is null)
{
    <main><p class="hint">@(Online ? "Im Netz lassen sich nur Hallen bedienen, die ausschliesslich Musik spielen. Die anderen laufen auf dem Rechner in der Halle." : "Keine Halle eingerichtet.")</p></main>
}
else
{
    <main>
        <div class="decklist">
            @foreach (var deck in _decks)
            {
                var view = View(deck.Id);
                <section class="deck" @key="deck.Id">
                    <h2>@deck.Name<span class="page"> · @(view?.Title ?? "")</span></h2>
                    <div class="grid" style="--cols:@(view?.Columns ?? deck.Columns)">
                        @foreach (var key in view?.Keys ?? [])
                        {
                            var music = MusicOf(key);
                            <button class="key @(key.Pressable ? "" : "flat") @(Playing(key) ? "playing" : "") @(key.Top.Length > 0 ? "split" : "")"
                                    style="background:@key.Color; color:@key.TextColor"
                                    disabled="@(!key.Pressable)"
                                    data-id="@(key.MusicId is { Length: > 0 } tile ? tile : $"{deck.Id}:{key.Number}")"
                                    data-play="@(music is null ? null : "songs")"
                                    data-songs="@music?.SongsJson"
                                    data-random="@(music is { Random: true } ? "1" : "0")"
                                    data-multi="@(music is { IsPlaylist: true } ? "1" : null)"
                                    data-label="@key.Label"
                                    @onclick="() => PressAsync(deck.Id, key)"
                                    @key="key.Number">
                                @if (key.Top is { Length: > 0 } heading)
                                {
                                    <span class="split-top">@heading</span>
                                    <span class="split-bottom">@key.Label</span>
                                }
                                else
                                {
                                    @if (key.Icon is { Length: > 0 } icon)
                                    {
                                        <img src="@DeckIcons.FileOf(icon)" alt="" />
                                    }
                                    else if (key.Symbol is { Length: > 0 } symbol)
                                    {
                                        <span class="symbol">@symbol</span>
                                    }
                                    <span class="label">
                                        @foreach (var line in key.Label.Split(NewLine))
                                        {
                                            <span>@line</span>
                                        }
                                    </span>
                                    @if (key.Subtitle is { Length: > 0 } subtitle)
                                    {
                                        <span class="sub">@subtitle</span>
                                    }
                                    @if (music is { IsPlaylist: true })
                                    {
                                        <span class="badge">@music.Songs @(music.Random ? "🔀" : "🔁")</span>
                                    }
                                }
                                <em>@key.Number</em>
                            </button>
                        }
                    </div>
                </section>
            }
        </div>

        @if (_note is { Length: > 0 } note)
        {
            <p class="note">@note</p>
        }
        <p class="hint">
            @(Connected
                ? "Agent verbunden: Tasten laufen in der Halle, Musik spielt in diesem Browser."
                : "Kein Agent verbunden: nur Musik spielt in diesem Browser, Uhr, vMix und LED bleiben still.")
        </p>
    </main>

    @if (_setup && _hallId is { Length: > 0 } setupHall)
    {
        <div class="sheet" @onclick="() => _setup = false">
            <section class="panel" @onclick:stopPropagation="true">
                <header class="panelbar">
                    <strong>Spieltag @(_hall?.Name ?? "")</strong>
                    <span class="lamp @(Connected ? "on" : "off")" title="@(Connected ? "Agent verbunden" : "kein Agent")"></span>
                    <span class="spacer"></span>
                    <button class="ctl" @onclick="() => _setup = false">Schliessen</button>
                </header>
                <GameSetup HallId="@setupHall" Changed="RefreshAsync" />
            </section>
        </div>
    }

    @if (_pick.Count > 0)
    {
        <div class="sheet" @onclick="ClosePick">
            <section class="panel pick" @onclick:stopPropagation="true">
                <header class="panelbar">
                    <strong>@_pickLabel</strong>
                    <span class="spacer"></span>
                    <button class="ctl" @onclick="ClosePick">Schliessen</button>
                </header>
                <div class="picklist">
                    @foreach (var entry in _pick)
                    {
                        <button class="pickrow" @onclick="() => PlayOneAsync(entry)">@entry.Label</button>
                    }
                </div>
            </section>
        </div>
    }

    <footer class="now">
        <div class="np">
            <span class="np-main">@(_playing is { Length: > 0 } playing ? playing : "keine Musik")</span>
            @if (_songTitle is { Length: > 0 } song)
            {
                <span class="np-song">@song@(_songArtist is { Length: > 0 } artist ? " · " + artist : "")</span>
            }
        </div>
        @if (_length > 0)
        {
            <div class="np-bar" @onclick="SeekAsync" title="Klicken, um zu springen">
                <div class="np-bar-fill" style="width:@Share%"></div>
            </div>
            <span class="np-time">-@Remaining</span>
        }
        <button class="ctl" @onclick="PauseAsync">Pause</button>
        <button class="ctl" @onclick="PreviousAsync">◀◀</button>
        <button class="ctl" @onclick="NextAsync">▶▶</button>
        <button class="ctl" @onclick="FadeAsync">Fade</button>
        <button class="ctl stop" @onclick="StopAsync">Stopp</button>
    </footer>
}
</div>

@code {
    private const char NewLine = '\n';

    [Parameter] public string? HallId { get; set; }

    [Parameter] public bool Online { get; set; }

    private string? _hallId;
    private string? _given;

    private IReadOnlyList<HallRow> _halls = [];
    private Hall? _hall;
    private AgentPresence _agent = new(false, null, null);
    private readonly Dictionary<string, DeckView> _views = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, List<(string Id, string Title)>> _trail = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<MusicItem> _music = [];
    private IReadOnlyList<Deck> _decks = [];
    private readonly string _board = Guid.NewGuid().ToString("N");
    private string? _note;
    private string? _playing;
    private IReadOnlyList<PickSong> _pick = [];
    private string _pickId = "";
    private string _pickLabel = "";
    private string? _songTitle;
    private string? _songArtist;
    private double _position;
    private double _length;
    private bool _setup;
    private long _musicOrder = -1;
    private long _controlOrder = -1;
    private long _boardMusicOrder = -1;
    private long _boardControlOrder = -1;
    private DotNetObjectReference<ShowBoardPage>? _self;
    private bool _ready;
    private Timer? _poll;

    private bool Connected => _agent.Connected;

    private DeckView? View(string deckId) => _views.TryGetValue(deckId, out var view) ? view : null;

    private DeckView? First => _decks.Count > 0 ? View(_decks[0].Id) : null;

    protected override async Task OnInitializedAsync()
    {
        try { await ReadAllAsync(); }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            _note = "Die Halle konnte nicht geladen werden. Die Seite versucht es gleich wieder.";
        }
        _poll ??= new Timer(_ => _ = PollAsync(), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10));
    }

    private async Task ReadAllAsync()
    {
        var all = await HallsQuery.HandleAsync(new GetHalls.Query());
        _halls = all.Where(h => h.MusicOnly || !Online).ToList();
        _given = HallId;
        var wanted = HallId ?? Query("halle");
        if (wanted is { Length: > 0 } named && _halls.All(h => h.Id != named) && all.FirstOrDefault(h => h.Id == named) is { } asked)
            _halls = _halls.Append(asked).ToList();
        _hallId = _halls.FirstOrDefault(h => h.Id == wanted)?.Id ?? _halls.FirstOrDefault()?.Id;
        if (Query("spiel") is "1" or "true") _setup = true;
        _music = await MusicQuery.HandleAsync(new GetMusic.Query());
        await LoadHallAsync();
        Feed.Changed += OnFeed;
        Playback.Changed += OnPlayback;
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        _self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("hallBoard.start", _self); }
        catch (JSException) { }
        if (_hallId is { Length: > 0 } id)
        {
            Playback.Claim(id, _board);
            var state = Playback.Of(id);
            _boardMusicOrder = state.MusicOrder;
            _boardControlOrder = state.ControlOrder;
        }
        _ready = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (HallId == _given) return;
        _given = HallId;
        if (HallId is not { Length: > 0 }) return;
        _hallId = HallId;
        await SwitchAsync();
    }

    [JSInvokable]
    public Task Playing(string label)
    {
        _playing = label.Length > 0 ? label : null;
        if (_playing is null) { _songTitle = null; _songArtist = null; _position = 0; _length = 0; }
        return InvokeAsync(StateHasChanged);
    }

    private sealed record PickSong(string Label, string Json);

    [JSInvokable]
    public Task LongPress(string id, string songsJson, string label)
    {
        _pickId = id;
        _pickLabel = label.Replace(NewLine, ' ');
        _pick = SongsOf(songsJson);
        return InvokeAsync(StateHasChanged);
    }

    private static IReadOnlyList<PickSong> SongsOf(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            if (document.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array) return [];
            var songs = new List<PickSong>();
            foreach (var song in document.RootElement.EnumerateArray())
            {
                var title = Text(song, "ti", "title");
                var artist = Text(song, "ar", "artist");
                if (title.Length == 0) title = FileName(Text(song, "r", "ref"));
                if (artist.Length > 0) title = $"{title} · {artist}";
                songs.Add(new PickSong(title.Length > 0 ? title : $"Stück {songs.Count + 1}", song.GetRawText()));
            }
            return songs;
        }
        catch (System.Text.Json.JsonException) { return []; }
    }

    private static string Text(System.Text.Json.JsonElement song, params string[] names)
    {
        foreach (var name in names)
            if (song.TryGetProperty(name, out var value) && value.ValueKind == System.Text.Json.JsonValueKind.String)
                return value.GetString() ?? "";
        return "";
    }

    private static string FileName(string reference)
    {
        var cut = reference.LastIndexOf('/');
        var name = cut >= 0 ? reference[(cut + 1)..] : reference;
        var dot = name.LastIndexOf('.');
        return dot > 0 ? name[..dot] : name;
    }

    private void ClosePick()
    {
        _pick = [];
        _pickId = "";
    }

    private async Task PlayOneAsync(PickSong song)
    {
        await JS.InvokeVoidAsync("hallBoard.playOne", _pickId, song.Json, _pickLabel);
        ClosePick();
    }

    [JSInvokable]
    public Task Progress(string title, string artist, double position, double length)
    {
        _songTitle = title.Length > 0 ? title : null;
        _songArtist = artist.Length > 0 ? artist : null;
        _position = position;
        _length = length;
        return InvokeAsync(StateHasChanged);
    }

    private string Share => (_length <= 0 ? 0 : Math.Clamp(_position / _length * 100, 0, 100))
        .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private string Remaining
    {
        get
        {
            var left = (int)Math.Max(0, Math.Round(_length - _position));
            return $"{left / 60}:{left % 60:00}";
        }
    }

    private async Task SeekAsync(MouseEventArgs e)
    {
        if (_length <= 0) return;
        await JS.InvokeVoidAsync("hallBoard.seekAt", e.ClientX);
    }

    private string PlayingId => _hallId is { Length: > 0 } id ? Playback.Of(id).MusicId : "";

    private bool Playing(DeckKeyRow key) =>
        key.Active
        || (key.MusicId is { Length: > 0 } id && string.Equals(id, PlayingId, StringComparison.OrdinalIgnoreCase));

    private MusicItem? MusicOf(DeckKeyRow key) =>
        key.MusicId is { Length: > 0 } id ? _music.FirstOrDefault(m => m.Id == id) : null;

    private async Task LoadHallAsync()
    {
        if (_hallId is not { Length: > 0 } id) return;
        _hall = await HallQuery.HandleAsync(new GetHall.Query(id));
        var setup = await SetupQuery.HandleAsync(new GetShowSetup.Query());
        _decks = _hall is null ? [] : setup.DecksOf(_hall);
    }

    private async Task SwitchAsync()
    {
        await LoadHallAsync();
        await RefreshAsync();
    }

    private DeckKey? KeyOf(string deckId, DeckKeyRow row) =>
        _decks.FirstOrDefault(d => d.Id == deckId) is { } deck
            ? (deck.Page(View(deckId)?.PageId) ?? deck.Home).KeyAt(row.Number)
            : null;

    private List<(string Id, string Title)> Trail(string deckId)
    {
        if (!_trail.TryGetValue(deckId, out var steps)) _trail[deckId] = steps = [];
        return steps;
    }

    private async Task<bool> NavigateAsync(string deckId, DeckKeyRow key)
    {
        if (_decks.FirstOrDefault(d => d.Id == deckId) is not { } deck) return false;
        var page = deck.Page(View(deckId)?.PageId) ?? deck.Home;
        var trail = Trail(deckId);
        if (key.Number == deck.Back && !page.IsHome)
        {
            if (trail.Count > 0) trail.RemoveAt(trail.Count - 1);
            await RefreshAsync();
            return true;
        }
        if (KeyOf(deckId, key) is { Kind: KeyKinds.Page, PageId: { Length: > 0 } target } opener)
        {
            trail.Add((target, opener.Label.Length > 0 ? opener.Label : deck.Page(target)?.Name ?? ""));
            await RefreshAsync();
            return true;
        }
        return false;
    }

    private async Task<bool> ControlAsync(string deckId, DeckKeyRow key)
    {
        if (KeyOf(deckId, key) is not { Kind: KeyKinds.Special, Special: { Length: > 0 } special }) return false;
        var what = special switch
        {
            SpecialKey.MusicStop or SpecialKey.MusicToggle => "stop",
            SpecialKey.MusicFade => "fade",
            SpecialKey.MusicNext => "next",
            SpecialKey.MusicPrevious => "previous",
            SpecialKey.MusicPause => "pause",
            _ => "",
        };
        if (what.Length == 0 || _hallId is not { Length: > 0 } id) return false;
        Playback.Command(id, _board, what);
        return true;
    }

    private void OnFeed(string hallId)
    {
        if (!string.Equals(hallId, _hallId, StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(async () =>
        {
            await ReadDeckAsync();
            StateHasChanged();
        });
    }

    private async Task PollAsync()
    {
        try { await RefreshAsync(); }
        catch (Exception) { }
    }

    private void OnPlayback(string hallId)
    {
        if (!string.Equals(hallId, _hallId, StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(async () =>
        {
            await FollowMusicAsync();
            StateHasChanged();
        });
    }

    private async Task ReadDeckAsync()
    {
        if (_hallId is not { Length: > 0 } id || _hall is null) return;
        foreach (var deck in _decks)
        {
            var step = Trail(deck.Id).LastOrDefault();
            if (await DeckQuery.HandleAsync(new GetDeckView.Query(id, deck.Id, step.Id ?? "", step.Title ?? "")) is { } view)
                _views[deck.Id] = view;
        }
        await LearnMusicAsync();
        await FollowMusicAsync();
    }

    private async Task LearnMusicAsync()
    {
        var unknown = _views.Values
            .SelectMany(view => view.Keys)
            .Any(key => key.MusicId is { Length: > 0 } id && _music.All(item => item.Id != id));
        if (unknown) _music = await MusicQuery.HandleAsync(new GetMusic.Query());
    }

    private async Task RefreshAsync()
    {
        if (_hallId is not { Length: > 0 } id) return;
        _agent = await Presence.HandleAsync(new GetAgentPresence.Query(id));
        await ReadDeckAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task FollowMusicAsync()
    {
        if (!_ready || _hallId is not { Length: > 0 } id) return;
        var state = Playback.Of(id);
        var mine = state.PlayedBy(_board);
        if (state.ControlOrder != _boardControlOrder)
        {
            _boardControlOrder = state.ControlOrder;
            if (state.Control.Length > 0) await JS.InvokeVoidAsync("hallBoard.control", state.Control);
        }
        if (state.MusicOrder != _boardMusicOrder)
        {
            _boardMusicOrder = state.MusicOrder;
            if (state.MusicId.Length == 0 || !mine) await JS.InvokeVoidAsync("hallBoard.stop");
            else await PlayAsync(state.MusicId);
        }
        if (First?.Live is not { } live) return;
        if (live.ControlOrder != _controlOrder)
        {
            _controlOrder = live.ControlOrder;
            if (live.Control.Length > 0) await JS.InvokeVoidAsync("hallBoard.control", live.Control);
        }
        if (live.MusicOrder == _musicOrder) return;
        _musicOrder = live.MusicOrder;
        if (live.MusicId.Length == 0 || !mine)
        {
            await JS.InvokeVoidAsync("hallBoard.stop");
            return;
        }
        await PlayAsync(live.MusicId);
    }

    private async Task PlayAsync(string musicId)
    {
        if (_music.FirstOrDefault(m => m.Id == musicId) is not { } item) return;
        await JS.InvokeVoidAsync("hallBoard.play", item.Id, item.SongsJson, item.Random, item.Display);
    }

    private async Task PressAsync(string deckId, DeckKeyRow key)
    {
        _note = null;
        if (_hallId is { Length: > 0 } mine) Playback.Claim(mine, _board);
        if (_decks.FirstOrDefault(d => d.Id == deckId) is { } board && key.Number == board.Panic)
        {
            await PanicAsync();
            return;
        }
        if (!Connected)
        {
            if (await NavigateAsync(deckId, key)) return;
            if (await ControlAsync(deckId, key)) return;
        }
        if (key.MusicId is { Length: > 0 } wanted && _music.All(item => item.Id != wanted))
            await LearnMusicAsync();
        if (MusicOf(key) is { } music)
        {
            if (_hallId is { Length: > 0 } hall)
            {
                if (Playback.Of(hall).MusicId == music.Id) Playback.Command(hall, _board, "fade");
                else Playback.Play(hall, _board, music.Id);
                if (Connected) await MusicPlay.HandleAsync(new PlayHallMusic.Command(hall, music.Id));
            }
            return;
        }
        if (_hallId is not { Length: > 0 } id || !await KeyPress.HandleAsync(new PressDeckKey.Command(id, deckId, key.Number)))
            _note = "Kein Agent verbunden.";
        await RefreshAsync();
    }

    private async Task PanicAsync()
    {
        await CommandAsync("stop");
        if (_hallId is not { Length: > 0 } id) return;
        if (!await Panic.HandleAsync(new PanicHall.Command(id)))
            _note = "PANIC: Musik gestoppt. Ohne Agent bleiben Uhr, vMix und LED unberührt.";
    }

    private async Task CommandAsync(string what)
    {
        if (_hallId is { Length: > 0 } id) Playback.Command(id, _board, what);
        else await JS.InvokeVoidAsync("hallBoard.control", what);
    }

    private Task StopAsync() => CommandAsync("stop");

    private Task FadeAsync() => CommandAsync("fade");

    private Task NextAsync() => CommandAsync("next");

    private Task PreviousAsync() => CommandAsync("previous");

    private Task PauseAsync() => CommandAsync("pause");

    private bool Offered(string stateId)
    {
        if (_hall is null) return false;
        return stateId switch
        {
            DefaultStates.Music => _hall.Offers.Sound,
            DefaultStates.AutoBreakMusic => _hall.Offers.Sound && _hall.Offers.Clock,
            DefaultStates.Led or DefaultStates.Sponsors => _hall.Offers.Led,
            DefaultStates.Overlay or DefaultStates.ClockVisible => _hall.Offers.Vmix,
            DefaultStates.ClockRunning => _hall.Offers.Clock,
            _ => true,
        };
    }

    private string StateValue(ShowState state) =>
        First?.States is { } live && live.TryGetValue(state.Id, out var current) && current.Length > 0
            ? current
            : state.First;

    private string Score(bool home) =>
        (home ? First?.Live?.HomeScore : First?.Live?.AwayScore) is { Length: > 0 } value ? value : "–";

    private string Time() => First?.Live?.Time is { Length: > 0 } time ? time : "--:--";

    private string Period() => First?.Live?.PeriodLabel ?? "";

    private string? Query(string name)
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        return query.TryGetValue(name, out var value) ? value.ToString() : null;
    }

    public async ValueTask DisposeAsync()
    {
        Feed.Changed -= OnFeed;
        Playback.Changed -= OnPlayback;
        if (_poll is not null) await _poll.DisposeAsync();
        _self?.Dispose();
    }
}
