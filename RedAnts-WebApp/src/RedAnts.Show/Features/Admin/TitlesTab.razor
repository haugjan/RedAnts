@inherits SetupTab
@inject GetHallStatus.Handler StatusQuery
@inject GetHalls.Handler HallsQuery

<section class="sa-card">
    <h2>vMix-Titel <StatusLine Text="@Status" IsError="@StatusIsError" /></h2>
    <p class="sa-hint">
        Jeder Titel ist ein vMix-Input mit Feldern. Beim Einblenden füllt der Agent die Felder mit den Vorlagen.
        Die Art <code>scoreboard</code> ist die Anzeige der Matchuhr, dort steht links der Wert der Uhr und rechts das Feld in vMix.
        Die Titel gelten für alle Hallen.
    </p>

        @foreach (var title in _titles)
        {
            <div class="sa-sub" @key="title">
                <div class="sa-form">
                    <label>Art
                        <input class="sa-input" list="show-title-kinds" @bind="title.Kind" @bind:after="Touch" />
                    </label>
                    <label>vMix-Input
                        @if (_inputs.Count > 0)
                        {
                            <select class="sa-input" @bind="title.Input" @bind:after="Touch">
                                @foreach (var input in _inputs)
                                {
                                    <option value="@input">@input</option>
                                }
                                @if (!_inputs.Contains(title.Input))
                                {
                                    <option value="@title.Input">@title.Input (nicht in vMix)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input class="sa-input" @bind="title.Input" @bind:after="Touch" placeholder="GT0.4 Spielerin.gtzip" />
                        }
                    </label>
                    <label>Overlay-Kanal
                        <select class="sa-input" @bind="title.Channel" @bind:after="Touch">
                            <option value="0">kein Overlay (immer sichtbar)</option>
                            <option value="1">Overlay 1</option>
                            <option value="2">Overlay 2</option>
                            <option value="3">Overlay 3</option>
                            <option value="4">Overlay 4</option>
                        </select>
                    </label>
                </div>

                <table class="sa-table">
                    <thead>
                        <tr>
                            <th style="width:280px">@(title.IsScoreboard ? "Wert der Uhr" : "Feld in vMix")</th>
                            <th>@(title.IsScoreboard ? "Feld in vMix" : "Vorlage")</th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var field in title.Fields)
                        {
                            <tr @key="field">
                                <td>
                                    @if (!title.IsScoreboard && FieldsOf(title.Input) is { Count: > 0 } names)
                                    {
                                        <input class="sa-input" list="@("fields-" + title.Input)" @bind="field.Name" @bind:after="Touch" />
                                        <datalist id="@("fields-" + title.Input)">
                                            @foreach (var name in names)
                                            {
                                                <option value="@name"></option>
                                            }
                                        </datalist>
                                    }
                                    else
                                    {
                                        <input class="sa-input" @bind="field.Name" @bind:after="Touch" />
                                    }
                                </td>
                                <td><input class="sa-input wide" @bind="field.Template" @bind:after="Touch" @onfocus="() => _focus = field" /></td>
                                <td><button class="sa-btn small" @onclick="() => RemoveField(title, field)">✕</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="sa-actions">
                    <button class="sa-btn small" @onclick="() => AddField(title)">+ Feld</button>
                    <button class="sa-btn small danger" @onclick="() => Remove(title)">Titel löschen</button>
                </div>
                @if (!title.IsScoreboard)
                {
                    <div class="sa-chips">
                        @foreach (var placeholder in Placeholders)
                        {
                            <button type="button" class="sa-chip" @onclick="() => Insert(placeholder)">@placeholder</button>
                        }
                    </div>
                }
            </div>
        }

        <datalist id="show-title-kinds">
            @foreach (var kind in Kinds)
            {
                <option value="@kind"></option>
            }
        </datalist>

        <div class="sa-actions">
            <button class="sa-btn small" @onclick="Add">+ Titel</button>
            <button class="sa-btn small" @onclick="LoadDefaults">⟲ Standard L-UPL</button>
            <button class="sa-btn primary" @onclick="SaveTitlesAsync" disabled="@(!Dirty)">💾 Speichern</button>
        </div>
    <p class="sa-hint">@(_inputs.Count > 0 ? $"{_inputs.Count} Inputs von vMix gemeldet." : "Kein Agent verbunden; Input-Namen von Hand eintragen.")</p>
</section>

@code {
    private static readonly string[] Kinds =
        ["scoreboard", "player_event", "penalty", "name", "bestplayer", "coach", "timeout", "message", "spectators", "commentary", "referee", "result", "opener", "starting6", "lineup_home", "lineup_away"];

    private static readonly string[] Placeholders =
    [
        "{player.number}", "{player.name}", "{player.position}", "{player.sponsor}", "{player.photo}",
        "{team.short}", "{team.long}", "{team.coach}", "{team.logo}", "{team.starting6}",
        "{starting6.1.number}", "{starting6.1.name}", "{lineup.1.number}", "{lineup.1.name}",
        "{home.short}", "{home.long}", "{away.short}", "{away.long}",
        "{score}", "{score.home}", "{score.away}", "{clock}", "{period}", "{period.label}", "{penalty}", "{text}", "{event}",
        "{game.title}", "{game.league}", "{game.location}",
        "{referee1}", "{referee2}", "{commentator1}", "{commentator2}",
    ];

    private sealed class TitleEdit
    {
        public string Kind = "";
        public string Input = "";
        public int Channel;
        public List<FieldEdit> Fields = [];
        public bool IsScoreboard => Kind.Equals("scoreboard", StringComparison.OrdinalIgnoreCase);
    }

    private sealed class FieldEdit
    {
        public string Name = "";
        public string Template = "";
    }

    private List<TitleEdit> _titles = [];
    private IReadOnlyList<string> _inputs = [];
    private IReadOnlyDictionary<string, IReadOnlyList<string>> _fields = new Dictionary<string, IReadOnlyList<string>>();
    private FieldEdit? _focus;

    private IReadOnlyList<string> FieldsOf(string input) =>
        _fields.TryGetValue(input, out var names) ? names : [];

    protected override async Task OnSetupLoadedAsync()
    {
        _titles = Setup.Titles.Select(t => new TitleEdit
        {
            Kind = t.Kind,
            Input = t.Input,
            Channel = t.Channel,
            Fields = t.Fields.Select(f => new FieldEdit { Name = f.Key, Template = f.Value }).ToList(),
        }).ToList();
        await ReadVmixAsync();
    }

    private async Task ReadVmixAsync()
    {
        foreach (var hall in await HallsQuery.HandleAsync(new GetHalls.Query()))
        {
            await ReadVmixAsync(hall.Id);
            if (_inputs.Count > 0) return;
        }
    }

    private async Task ReadVmixAsync(string hallId)
    {
        _inputs = [];
        _fields = new Dictionary<string, IReadOnlyList<string>>();
        var status = await StatusQuery.HandleAsync(new GetHallStatus.Query(hallId));
        var json = status.Report(AgentReportKinds.Vmix)?.Json;
        if (json is null) return;
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            if (!document.RootElement.TryGetProperty("inputs", out var inputs) || inputs.ValueKind != System.Text.Json.JsonValueKind.Array) return;
            var titles = new List<string>();
            var fields = new Dictionary<string, IReadOnlyList<string>>();
            foreach (var input in inputs.EnumerateArray())
            {
                var title = input.ValueKind == System.Text.Json.JsonValueKind.String
                    ? input.GetString() ?? ""
                    : input.TryGetProperty("title", out var name) ? name.GetString() ?? "" : "";
                if (title.Length == 0) continue;
                titles.Add(title);
                if (input.ValueKind == System.Text.Json.JsonValueKind.Object
                    && input.TryGetProperty("fields", out var list)
                    && list.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    fields[title] = list.EnumerateArray().Select(f => f.GetString() ?? "").Where(f => f.Length > 0).ToList();
                }
            }
            _inputs = titles;
            _fields = fields;
        }
        catch (System.Text.Json.JsonException) { }
    }

    private void Add()
    {
        _titles.Add(new TitleEdit { Kind = "player_event", Input = _inputs.FirstOrDefault() ?? "", Channel = 1, Fields = [new FieldEdit()] });
        Touch();
    }

    private void LoadDefaults()
    {
        _titles = ShowSetup.Default.Titles.Select(t => new TitleEdit
        {
            Kind = t.Kind,
            Input = t.Input,
            Channel = t.Channel,
            Fields = t.Fields.Select(f => new FieldEdit { Name = f.Key, Template = f.Value }).ToList(),
        }).ToList();
        Touch();
    }

    private void Remove(TitleEdit title) { _titles.Remove(title); Touch(); }

    private void AddField(TitleEdit title) { title.Fields.Add(new FieldEdit()); Touch(); }

    private void RemoveField(TitleEdit title, FieldEdit field) { title.Fields.Remove(field); Touch(); }

    private void Insert(string placeholder)
    {
        var target = _focus ?? _titles.SelectMany(t => t.Fields).FirstOrDefault();
        if (target is null) return;
        target.Template += placeholder;
        Touch();
    }

    private Task SaveTitlesAsync() => SaveSetupAsync(setup => setup with
    {
        Titles = _titles
            .Where(t => t.Kind.Trim().Length > 0)
            .Select(t => new OverlayTitle(
                t.Kind.Trim(),
                t.Input.Trim(),
                t.Channel,
                t.Fields.Where(f => f.Name.Trim().Length > 0).ToDictionary(f => f.Name.Trim(), f => f.Template.Trim())))
            .ToList(),
    });
}
