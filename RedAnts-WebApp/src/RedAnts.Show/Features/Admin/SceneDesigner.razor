@using RedAnts.Show.Domain

<section class="sa-card sd">
    <h2>Szenen <small>für alle Hallen</small> <StatusLine Text="@Status" IsError="@StatusIsError" /></h2>
    <div class="sa-columns">
        <aside>
            <div class="sd-list">
                @foreach (var scene in _scenes.Where(s => !s.System))
                {
                    <div class="sd-item @(scene == _current ? "active" : "")" @onclick="() => _current = scene" @key="scene">
                        <span class="sd-side @scene.Side"></span><span>@scene.Label</span><small>@scene.Id</small>
                    </div>
                }
            </div>
            <div class="sa-actions">
                <button class="sa-btn small" @onclick="AddScene">+ Neue Szene</button>
                <button class="sa-btn small" @onclick="ResetDefaults">⟲ Standard</button>
            </div>
            <h3>System <small>fest</small></h3>
            <div class="sd-list">
                @foreach (var scene in _scenes.Where(s => s.System))
                {
                    <div class="sd-item @(scene == _current ? "active" : "")" @onclick="() => _current = scene" @key="scene">
                        <span class="sd-lock">🔒</span><span>@scene.Label</span><small>@scene.Id</small>
                    </div>
                }
            </div>
        </aside>

        <div>
            @if (_current is null)
            {
                <p class="sa-hint">Keine Szene gewählt.</p>
            }
            else
            {
                <div class="sd-head">
                    <label>Bezeichnung <input class="sa-input" @bind="_current.Label" disabled="@_current.System" /></label>
                    <label>Kennung <input class="sa-input" @bind="_current.Id" disabled="@_current.System" /></label>
                    <label>Seite
                        <select class="sa-input" @bind="_current.Side" disabled="@_current.System">
                            <option value="home">Heim</option>
                            <option value="away">Gast</option>
                            <option value="">neutral</option>
                        </select>
                    </label>
                    <span class="sd-spacer"></span>
                    <button class="sa-btn small" @onclick="() => OnRun.InvokeAsync(_current.Id)">▶ In @HallName auslösen</button>
                    @if (!_current.System)
                    {
                        <button class="sa-btn small danger" @onclick="RemoveCurrent">Löschen</button>
                    }
                </div>

                @if (_current.System)
                {
                    <p class="sa-hint">Systemszenen liefert der Agent mit. Sie lassen sich Tasten zuordnen und in eigenen Szenen verwenden, aber nicht ändern.</p>
                }
                <p class="sd-effects">@EffectText(_current)</p>

                <div class="sd-steps">
                    @for (var i = 0; i < _current.Steps.Count; i++)
                    {
                        var index = i;
                        var step = _current.Steps[index];
                        var problem = Problem(step);
                        <div class="sd-step @(problem is not null ? "warn" : "") @(_current.System ? "locked" : "")" title="@problem" @key="step">
                            <span class="sd-n">@(index + 1)</span>
                            <select class="sa-input" value="@step.Action" disabled="@_current.System"
                                    @onchange="e => ChangeAction(step, e.Value?.ToString() ?? SceneActions.Wait)">
                                @foreach (var action in SceneActions.All)
                                {
                                    <option value="@action">@SceneActions.Label(action)</option>
                                }
                            </select>
                            <div class="sd-args">
                                @switch (step.Action)
                                {
                                    case SceneActions.SoundPlay:
                                        <span>Befehl</span>
                                        <select class="sa-input" @bind="step.Target" disabled="@_current.System">
                                            <option value="">(keiner)</option>
                                            @foreach (var sound in Sounds)
                                            {
                                                <option value="@sound.Target">@sound.Label</option>
                                            }
                                        </select>
                                        <em>läuft im Browser</em>
                                        break;
                                    case SceneActions.SoundStop:
                                        <em>stoppt die Musik</em>
                                        break;
                                    case SceneActions.SoundFade:
                                        <span>über ms</span>
                                        <input class="sa-input narrow" type="number" @bind="step.Ms" disabled="@_current.System" />
                                        break;
                                    case SceneActions.LedStart:
                                    case SceneActions.LedStop:
                                        <span>Vorlage</span>
                                        <select class="sa-input" @bind="step.Target" disabled="@_current.System">
                                            @foreach (var template in LedTemplates)
                                            {
                                                <option value="led:@template.Event">@template.Event</option>
                                            }
                                        </select>
                                        <label class="sd-check"><input type="checkbox" @bind="step.Overlay" disabled="@_current.System" /> als Overlay</label>
                                        @if (step.Action == SceneActions.LedStart)
                                        {
                                            <span>Einblenden s</span>
                                            <input class="sa-input narrow" type="number" step="0.1" @bind="step.FadeIn" disabled="@_current.System" />
                                        }
                                        @if (LedCommand(step.Target) is { } command)
                                        {
                                            <em>@command</em>
                                        }
                                        break;
                                    case SceneActions.OverlayShow:
                                        <span>Titel</span>
                                        <select class="sa-input" @bind="step.Target" disabled="@_current.System">
                                            @foreach (var title in Titles)
                                            {
                                                <option value="title:@title.Kind">@title.Kind · @title.Input</option>
                                            }
                                        </select>
                                        <span>Ereignis</span>
                                        <select class="sa-input" @bind="step.Event" disabled="@_current.System">
                                            <option value="">(aus Szene)</option>
                                            @foreach (var ev in Events)
                                            {
                                                <option value="@ev">@ev</option>
                                            }
                                        </select>
                                        break;
                                    case SceneActions.OverlayHide:
                                        <span>Titel</span>
                                        <select class="sa-input" @bind="step.Target" disabled="@_current.System">
                                            <option value="title:*">alle Einblender</option>
                                            @foreach (var title in Titles)
                                            {
                                                <option value="title:@title.Kind">@title.Kind</option>
                                            }
                                        </select>
                                        break;
                                    case SceneActions.LightScene:
                                        <span>Lichtszene</span>
                                        <input class="sa-input" @bind="step.Target" disabled="@_current.System" />
                                        <em>Moving Heads kommen später</em>
                                        break;
                                    case SceneActions.DeckContext:
                                        <span>Seite</span>
                                        <select class="sa-input" @bind="step.Target" disabled="@_current.System">
                                            @foreach (var context in DeckContexts.All)
                                            {
                                                <option value="@context.Key">@context.Label</option>
                                            }
                                        </select>
                                        break;
                                    case SceneActions.PlayerPick:
                                        <em>wartet auf eine Spielerin auf dem Streamdeck</em>
                                        break;
                                    case SceneActions.Wait:
                                        <span>ms</span>
                                        <input class="sa-input narrow" type="number" @bind="step.Ms" disabled="@_current.System" />
                                        break;
                                    case SceneActions.WaitScore:
                                        <span>höchstens ms</span>
                                        <input class="sa-input narrow" type="number" @bind="step.TimeoutMs" disabled="@_current.System" />
                                        <em>geht danach trotzdem weiter</em>
                                        break;
                                    case SceneActions.SceneRun:
                                        <span>Szene</span>
                                        <select class="sa-input" @bind="step.Target" disabled="@_current.System">
                                            @foreach (var other in _scenes.Where(s => s != _current))
                                            {
                                                <option value="@other.Id">@other.Label</option>
                                            }
                                        </select>
                                        break;
                                    case SceneActions.StateSet:
                                        <span>Zustand</span>
                                        <select class="sa-input" @bind="step.Target" disabled="@_current.System">
                                            @foreach (var state in DefaultStates.All)
                                            {
                                                <option value="@state.Id">@state.Name</option>
                                            }
                                        </select>
                                        <span>auf</span>
                                        <select class="sa-input" @bind="step.Event" disabled="@_current.System">
                                            @foreach (var value in StateValues(step.Target))
                                            {
                                                <option value="@value">@value</option>
                                            }
                                        </select>
                                        break;
                                }
                                @if (Effect(step) is { Length: > 0 } effect)
                                {
                                    <span class="sd-effect">→ @effect</span>
                                }
                            </div>
                            <div class="sd-ops">
                                @if (!_current.System)
                                {
                                    <button class="sa-btn small" disabled="@(index == 0)" @onclick="() => Move(step, -1)">↑</button>
                                    <button class="sa-btn small" disabled="@(index == _current.Steps.Count - 1)" @onclick="() => Move(step, 1)">↓</button>
                                    <button class="sa-btn small" @onclick="() => _current.Steps.Remove(step)">✕</button>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (!_current.System)
                {
                    <div class="sa-actions">
                        <button class="sa-btn small" @onclick="AddStep">+ Schritt</button>
                        <button class="sa-btn primary" @onclick="SaveAsync">💾 Szenen speichern</button>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public IReadOnlyList<Scene> Scenes { get; set; } = [];
    [Parameter] public Hall? Hall { get; set; }
    [Parameter] public string HallName { get; set; } = "der Halle";
    [Parameter] public IReadOnlyList<SoundCommand> Sounds { get; set; } = [];
    [Parameter] public string? Status { get; set; }
    [Parameter] public bool StatusIsError { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<Scene>> OnSave { get; set; }
    [Parameter] public EventCallback<string> OnRun { get; set; }

    private static readonly string[] Events =
        ["goal", "owngoal", "penalty", "name", "bestplayer", "coach", "timeout", "lineup", "starting6", "commentary", "referee", "opener", "result", "message"];

    private sealed class SceneEdit
    {
        public string Id = "";
        public string Label = "";
        public string Side = "";
        public bool System;
        public List<StepEdit> Steps = [];

        public static SceneEdit From(Scene scene) => new()
        {
            Id = scene.Id,
            Label = scene.Label,
            Side = scene.Side,
            System = scene.System,
            Steps = scene.Steps.Select(StepEdit.From).ToList(),
        };

        public Scene ToScene() => new(Id.Trim(), Label.Trim(), Side, Steps.Select(s => s.ToStep()).ToList(), System);
    }

    private sealed class StepEdit
    {
        public string Action = SceneActions.Wait;
        public string? Target;
        public int? Ms;
        public int? TimeoutMs;
        public bool Overlay;
        public double? FadeIn;
        public string? Event;

        public static StepEdit From(SceneStep step) => new()
        {
            Action = step.Action,
            Target = step.Target,
            Ms = step.Ms,
            TimeoutMs = step.TimeoutMs,
            Overlay = step.Overlay,
            FadeIn = step.FadeIn,
            Event = step.Event,
        };

        public SceneStep ToStep() => new(
            Action,
            string.IsNullOrWhiteSpace(Target) ? null : Target.Trim(),
            Ms, TimeoutMs, Overlay, FadeIn,
            string.IsNullOrWhiteSpace(Event) ? null : Event);
    }

    private List<SceneEdit> _scenes = [];
    private SceneEdit? _current;
    private IReadOnlyList<Scene>? _loadedFrom;

    private IReadOnlyList<LedTemplate> LedTemplates => Hall?.LedTemplates ?? Domain.Hall.DefaultLedTemplates;

    private IReadOnlyList<OverlayTitle> Titles => Hall?.OverlayTitles ?? [];

    private HallCapabilities? Offers => Hall?.Offers;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loadedFrom, Scenes)) return;
        _loadedFrom = Scenes;
        _scenes = Scenes.Select(SceneEdit.From).ToList();
        _current = _scenes.FirstOrDefault(s => s.Id == _current?.Id) ?? _scenes.FirstOrDefault(s => !s.System);
    }

    private void AddScene()
    {
        var scene = new SceneEdit { Id = $"neu-{_scenes.Count + 1}", Label = "Neue Szene" };
        _scenes.Add(scene);
        _current = scene;
    }

    private void RemoveCurrent()
    {
        if (_current is null) return;
        _scenes.Remove(_current);
        _current = _scenes.FirstOrDefault(s => !s.System);
    }

    private void ResetDefaults()
    {
        _scenes = DefaultScenes.WithSystem(DefaultScenes.All).Select(SceneEdit.From).ToList();
        _current = _scenes.FirstOrDefault(s => !s.System);
    }

    private void AddStep() => _current?.Steps.Add(Default(SceneActions.Wait));

    private void Move(StepEdit step, int delta)
    {
        if (_current is null) return;
        var index = _current.Steps.IndexOf(step);
        var target = index + delta;
        if (index < 0 || target < 0 || target >= _current.Steps.Count) return;
        _current.Steps.RemoveAt(index);
        _current.Steps.Insert(target, step);
    }

    private void ChangeAction(StepEdit step, string action)
    {
        var fresh = Default(action);
        step.Action = fresh.Action;
        step.Target = fresh.Target;
        step.Ms = fresh.Ms;
        step.TimeoutMs = fresh.TimeoutMs;
        step.Overlay = fresh.Overlay;
        step.FadeIn = fresh.FadeIn;
        step.Event = fresh.Event;
    }

    private StepEdit Default(string action) => action switch
    {
        SceneActions.SoundPlay => new() { Action = action, Target = Sounds.FirstOrDefault()?.Target },
        SceneActions.SoundFade => new() { Action = action, Ms = 2000 },
        SceneActions.LedStart => new() { Action = action, Target = "led:" + (LedTemplates.FirstOrDefault()?.Event ?? ""), Overlay = true },
        SceneActions.LedStop => new() { Action = action, Target = "led:stopp" },
        SceneActions.OverlayShow => new() { Action = action, Target = Titles.FirstOrDefault() is { } title ? "title:" + title.Kind : null },
        SceneActions.OverlayHide => new() { Action = action, Target = "title:*" },
        SceneActions.LightScene => new() { Action = action, Target = "light:normal" },
        SceneActions.DeckContext => new() { Action = action, Target = "Main" },
        SceneActions.Wait => new() { Action = action, Ms = 1000 },
        SceneActions.WaitScore => new() { Action = action, TimeoutMs = 3000 },
        SceneActions.SceneRun => new() { Action = action, Target = _scenes.FirstOrDefault(s => s != _current)?.Id },
        SceneActions.StateSet => new() { Action = action, Target = DefaultStates.Break, Event = "an" },
        _ => new() { Action = action },
    };

    private static IReadOnlyList<string> StateValues(string? stateId) =>
        DefaultStates.All.FirstOrDefault(s => s.Id == stateId)?.Values ?? ["aus", "an"];

    private string? Problem(StepEdit step) => step.Action switch
    {
        SceneActions.SoundPlay or SceneActions.SoundStop or SceneActions.SoundFade when Offers is { Sound: false } => "Diese Halle bietet keinen Sound an (Tab Hallen).",
        SceneActions.LedStart or SceneActions.LedStop when Offers is { Led: false } => "Diese Halle bietet keine LED-Wand an (Tab Hallen).",
        SceneActions.OverlayShow or SceneActions.OverlayHide when Offers is { Vmix: false } => "Diese Halle bietet kein vMix an (Tab Hallen).",
        SceneActions.LightScene when Offers is { Light: false } => "Diese Halle bietet keine Lichtshow an (Tab Hallen).",
        SceneActions.OverlayShow when !Titles.Any(t => "title:" + t.Kind == step.Target) => "Dieser vMix-Titel ist in der gewählten Halle nicht konfiguriert.",
        SceneActions.LedStart or SceneActions.LedStop when !LedTemplates.Any(t => "led:" + t.Event == step.Target) => "Diese LED-Vorlage ist in der gewählten Halle nicht konfiguriert.",
        SceneActions.SoundPlay when !Sounds.Any(s => s.Target == step.Target) => "Dieser Musik-Befehl fehlt (Tab Musik).",
        _ => null,
    };

    private string? LedCommand(string? target) => LedTemplates.FirstOrDefault(t => "led:" + t.Event == target)?.Command;

    private string Effect(StepEdit step) =>
        string.Join(", ", DefaultStates.Effects(step.ToStep())
            .Select(e => (DefaultStates.All.FirstOrDefault(s => s.Id == e.Key)?.Name ?? e.Key) + ": " + e.Value));

    private string EffectText(SceneEdit scene)
    {
        var effects = scene.ToScene().Effects;
        return effects.Count == 0
            ? "Diese Szene verändert keinen Zustand."
            : "Wirkung auf Zustände: " + string.Join(", ", effects.Select(e => (DefaultStates.All.FirstOrDefault(s => s.Id == e.Key)?.Name ?? e.Key) + ": " + e.Value));
    }

    private Task SaveAsync() => OnSave.InvokeAsync(_scenes.Select(s => s.ToScene()).ToList());
}
