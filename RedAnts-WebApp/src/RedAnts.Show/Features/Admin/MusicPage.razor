@using Microsoft.AspNetCore.Components.Forms
@using RedAnts.Show.Features.Music
@using RedAnts.Show.Features.Sounds
@inject GetMusicLibrary.Handler LibraryQuery
@inject SaveMusicEntry.Handler EntrySave
@inject DeleteMusicEntry.Handler EntryDelete
@inject UploadDJSound.Handler SoundUpload
@inject ImportMusicLibrary.Handler LibraryImport
@inject FindUnusedSounds.Handler UnusedQuery
@inject DeleteUnusedSounds.Handler UnusedDeletion
@inject IJSRuntime JS

<section class="sa-card">
    <h2>Musik <StatusLine Text="@_status" IsError="@_statusIsError" /></h2>
    <p class="sa-hint">
        Jeder Eintrag ist ein Stück oder eine Liste von Stücken. Welche Taste welchen Eintrag spielt, steht unter Decks.
    </p>

    <div class="sa-actions">
        <input class="sa-input" placeholder="Suchen" @bind="_search" @bind:event="oninput" />
        <label class="sa-btn small">
            ⬆ Hochladen
            <InputFile OnChange="UploadAsync" multiple accept="audio/*" style="display:none" />
        </label>
        <button class="sa-btn small" @onclick="AddEntry">+ Eintrag</button>
        <button class="sa-btn small" @onclick="() => _settings = true">🟢 Spotify</button>
        <button class="sa-btn small @(_cleanupOpen ? "on" : "")" @onclick="ToggleCleanupAsync">🧹 Aufräumen</button>
        <button class="sa-btn small" @onclick="LoadAsync" title="Liste neu laden">↺</button>
        <button class="sa-btn small" @onclick="ExportAsync" title="Die Einträge als Datei sichern">⇅ Export</button>
        <label class="sa-btn small" title="Einträge aus einer Datei übernehmen">
            ⇧ Import
            <InputFile OnChange="ImportAsync" accept="application/json,.json" style="display:none" />
        </label>
        <span class="sa-hint">@_entries.Count Einträge</span>
    </div>

    @if (_cleanupOpen)
    {
        <div class="mu-clean">
            <strong>Nicht verwendete Dateien im Speicher</strong>
            @if (_cleanup is not { } report)
            {
                <p class="sa-hint">Wird geprüft …</p>
            }
            else
            {
                <p class="sa-hint">
                    @report.TotalBlobs Dateien · @report.ReferencedCount verwendet · @report.Unused.Count nicht verwendet (@Size(report.DeletableBytes) löschbar).
                </p>
                @if (report.Unused.Count == 0)
                {
                    <p class="sa-hint">Nichts zu tun, jede Datei gehört zu einem Eintrag.</p>
                }
                else
                {
                    <div class="mu-cleanlist">
                        @foreach (var file in report.Unused)
                        {
                            <div class="mu-cleanrow">
                                <span class="mu-cleanname">@SoundName(file.Path)</span>
                                <span class="sa-hint">
                                    @Size(file.SizeBytes)@(file.LastModified is { } at ? " · " + SwissTime.ToSwiss(at).ToString("dd.MM.yyyy") : "")@(file.RecentlyUploaded ? " · gerade hochgeladen, bleibt" : "")
                                </span>
                            </div>
                        }
                    </div>
                    <div class="sa-actions">
                        <button class="sa-btn small danger" disabled="@(_cleanupBusy || Deletable == 0)" @onclick="RunCleanupAsync">
                            @(_cleanupBusy ? "Löscht …" : $"🗑 {Deletable} Dateien endgültig löschen")
                        </button>
                        <span class="sa-hint">Dateien der letzten Stunde bleiben zur Sicherheit liegen.</span>
                    </div>
                }
            }
        </div>
    }

    <table class="sa-table mu-table">
        <thead>
            <tr><th>Name</th><th style="width:150px">Stücke</th><th style="width:70px">Zufall</th><th style="width:120px"></th></tr>
        </thead>
        <tbody>
            @foreach (var row in Filtered)
            {
                <tr @key="row.Id">
                    <td><input class="sa-input wide" @bind="row.Name" @bind:after="() => SaveAsync(row)" /></td>
                    <td>
                        <button class="sa-btn small" @onclick="() => Toggle(row)">
                            @(row.Songs.Count == 1 ? "1 Stück" : $"{row.Songs.Count} Stücke") @(_open == row.Id ? "▴" : "▾")
                        </button>
                    </td>
                    <td>
                        <input type="checkbox" checked="@row.Random" @onchange="e => RandomAsync(row, e.Value is true)" />
                    </td>
                    <td>
                        <button class="sa-btn small" title="Bearbeiten" @onclick="() => Edit(row)">✎</button>
                        <button class="sa-btn small" title="Vorhören" @onclick="() => PlayAsync(row.Songs.FirstOrDefault())">▶</button>
                        <button class="sa-btn small" @onclick="() => DeleteAsync(row)">✕</button>
                    </td>
                </tr>
                @if (_open == row.Id)
                {
                    <tr class="mu-detail" @key="@($"{row.Id}-detail")">
                        <td colspan="4">
                            @foreach (var song in row.Songs.ToList())
                            {
                                <div class="mu-song">
                                    <span class="mu-song__kind">@(song.Kind == SoundKind.Spotify ? "Spotify" : "Datei")</span>
                                    <span class="mu-song__ref" title="@song.Ref">@Short(song)</span>
                                    <label class="mu-song__start">
                                        Start
                                        <input class="sa-input" type="number" step="0.1" min="0" value="@song.StartSec"
                                               @onchange="e => StartAsync(row, song, e.Value?.ToString())" />
                                    </label>
                                    <button class="sa-btn small" @onclick="() => PlayAsync(song)">▶</button>
                                    <button class="sa-btn small" @onclick="() => RemoveSongAsync(row, song)">✕</button>
                                </div>
                            }
                            <div class="sa-actions">
                                <label class="sa-btn small">
                                    + Datei
                                    <InputFile OnChange="args => AddFilesAsync(row, args)" multiple accept="audio/*" style="display:none" />
                                </label>
                                <button class="sa-btn small" @onclick="() => OpenSpotify(row)">+ Spotify</button>
                                <button class="sa-btn small" @onclick="StopAsync">■ Stopp</button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (_entries.Count == 0)
    {
        <p class="sa-hint">Noch keine Musik. Lade Dateien hoch oder lege einen Eintrag an.</p>
    }
</section>

@if (_editing is { } editing)
{
    <MusicEntryDialog Entry="@editing"
                      IsNew="@_editingIsNew"
                      OnSaved="SaveEntryAsync"
                      OnClosed="() => _editing = null" />
}

@if (_spotifyFor is { } target)
{
    <SpotifySearchDialog Term="@target.Name"
                         OnPicked="track => AddSpotifyAsync(target, track.Uri)"
                         OnLink="uri => AddSpotifyAsync(target, uri)"
                         OnClosed="() => _spotifyFor = null" />
}

@if (_settings)
{
    <SpotifySettingsDialog OnClosed="() => _settings = false" OnSaved="() => _settings = false" />
}

@code {
    private sealed class Row
    {
        public string Id = "";
        public string Name = "";
        public List<DJSound> Songs = [];
        public bool Random;
    }

    private List<Row> _entries = [];
    private string _search = "";
    private string? _open;
    private Row? _spotifyFor;
    private MusicEntry? _editing;
    private bool _editingIsNew;
    private bool _settings;
    private bool _cleanupOpen;
    private bool _cleanupBusy;
    private FindUnusedSounds.Result? _cleanup;
    private string? _status;
    private bool _statusIsError;

    private IEnumerable<Row> Filtered =>
        _search.Trim() is { Length: > 0 } term
            ? _entries.Where(e => e.Name.Contains(term, StringComparison.CurrentCultureIgnoreCase))
            : _entries;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var entries = await LibraryQuery.HandleAsync(new GetMusicLibrary.Query());
        _entries = entries.Select(e => new Row
        {
            Id = e.Id,
            Name = e.Name,
            Songs = e.Songs.ToList(),
            Random = e.Random,
        }).ToList();
    }

    private void Toggle(Row row) => _open = _open == row.Id ? null : row.Id;

    private void AddEntry()
    {
        _editing = new MusicEntry(Guid.NewGuid().ToString("N")[..12], "", [], false);
        _editingIsNew = true;
    }

    private void Edit(Row row)
    {
        _editing = new MusicEntry(row.Id, row.Name, row.Songs, row.Random);
        _editingIsNew = false;
    }

    private async Task SaveEntryAsync(MusicEntry entry)
    {
        try
        {
            await EntrySave.HandleAsync(new SaveMusicEntry.Command(entry));
            _editing = null;
            await LoadAsync();
            Notify("Gespeichert.");
        }
        catch (DomainException ex) { Fail(ex.Message); }
    }

    private Task RandomAsync(Row row, bool random)
    {
        row.Random = random;
        return SaveAsync(row);
    }

    private async Task StartAsync(Row row, DJSound song, string? value)
    {
        if (!double.TryParse(value, out var start) || start < 0) start = 0;
        Replace(row, song, song with { StartSec = start });
        await SaveAsync(row);
    }

    private async Task RemoveSongAsync(Row row, DJSound song)
    {
        row.Songs.Remove(song);
        await SaveAsync(row);
    }

    private async Task AddFilesAsync(Row row, InputFileChangeEventArgs args)
    {
        foreach (var file in args.GetMultipleFiles(20))
            if (await StoreAsync(file) is { } path)
                row.Songs.Add(new DJSound(SoundKind.Local, path));
        await SaveAsync(row);
    }

    private async Task AddSpotifyAsync(Row row, string uri)
    {
        _spotifyFor = null;
        if (uri.Trim().Length == 0) return;
        row.Songs.Add(new DJSound(SoundKind.Spotify, uri.Trim()));
        await SaveAsync(row);
    }

    private void OpenSpotify(Row row) => _spotifyFor = row;

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        var added = 0;
        foreach (var file in args.GetMultipleFiles(50))
        {
            if (await StoreAsync(file) is not { } path) continue;
            var row = new Row
            {
                Id = Guid.NewGuid().ToString("N")[..12],
                Name = Path.GetFileNameWithoutExtension(file.Name),
                Songs = [new DJSound(SoundKind.Local, path)],
            };
            _entries.Add(row);
            await SaveAsync(row, quiet: true);
            added++;
        }
        await LoadAsync();
        Notify(added == 1 ? "Eine Datei übernommen." : $"{added} Dateien übernommen.");
    }

    private async Task<string?> StoreAsync(IBrowserFile file)
    {
        try
        {
            await using var stream = file.OpenReadStream(200L * 1024 * 1024);
            return await SoundUpload.HandleAsync(new UploadDJSound.Command(file.Name, stream, file.ContentType));
        }
        catch (DomainException ex) { Fail(ex.Message); return null; }
        catch (IOException ex) { Fail(ex.Message); return null; }
    }

    private async Task SaveAsync(Row row, bool quiet = false)
    {
        try
        {
            await EntrySave.HandleAsync(new SaveMusicEntry.Command(
                new MusicEntry(row.Id, row.Name, row.Songs, row.Random)));
            if (!quiet) Notify("Gespeichert.");
        }
        catch (DomainException ex) { Fail(ex.Message); }
    }

    private async Task DeleteAsync(Row row)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"„{row.Name}“ wirklich löschen?")) return;
        await EntryDelete.HandleAsync(new DeleteMusicEntry.Command(row.Id));
        _entries.Remove(row);
        Notify("Gelöscht.");
    }

    private async Task PlayAsync(DJSound? song)
    {
        if (song is null) return;
        if (song.Kind == SoundKind.Spotify) { Fail("Spotify-Stücke spielen nur auf dem Bord."); return; }
        await JS.InvokeVoidAsync("showAdmin.preview", "/dj/sound/" + song.Ref, song.StartSec);
    }

    private async Task StopAsync() => await JS.InvokeVoidAsync("showAdmin.stop");

    private void Replace(Row row, DJSound song, DJSound replacement)
    {
        var index = row.Songs.IndexOf(song);
        if (index >= 0) row.Songs[index] = replacement;
    }

    private static string Short(DJSound song)
    {
        var text = song.Title is { Length: > 0 } title ? title : song.Ref;
        var cut = text.LastIndexOf('/');
        return cut >= 0 ? text[(cut + 1)..] : text;
    }

    private async Task ExportAsync()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(
            _entries.Select(e => new MusicEntry(e.Id, e.Name, e.Songs, e.Random)), ShowJson.Pretty);
        await JS.InvokeVoidAsync("showAdmin.download", $"musik-{SwissTime.Today:yyyy-MM-dd}.json", json);
        Notify($"{_entries.Count} Einträge gesichert.");
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await using var stream = args.File.OpenReadStream(20L * 1024 * 1024);
            var entries = await System.Text.Json.JsonSerializer.DeserializeAsync<List<MusicEntry>>(stream, ShowJson.Options);
            if (entries is null) { Fail("Die Datei liess sich nicht lesen."); return; }
            var done = await LibraryImport.HandleAsync(new ImportMusicLibrary.Command(entries, Replace: false));
            await LoadAsync();
            Notify($"{done.Added} neu, {done.Updated} aktualisiert, {done.Total} Einträge insgesamt.");
        }
        catch (DomainException ex) { Fail(ex.Message); }
        catch (System.Text.Json.JsonException) { Fail("Die Datei ist kein gültiges Musikpaket."); }
    }

    private int Deletable => _cleanup?.Unused.Count(file => !file.RecentlyUploaded) ?? 0;

    private async Task ToggleCleanupAsync()
    {
        _cleanupOpen = !_cleanupOpen;
        if (!_cleanupOpen) return;
        _cleanup = null;
        _cleanup = await UnusedQuery.HandleAsync(new FindUnusedSounds.Query());
    }

    private async Task RunCleanupAsync()
    {
        if (_cleanup is not { } report) return;
        _cleanupBusy = true;
        try
        {
            var paths = report.Unused.Where(file => !file.RecentlyUploaded).Select(file => file.Path).ToList();
            var done = await UnusedDeletion.HandleAsync(new DeleteUnusedSounds.Command(paths));
            _cleanup = await UnusedQuery.HandleAsync(new FindUnusedSounds.Query());
            Notify($"{done.Deleted} Dateien gelöscht, {Size(done.FreedBytes)} frei.");
        }
        finally { _cleanupBusy = false; }
    }

    private static string SoundName(string path)
    {
        var cut = path.LastIndexOf('/');
        return cut >= 0 ? path[(cut + 1)..] : path;
    }

    private static string Size(long bytes) =>
        bytes >= 1024L * 1024 * 1024 ? $"{bytes / 1024d / 1024 / 1024:0.0} GB"
        : bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024:0.0} MB"
        : $"{Math.Max(1, bytes / 1024)} KB";

    private void Notify(string text)
    {
        _status = text;
        _statusIsError = false;
    }

    private void Fail(string text)
    {
        _status = text;
        _statusIsError = true;
    }
}
