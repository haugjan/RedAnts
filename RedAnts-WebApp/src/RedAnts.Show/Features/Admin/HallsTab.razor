@inherits HallTab
@using RedAnts.Show.Features.Music
@using RedAnts.Show.Features.Setup
@inject GetMusic.Handler MusicQuery
@inject GetShowSetup.Handler SetupQuery
@inject GetHalls.Handler HallsQuery
@inject CreateHall.Handler HallCreation
@inject RenewAgentKey.Handler KeyRenewal
@inject DeleteHall.Handler HallDeletion

<section class="sa-card">
    <h2>Hallen <StatusLine Text="@Status" IsError="@StatusIsError" /></h2>
    <div class="sa-columns">
        <aside>
            <ul class="sa-list">
                @foreach (var row in _halls)
                {
                    <li class="@(row.Id == Hall?.Id ? "active" : "")" @onclick="() => State.SelectedHallId = row.Id">
                        <span class="sa-lamp @(row.AgentConnected ? "on" : "off")"></span>@row.Name <small>@row.Id</small>
                    </li>
                }
            </ul>
            <h3>Neue Halle</h3>
            <input class="sa-input" placeholder="Kennung, z.B. win4" @bind="_newId" />
            <input class="sa-input" placeholder="Name" @bind="_newName" />
            <button class="sa-btn" @onclick="CreateAsync">Anlegen</button>
        </aside>

        <div>
            @if (Hall is null)
            {
                <p class="sa-hint">Keine Halle gewählt. Links eine anlegen.</p>
            }
            else
            {
                <div class="sa-form">
                    <label>Name <input class="sa-input" @bind="_name" @bind:after="Touch" /></label>
                    <label>Team-ID swissunihockey <input class="sa-input" type="number" @bind="_teamId" @bind:after="Touch" /></label>
                    <label>Saison (Startjahr) <input class="sa-input" type="number" @bind="_season" @bind:after="Touch" /></label>
                </div>

                <h3>Angebot dieser Halle</h3>
                <p class="sa-hint">
                    Der Agent startet nur, was hier aktiv ist. Deck-Tasten und Szenen, die ein abgewähltes Gerät brauchen,
                    bleiben leer beziehungsweise melden es bei der Ausführung.
                </p>
                <div class="sa-offer">
                    <label class="sa-check"><input type="checkbox" @bind="_sound" @bind:after="Touch" /> Sound</label>
                    <label class="sa-check"><input type="checkbox" @bind="_clock" @bind:after="Touch" /> Matchuhr</label>
                    <label class="sa-check"><input type="checkbox" @bind="_vmix" @bind:after="Touch" /> vMix</label>
                    <label class="sa-check"><input type="checkbox" @bind="_led" @bind:after="Touch" /> LED-Wand</label>
                    <label class="sa-check"><input type="checkbox" @bind="_light" @bind:after="Touch" /> Lichtshow</label>
                    <label class="sa-check"><input type="checkbox" @bind="_players" @bind:after="Touch" /> Spielerinnen</label>
                </div>
                <p class="sa-hint">
                    Ohne <strong>Spielerinnen</strong> fragt keine Taste mehr nach einer Person: Tor und Strafe spielen
                    nur noch Musik und Einblender, Tasten, die ausschliesslich der Spielerwahl dienen, verschwinden.
                </p>

                <h3>Sichtbarkeit</h3>
                <label class="sa-check"><input type="checkbox" @bind="_hidden" @bind:after="Touch" /> Diese Halle ausblenden</label>
                <p class="sa-hint">
                    Eine ausgeblendete Halle bleibt vollständig erhalten und hier bearbeitbar, erscheint aber nicht mehr
                    in der Hallenauswahl des Bords.
                </p>

                <h3>Decks dieser Halle</h3>
                <p class="sa-hint">Die Decks selbst stehen unter Decks und gelten für alle Hallen. Ohne Auswahl bietet die Halle alle an.</p>
                <div class="sa-offer">
                    @foreach (var deck in _library)
                    {
                        <label class="sa-check">
                            <input type="checkbox" checked="@_deckIds.Contains(deck.Id)" @onchange="e => ToggleDeck(deck.Id, e.Value is true)" />
                            @deck.Name
                        </label>
                    }
                </div>

                @if (_sound)
                {
                    <h3>Sound</h3>
                    <div class="sa-form">
                        <label>Musik bei Spielunterbruch
                            <select class="sa-input" @bind="_breakSound" @bind:after="Touch">
                                <option value="">keine</option>
                                @foreach (var sound in _sounds)
                                {
                                    <option value="@sound.Id">@sound.Display</option>
                                }
                            </select>
                        </label>
                    </div>
                    <p class="sa-hint">Die Taste "Auto-Pausenmusik" auf dem Deck spielt diesen Befehl, sobald die Uhr mitten im Drittel steht, und stoppt ihn, sobald sie wieder läuft.</p>
                }
                @if (_clock)
                {
                    <h3>Matchuhr</h3>
                    <div class="sa-form">
                        <label>Typ
                            <select class="sa-input" @bind="_clockType" @bind:after="Touch">
                                <option value="iCast">iCast (UDP)</option>
                                <option value="Bodet">Bodet ScorePad (TCP)</option>
                            </select>
                        </label>
                        <label>Port <input class="sa-input" type="number" @bind="_clockPort" @bind:after="Touch" /></label>
                        <label>Absender-IP (leer = jede) <input class="sa-input" @bind="_clockSource" @bind:after="Touch" placeholder="192.168.1.30" /></label>
                        <label>Drittelsdauer (Minuten) <input class="sa-input" type="number" @bind="_periodMinutes" @bind:after="Touch" /></label>
                    </div>
                }
                @if (_vmix)
                {
                    <h3>vMix</h3>
                    <div class="sa-form">
                        <label>Host <input class="sa-input" @bind="_vmixHost" @bind:after="Touch" placeholder="192.168.1.20" /></label>
                        <label>Port <input class="sa-input" type="number" @bind="_vmixPort" @bind:after="Touch" /></label>
                        <label>Bilderordner auf dem vMix-Rechner <input class="sa-input" @bind="_imageFolder" @bind:after="Touch" placeholder="C:\Livestream\Bilder" /></label>
                    </div>

                    <h3>Persönliche Sponsoren</h3>
                    <div class="sa-form">
                        <label>Ordner Heim auf dem vMix-Rechner <input class="sa-input" @bind="_sponsorHome" @bind:after="Touch" placeholder="C:\Livestream\PersonalSponsors" /></label>
                        <label>Ordner Gast auf dem vMix-Rechner <input class="sa-input" @bind="_sponsorAway" @bind:after="Touch" /></label>
                        <label>Rahmenfarbe <input class="sa-input" @bind="_sponsorBorder" @bind:after="Touch" placeholder="@PersonalSponsors.DefaultBorder" /></label>
                    </div>
                    <div class="sa-offer">
                        <label class="sa-check"><input type="checkbox" @bind="_sponsorOnGoal" @bind:after="Touch" /> Tor</label>
                        <label class="sa-check"><input type="checkbox" @bind="_sponsorOnPenalty" @bind:after="Touch" /> Strafe</label>
                        <label class="sa-check"><input type="checkbox" @bind="_sponsorOnName" @bind:after="Touch" /> Name</label>
                        <label class="sa-check"><input type="checkbox" @bind="_sponsorOnBestPlayer" @bind:after="Touch" /> Best Player</label>
                    </div>
                    <label>Anzahl Logos je Nummer
                        <textarea class="sa-input" rows="8" @bind="_sponsorCounts" @bind:after="Touch" placeholder="[Home]&#10;7=2&#10;00=1&#10;coach=1&#10;[Away]"></textarea>
                    </label>
                    <p class="sa-hint">
                        Dateinamen wie bei TCunihockey: <code>&lt;Nummer&gt;_1.png</code>, <code>&lt;Nummer&gt;_2.png</code> … im Ordner,
                        <code>00</code> ist die Topscorerin, <code>coach</code> der Coach. Die Datei <code>PersSponsorLUPL.txt</code> lässt sich
                        hier eins zu eins einfügen. Ohne Eintrag bleibt das Sponsorenfeld im Einblender leer.
                    </p>
                }
                @if (_led)
                {
                    <h3>LED-Wand</h3>
                    <div class="sa-form">
                        <label>sedna Host <input class="sa-input" @bind="_sednaHost" @bind:after="Touch" /></label>
                        <label>sedna Port <input class="sa-input" type="number" @bind="_sednaPort" @bind:after="Touch" /></label>
                        <label>Standardbild
                            <select class="sa-input" @bind="_screen" @bind:after="Touch">
                                <option value="">@Hall.FallbackScreen (Vorgabe)</option>
                                @foreach (var template in Hall.LedTemplates.OrderBy(t => t.Event, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@template.Event">@template.Event</option>
                                }
                            </select>
                        </label>
                    </div>
                    <p class="sa-hint">
                        Auf dieses Bild stellt PANIC die LED-Wand zurück, zum Beispiel <code>spiel-nla</code> für L-UPL
                        oder <code>spiel-u21</code> für U21.
                    </p>
                }
                @if (_light)
                {
                    <h3>Lichtshow</h3>
                    <p class="sa-hint">Moving Heads sind erst als Zustand vorbereitet; es gibt noch kein Gerät zu konfigurieren.</p>
                }

                <h3>Agent</h3>
                <p class="sa-hint">Hallen-ID <code>@Hall.Id</code>, Schlüssel <code>@Hall.AgentKey</code></p>
                <p class="sa-hint">Installation: <code>Install-ShowAgent.ps1 -Cloud @BaseUrl -Hall @Hall.Id -Key @Hall.AgentKey</code></p>
                <button class="sa-btn" @onclick="RenewKeyAsync">Schlüssel erneuern</button>

                <div class="sa-actions">
                    <button class="sa-btn primary" @onclick="SaveFormAsync" disabled="@(!Dirty)">💾 Halle speichern</button>
                    <button class="sa-btn danger" @onclick="DeleteAsync">Halle löschen</button>
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public EventCallback OnHallsChanged { get; set; }
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private IReadOnlyList<HallRow> _halls = [];
    private string _newId = "", _newName = "";
    private string _name = "", _vmixHost = "", _sednaHost = "", _clockType = "iCast", _clockSource = "", _imageFolder = "", _screen = "";
    private int _teamId, _season, _vmixPort, _sednaPort, _clockPort, _periodMinutes;
    private bool _sound = true, _clock = true, _vmix = true, _led = true, _light, _players = true, _hidden;
    private string _breakSound = "";
    private string _sponsorHome = "", _sponsorAway = "", _sponsorBorder = PersonalSponsors.DefaultBorder, _sponsorCounts = "";
    private bool _sponsorOnGoal = true, _sponsorOnPenalty = true, _sponsorOnName = true, _sponsorOnBestPlayer = true;
    private IReadOnlyList<MusicItem> _sounds = [];
    private IReadOnlyList<Deck> _library = [];
    private HashSet<string> _deckIds = new(StringComparer.OrdinalIgnoreCase);

    private string BaseUrl => new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);

    protected override async Task OnInitializedAsync()
    {
        _sounds = await MusicQuery.HandleAsync(new GetMusic.Query());
        _library = (await SetupQuery.HandleAsync(new GetShowSetup.Query())).DeckLibrary;
        await base.OnInitializedAsync();
        await ReloadListAsync();
    }

    protected override Task OnHallLoadedAsync()
    {
        if (Hall is null) return Task.CompletedTask;
        _name = Hall.Name;
        _teamId = Hall.TeamId;
        _season = Hall.Season;
        _vmixHost = Hall.Devices.VmixHost;
        _vmixPort = Hall.Devices.VmixPort;
        _sednaHost = Hall.Devices.SednaHost;
        _sednaPort = Hall.Devices.SednaPort;
        _clockType = Hall.Devices.ClockType;
        _clockPort = Hall.Devices.ClockPort;
        _clockSource = Hall.Devices.ClockSource;
        _periodMinutes = Hall.Devices.PeriodMinutes;
        _imageFolder = Hall.Devices.ImageFolder;
        _sound = Hall.Offers.Sound;
        _clock = Hall.Offers.Clock;
        _vmix = Hall.Offers.Vmix;
        _led = Hall.Offers.Led;
        _light = Hall.Offers.Light;
        _players = Hall.Offers.Players;
        _hidden = Hall.Hidden;
        _screen = Hall.DefaultScreen;
        _breakSound = Hall.BreakMusicId;
        var sponsors = Hall.SponsorLogos;
        _sponsorHome = sponsors.HomeFolder;
        _sponsorAway = sponsors.AwayFolder;
        _sponsorBorder = sponsors.BorderColor;
        _sponsorCounts = sponsors.Ini;
        _sponsorOnGoal = sponsors.OnGoal;
        _sponsorOnPenalty = sponsors.OnPenalty;
        _sponsorOnName = sponsors.OnName;
        _sponsorOnBestPlayer = sponsors.OnBestPlayer;
        _deckIds = Hall.DeckIds is { Count: > 0 } chosen
            ? chosen.ToHashSet(StringComparer.OrdinalIgnoreCase)
            : _library.Select(deck => deck.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return Task.CompletedTask;
    }

    private void ToggleDeck(string id, bool wanted)
    {
        if (wanted) _deckIds.Add(id);
        else _deckIds.Remove(id);
        Touch();
    }

    private async Task ReloadListAsync()
    {
        _halls = await HallsQuery.HandleAsync(new GetHalls.Query());
        await OnHallsChanged.InvokeAsync();
    }

    private Task SaveFormAsync() => SaveAsync(hall => hall with
    {
        Name = _name,
        TeamId = _teamId,
        Season = _season,
        Devices = hall.Devices with
        {
            VmixHost = _vmixHost.Trim(),
            VmixPort = _vmixPort,
            SednaHost = _sednaHost.Trim(),
            SednaPort = _sednaPort,
            ClockType = _clockType,
            ClockPort = _clockPort,
            ClockSource = _clockSource.Trim(),
            PeriodMinutes = _periodMinutes,
            ImageFolder = _imageFolder.Trim(),
        },
        Offered = new HallCapabilities(_sound, _clock, _vmix, _led, _light, _players),
        Hidden = _hidden,
        DefaultScreen = _screen.Trim(),
        BreakMusicId = _breakSound,
        DeckIds = _library.Select(deck => deck.Id).Where(_deckIds.Contains).ToList(),
        Sponsors = PersonalSponsors.Parse(_sponsorCounts) with
        {
            HomeFolder = _sponsorHome.Trim(),
            AwayFolder = _sponsorAway.Trim(),
            BorderColor = _sponsorBorder.Trim() is { Length: > 0 } border ? border : PersonalSponsors.DefaultBorder,
            OnGoal = _sponsorOnGoal,
            OnPenalty = _sponsorOnPenalty,
            OnName = _sponsorOnName,
            OnBestPlayer = _sponsorOnBestPlayer,
        },
    });

    private async Task CreateAsync() => await Guarded(async () =>
    {
        var created = await HallCreation.HandleAsync(new CreateHall.Command(_newId, _newName));
        _newId = ""; _newName = "";
        await ReloadListAsync();
        if (State.SelectedHallId == created.Id) await LoadAsync();
        else State.SelectedHallId = created.Id;
        Notify($"Halle {created.Name} angelegt.");
    });

    private async Task RenewKeyAsync() => await Guarded(async () =>
    {
        if (Hall is null) return;
        await KeyRenewal.HandleAsync(new RenewAgentKey.Command(Hall.Id));
        await LoadAsync();
        Notify("Neuer Schlüssel erzeugt; den Agenten mit dem neuen Schlüssel starten.");
    });

    private async Task DeleteAsync() => await Guarded(async () =>
    {
        if (Hall is null) return;
        await HallDeletion.HandleAsync(new DeleteHall.Command(Hall.Id));
        State.SelectedHallId = null;
        await ReloadListAsync();
        Notify("Halle gelöscht.");
    });
}
