@inherits HallTab
@using RedAnts.Show.Features.Scenes
@inject GetScenes.Handler ScenesQuery

<section class="sa-card">
    <h2>Zustände <small>fest im Code</small></h2>
    <p class="sa-hint">
        Zustände sind Teil der Applikation und nicht einstellbar. Beobachtete Zustände meldet das Gerät (vMix, Uhr),
        gesetzte ändern nur Szenen. Deck-Tasten binden sich an einen Zustand, Szenen verändern ihn.
        Eine Änderung an dieser Liste braucht eine neue Version der Applikation.
    </p>
    <table class="sa-table">
        <thead><tr><th style="width:190px">Name</th><th style="width:150px">Kennung</th><th style="width:240px">Werte</th><th style="width:140px">Quelle</th><th>Notiz</th></tr></thead>
        <tbody>
            @foreach (var state in DefaultStates.All)
            {
                <tr @key="state.Id">
                    <td>@state.Name</td>
                    <td><code>@state.Id</code></td>
                    <td>@string.Join(" · ", state.Values)</td>
                    <td>@state.Source</td>
                    <td>@state.Note</td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Eingebaute Ableitung</h3>
    <p class="sa-hint">
        Einblender zeigen → Einblender an · Einblender ausblenden (alle) → aus · Scoreboard zeigen oder ausblenden → Uhr sichtbar ·
        Musik abspielen → Musik läuft · Musik stoppen → aus · Musik ausblenden → fade · LED starten → LED läuft
        (Sponsoren-Playlist zusätzlich Sponsoren-Loop an) · LED stoppen → LED aus · Lichtszene → Licht · Zustand setzen → wie angegeben.
    </p>
</section>

<section class="sa-card">
    <h2>Automatik <small>@(Hall?.Name ?? "keine Halle")</small> <StatusLine Text="@Status" IsError="@StatusIsError" /></h2>
    @if (Hall is null)
    {
        <p class="sa-hint">Keine Halle gewählt.</p>
    }
    else
    {
        <p class="sa-hint">Wenn ein Zustand auf einen Wert wechselt, läuft eine Szene. Ketten brechen nach drei Stufen ab.</p>
        <table class="sa-table">
            <thead><tr><th style="width:220px">Wenn Zustand</th><th style="width:160px">wird</th><th>dann Szene</th><th style="width:40px"></th></tr></thead>
            <tbody>
                @foreach (var rule in _rules)
                {
                    <tr @key="rule">
                        <td>
                            <select class="sa-input" @bind="rule.StateId" @bind:after="Touch">
                                @foreach (var state in DefaultStates.All)
                                {
                                    <option value="@state.Id">@state.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="sa-input" @bind="rule.Value" @bind:after="Touch">
                                @foreach (var value in ValuesOf(rule.StateId))
                                {
                                    <option value="@value">@value</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="sa-input" @bind="rule.SceneId" @bind:after="Touch">
                                @foreach (var scene in _scenes)
                                {
                                    <option value="@scene.Id">@(scene.System ? "🔒 " : "")@scene.Label</option>
                                }
                            </select>
                        </td>
                        <td><button class="sa-btn small" @onclick="() => RemoveRule(rule)">✕</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="sa-actions">
            <button class="sa-btn small" @onclick="AddRule">+ Regel</button>
            <button class="sa-btn primary" @onclick="SaveRulesAsync" disabled="@(!Dirty)">💾 Automatik speichern</button>
        </div>
    }
</section>

@code {
    private sealed class RuleEdit
    {
        public string StateId = "";
        public string Value = "";
        public string SceneId = "";
    }

    private List<RuleEdit> _rules = [];
    private IReadOnlyList<Scene> _scenes = [];

    protected override async Task OnInitializedAsync()
    {
        _scenes = await ScenesQuery.HandleAsync(new GetScenes.Query());
        await base.OnInitializedAsync();
    }

    protected override Task OnHallLoadedAsync()
    {
        _rules = Hall?.Rules.Select(r => new RuleEdit { StateId = r.StateId, Value = r.Value, SceneId = r.SceneId }).ToList() ?? [];
        return Task.CompletedTask;
    }

    private static IReadOnlyList<string> ValuesOf(string stateId) =>
        DefaultStates.All.FirstOrDefault(s => s.Id == stateId)?.Values ?? [];

    private void AddRule()
    {
        var state = DefaultStates.All[0];
        _rules.Add(new RuleEdit
        {
            StateId = state.Id,
            Value = state.Values.Count > 1 ? state.Values[^1] : state.First,
            SceneId = _scenes.FirstOrDefault()?.Id ?? "",
        });
        Touch();
    }

    private void RemoveRule(RuleEdit rule) { _rules.Remove(rule); Touch(); }

    private Task SaveRulesAsync() => SaveAsync(hall => hall with
    {
        Automation = _rules
            .Where(r => r.StateId.Length > 0 && r.SceneId.Length > 0)
            .Select(r => new AutomationRule(r.StateId, r.Value, r.SceneId))
            .ToList(),
    });
}
