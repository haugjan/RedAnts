@using RedAnts.DJ.Features.Admin
@using RedAnts.DJ.Features.Sounds
@using RedAnts.Show.Features.Music
@inject GetSounds.Handler SoundsQuery
@inject SaveSounds.Handler SoundsSave
@inject UploadDJSound.Handler Upload
@inject GetSpotifyHits.Handler Spotify

<section class="sa-card">
    <h2>Musik <small>Befehle für alle Hallen</small> <StatusLine Text="@_status" IsError="@_statusIsError" /></h2>
    <p class="sa-hint">
        Ein Befehl ist eine Kachel mit einem oder mehreren Songs: Datei aus dem Speicher oder Spotify, je Song Cue-Start und Cue-Länge,
        dazu Reihenfolge, Loop, Lautstärke und Fade-out. Szenen und Deck-Tasten verweisen auf diese Befehle; abgespielt wird im Browser.
    </p>

    <div class="sa-columns">
        <aside>
            <ul class="sa-list">
                @foreach (var sound in _sounds)
                {
                    <li class="@(sound == _current ? "active" : "")" @onclick="() => Select(sound)" @key="sound">
                        <span class="sa-swatch" style="background:@sound.Color"></span>@sound.Label
                        <small>@(sound.Tracks.Count == 1 ? "1 Song" : sound.Tracks.Count + " Songs")</small>
                    </li>
                }
            </ul>
            <div class="sa-actions">
                <button class="sa-btn small" @onclick="Add">+ Befehl</button>
                <button class="sa-btn primary" @onclick="SaveAsync">💾 Speichern</button>
            </div>
        </aside>

        <div>
            @if (_current is null)
            {
                <p class="sa-hint">Keinen Befehl gewählt.</p>
            }
            else
            {
                <div class="sa-form">
                    <label>Bezeichnung <input class="sa-input" @bind="_current.Label" /></label>
                    <label>Kennung <input class="sa-input" @bind="_current.Id" /></label>
                    <label>Farbe <input class="sa-input" type="color" @bind="_current.Color" /></label>
                    <label>Lautstärke %<input class="sa-input" type="number" min="0" max="100" @bind="_current.Volume" /></label>
                    <label>Fade-out s <input class="sa-input" type="number" step="0.5" @bind="_current.FadeOutSec" /></label>
                    <label class="sa-check"><input type="checkbox" @bind="_current.Loop" /> endlos wiederholen</label>
                    @if (_current.Tracks.Count > 1)
                    {
                        <label class="sa-check"><input type="checkbox" @bind="_current.Random" /> zufällige Reihenfolge</label>
                    }
                </div>

                <h3>Songs (@_current.Tracks.Count)</h3>
                <table class="sa-table">
                    <thead>
                        <tr><th style="width:90px">Quelle</th><th>Datei oder Spotify</th><th style="width:110px">Cue ab s</th><th style="width:110px">Länge s</th><th style="width:120px"></th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _current.Tracks.Count; i++)
                        {
                            var index = i;
                            var track = _current.Tracks[index];
                            <tr @key="track">
                                <td>
                                    <select class="sa-input" @bind="track.Source">
                                        <option value="@SoundSource.Blob">Datei</option>
                                        <option value="@SoundSource.Spotify">Spotify</option>
                                    </select>
                                </td>
                                <td>
                                    <input class="sa-input wide" @bind="track.Ref" @bind:after="() => DescribeAsync(track)" placeholder="@(track.Source == SoundSource.Spotify ? "spotify:track:… oder Link" : "datei.mp3")" />
                                    @if (track.Title.Length > 0)
                                    {
                                        <span class="sa-hint">@track.Display</span>
                                    }
                                </td>
                                <td><input class="sa-input" type="number" step="0.5" @bind="track.StartSec" /></td>
                                <td><input class="sa-input" type="number" step="0.5" @bind="track.DurationSec" /></td>
                                <td class="sa-rowops">
                                    @if (track.Source == SoundSource.Blob && track.Ref.Length > 0)
                                    {
                                        <a class="sa-btn small" href="/dj/sound/@track.Ref" target="_blank" title="anhören">▶</a>
                                    }
                                    <button class="sa-btn small" disabled="@(index == 0)" @onclick="() => Move(index, -1)">↑</button>
                                    <button class="sa-btn small" disabled="@(index == _current.Tracks.Count - 1)" @onclick="() => Move(index, 1)">↓</button>
                                    <button class="sa-btn small" @onclick="() => _current.Tracks.RemoveAt(index)">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="sa-actions">
                    <button class="sa-btn small" @onclick="AddTrack">+ Song</button>
                    <label class="sa-btn small">
                        ⬆ Datei hochladen
                        <InputFile OnChange="UploadAsync" style="display:none" accept="audio/*" />
                    </label>
                    <button class="sa-btn small danger" @onclick="Remove">Befehl löschen</button>
                </div>

                <h3>Spotify suchen</h3>
                <div class="sa-actions">
                    <input class="sa-input" style="max-width:320px" placeholder="Titel oder Interpret" @bind="_term" @bind:event="oninput" />
                    <button class="sa-btn small" @onclick="SearchAsync">Suchen</button>
                </div>
                @if (_hits.Count > 0)
                {
                    <ul class="sa-list">
                        @foreach (var hit in _hits)
                        {
                            <li @onclick="() => AddSpotify(hit)" @key="hit.Uri">@hit.Name <small>@hit.Artist</small></li>
                        }
                    </ul>
                }
            }
        </div>
    </div>
</section>

@code {
    private sealed class SoundEdit
    {
        public string Id = "";
        public string Label = "";
        public string Color = SoundCommand.DefaultColor;
        public string? Icon;
        public bool Random;
        public bool Loop;
        public int Volume = 100;
        public double FadeOutSec;
        public List<TrackEdit> Tracks = [];

        public static SoundEdit From(SoundCommand sound) => new()
        {
            Id = sound.Id,
            Label = sound.Label,
            Color = sound.Color,
            Icon = sound.Icon,
            Random = sound.Random,
            Loop = sound.Loop,
            Volume = sound.Volume,
            FadeOutSec = sound.FadeOutSec,
            Tracks = sound.Tracks.Select(TrackEdit.From).ToList(),
        };

        public SoundCommand ToSound() => new(
            Id.Trim(), Label.Trim(), Color, Icon,
            Tracks.Where(t => t.Ref.Trim().Length > 0).Select(t => t.ToTrack()).ToList(),
            Random, Loop, Volume, FadeOutSec);
    }

    private sealed class TrackEdit
    {
        public SoundSource Source = SoundSource.Blob;
        public string Ref = "";
        public string Title = "";
        public string Artist = "";
        public double StartSec;
        public double? DurationSec;

        public string Display => Artist.Length > 0 ? $"{Title} · {Artist}" : Title;

        public static TrackEdit From(SoundTrack track) => new()
        {
            Source = track.Source,
            Ref = track.Ref,
            Title = track.Title,
            Artist = track.Artist,
            StartSec = track.StartSec,
            DurationSec = track.DurationSec,
        };

        public SoundTrack ToTrack() => new(Source, Ref.Trim(), Title, Artist, StartSec, DurationSec);
    }

    private List<SoundEdit> _sounds = [];
    private SoundEdit? _current;
    private IReadOnlyList<SpotifyHit> _hits = [];
    private string _term = "";
    private string? _status;
    private bool _statusIsError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _sounds = (await SoundsQuery.HandleAsync(new GetSounds.Query())).Select(SoundEdit.From).ToList();
        _current = _sounds.FirstOrDefault(s => s.Id == _current?.Id) ?? _sounds.FirstOrDefault();
    }

    private void Select(SoundEdit sound) => _current = sound;

    private void Add()
    {
        var sound = SoundEdit.From(SoundCommand.Create("Neuer Befehl"));
        _sounds.Add(sound);
        _current = sound;
    }

    private void Remove()
    {
        if (_current is null) return;
        _sounds.Remove(_current);
        _current = _sounds.FirstOrDefault();
    }

    private void AddTrack() => _current?.Tracks.Add(new TrackEdit());

    private void Move(int index, int delta)
    {
        if (_current is null) return;
        var target = index + delta;
        if (target < 0 || target >= _current.Tracks.Count) return;
        (_current.Tracks[index], _current.Tracks[target]) = (_current.Tracks[target], _current.Tracks[index]);
    }

    private async Task DescribeAsync(TrackEdit track)
    {
        if (track.Source != SoundSource.Spotify || track.Ref.Trim().Length == 0) return;
        var hits = await Spotify.HandleAsync(new GetSpotifyHits.Query("", track.Ref));
        if (hits.FirstOrDefault() is not { } hit) return;
        track.Title = hit.Name;
        track.Artist = hit.Artist;
    }

    private async Task SearchAsync() => await Guarded(async () =>
    {
        _hits = await Spotify.HandleAsync(new GetSpotifyHits.Query(_term));
        if (_hits.Count == 0) Notify("Keine Treffer; ist Spotify im DJ-Bereich verbunden?");
    });

    private void AddSpotify(SpotifyHit hit)
    {
        _current?.Tracks.Add(new TrackEdit { Source = SoundSource.Spotify, Ref = hit.Uri, Title = hit.Name, Artist = hit.Artist });
        _hits = [];
    }

    private async Task UploadAsync(InputFileChangeEventArgs e) => await Guarded(async () =>
    {
        var file = e.File;
        await using var stream = file.OpenReadStream(80 * 1024 * 1024);
        var name = await Upload.HandleAsync(new UploadDJSound.Command(file.Name, stream, file.ContentType));
        _current?.Tracks.Add(new TrackEdit { Source = SoundSource.Blob, Ref = name, Title = file.Name });
        Notify($"{file.Name} hochgeladen.");
    });

    private async Task SaveAsync() => await Guarded(async () =>
    {
        await SoundsSave.HandleAsync(new SaveSounds.Command(_sounds.Select(s => s.ToSound()).ToList()));
        await ReloadAsync();
        Notify($"{_sounds.Count} Musik-Befehle gespeichert.");
    });

    private async Task Guarded(Func<Task> work)
    {
        _status = null;
        try { await work(); }
        catch (DomainException ex) { _status = ex.Message; _statusIsError = true; }
    }

    private void Notify(string text) { _status = text; _statusIsError = false; }
}
