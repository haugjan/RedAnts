@using System.Text.Json
@using Microsoft.JSInterop
@inject GetShowProfiles.Handler ProfilesQuery
@inject SaveShowProfiles.Handler ProfilesSave
@inject GetSpotifySettings.Handler SpotifyState
@inject IJSRuntime JS
@implements IDisposable

<div class="se">
    <header class="se-top">
        <h1>Show · Soundboard-Konfiguration</h1>
        <div class="se-actions">
            <button class="se-btn primary" @onclick="SaveAsync">💾 Speichern</button>
            <button class="se-btn" @onclick="LoadAsync">↺ Neu laden</button>
            <button class="se-btn" @onclick="() => _showIo = !_showIo">⇅ Import/Export</button>
            <button class="se-btn" @onclick="ToggleSpotifySettings">🟢 Spotify</button>
            <button class="se-btn" @onclick="ResetAsync">⟲ Vorlage</button>
            <a class="se-btn" href="/show" target="_blank">▶ Board öffnen</a>
            @if (_status is { Length: > 0 })
            {
                <span class="se-status">@_status</span>
            }
        </div>
    </header>

    @if (_showIo)
    {
        <ProfileBundlePanel Profiles="_profiles" OnImported="ApplyImportedAsync" />
    }

    @if (_showSpotify)
    {
        <SpotifySettingsDialog OnClosed="() => _showSpotify = false" OnSaved="RefreshSpotifyStateAsync" />
    }

    @if (_profile is null)
    {
        <p class="se-muted">Wird geladen …</p>
    }
    else
    {
        <div class="se-tabs">
            @foreach (var p in _profiles)
            {
                <button class="se-tab @(p == _profile ? "active" : "")" @onclick="() => SelectProfile(p)">@p.Name</button>
            }
            <button class="se-tab add" title="Neues Profil" @onclick="AddProfile">+ Profil</button>
        </div>

        <div class="se-body">
            <div class="se-tree">
                <div class="se-prof-head">
                    <input class="se-in" @bind="_profile.Name" @bind:event="oninput" />
                    <input class="se-color" type="color" @bind="_profile.Color" title="Profilfarbe" />
                </div>
                <div class="se-prof-btns">
                    <button class="se-btn sm" @onclick="DuplicateProfile">⧉ Duplizieren</button>
                    <button class="se-btn sm danger" @onclick="DeleteProfile">🗑 Löschen</button>
                </div>
                <div class="se-ftree">
                    <button class="se-fnode @(_levelStack.Count == 0 ? "cur" : "")" @onclick="() => GoLevel(0)">🏠 Hauptseite</button>
                    @RenderFolders(_profile.Root, 1)
                </div>
            </div>

            <div class="se-detail">
                <div class="se-canvas-head">
                    <strong>Anordnung (5 × 3, Streamdeck)</strong>
                    <button class="se-crumb2" @onclick="() => GoLevel(0)">@_profile.Name</button>
                    @for (var d = 0; d < _levelStack.Count; d++)
                    {
                        var depth = d;
                        <span class="se-sep2">›</span>
                        <button class="se-crumb2" @onclick="() => GoLevel(depth + 1)">@_levelStack[depth].Label</button>
                    }
                </div>
                @{ var level = CurrentLevel(); var canvasHasBack = _levelStack.Count > 0; ShowLayout.EnsureEdit(level, canvasHasBack); }
                <div class="se-canvas">
                    @if (canvasHasBack)
                    {
                        <div class="se-reserved" style="grid-column:1 / span 1; grid-row:1 / span 1">↩ Zurück</div>
                    }
                    <div class="se-reserved" style="grid-column:@(ShowLayout.PauseCell.X + 1) / span 1; grid-row:@(ShowLayout.PauseCell.Y + 1) / span 1">⏸ Pause</div>
                    <div class="se-reserved" style="grid-column:@(ShowLayout.FadeCell.X + 1) / span 1; grid-row:@(ShowLayout.FadeCell.Y + 1) / span 1">🔉 Fade</div>
                    @foreach (var node in level)
                    {
                        <div class="se-ct @(node.Kind == NodeKind.Folder ? "folder" : "") @(node == _selected ? "sel" : "")"
                             data-id="@node.Id" data-x="@node.X" data-y="@node.Y" data-w="@node.W" data-h="@node.H"
                             @onclick="() => Select(node)"
                             style="grid-column:@(node.X + 1) / span 1; grid-row:@(node.Y + 1) / span 1; --c:@node.Color">
                            @if (node.Kind == NodeKind.Folder)
                            {
                                <span class="se-ct-fhead"><span>📂</span>@node.Label</span>
                                <span class="se-ct-ico fbody">@(string.IsNullOrEmpty(node.Icon) ? "📁" : node.Icon)</span>
                                <button class="se-ct-open" @onclick:stopPropagation="true" @onclick="() => EnterLevel(node)">öffnen ↳</button>
                            }
                            else
                            {
                                <span class="se-ct-ico">@(string.IsNullOrEmpty(node.Icon) ? "🔊" : node.Icon)</span>
                                <span class="se-ct-lbl">@node.Label</span>
                            }
                        </div>
                    }
                </div>

                <p class="se-hint">Neue Kachel: auf eine freie Zelle klicken, dann Ordner oder Song wählen. Kacheln per Ziehen in eine andere Zelle verschieben.</p>
                <div class="se-add-tiles">
                    <button class="se-btn sm" @onclick="() => AddChild(CurrentLevel(), NodeKind.Sound)">+ Song</button>
                    <button class="se-btn sm" @onclick="() => AddChild(CurrentLevel(), NodeKind.Folder)">+ Ordner</button>
                </div>

                @if (_selected is { } sel)
                {
                    <TileEditorDialog @ref="_editor" @key="sel" Node="sel" IsNew="_selectedIsNew" SpotifyConfigured="_spotifyConfigured"
                                      OnClosed="CloseEditor" OnRemoved="RemoveSelected" />
                }

                @if (_chooseKind)
                {
                    <NewTileDialog OnChosen="CommitNewTile" OnCancelled="CancelNewTile" />
                }
            </div>
        </div>
    }
</div>

@code {
    private List<EditProfile> _profiles = new();
    private EditProfile? _profile;
    private EditButton? _selected;
    private bool _selectedIsNew;
    private string _status = "";
    private bool _showIo;
    private bool _showSpotify;
    private bool _spotifyConfigured;
    private bool _chooseKind;
    private (int X, int Y, int W, int H)? _newRect;
    private readonly List<EditButton> _levelStack = new();
    private DotNetObjectReference<ShowAdminPage>? _gridRef;
    private TileEditorDialog? _editor;

    private TileEditorDialog? Editor => _selected is null ? null : _editor;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _gridRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("showGridInit", _gridRef);
    }

    public void Dispose() => _gridRef?.Dispose();

    private async Task LoadAsync()
    {
        var loaded = await ProfilesQuery.HandleAsync(new GetShowProfiles.Query());
        _profiles = loaded.Select(EditProfile.From).ToList();
        foreach (var p in _profiles) p.Root.RemoveAll(b => b.Panic);
        _profile = _profiles.FirstOrDefault();
        _selected = null;
        _status = "";
        await RefreshSpotifyStateAsync();
    }

    private async Task SaveAsync()
    {
        try
        {
            await ProfilesSave.HandleAsync(new SaveShowProfiles.Command(_profiles.Select(p => p.ToModel()).ToList()));
            _status = $"Gespeichert · {DateTime.Now:HH:mm:ss}";
        }
        catch (DomainException ex) { _status = ex.Message; }
        catch (Exception ex) { _status = "Fehler: " + ex.Message; }
    }

    private async Task ResetAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Alle Profile auf die Standard-Vorlage zurücksetzen? Gespeicherte Änderungen gehen verloren.")) return;
        await ProfilesSave.HandleAsync(new SaveShowProfiles.Command(ShowConfig.Profiles));
        await LoadAsync();
        _status = "Auf Vorlage zurückgesetzt.";
    }

    private Task ApplyImportedAsync(List<ShowProfile> imported)
    {
        _profiles = imported.Select(EditProfile.From).ToList();
        foreach (var p in _profiles) p.Root.RemoveAll(b => b.Panic);
        _profile = _profiles.First();
        _selected = null;
        return Task.CompletedTask;
    }

    private async Task RefreshSpotifyStateAsync() =>
        _spotifyConfigured = (await SpotifyState.HandleAsync(new GetSpotifySettings.Query())).Configured;

    private void ToggleSpotifySettings() => _showSpotify = !_showSpotify;

    private void SelectProfile(EditProfile p) { _profile = p; _selected = null; }

    private void AddProfile()
    {
        var p = new EditProfile { Name = "Neues Profil" };
        _profiles.Add(p);
        _profile = p;
        _selected = null;
    }

    private void DuplicateProfile()
    {
        if (_profile is null) return;
        var json = JsonSerializer.Serialize(_profile.ToModel(), ShowJson.Options);
        var copy = EditProfile.From(JsonSerializer.Deserialize<ShowProfile>(json, ShowJson.Options)!);
        copy.Id = Guid.NewGuid().ToString("N")[..6];
        copy.Name = _profile.Name + " (Kopie)";
        _profiles.Add(copy);
        _profile = copy;
        _selected = null;
    }

    private async Task DeleteProfile()
    {
        if (_profile is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Profil „{_profile.Name}“ wirklich löschen?")) return;
        _profiles.Remove(_profile);
        _profile = _profiles.FirstOrDefault();
        _selected = null;
    }

    private List<EditButton> CurrentLevel()
    {
        if (_profile is null) return new();
        while (_levelStack.Count > 0 && !Contains(_profile.Root, _levelStack[^1]))
            _levelStack.RemoveAt(_levelStack.Count - 1);
        return _levelStack.Count > 0 ? _levelStack[^1].Children : _profile.Root;
    }

    private static bool Contains(List<EditButton> nodes, EditButton target)
    {
        foreach (var n in nodes)
        {
            if (n == target) return true;
            if (n.Kind == NodeKind.Folder && Contains(n.Children, target)) return true;
        }
        return false;
    }

    private void GoLevel(int depth) { while (_levelStack.Count > depth) _levelStack.RemoveAt(_levelStack.Count - 1); }
    private void EnterLevel(EditButton folder) { if (folder.Kind == NodeKind.Folder) { _levelStack.Add(folder); _selected = null; } }

    private void NavigateTo(EditButton folder)
    {
        if (_profile is null) return;
        var path = new List<EditButton>();
        if (FindPath(_profile.Root, folder, path)) { _levelStack.Clear(); _levelStack.AddRange(path); }
        _selected = null;
    }

    private static bool FindPath(List<EditButton> nodes, EditButton target, List<EditButton> path)
    {
        foreach (var n in nodes.Where(x => x.Kind == NodeKind.Folder))
        {
            path.Add(n);
            if (n == target) return true;
            if (FindPath(n.Children, target, path)) return true;
            path.RemoveAt(path.Count - 1);
        }
        return false;
    }

    private static bool RemoveFrom(List<EditButton> nodes, EditButton target)
    {
        if (nodes.Remove(target)) return true;
        foreach (var n in nodes.Where(x => x.Kind == NodeKind.Folder))
            if (RemoveFrom(n.Children, target)) return true;
        return false;
    }

    private RenderFragment RenderFolders(List<EditButton> nodes, int depth) =>
    @<text>
        @foreach (var f in nodes.Where(n => n.Kind == NodeKind.Folder))
        {
            <div class="se-fnode-row">
                <button class="se-fnode @(_levelStack.Count > 0 && _levelStack[^1] == f ? "cur" : "")"
                        style="padding-left:@(depth * 14)px" @onclick="() => NavigateTo(f)">📁 @f.Label</button>
            </div>
            @RenderFolders(f.Children, depth + 1)
        }
    </text>;

    private void Select(EditButton node)
    {
        _selected = node;
        _selectedIsNew = false;
        _ = JS.InvokeVoidAsync("showEditStop");
    }

    private void AddChild(List<EditButton> list, NodeKind kind)
    {
        var b = new EditButton { Kind = kind, Label = kind == NodeKind.Folder ? "Ordner" : "Neu", Icon = kind == NodeKind.Folder ? "📁" : "🔊" };
        list.Add(b);
        _selected = b;
        _selectedIsNew = true;
    }

    private void CloseEditor()
    {
        _selected = null;
        _selectedIsNew = false;
        _ = JS.InvokeVoidAsync("showEditStop");
        _ = JS.InvokeVoidAsync("showPreviewStop");
    }

    private void RemoveSelected()
    {
        if (_selected is { } node && _profile is not null) RemoveFrom(_profile.Root, node);
        CloseEditor();
    }

    [JSInvokable]
    public Task SetRect(string id, int x, int y, int w, int h)
    {
        var level = CurrentLevel();
        var n = level.FirstOrDefault(b => b.Id == id);
        if (n is null) return Task.CompletedTask;
        x = Math.Clamp(x, 0, ShowLayout.Cols - 1);
        y = Math.Clamp(y, 0, ShowLayout.Rows - 1);
        if (ShowLayout.IsReserved(x, y, _levelStack.Count > 0)) return Task.CompletedTask;
        if (Overlaps(level, n, x, y, 1, 1)) return Task.CompletedTask;
        if (n.X == x && n.Y == y) return Task.CompletedTask;
        n.X = x; n.Y = y; n.W = 1; n.H = 1;
        return InvokeAsync(StateHasChanged);
    }

    private static bool Overlaps(List<EditButton> level, EditButton self, int x, int y, int w, int h)
    {
        foreach (var o in level)
        {
            if (o == self) continue;
            int ox = Math.Max(0, o.X), oy = Math.Max(0, o.Y);
            int ow = o.W <= 0 ? 1 : o.W, oh = o.H <= 0 ? 1 : o.H;
            if (x < ox + ow && x + w > ox && y < oy + oh && y + h > oy) return true;
        }
        return false;
    }

    [JSInvokable]
    public Task CreateRect(int x, int y, int w, int h)
    {
        x = Math.Clamp(x, 0, ShowLayout.Cols - 1);
        y = Math.Clamp(y, 0, ShowLayout.Rows - 1);
        if (ShowLayout.IsReserved(x, y, _levelStack.Count > 0)) return Task.CompletedTask;
        if (Overlaps(CurrentLevel(), new EditButton(), x, y, 1, 1)) return Task.CompletedTask;
        _newRect = (x, y, 1, 1);
        _chooseKind = true;
        return InvokeAsync(StateHasChanged);
    }

    private void CommitNewTile(NodeKind kind)
    {
        if (_newRect is not { } r) { _chooseKind = false; return; }
        var b = new EditButton
        {
            Kind = kind,
            Label = kind == NodeKind.Folder ? "Ordner" : "Neu",
            Icon = kind == NodeKind.Folder ? "📁" : "🔊",
            X = r.X, Y = r.Y, W = r.W, H = r.H,
        };
        CurrentLevel().Add(b);
        _selected = b;
        _selectedIsNew = true;
        _newRect = null;
        _chooseKind = false;
    }

    private void CancelNewTile() { _newRect = null; _chooseKind = false; }

    [JSInvokable]
    public Task OnEditPosition(double pos, double dur) => Editor?.ReportPositionAsync(pos, dur) ?? Task.CompletedTask;

    [JSInvokable]
    public Task OnEditStopped() => Editor?.ReportStoppedAsync() ?? Task.CompletedTask;

    [JSInvokable]
    public async Task OnEditorEscape()
    {
        if (Editor is { } editor) { await editor.HandleEscapeAsync(); return; }
        if (_chooseKind) CancelNewTile();
        else if (_showSpotify) _showSpotify = false;
        else return;
        await InvokeAsync(StateHasChanged);
    }
}
