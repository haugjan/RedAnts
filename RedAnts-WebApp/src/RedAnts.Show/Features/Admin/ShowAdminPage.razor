@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable
@inject GetHalls.Handler HallsQuery
@inject ShowAdminState State
@inject NavigationManager Navigation

<div class="sa">
    <nav class="sa-subnav">
        @foreach (var tab in Tabs)
        {
            <button class="sa-subnav-btn @(_tab == tab.Key ? "active" : "")" @onclick="() => Go(tab.Key)" @key="tab.Key">@tab.Label</button>
        }
        <span class="sa-subnav-spacer"></span>
        @if (PerHall && _halls.Count > 0)
        {
            <label class="sa-subnav-hall">
                Halle
                <select class="sa-input" value="@State.SelectedHallId" @onchange="OnHallChanged">
                    @foreach (var hall in _halls)
                    {
                        <option value="@hall.Id">@hall.Name</option>
                    }
                </select>
            </label>
            <span class="sa-lamp @(_halls.FirstOrDefault(h => h.Id == State.SelectedHallId)?.AgentConnected == true ? "on" : "off")"
                  title="Agent der gewählten Halle"></span>
        }
    </nav>

    <main class="sa-content" @key="@($"{_tab}|{State.SelectedHallId}")">
        <ErrorBoundary @ref="_boundary">
            <ChildContent>
        @switch (_tab)
        {
            case "musik": <MusicPage /> break;
            case "vmix": <TitlesTab /> break;
            case "led": <LedTab /> break;
            case "decks": <DecksTab /> break;
            case "bedienung": <ControlTab /> <StatesTab /> <GamesTab /> break;
            default: <HallsTab OnHallsChanged="ReloadHallsAsync" /> break;
        }
            </ChildContent>
            <ErrorContent>
                <section class="sa-card">
                    <h2>Fehler</h2>
                    <p class="sa-hint">Die Seite ist auf einen Fehler gelaufen und zeigt den letzten Stand nicht mehr. Erneut laden und es nochmals versuchen.</p>
                    <button class="sa-btn small" @onclick="Again">Seite neu laden</button>
                </section>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    [Parameter] public string? Page { get; set; }

    private static readonly (string Key, string Label)[] Tabs =
    [
        ("hallen", "Hallen"),
        ("musik", "Musik"),
        ("decks", "Decks"),
        ("bedienung", "Bedienung"),
        ("vmix", "vMix-Titel"),
        ("led", "LED-Vorlagen"),
    ];

    private static readonly string[] HallPages = ["hallen", "bedienung"];

    private bool PerHall => HallPages.Contains(_tab);

    private IReadOnlyList<HallRow> _halls = [];
    private string _tab = "hallen";
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        if (Page is { Length: > 0 } page && Tabs.Any(t => t.Key == page)) _tab = page;
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("halle", out var hall)) State.SelectedHallId = hall!;
        State.Changed += OnStateChanged;
        await ReloadHallsAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _ready = true;
        WriteUrl();
    }

    private async Task ReloadHallsAsync()
    {
        try { _halls = await HallsQuery.HandleAsync(new GetHalls.Query()); }
        catch (Exception e) when (e is not OperationCanceledException) { _halls = []; }
        if (_halls.Count > 0 && !_halls.Any(h => h.Id == State.SelectedHallId))
            State.SelectedHallId = _halls[0].Id;
    }

    private void OnHallChanged(ChangeEventArgs e) => State.SelectedHallId = e.Value?.ToString();

    private ErrorBoundary? _boundary;

    private void Again()
    {
        _boundary?.Recover();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void Go(string tab)
    {
        if (_tab == tab) return;
        var hall = HallPages.Contains(tab) && State.SelectedHallId is { Length: > 0 } id
            ? "?halle=" + Uri.EscapeDataString(id)
            : "";
        Navigation.NavigateTo($"/admin/show/{tab}{hall}", forceLoad: true);
    }

    private void OnStateChanged()
    {
        if (_ready) WriteUrl();
        StateHasChanged();
    }

    private void WriteUrl()
    {
        if (!_ready) return;
        var url = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["halle"] = PerHall ? State.SelectedHallId : null,
        });
        Navigation.NavigateTo(url, forceLoad: false, replace: true);
    }

    public void Dispose() => State.Changed -= OnStateChanged;
}
