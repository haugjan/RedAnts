@if (_asking)
{
    <span class="ly-confirm">
        <button class="sa-btn small danger" @onclick="ConfirmAsync">@Confirm</button>
        <button class="sa-btn small" @onclick="() => _asking = false">Abbrechen</button>
    </span>
}
else
{
    <button class="sa-btn small @(Danger ? "danger" : "")" disabled="@Disabled" @onclick="() => _asking = true">@Label</button>
}

@code {
    private bool _asking;

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Confirm { get; set; } = "Wirklich?";
    [Parameter] public bool Danger { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private async Task ConfirmAsync()
    {
        _asking = false;
        await OnConfirm.InvokeAsync();
    }
}
