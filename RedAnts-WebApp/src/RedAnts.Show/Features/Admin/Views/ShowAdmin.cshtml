@model string
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>Show Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap" rel="stylesheet" />
    <style>
        html, body { height: 100%; margin: 0; background: #f4f4f4; font-family: 'Lato', 'Segoe UI', Roboto, sans-serif; }
    </style>
    <link rel="stylesheet" href="/_content/RedAnts.Show/show/board.css" asp-append-version="true" />
    <link rel="stylesheet" href="/_content/RedAnts.Show/show/showadmin.css" asp-append-version="true" />
</head>
<body>
    <component type="typeof(RedAnts.Show.Features.Admin.ShowAdminPage)" param-Page="@Model" render-mode="Server" />
    <script src="/_content/RedAnts.Show/dj/soundboard.js" asp-append-version="true"></script>
    <script>
        if (window.djBoard) djBoard.useServerTokens('/admin/dj/spotify/token');
        window.showAdmin = (function () {
            var audio = null, timer = null, spotifyTimer = null, hook = null;

            function report(pos, dur) {
                if (hook) { try { hook.invokeMethodAsync('OnCuePosition', pos || 0, dur || 0); } catch (e) { } }
            }
            function reportStopped() {
                if (hook) { try { hook.invokeMethodAsync('OnCueStopped'); } catch (e) { } }
            }
            function clearTimers() {
                if (timer) { clearInterval(timer); timer = null; }
                if (spotifyTimer) { clearInterval(spotifyTimer); spotifyTimer = null; }
            }
            function halt() {
                clearTimers();
                try { if (audio) audio.pause(); } catch (e) { }
                audio = null;
                if (window.djBoard) { try { djBoard.stopAll(); } catch (e) { } }
            }

            var api = {
                download: function (name, text) {
                    const blob = new Blob([text], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url; a.download = name;
                    document.body.appendChild(a); a.click(); a.remove();
                    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
                },
                bindCue: function (ref) { hook = ref; },
                unbindCue: function () { hook = null; halt(); },
                preview: function (url, startSec) { api.play(url, startSec, null); },
                play: function (url, startSec, durationSec) {
                    halt();
                    audio = new Audio(url);
                    audio.addEventListener('loadedmetadata', function () { report(audio.currentTime, audio.duration || 0); });
                    audio.addEventListener('ended', function () { api.stop(); });
                    audio.addEventListener('error', function () {
                        var code = audio && audio.error ? audio.error.code : 0;
                        console.error('Stück nicht abspielbar', url, audio && audio.error);
                        alert('Das Stück kann nicht geladen werden (Code ' + code + ').\n' + url);
                    });
                    var begin = function () {
                        if (startSec > 0) { try { audio.currentTime = startSec; } catch (e) { } }
                        audio.play().catch(function (e) {
                            console.error('Abspielen abgelehnt', url, e);
                            alert('Abspielen nicht möglich: ' + (e && e.message ? e.message : e));
                        });
                    };
                    if (audio.readyState >= 1) begin(); else audio.addEventListener('canplay', begin, { once: true });
                    timer = setInterval(function () {
                        if (!audio) return;
                        report(audio.currentTime, audio.duration || 0);
                        if (durationSec && audio.currentTime >= (startSec || 0) + durationSec) api.stop();
                    }, 250);
                },
                playSpotify: async function (uri, startSec, shuffle) {
                    if (!uri) { alert('Kein Spotify-Link hinterlegt.'); return; }
                    if (!window.djBoard) { alert('Spotify-Player nicht geladen.'); return; }
                    var ready = false;
                    try { ready = await djBoard.ensureSpotify(); }
                    catch (e) { alert(e && e.message ? e.message : 'Spotify-Player nicht bereit.'); return; }
                    if (!ready) { alert('Spotify-Player nicht bereit. Unter \u201eSpotify\u201c ein Konto verbinden (Premium n\u00f6tig).'); return; }
                    halt();
                    var status = await djBoard.playSpotify(uri, (startSec || 0) * 1000, !!shuffle);
                    if (status !== 'ok') { alert('Spotify: ' + status); return; }
                    spotifyTimer = setInterval(async function () {
                        var state = await djBoard.getState();
                        if (state) report((state.position || 0) / 1000, (state.duration || 0) / 1000);
                    }, 300);
                },
                seek: function (frac) {
                    if (audio && audio.duration) {
                        try { audio.currentTime = frac * audio.duration; } catch (e) { }
                        report(audio.currentTime, audio.duration || 0);
                    }
                },
                seekIn: function (id, x) {
                    var el = document.getElementById(id);
                    if (!el || !el.clientWidth) return;
                    api.seek(Math.max(0, Math.min(1, x / el.clientWidth)));
                },
                stop: function () { halt(); reportStopped(); }
            };

            document.addEventListener('click', function (e) {
                if (e.target && e.target.closest && e.target.closest('[data-preview-stop]')) { api.stop(); return; }
                var button = e.target && e.target.closest ? e.target.closest('[data-preview]') : null;
                if (!button) return;
                var source = button.getAttribute('data-preview') || '';
                if (!source) return;
                var start = parseFloat(button.getAttribute('data-start') || '0') || 0;
                var lengthText = button.getAttribute('data-length') || '';
                var length = lengthText ? parseFloat(lengthText) : null;
                if (button.getAttribute('data-kind') === 'spotify') api.playSpotify(source, start, false);
                else api.play(source, start, length);
            });

            return api;
        })();
    </script>
    <script src="/_framework/blazor.server.js"></script>
</body>
</html>
