@inherits SetupTab
@using System.Text.Json
@using RedAnts.Show.Features.Music
@implements IAsyncDisposable
@inject GetMusic.Handler MusicQuery
@inject IJSRuntime JS

<section class="sa-card">
    <h2>Decks <StatusLine Text="@Status" IsError="@StatusIsError" /></h2>
    <p class="sa-hint">
        Die Decks gelten für alle Hallen. Unter Hallen wird gewählt, welche davon eine Halle anbietet.
        Die Grösse wird beim Anlegen gewählt und steht danach fest. Unterseiten gehören allen Decks derselben Grösse: was hier geändert wird, gilt auf jedem dieser Decks. Nur die Startseite gehört dem einzelnen Deck.
        Eine belegte Kachel lässt sich auf eine freie ziehen; Entf löscht die gewählte Taste, Strg+C kopiert sie, Strg+V fügt sie auf der gewählten Kachel ein, auch in einem anderen Tab.
    </p>

        <div class="sa-actions">
            <label class="sa-inline">Gerät
                <select class="sa-input" value="@_deckId" @onchange="OnDeckChanged">
                    @foreach (var row in _decks)
                    {
                        <option value="@row.Id">@row.Name</option>
                    }
                </select>
            </label>
            <label class="sa-inline">Seite
                <select class="sa-input" value="@_pageId" @onchange="OnPageChanged">
                    @foreach (var entry in Pages)
                    {
                        <option value="@entry.Id">@Indent(entry)@entry.Name</option>
                    }
                </select>
            </label>
            <label class="sa-inline">Neues Deck
                <select class="sa-input" value="@_format" @onchange="e => _format = e.Value?.ToString() ?? DeckFormat.Mk2">
                    @foreach (var format in DeckFormat.All)
                    {
                        <option value="@format.Id">@format.Label</option>
                    }
                </select>
            </label>
            <button class="sa-btn small" @onclick="AddDeck">+ Deck</button>
            <button class="sa-btn small danger" @onclick="RemoveDeck" disabled="@(_decks.Count < 2)">Deck löschen</button>
            <button class="sa-btn small" @onclick="AddPage">+ Seite</button>
            <button class="sa-btn small danger" @onclick="RemovePage" disabled="@(Page?.IsHome ?? true)">Seite löschen</button>
            <span class="sd-spacer"></span>
            <button class="sa-btn small" @onclick="Defaults">⟲ Standard</button>
            <button class="sa-btn primary" @onclick="SaveDecksAsync" disabled="@(!Dirty)">💾 Speichern</button>
        </div>

        @if (Deck is { } deck && Page is { } sheet)
        {
            <div class="sa-actions">
                <label class="sa-inline">Name des Decks <input class="sa-input" value="@deck.Name" @onchange="RenameDeck" /></label>
                <span class="sa-inline">Grösse <strong class="sa-fixed">@DeckFormat.NameOf(deck)</strong></span>
                <label class="sa-inline">PANIC auf <input class="sa-input sa-num" type="number" min="1" max="@deck.Count" value="@deck.Panic" @onchange="e => SetFixed(e, panic: true)" /></label>
                <label class="sa-inline">Zurück auf <input class="sa-input sa-num" type="number" min="1" max="@deck.Count" value="@deck.Back" @onchange="e => SetFixed(e, panic: false)" /></label>
            </div>
            <div class="sa-actions">
                <label class="sa-inline">Name der Seite <input class="sa-input" value="@sheet.Name" @onchange="RenamePage" /></label>
                <span class="sa-hint">
                    Zurück auf @deck.Back (nur auf Unterseiten) · PANIC auf @deck.Panic · Kennung <code>@deck.Id</code>
                    @if (!sheet.IsHome)
                    {
                        <text> · geteilt mit @Sharing(deck)</text>
                    }
                </span>
            </div>

            <div class="sa-deckgrid">
                <div class="sa-deck" style="grid-template-columns:repeat(@deck.Columns, 92px)">
                    @for (var n = 1; n <= deck.Count; n++)
                    {
                        var number = n;
                        var tile = sheet.KeyAt(number);
                        var locked = Locked(deck, sheet, number);
                        <div class="sa-key @(number == _selected ? "selected" : "") @(_dragFrom == number ? "dragging" : "") @(_dragFrom > 0 && Droppable(deck, sheet, number) ? "target" : "")"
                             style="background:@(locked is not null ? "#3a3f47" : tile.Color);color:#fff"
                             draggable="@(Draggable(deck, sheet, number) ? "true" : "false")"
                             @ondragstart="() => _dragFrom = number"
                             @ondragend="() => _dragFrom = 0"
                             @ondragover:preventDefault="true"
                             @ondragenter:preventDefault="true"
                             @ondrop="() => Drop(deck, sheet, number)"
                             @onclick="() => _selected = number">
                            <span class="sa-key-n">@number</span>
                            @if (locked is { } lockedLabel)
                            {
                                <span class="sa-key-lbl">@lockedLabel</span>
                            }
                            else
                            {
                                @if (tile.Icon is { Length: > 0 } symbol)
                                {
                                    @if (DeckIcons.Known(symbol))
                                    {
                                        <img class="sa-key-icon" src="@DeckIcons.FileOf(symbol)" alt="" />
                                    }
                                    else
                                    {
                                        <span class="sa-key-symbol">@symbol</span>
                                    }
                                }
                                <span class="sa-key-lbl">@Caption(tile)</span>
                            }
                        </div>
                    }
                </div>

                <div class="sa-keyeditor">
                    @{
                        var current = sheet.KeyAt(_selected);
                        var fixedLabel = Locked(deck, sheet, _selected);
                    }
                    <h3>Taste @_selected</h3>
                    @if (fixedLabel is not null)
                    {
                        <p class="sa-hint">Dieser Platz gehört fest zu @fixedLabel und liegt auf jeder Seite gleich.</p>
                    }
                    else
                    {
                        <label>Art
                            <select class="sa-input" value="@current.Kind" @onchange="e => SetKind(e.Value?.ToString())">
                                @foreach (var kind in KeyKinds.All)
                                {
                                    <option value="@kind">@KeyKinds.Label(kind)</option>
                                }
                            </select>
                        </label>

                        @if (current.Kind != KeyKinds.Empty)
                        {
                            <label>Beschriftung <input class="sa-input" value="@current.Label" @onchange="@(e => SetLabel(e))" /></label>
                            <label>Farbe <input class="sa-input" type="color" value="@current.Color" @onchange="@(e => SetColor(e))" /></label>

                            <div class="sa-iconrow">
                                <span class="sa-iconrow-lbl">Grafiken</span>
                                <div class="sa-icons">
                                    <button class="sa-icon @(current.Icon is null ? "on" : "")" @onclick="() => Set(k => k with { Icon = null })" title="ohne Symbol">∅</button>
                                    @foreach (var icon in DeckIcons.All)
                                    {
                                        var name = icon;
                                        <button class="sa-icon @(current.Icon == name ? "on" : "")" title="@name" @onclick="() => Set(k => k with { Icon = name })">
                                            <img src="@DeckIcons.FileOf(name)" alt="@name" />
                                        </button>
                                    }
                                </div>
                            </div>
                            @foreach (var band in DeckIcons.Symbols.GroupBy(s => s.Group))
                            {
                                <div class="sa-iconrow">
                                    <span class="sa-iconrow-lbl">@band.Key</span>
                                    <div class="sa-icons">
                                        @foreach (var entry in band)
                                        {
                                            var glyph = entry.Glyph;
                                            <button class="sa-icon glyph @(current.Icon == glyph ? "on" : "")" title="@entry.Label" @onclick="() => Set(k => k with { Icon = glyph })">@glyph</button>
                                        }
                                    </div>
                                </div>
                            }
                        }

                        @if (current.Kind == KeyKinds.Music)
                        {
                            <label>Musik-Befehl
                                <select class="sa-input" value="@current.MusicId" @onchange="e => Set(k => k with { MusicId = e.Value?.ToString() })">
                                    <option value="">bitte wählen</option>
                                    @foreach (var item in _music)
                                    {
                                        <option value="@item.Id">@item.Display</option>
                                    }
                                </select>
                            </label>
                            <p class="sa-hint">Die Stücke, ihre Ordner, Bilder und Cue-Punkte werden unter <a href="/admin/dj" target="_top">Musik verwalten</a> gepflegt. Die Anordnung dort spielt keine Rolle mehr, die Tastenbelegung kommt aus diesem Deck.</p>
                        }

                        @if (current.Kind == KeyKinds.Special)
                        {
                            <label>Funktion
                                <select class="sa-input" value="@current.Special" @onchange="e => Set(k => k with { Special = e.Value?.ToString() })">
                                    <option value="">bitte wählen</option>
                                    @foreach (var group in SpecialKey.All.GroupBy(s => s.Group))
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var special in group)
                                            {
                                                <option value="@special.Id">@special.Label</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </label>
                            @if (SpecialKey.ChoosesPlayer(current.Special))
                            {
                                <p class="sa-hint">Die gewählte Spielerin erscheint auf:</p>
                                <label class="sa-check">
                                    <input type="checkbox" checked="@current.Livestream" @onchange="e => Set(k => k with { Livestream = e.Value is true })" />
                                    Livestream (vMix-Titel)
                                </label>
                                <label class="sa-check">
                                    <input type="checkbox" checked="@current.Led" @onchange="e => Set(k => k with { Led = e.Value is true })" />
                                    LED-Wand (nur Red Ants)
                                </label>
                                <p class="sa-hint">Ohne beides öffnet die Taste keine Spielerinnen-Auswahl, es laufen nur ihre Befehle (z. B. Sound). Beim Tor gibt es Assist und Speaker-Knopf nur mit LED-Wand.</p>
                            }
                        }

                        @if (current.Kind == KeyKinds.Page)
                        {
                            <label>Seite
                                <select class="sa-input" value="@current.PageId" @onchange="e => Set(k => k with { PageId = e.Value?.ToString() })">
                                    <option value="">bitte wählen</option>
                                    @foreach (var target in Pages.Where(p => !p.IsHome).OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase))
                                    {
                                        <option value="@target.Id">@target.Name</option>
                                    }
                                </select>
                            </label>
                        }

                        @if (current.Kind == KeyKinds.Live)
                        {
                            <label>Anzeige
                                <select class="sa-input" value="@current.Live" @onchange="e => Set(k => k with { Live = e.Value?.ToString() })">
                                    <option value="">nur Beschriftung</option>
                                    @foreach (var value in LiveValues.All)
                                    {
                                        <option value="@value">@LiveValues.Label(value)</option>
                                    }
                                </select>
                            </label>
                            <p class="sa-hint">Eine Anzeige lässt sich nicht drücken. „Nur Beschriftung“ gibt eine tote Taste, etwa als Titel einer Unterseite.</p>
                        }

                        @if (current.Kind is KeyKinds.Steps or KeyKinds.Special)
                        {
                            <h4>Befehle</h4>
                            @if (current.Kind == KeyKinds.Special)
                            {
                                <p class="sa-hint">Laufen beim Druck, bevor die feste Funktion übernimmt: hier stehen Musik und LED-Vorlage von Tor, Strafe und Best Player.</p>
                            }
                            @for (var i = 0; i < current.Sequence.Count; i++)
                            {
                                var index = i;
                                var step = current.Sequence[index];
                                <div class="sa-step">
                                    <select class="sa-input" value="@step.Action" @onchange="e => SetStep(index, s => s with { Action = e.Value?.ToString() ?? KeyActions.Wait })">
                                        @foreach (var action in KeyActions.All)
                                        {
                                            <option value="@action">@KeyActions.Label(action)</option>
                                        }
                                    </select>
                                    @if (step.Action == KeyActions.Wait)
                                    {
                                        <input class="sa-input" type="number" value="@step.Ms" @onchange="e => SetStep(index, s => s with { Ms = Number(e.Value) })" placeholder="Millisekunden" />
                                    }
                                    else if (step.Action == KeyActions.MusicPlay)
                                    {
                                        <select class="sa-input" value="@step.Target" @onchange="e => SetStep(index, s => s with { Target = e.Value?.ToString() })">
                                            <option value="">bitte wählen</option>
                                            @foreach (var item in _music)
                                            {
                                                <option value="@item.Id">@item.Display</option>
                                            }
                                        </select>
                                    }
                                    else if (step.Action == KeyActions.VmixText)
                                    {
                                        <input class="sa-input" value="@step.Text" placeholder="Text, z. B. Empty Net"
                                               @onchange="e => SetStep(index, s => s with { Text = e.Value?.ToString() ?? string.Empty })" />
                                        <select class="sa-input" value="@step.Target" @onchange="e => SetStep(index, s => s with { Target = e.Value?.ToString() })">
                                            <option value="">Einblender wählen</option>
                                            @foreach (var (value, label) in TitleChoices(step.Target))
                                            {
                                                <option value="@value">@label</option>
                                            }
                                        </select>
                                    }
                                    else if (step.Action is KeyActions.VmixShow or KeyActions.VmixHide)
                                    {
                                        <select class="sa-input" value="@step.Target" @onchange="e => SetStep(index, s => s with { Target = e.Value?.ToString() })">
                                            <option value="">Einblender wählen</option>
                                            @foreach (var (value, label) in TitleChoices(step.Target))
                                            {
                                                <option value="@value">@label</option>
                                            }
                                        </select>
                                    }
                                    else if (step.Action == KeyActions.LedStart)
                                    {
                                        <select class="sa-input" value="@step.Target" @onchange="e => SetStep(index, s => s with { Target = e.Value?.ToString() })">
                                            <option value="">LED-Vorlage wählen</option>
                                            @foreach (var (value, label) in LedChoices(step.Target))
                                            {
                                                <option value="@value">@label</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input class="sa-input" value="@step.Target" @onchange="e => SetStep(index, s => s with { Target = e.Value?.ToString() })" placeholder="@Placeholder(step.Action)" />
                                    }
                                    <button class="sa-btn small danger" @onclick="() => RemoveStep(index)">✕</button>
                                </div>
                            }
                            <button class="sa-btn small" @onclick="AddStep">+ Befehl</button>
                        }

                        @if (current.Kind != KeyKinds.Empty && current.Kind != KeyKinds.Live)
                        {
                            <label class="sa-check">
                                <input type="checkbox" checked="@current.HomeAfter" @onchange="e => Set(k => k with { HomeAfter = e.Value is true })" />
                                danach zurück auf die Startseite
                            </label>
                        }
                    }
                </div>
            </div>
        }
</section>

@code {
    private IReadOnlyList<MusicItem> _music = [];
    private List<Deck> _decks = [];
    private List<PageSet> _sets = [];
    private string _deckId = "";
    private string _pageId = DeckPage.HomeId;
    private string _format = DeckFormat.Default.Id;
    private int _selected = 1;

    private Deck? Deck => _decks.FirstOrDefault(d => d.Id == _deckId);

    private PageSet? Shared => Deck is { } deck ? _sets.FirstOrDefault(set => set.Fits(deck)) : null;

    private DeckPage? Page => Pages.FirstOrDefault(p => p.Id == _pageId) ?? Deck?.Home;

    private IReadOnlyList<DeckPage> Pages
    {
        get
        {
            if (Deck is not { } deck) return [];
            var own = deck.Pages.Select(p => p.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
            IEnumerable<DeckPage> shared = Shared is { } set ? set.Pages.Where(p => !p.IsHome && !own.Contains(p.Id)) : [];
            return
            [
                deck.Home,
                .. deck.Pages.Where(p => !p.IsHome).Concat(shared).OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase),
            ];
        }
    }

    private string Sharing(Deck deck)
    {
        var others = _decks
            .Where(d => d.Id != deck.Id && d.Columns == deck.Columns && d.Rows == deck.Rows)
            .Select(d => d.Name)
            .ToList();
        return others.Count == 0 ? "keinem weiteren Deck" : string.Join(", ", others);
    }

    protected override async Task OnSetupLoadedAsync()
    {
        _music = (await MusicQuery.HandleAsync(new GetMusic.Query()))
            .OrderBy(item => item.Display, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        Load();
    }

    private void Load()
    {
        var shared = DeckSharing.Share(Setup.DeckLibrary, Setup.PageLibrary);
        _decks = shared.Decks.Select(Copy).ToList();
        _sets = shared.Sets.ToList();
        _deckId = _decks.FirstOrDefault()?.Id ?? "";
        _pageId = DeckPage.HomeId;
        _selected = 1;
    }

    private static Deck Copy(Deck deck) => deck with
    {
        Pages = deck.Pages.Select(p => p with { Keys = p.Keys.ToList() }).ToList(),
    };

    private void OnDeckChanged(ChangeEventArgs e)
    {
        _deckId = e.Value?.ToString() ?? "";
        _pageId = DeckPage.HomeId;
        _selected = 1;
    }

    private void OnPageChanged(ChangeEventArgs e)
    {
        _pageId = e.Value?.ToString() ?? DeckPage.HomeId;
        _selected = 1;
    }

    private string Indent(DeckPage page) => page.ParentId is null ? "" : "— ";

    private static string Caption(DeckKey key) =>
        key.Label.Length > 0 ? key.Label : key.Kind == KeyKinds.Empty ? "" : KeyKinds.Label(key.Kind);

    private static string? Locked(Deck deck, DeckPage page, int number) =>
        number == deck.Panic ? "PANIC" : number == deck.Back && !page.IsHome ? "Zurück" : null;

    private static int? Number(object? value) =>
        int.TryParse(value?.ToString(), out var number) ? number : null;

    private static string Placeholder(string action) => action switch
    {
        KeyActions.VmixShow or KeyActions.VmixHide => "title:coach_home",
        KeyActions.VmixText => "title:message",
        KeyActions.LedStart => "led:tor-heim",
        _ => "",
    };

    private IReadOnlyList<(string Value, string Label)> TitleChoices(string? current) =>
        Choices(Setup.Titles.Select(title => ("title:" + title.Kind, title.Kind)), current);

    private IReadOnlyList<(string Value, string Label)> LedChoices(string? current) =>
        Choices(Setup.Led.Select(led => ("led:" + led.Event, $"{led.Event} · {Playlist(led.Command)}")), current);

    private static IReadOnlyList<(string Value, string Label)> Choices(IEnumerable<(string Value, string Label)> known, string? current)
    {
        var choices = known
            .DistinctBy(choice => choice.Value, StringComparer.OrdinalIgnoreCase)
            .OrderBy(choice => choice.Label, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        if (current is { Length: > 0 } && !choices.Any(choice => choice.Value.Equals(current, StringComparison.OrdinalIgnoreCase)))
            choices.Insert(0, (current, $"{current} (nicht mehr vorhanden)"));
        return choices;
    }

    private static string Playlist(string command) =>
        System.Text.RegularExpressions.Regex.Match(command, "-n\\s+\"([^\"]+)\"") is { Success: true } match ? match.Groups[1].Value : command;

    private void SetLabel(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? "";
        Set(k => k with { Label = text });
    }

    private void SetColor(ChangeEventArgs e)
    {
        var color = e.Value?.ToString() ?? DeckKey.DefaultColor;
        Set(k => k with { Color = color });
    }

    private int _dragFrom;

    private DotNetObjectReference<DecksTab>? _self;

    private bool Draggable(Deck deck, DeckPage page, int number) =>
        Locked(deck, page, number) is null && !page.KeyAt(number).IsEmpty;

    private bool Droppable(Deck deck, DeckPage page, int number) =>
        Locked(deck, page, number) is null && page.KeyAt(number).IsEmpty && number != _dragFrom;

    private void Drop(Deck deck, DeckPage page, int number)
    {
        var from = _dragFrom;
        _dragFrom = 0;
        if (from == 0 || !Draggable(deck, page, from) || !Droppable(deck, page, number)) return;
        var moved = page.KeyAt(from) with { Number = number };
        Replace(deck, page.With(moved).With(new DeckKey(from, KeyKinds.Empty)));
        _selected = number;
        Touch();
    }

    [JSInvokable]
    public string? CopyKey()
    {
        if (Page is not { } page) return null;
        var key = page.KeyAt(_selected);
        if (key.IsEmpty) { Notify("Die gewählte Kachel ist leer."); StateHasChanged(); return null; }
        Notify($"Taste {_selected} kopiert.");
        StateHasChanged();
        return JsonSerializer.Serialize(key, ShowJson.Pretty);
    }

    [JSInvokable]
    public void ClearKey()
    {
        if (Deck is not { } deck || Page is not { } page) return;
        if (Locked(deck, page, _selected) is not null)
        {
            Fail($"Taste {_selected} gehört fest zu PANIC oder Zurück.");
            StateHasChanged();
            return;
        }
        if (page.KeyAt(_selected).IsEmpty) return;
        Replace(deck, page.With(new DeckKey(_selected, KeyKinds.Empty)));
        Touch();
        Notify($"Taste {_selected} gelöscht.");
        StateHasChanged();
    }

    [JSInvokable]
    public void PasteKey(string? json)
    {
        if (Deck is not { } deck || Page is not { } page) return;
        if (Locked(deck, page, _selected) is not null)
        {
            Fail($"Taste {_selected} gehört fest zu PANIC oder Zurück.");
            StateHasChanged();
            return;
        }
        DeckKey? key = null;
        try { key = JsonSerializer.Deserialize<DeckKey>(json ?? "", ShowJson.Options); }
        catch (JsonException) { }
        if (key is null || !KeyKinds.All.Contains(key.Kind))
        {
            Fail("In der Zwischenablage steht keine Taste.");
            StateHasChanged();
            return;
        }
        Replace(deck, page.With(key with { Number = _selected }));
        Touch();
        Notify($"Taste {_selected} eingefügt.");
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        _self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("showAdmin.bindKeys", _self); }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("showAdmin.unbindKeys"); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }

    private void Set(Func<DeckKey, DeckKey> change)
    {
        if (Deck is not { } deck || Page is not { } page) return;
        var key = change(page.KeyAt(_selected));
        Replace(deck, page.With(key));
        Touch();
    }

    private void SetKind(string? kind)
    {
        if (kind is null) return;
        Set(k => new DeckKey(k.Number, kind, k.Label, k.Color, k.Icon,
            Steps: kind is KeyKinds.Steps or KeyKinds.Special ? k.Sequence : null,
            Live: kind == KeyKinds.Live ? k.Live ?? "" : null,
            HomeAfter: k.HomeAfter,
            Livestream: k.Livestream,
            Led: k.Led));
    }

    private void SetStep(int index, Func<KeyStep, KeyStep> change) =>
        Set(k =>
        {
            var steps = k.Sequence.ToList();
            if (index < 0 || index >= steps.Count) return k;
            steps[index] = change(steps[index]);
            return k with { Steps = steps };
        });

    private void AddStep() =>
        Set(k => k with { Steps = k.Sequence.Append(new KeyStep(KeyActions.VmixShow)).ToList() });

    private void RemoveStep(int index) =>
        Set(k =>
        {
            var steps = k.Sequence.ToList();
            if (index < 0 || index >= steps.Count) return k;
            steps.RemoveAt(index);
            return k with { Steps = steps };
        });

    private void Replace(Deck deck, DeckPage page)
    {
        if (page.IsHome || deck.Pages.Any(p => p.Id == page.Id))
        {
            var pages = deck.Pages.Select(p => p.Id == page.Id ? page : p).ToList();
            _decks = _decks.Select(d => d.Id == deck.Id ? d with { Pages = pages } : d).ToList();
            return;
        }
        Sheet(deck, set => set.With(page));
    }

    private void Sheet(Deck deck, Func<PageSet, PageSet> change)
    {
        var known = _sets.FirstOrDefault(set => set.Fits(deck));
        var updated = change(known ?? new PageSet(deck.Columns, deck.Rows, []));
        _sets = known is null
            ? [.. _sets, updated]
            : _sets.Select(set => set.Fits(deck) ? updated : set).ToList();
    }

    private void AddDeck()
    {
        if (DeckFormat.Of(_format) is not { } format) return;
        var id = $"deck-{_decks.Count + 1}";
        while (_decks.Any(d => d.Id == id)) id += "x";
        _decks = [.. _decks, format.Create(id, $"Neues {format.Name}")];
        _deckId = id;
        _pageId = DeckPage.HomeId;
        _selected = 1;
        Notify($"Deck mit {format.Label} angelegt. Die Grösse steht damit fest; die Unterseiten teilt es mit den anderen Decks dieser Grösse. Unter Hallen wird gewählt, wer es anbietet.");
        Touch();
    }

    private void RemoveDeck()
    {
        if (Deck is not { } deck || _decks.Count < 2) return;
        foreach (var page in deck.Pages.Where(p => !p.IsHome))
            Sheet(deck, set => set.Page(page.Id) is null ? set.With(page) : set);
        _decks = _decks.Where(d => d.Id != deck.Id).ToList();
        _deckId = _decks[0].Id;
        _pageId = DeckPage.HomeId;
        _selected = 1;
        Notify($"Deck „{deck.Name}“ entfernt. Hallen, die es anbieten, verlieren es beim Speichern.");
        Touch();
    }

    private void RenameDeck(ChangeEventArgs e)
    {
        if (Deck is not { } deck) return;
        var name = e.Value?.ToString() ?? "";
        if (name.Trim().Length == 0) return;
        _decks = _decks.Select(d => d.Id == deck.Id ? d with { Name = name.Trim() } : d).ToList();
        Touch();
    }

    private void SetFixed(ChangeEventArgs e, bool panic)
    {
        if (Deck is not { } deck || Number(e.Value) is not { } value) return;
        var place = Math.Clamp(value, 1, deck.Count);
        if (place == (panic ? deck.Back : deck.Panic))
        {
            Fail("PANIC und Zurück brauchen verschiedene Plätze.");
            return;
        }
        _decks = _decks
            .Select(d => d.Id == deck.Id ? (panic ? d with { PanicKey = place } : d with { BackKey = place }) : d)
            .ToList();
        Touch();
    }

    private void AddPage()
    {
        if (Deck is not { } deck) return;
        var taken = Pages.Select(p => p.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var id = $"seite-{taken.Count}";
        while (taken.Contains(id)) id += "x";
        Sheet(deck, set => set.With(new DeckPage(id, "Neue Seite", DeckPage.HomeId, [])));
        _pageId = id;
        _selected = 1;
        Notify($"Seite angelegt. Sie steht jedem Deck mit {deck.Columns} × {deck.Rows} Tasten zur Verfügung.");
        Touch();
    }

    private void RemovePage()
    {
        if (Deck is not { } deck || Page is not { } page || page.IsHome) return;
        var opens = Opens(deck, page.Id);
        if (deck.Pages.Any(p => p.Id == page.Id))
            _decks = _decks
                .Select(d => d.Id == deck.Id ? d with { Pages = d.Pages.Where(p => p.Id != page.Id).ToList() } : d)
                .ToList();
        else
            Sheet(deck, set => set.Without(page.Id));
        _pageId = DeckPage.HomeId;
        _selected = 1;
        Notify(opens == 0
            ? $"Seite „{page.Name}“ ist auf jedem Deck mit {deck.Columns} × {deck.Rows} Tasten weg."
            : $"Seite „{page.Name}“ ist weg. {(opens == 1 ? "Eine Taste zeigt" : $"{opens} Tasten zeigen")} jetzt ins Leere.");
        Touch();
    }

    private int Opens(Deck deck, string pageId) =>
        _decks.Where(d => d.Columns == deck.Columns && d.Rows == deck.Rows)
            .SelectMany(d => d.Pages)
            .Concat(Shared?.Pages ?? [])
            .SelectMany(page => page.Keys)
            .Count(key => key.PageId == pageId);

    private void RenamePage(ChangeEventArgs e)
    {
        if (Deck is not { } deck || Page is not { } page) return;
        Replace(deck, page with { Name = e.Value?.ToString() ?? page.Name });
        Touch();
    }

    private void Defaults()
    {
        var shared = DeckSharing.Share(DefaultDecks.All);
        _decks = shared.Decks.Select(Copy).ToList();
        _sets = shared.Sets.ToList();
        _deckId = _decks[0].Id;
        _pageId = DeckPage.HomeId;
        _selected = 1;
        Touch();
    }

    private async Task SaveDecksAsync() => await Guarded(async () =>
    {
        var shared = DeckSharing.Share(_decks, _sets);
        var decks = shared.Decks.Select(Checked).ToList();
        var sets = shared.Sets.Select(Checked).ToList();
        await SaveSetupAsync(setup => setup with { Decks = decks, Sheets = sets });
    });

    private static PageSet Checked(PageSet set)
    {
        try
        {
            return set.Validated();
        }
        catch (ValidationException e)
        {
            throw new ValidationException(e.Field, Spot(set) is { Length: > 0 } where ? where : e.Message);
        }
    }

    private static string Spot(PageSet set)
    {
        foreach (var page in set.Pages)
            foreach (var key in page.Keys)
            {
                try { key.Validated(set.Count); }
                catch (ValidationException e) { return $"Seite „{page.Name}“, Taste {key.Number}: {e.Message}"; }
            }
        return "";
    }

    private static Deck Checked(Deck deck)
    {
        try
        {
            return deck.Validated();
        }
        catch (ValidationException e)
        {
            throw new ValidationException(e.Field, Spot(deck) is { Length: > 0 } where ? where : $"{deck.Name}: {e.Message}");
        }
    }

    private static string Spot(Deck deck)
    {
        foreach (var page in deck.Pages)
            foreach (var key in page.Keys)
            {
                try { key.Validated(deck.Count); }
                catch (ValidationException e) { return $"{deck.Name}, Seite „{page.Name}“, Taste {key.Number}: {e.Message}"; }
            }
        return "";
    }
}
