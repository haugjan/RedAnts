@using RedAnts.Domain.Ticketing
@using RedAnts.Domain.Ticketing.Sales
@using RedAnts.Features.Ticketing.Email
@using RedAnts.Features.Ticketing.Ports
@using RedAnts.Features.Ticketing.Scanning
@inject IPublicBaseUrl PublicUrl
@inject ITicketTokens Tokens

<section class="ta-page">
    <h1 class="ta-page-title">@TicketType.EventTicket.DisplayName()</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="seasonSelect">Saison</label>
                    <select id="seasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="OnSeasonChangedAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="eventSelect">Anlass</label>
                    <select id="eventSelect" class="ta-select" disabled="@(_events.Count == 0)"
                            @bind="SelectedEventId" @bind:after="ReloadTicketsAsync">
                        @if (_events.Count == 0)
                        {
                            <option value="0">— keine Anlässe —</option>
                        }
                        else
                        {
                            @foreach (var e in _events)
                            {
                                <option value="@e.Id">@e.Date.ToString("dd.MM.yyyy") · @e.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="ticketBundleFilter">Bundle</label>
                    <select id="ticketBundleFilter" class="ta-select" @bind="_bundleFilter">
                        <option value="0">Alle anzeigen</option>
                        @foreach (var b in _bundles)
                        {
                            <option value="@b.Id">@b.Reference</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="ticketSearch">Suche</label>
                    <input id="ticketSearch" class="ta-input" type="search" placeholder="Name, E-Mail …" @bind="_search" @bind:event="oninput" />
                </div>
            </div>
            <div class="ta-toolbar-actions">
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_bundles.Count == 0)" @onclick="OpenExport">
                    Export CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_bundleFilter <= 0)"
                        title="@(_bundleFilter <= 0 ? "Zum Drucken zuerst ein Bundle wählen" : "Alle Tickets dieses Bundles als PDF drucken")"
                        @onclick="OpenBundlePrint">
                    PDF drucken
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_tickets.Count == 0)" @onclick="OpenBulk"
                        title="Die aktuell gefilterten Tickets mit E-Mail versenden">Tickets versenden</button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedEventId <= 0)" @onclick="OpenCreateBundle">
                    Bundle erstellen
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedEventId <= 0)" @onclick="OpenImport">
                    Import CSV
                </button>
                <button type="button" class="ta-btn ta-btn-primary" disabled="@(SelectedEventId <= 0)" @onclick="OpenCreate">
                    Ticket erstellen
                </button>
            </div>
        </div>

        @if (SelectedEventId <= 0)
        {
            <div class="ta-placeholder">Für diese Saison sind keine Anlässe erfasst.</div>
        }
        else if (_tickets.Count == 0)
        {
            <div class="ta-placeholder">Für diesen Anlass sind keine Tickets erfasst.</div>
        }
        else
        {
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Ticket-Nr.</th>
                            <th class="ta-th-sort" @onclick='() => Sort("buyer")'>Person <span class="ta-sort-ind">@Ind("buyer")</span></th>
                            <th>Bundle</th>
                            <th class="ta-th-sort" @onclick='() => Sort("created")'>Erstellt <span class="ta-sort-ind">@Ind("created")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("category")'>Kategorie <span class="ta-sort-ind">@Ind("category")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("price")'>Preis <span class="ta-sort-ind">@Ind("price")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("status")'>Status <span class="ta-sort-ind">@Ind("status")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("redeemed")'>Eingelöst <span class="ta-sort-ind">@Ind("redeemed")</span></th>
                            <th>Event&shy;besuche</th>
                            <th class="ta-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Sorted())
                        {
                            <tr>
                                <td>
                                    <span class="ta-ticketno">
                                        <span class="ta-no">@AdminFormat.TicketNo(t.Uuid)</span>
                                        <a class="ta-qr-link" href="@PublicUrl.TicketUrl(Tokens.CreateShort(t.Uuid))" target="_blank" rel="noopener" title="Online-Ticket" aria-label="Online-Ticket">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17 14h.01M20 14v3M14 17h.01M17 20h3M20 20h.01"/></svg>
                                        </a>
                                    </span>
                                </td>
                                <td class="ta-cell-name">
                                    <PersonCell Holder="t.Holder" />
                                    @if (t.OriginType is { } ot)
                                    {
                                        <div class="ta-conv-badge" title="Dieses Ticket entstand durch Kartenumwandlung.">↔ Umwandlung: @OriginLabel(ot)@(t.OriginCardUuid is { } cu ? " " + cu.ToString("N")[..8].ToUpperInvariant() : "")</div>
                                    }
                                </td>
                                <td>
                                    @if (t.BundleId is { } bundleId && _bundleRefById.TryGetValue(bundleId, out var bundleRef))
                                    {
                                        <span class="ta-badge ta-badge-buyer">@bundleRef</span>
                                    }
                                    else
                                    {
                                        <span class="ta-muted">—</span>
                                    }
                                </td>
                                <td class="ta-created" title="@AdminFormat.CreatedTooltip(t.CreatedAt, t.CreatedByName, t.CreatedByEmail, t.OrderId)">
                                    @AdminFormat.CreatedShort(t.CreatedAt, t.CreatedByName, t.OrderId)
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketCategory"
                                                      Value="@t.Category"
                                                      Options="@AllCategories"
                                                      Label="@(c => c.DisplayName())"
                                                      FieldLabel="Kategorie"
                                                      Save="@(c => SaveCategoryAsync(t, c))" />
                                </td>
                                <td class="ta-num">
                                    <InlineNumberEdit Value="@t.Price"
                                                      Decimals="2"
                                                      Min="0"
                                                      Prefix="CHF"
                                                      FieldLabel="Abgabepreis"
                                                      Save="@(p => SavePriceAsync(t, p))" />
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketStatus"
                                                      Value="@t.Status"
                                                      Options="@AllStatuses"
                                                      Label="@(s => s.DisplayName())"
                                                      FieldLabel="Status"
                                                      Save="@(s => SaveStatusAsync(t, s))">
                                        <Display Context="status">
                                            <span class="ta-badge ta-badge-@status.ToString().ToLowerInvariant()">@status.DisplayName()</span>
                                        </Display>
                                    </InlineSelectEdit>
                                </td>
                                <td>
                                    @if (t.Status == TicketStatus.Valid)
                                    {
                                        <InlineSelectEdit TValue="RedemptionState"
                                                          Value="@StateOf(t)"
                                                          Options="@AllRedemptionStates"
                                                          Label="@RedemptionLabel"
                                                          FieldLabel="Eingelöst"
                                                          Save="@(s => SaveRedemptionAsync(t, s))">
                                            <Display Context="state">
                                                <span class="ta-badge @RedemptionBadge(state)">@RedemptionLabel(state)</span>
                                            </Display>
                                        </InlineSelectEdit>
                                    }
                                    else
                                    {
                                        <span class="ta-badge ta-badge-draft">Offen</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="ta-visits-link" @onclick="() => _visitsFor = t">Besuche</button>
                                </td>
                                <td class="ta-col-actions">
                                    <button type="button" class="ta-icon-btn" title="@(HasEmail(t) ? "E-Mail senden" : "Keine E-Mail hinterlegt")" disabled="@(!HasEmail(t))" @onclick="() => OpenMail(t)">✉</button>
                                    <button type="button" class="ta-icon-btn" title="Bearbeiten" @onclick="() => OpenEdit(t)">✎</button>
                                    <button type="button" class="ta-icon-btn" title="Als PDF drucken" @onclick="() => OpenSinglePrint(t.Uuid)">🖨</button>
                                    @if (Identity?.IsAdmin == true)
                                    {
                                        <button type="button" class="ta-icon-btn ta-icon-btn-danger" title="Löschen" @onclick="() => _deleteTarget = t">🗑</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="ta-summary">
                @_tickets.Count Tickets · @_tickets.Count(t => StateOf(t) == RedemptionState.Redeemed) eingelöst
                · @_tickets.Count(t => StateOf(t) == RedemptionState.Outside) draussen
                · @_tickets.Count(t => StateOf(t) == RedemptionState.Open) offen
            </p>
        }
    }
</section>

@if (_showCreate)
{
    <div class="ta-overlay" @onmousedown="CloseCreate">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Ticket erstellen</h2>
            <PersonEditor Model="_newPerson" Prefix="newEt" EmailHint=" (optional, für den Ticketversand)" />
            <div class="ta-field">
                <label class="ta-label" for="newCategory">Kategorie</label>
                <select id="newCategory" class="ta-select" @bind="_newCategory">
                    @foreach (var cat in Enum.GetValues<TicketCategory>())
                    {
                        <option value="@cat">@cat.DisplayName()</option>
                    }
                </select>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newPrice">Abgabepreis (CHF)</label>
                <input id="newPrice" type="number" step="0.01" min="0" class="ta-input" @bind="_newPrice" @bind:after="OnNewPriceChanged" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newTicketPaymentSource">Zahlart</label>
                <select id="newTicketPaymentSource" class="ta-select" @bind="_newPaymentSource">
                    @foreach (var ps in PaymentSourceExtensions.AdminChoicesForPrice(_newPrice))
                    {
                        <option value="@ps">@ps.DisplayName()</option>
                    }
                </select>
            </div>
            @if (_createError is not null)
            {
                <p class="ta-modal-error">@_createError</p>
            }
            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseCreate">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="CreateTicketAsync">Erstellen</button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="ta-overlay" @onmousedown="CancelEdit">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Ticket bearbeiten</h2>
            <p class="ta-modal-sub">Ticket-Nr. @AdminFormat.TicketNo(_editing.Uuid)</p>

            <div class="ta-field">
                <label class="ta-label" for="editCategory">Kategorie</label>
                <select id="editCategory" class="ta-select" @bind="_editCategory">
                    @foreach (var cat in Enum.GetValues<TicketCategory>())
                    {
                        <option value="@cat">@cat.DisplayName()</option>
                    }
                </select>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editPrice">Preis (CHF)</label>
                <input id="editPrice" type="number" step="0.01" min="0" class="ta-input" @bind="_editPrice" @bind:after="() => _editPrice = decimal.Round(_editPrice, 2)" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editStatus">Status</label>
                <select id="editStatus" class="ta-select" @bind="_editStatus">
                    <option value="@TicketStatus.Valid">Gültig</option>
                    <option value="@TicketStatus.Cancelled">Storniert</option>
                </select>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editRedeemed">Eingelöst</label>
                <select id="editRedeemed" class="ta-select" @bind="_editRedeemed" disabled="@(_editStatus == TicketStatus.Cancelled)">
                    <option value="false">Offen</option>
                    <option value="true">Eingelöst</option>
                </select>
                <p class="ta-field-hint">Ein storniertes Ticket kann nicht eingelöst sein.</p>
            </div>

            <PersonEditor Model="_editPerson" Prefix="editEt" EmailHint=" (für den Ticketversand)" />

            @if (_editError is not null)
            {
                <p class="ta-modal-error">@_editError</p>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CancelEdit" disabled="@_saving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SaveEdit" disabled="@_saving">
                    @(_saving ? "Speichert …" : "Speichern")
                </button>
            </div>
        </div>
    </div>
}

@if (_visitsFor is not null)
{
    <VisitsOverlay Uuid="@_visitsFor.Uuid"
                   Title="@($"Spielticket {AdminFormat.TicketNo(_visitsFor.Uuid)}")"
                   OnClose="() => _visitsFor = null" />
}

@if (_deleteTarget is not null)
{
    <ConfirmDialog Title="Ticket löschen"
                   Message="@($"Ticket {AdminFormat.TicketNo(_deleteTarget.Uuid)} endgültig löschen? Das kann nicht rückgängig gemacht werden.")"
                   ConfirmLabel="Löschen" Danger="true" Busy="_deleteBusy" Error="@_deleteError"
                   OnConfirm="DeleteConfirmedAsync" OnCancel="CancelDelete" />
}

@if (_showCreateBundle)
{
    <div class="ta-overlay" @onmousedown="CloseCreateBundle">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Ticket-Bundle erstellen</h2>
            <div class="ta-field">
                <label class="ta-label">Anlass</label>
                <div class="ta-readonly">@_selectedEventName</div>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="bundleCategory">Ticketkategorie</label>
                <select id="bundleCategory" class="ta-select" @bind="_bundleCategory">
                    @foreach (var cat in AllCategories)
                    {
                        <option value="@cat">@cat.DisplayName()</option>
                    }
                </select>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="bundleReference">Bundlename</label>
                <input id="bundleReference" class="ta-input" type="text" maxlength="50" placeholder="z. B. Sponsoren 2026" @bind="_bundleReference" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="bundleQuantity">Anzahl Tickets</label>
                <input id="bundleQuantity" class="ta-input" type="number" min="1" max="1000" @bind="_bundleQuantity" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="bundlePaymentSource">Zahlart</label>
                <select id="bundlePaymentSource" class="ta-select" @bind="_bundlePaymentSource">
                    @foreach (var ps in PaymentSourceExtensions.AdminChoicesForPrice(0m))
                    {
                        <option value="@ps">@ps.DisplayName()</option>
                    }
                </select>
            </div>
            @if (_bundleError is not null)
            {
                <p class="ta-modal-error">@_bundleError</p>
            }
            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseCreateBundle" disabled="@_bundleSaving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="CreateBundleAsync" disabled="@_bundleSaving">
                    @(_bundleSaving ? "Wird erstellt …" : "Bundle erstellen")
                </button>
            </div>
        </div>
    </div>
}

@if (_showImport)
{
    <div class="ta-overlay" @onmousedown="CloseImport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Spieltickets importieren</h2>

            <div class="ta-field">
                <label class="ta-label">Anlass</label>
                <div class="ta-readonly">@_selectedEventName</div>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="impEventCategory">Kategorie (Vorauswahl, Datei kann überschreiben)</label>
                <select id="impEventCategory" class="ta-select" @bind="_importCategory">
                    @foreach (var c in MainCategories)
                    {
                        <option value="@c">@c.DisplayName()</option>
                    }
                </select>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="impEventReference">Bundle</label>
                <input id="impEventReference" class="ta-input" type="text" maxlength="50" list="eventImportBundleOptions" placeholder="z. B. Sponsoren 2026" @bind="_importReference" />
                <datalist id="eventImportBundleOptions">
                    @foreach (var b in _bundles) { <option value="@b.Reference" /> }
                </datalist>
                <p class="ta-hint">Gilt für Zeilen ohne eigene Bundle-Spalte; eine Bundle-Spalte in der Datei hat Vorrang.</p>
            </div>

            <div class="ta-field">
                <label class="ta-label">Datei (CSV oder Excel)</label>
                <InputFile OnChange="OnImportFileAsync" accept=".csv,.xlsx,text/csv" />
                <p class="ta-hint">
                    Spalten (alle optional): Karten-Nr, Bundle, Kategorie, Firma, Anrede, Name, Vorname, Strasse, Adresszusatz, PLZ, Ort, Land, E-Mail, Telefon, Geburtsdatum (dd.MM.yyyy).
                    Die Spalten werden automatisch erkannt; passt die Zuordnung nicht, unten von Hand anpassen.
                    Zeilen mit bestehender Ticket-Nr werden aktualisiert.
                    <a href="/admin/event-tickets/example.csv" target="_blank" rel="noopener">Beispieldatei herunterladen</a>
                </p>
            </div>

            @if (_importTable is not null && _importTable.Columns.Count > 0)
            {
                <div class="ta-field">
                    @if (!_showMapping)
                    {
                        <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => _showMapping = true">Spaltenzuordnung anpassen</button>
                    }
                    else
                    {
                        <label class="ta-label">Spaltenzuordnung</label>
                        <p class="ta-hint">Ordne jeder benötigten Spalte eine Spalte aus deiner Datei zu.</p>
                        <table class="ta-map">
                            @foreach (var field in TicketImportCsv.Fields)
                            {
                                <tr>
                                    <td class="ta-map-label">@field.Label</td>
                                    <td>
                                        <select class="ta-select" value="@MapValue(field.Key)" @onchange="e => SetMap(field.Key, e.Value?.ToString())">
                                            <option value="-1">(nicht zuordnen)</option>
                                            @for (var i = 0; i < _importTable.Columns.Count; i++)
                                            {
                                                var idx = i;
                                                <option value="@idx">@_importTable.Columns[idx]</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </table>
                        <div class="ta-modal-actions">
                            <button type="button" class="ta-btn ta-btn-primary" @onclick="ApplyMapping">Zuordnung übernehmen</button>
                        </div>
                    }
                </div>
            }

            @if (_importFileName is not null)
            {
                <div class="ta-parse">
                    <strong>@_importFileName</strong>: @_importRows.Count gültige Zeile@(_importRows.Count == 1 ? "" : "n") erkannt.
                    @if (_importWarnings.Count > 0)
                    {
                        <ul class="ta-warnings">
                            @foreach (var w in _importWarnings) { <li>@w</li> }
                        </ul>
                    }
                </div>
                @if (_importErrors.Count > 0)
                {
                    <div class="ta-error">
                        @_importErrors.Count Fehler, bitte in der Datei korrigieren:
                        <ul class="ta-warnings">
                            @foreach (var er in _importErrors) { <li>@er</li> }
                        </ul>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(_importError)) { <div class="ta-error">@_importError</div> }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseImport" disabled="@_importSaving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="RunImportAsync" disabled="@(_importSaving || _importRows.Count == 0 || _importErrors.Count > 0)">
                    @(_importSaving ? "Wird importiert …" : _importErrors.Count > 0 ? "Bitte Fehler beheben" : $"{_importRows.Count} Spieltickets importieren")
                </button>
            </div>
        </div>
    </div>
}

@if (_showExport)
{
    <div class="ta-overlay" @onmousedown="CloseExport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Spieltickets exportieren</h2>
            <p class="ta-modal-sub">Bundle wählen (Mehrfachauswahl möglich).</p>
            @if (_bundles.Count == 0)
            {
                <p class="ta-muted-text">Für diesen Anlass sind keine Bundles erfasst.</p>
            }
            else
            {
                <div class="ta-export-list">
                    @foreach (var b in _bundles)
                    {
                        <label class="ta-export-item">
                            <input type="checkbox" checked="@_exportSel.Contains(b.Id)"
                                   @onchange="e => ToggleExport(b.Id, (bool)(e.Value ?? false))" />
                            @b.Reference · @b.Category.DisplayName() · @b.TicketCount Stk.
                        </label>
                    }
                </div>
            }
            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseExport">Schliessen</button>
                @if (_exportSel.Count > 0)
                {
                    <a class="ta-btn ta-btn-primary" href="/admin/event-tickets/tickets.csv?ids=@string.Join(",", _exportSel)"
                       target="_blank" rel="noopener" @onclick="CloseExport">Herunterladen</a>
                }
            </div>
        </div>
    </div>
}

@if (_showPrint)
{
    <TicketPrintDialog Type="TicketType.EventTicket"
                       Title="Spieltickets als PDF drucken"
                       Subtitle="@_printSubtitle"
                       Layout="_printLayout"
                       OnClose="ClosePrint">
        <HiddenInputs>
            @if (_printUuid is { } u)
            {
                <input type="hidden" name="uuid" value="@u" />
            }
            else if (_printBundleId is { } b)
            {
                <input type="hidden" name="bundleId" value="@b" />
            }
        </HiddenInputs>
    </TicketPrintDialog>
}

@if (_mailFor is not null)
{
    <div class="ta-overlay" @onmousedown="CloseMail">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Spielticket senden</h2>
            <p class="ta-modal-sub">@(_mailFor.Holder?.DisplayName ?? AdminFormat.TicketNo(_mailFor.Uuid)) · @_mailFor.Holder?.Email</p>

            <div class="ta-field">
                <label class="ta-label" for="etMailSubject">Betreff</label>
                <input id="etMailSubject" class="ta-input" type="text" maxlength="200" @bind="_mailSubject" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="etMailBody">Text</label>
                <textarea id="etMailBody" class="ta-input ta-textarea" @bind="_mailBody"></textarea>
                <p class="ta-hint">Platzhalter: {Name}, {Anlass}, {Datum}. Markdown wird unterstützt. QR-Code, Online-Ticket und PDF-Link werden automatisch angehängt.</p>
            </div>

            @if (_mailSent) { <div class="ta-flash">E-Mail wurde in den Versand gegeben.</div> }
            @if (!string.IsNullOrEmpty(_mailError)) { <div class="ta-modal-error">@_mailError</div> }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseMail" disabled="@_mailSending">Schliessen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SendMail" disabled="@(_mailSending || _mailSent)">
                    @(_mailSent ? "Gesendet ✓" : _mailSending ? "Sendet …" : "Senden")
                </button>
            </div>
        </div>
    </div>
}

@if (_showBulk)
{
    <div class="ta-overlay" @onmousedown="CloseBulk">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Spieltickets versenden</h2>

            @if (_bulkResult is not null)
            {
                <div class="ta-flash">@_bulkResult.Enqueued Ticket@(_bulkResult.Enqueued == 1 ? "" : "s") eingereiht@(_bulkResult.Failed > 0 ? $", {_bulkResult.Failed} fehlgeschlagen" : "").</div>
                @if (_bulkResult.NoEmail > 0)
                {
                    <p class="ta-hint">@_bulkResult.NoEmail Ticket@(_bulkResult.NoEmail == 1 ? "" : "s") ohne E-Mail übersprungen.</p>
                }
                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="CloseBulk">Schliessen</button>
                </div>
            }
            else
            {
                <p class="ta-hint">@BulkWithEmail Ticket@(BulkWithEmail == 1 ? "" : "s") mit E-Mail werden versendet · @BulkWithoutEmail ohne E-Mail werden übersprungen. Grundlage ist die aktuelle Filterung (@(_bundleFilter > 0 ? "gewähltes Bundle" : "alle Bundles")).</p>

                <div class="ta-field">
                    <label class="ta-label" for="etBulkSubject">Betreff</label>
                    <input id="etBulkSubject" class="ta-input" type="text" maxlength="200" @bind="_bulkSubject" />
                </div>
                <div class="ta-field">
                    <label class="ta-label" for="etBulkBody">Text</label>
                    <textarea id="etBulkBody" class="ta-input ta-textarea" @bind="_bulkBody"></textarea>
                    <p class="ta-hint">Platzhalter: {Name}, {Anlass}, {Datum}. Markdown wird unterstützt. QR-Code, Online-Ticket und PDF-Link werden je Ticket angehängt.</p>
                </div>

                @if (!string.IsNullOrEmpty(_bulkError)) { <div class="ta-modal-error">@_bulkError</div> }

                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseBulk" disabled="@_bulkSending">Abbrechen</button>
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="SendBulk" disabled="@(_bulkSending || BulkWithEmail == 0)">
                        @(_bulkSending ? "Sendet …" : $"{BulkWithEmail} Tickets senden")
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string AdminUser { get; set; } = "";
    [CascadingParameter] public AdminIdentity? Identity { get; set; }

    [Inject] private ISeasons Seasons { get; set; } = default!;
