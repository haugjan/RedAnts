    [Inject] private IAdmissionService Admission { get; set; } = default!;
    [Inject] private IAdminOrderFactory OrderFactory { get; set; } = default!;
    [Inject] private IAdminTicketDeletion Deletion { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;
    [Inject] private ITicketPrintSettings PrintSettings { get; set; } = default!;
    [Inject] private IEventTicketMailer Mailer { get; set; } = default!;

    private EventTicket? _mailFor;
    private string _mailSubject = "";
    private string _mailBody = "";
    private bool _mailSending;
    private bool _mailSent;
    private string? _mailError;

    private static bool HasEmail(EventTicket t) => !string.IsNullOrWhiteSpace(t.Holder?.Email);

    private void OpenMail(EventTicket t)
    {
        _mailFor = t;
        _mailSubject = Mailer.DefaultSubject;
        _mailBody = Mailer.DefaultBody;
        _mailSent = false;
        _mailError = null;
    }

    private void CloseMail() { if (!_mailSending) { _mailFor = null; _mailError = null; } }

    private async Task SendMail()
    {
        if (_mailFor is null) return;
        _mailSending = true;
        _mailError = null;
        try
        {
            var result = await SendOneAsync(_mailFor, _mailSubject, _mailBody);
            if (result.Success) { _mailSent = true; await Task.Delay(1400); _mailFor = null; }
            else _mailError = result.Error;
        }
        finally { _mailSending = false; }
    }

    private Task<EmailSendResult> SendOneAsync(EventTicket t, string subject, string body) =>
        Mailer.SendAsync(new EventMailTicket(t.Uuid, t.Holder?.Email, t.Holder?.DisplayName, t.EventId,
            t.Category.DisplayName()), subject, body);

    private bool _showBulk;
    private bool _bulkSending;
    private string _bulkSubject = "";
    private string _bulkBody = "";
    private string? _bulkError;
    private BulkResult? _bulkResult;
    private sealed record BulkResult(int Enqueued, int Failed, int NoEmail);

    private int BulkWithEmail => Filtered().Count(HasEmail);
    private int BulkWithoutEmail => Filtered().Count(t => !HasEmail(t));

    private void OpenBulk()
    {
        _bulkSubject = Mailer.DefaultSubject;
        _bulkBody = Mailer.DefaultBody;
        _bulkResult = null;
        _bulkError = null;
        _showBulk = true;
    }

    private void CloseBulk() { if (!_bulkSending) _showBulk = false; }

    private async Task SendBulk()
    {
        _bulkSending = true;
        _bulkError = null;
        try
        {
            int enqueued = 0, failed = 0, noEmail = 0;
            foreach (var t in Filtered().ToList())
            {
                if (!HasEmail(t)) { noEmail++; continue; }
                var r = await SendOneAsync(t, _bulkSubject, _bulkBody);
                if (r.Success) enqueued++; else failed++;
            }
            _bulkResult = new BulkResult(enqueued, failed, noEmail);
        }
        finally { _bulkSending = false; }
    }

    private bool _showPrint;
    private TicketPrintLayout _printLayout = TicketPrintLayout.Default;
    private int? _printBundleId;
    private Guid? _printUuid;
    private string _printSubtitle = "";

    private async Task OpenBundlePrint()
    {
        if (_bundleFilter <= 0) return;
        var bundle = _bundles.FirstOrDefault(b => b.Id == _bundleFilter);
        _printBundleId = _bundleFilter;
        _printUuid = null;
        _printSubtitle = bundle is null ? "" : $"{bundle.Reference} · {bundle.TicketCount} Tickets · eine Seite pro Ticket";
        _printLayout = await PrintSettings.GetAsync(TicketType.EventTicket);
