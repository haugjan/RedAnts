@using RedAnts.Ticketing.Domain
@using RedAnts.Ticketing.Domain.Sales

<section class="ta-page">
    <h1 class="ta-page-title">@TicketType.EventTicket.DisplayName()</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="seasonSelect">Saison</label>
                    <select id="seasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="OnSeasonChangedAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="eventSelect">Anlass</label>
                    <select id="eventSelect" class="ta-select" disabled="@(_events.Count == 0)"
                            @bind="SelectedEventId" @bind:after="ReloadTicketsAsync">
                        @if (_events.Count == 0)
                        {
                            <option value="0">— keine Anlässe —</option>
                        }
                        else
                        {
                            @foreach (var e in _events)
                            {
                                <option value="@e.Id">@e.Date.ToString("dd.MM.yyyy") · @e.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="ticketBundleFilter">Bundle</label>
                    <select id="ticketBundleFilter" class="ta-select" @bind="_bundleFilter" @bind:after="ReloadTicketsAsync">
                        <option value="0">Alle anzeigen</option>
                        @foreach (var b in _result.Bundles)
                        {
                            <option value="@b.Id">@b.Reference</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="ticketSearch">Suche</label>
                    <input id="ticketSearch" class="ta-input" type="search" placeholder="Name, E-Mail …" @bind="_search" @bind:event="oninput" @bind:after="SearchAsync" />
                </div>
            </div>
            <div class="ta-toolbar-actions">
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_result.Bundles.Count == 0)" @onclick="OpenExport">
                    Export CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_bundleFilter <= 0)"
                        title="@(_bundleFilter <= 0 ? "Zum Drucken zuerst ein Bundle wählen" : "Alle Tickets dieses Bundles als PDF drucken")"
                        @onclick="OpenBundlePrint">
                    PDF drucken
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_result.Tickets.Count == 0)" @onclick="() => _showBulk = true"
                        title="Die aktuell gefilterten Tickets mit E-Mail versenden">Tickets versenden</button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedEventId <= 0)" @onclick="() => _showCreateBundle = true">
                    Bundle erstellen
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedEventId <= 0)" @onclick="OpenImport">
                    Import CSV
                </button>
                <button type="button" class="ta-btn ta-btn-primary" disabled="@(SelectedEventId <= 0)" @onclick="() => _showCreate = true">
                    Ticket erstellen
                </button>
            </div>
        </div>

        @if (SelectedEventId <= 0)
        {
            <div class="ta-placeholder">Für diese Saison sind keine Anlässe erfasst.</div>
        }
        else if (_result.Total == 0)
        {
            <div class="ta-placeholder">Für diesen Anlass sind keine Tickets erfasst.</div>
        }
        else
        {
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Ticket-Nr.</th>
                            <th class="ta-th-sort" @onclick='() => Sort("buyer")'>Person <span class="ta-sort-ind">@Ind("buyer")</span></th>
                            <th>Bundle</th>
                            <th class="ta-th-sort" @onclick='() => Sort("created")'>Erstellt <span class="ta-sort-ind">@Ind("created")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("category")'>Kategorie <span class="ta-sort-ind">@Ind("category")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("price")'>Preis <span class="ta-sort-ind">@Ind("price")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("status")'>Status <span class="ta-sort-ind">@Ind("status")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("redeemed")'>Eingelöst <span class="ta-sort-ind">@Ind("redeemed")</span></th>
                            <th>Event&shy;besuche</th>
                            <th class="ta-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Sorted())
                        {
                            <tr>
                                <td>
                                    <span class="ta-ticketno">
                                        <span class="ta-no">@AdminFormat.TicketNo(t.Uuid)</span>
                                        <a class="ta-qr-link" href="@t.Link" target="_blank" rel="noopener" title="Online-Ticket" aria-label="Online-Ticket">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17 14h.01M20 14v3M14 17h.01M17 20h3M20 20h.01"/></svg>
                                        </a>
                                    </span>
                                </td>
                                <td class="ta-cell-name">
                                    <PersonCell Holder="t.Holder" />
                                    @if (t.OriginType is { } ot)
                                    {
                                        <div class="ta-conv-badge" title="Dieses Ticket entstand durch Kartenumwandlung.">↔ Umwandlung: @OriginLabel(ot)@(t.OriginCardUuid is { } cu ? " " + cu.ToString("N")[..8].ToUpperInvariant() : "")</div>
                                    }
                                </td>
                                <td>
                                    @if (t.BundleReference is { } bundleRef)
                                    {
                                        <span class="ta-badge ta-badge-buyer">@bundleRef</span>
                                    }
                                    else
                                    {
                                        <span class="ta-muted">—</span>
                                    }
                                </td>
                                <td class="ta-created" title="@AdminFormat.CreatedTooltip(t.CreatedAt, t.CreatedByName, t.CreatedByEmail, t.OrderId)">
                                    @AdminFormat.CreatedShort(t.CreatedAt, t.CreatedByName, t.OrderId)
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketCategory"
                                                      Value="@t.Category"
                                                      Options="@AllCategories"
                                                      Label="@(c => c.DisplayName())"
                                                      FieldLabel="Kategorie"
                                                      Save="@(c => SaveCategoryAsync(t, c))" />
                                </td>
                                <td class="ta-num">
                                    <InlineNumberEdit Value="@t.Price"
                                                      Decimals="2"
                                                      Min="0"
                                                      Prefix="CHF"
                                                      FieldLabel="Abgabepreis"
                                                      Save="@(p => SavePriceAsync(t, p))" />
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketStatus"
                                                      Value="@t.Status"
                                                      Options="@AllStatuses"
                                                      Label="@(s => s.DisplayName())"
                                                      FieldLabel="Status"
                                                      Save="@(s => SaveStatusAsync(t, s))">
                                        <Display Context="status">
                                            <span class="ta-badge ta-badge-@status.ToString().ToLowerInvariant()">@status.DisplayName()</span>
                                        </Display>
                                    </InlineSelectEdit>
                                </td>
                                <td>
                                    @if (t.Status == TicketStatus.Valid)
                                    {
                                        <InlineSelectEdit TValue="RedemptionState"
                                                          Value="@t.Redemption"
                                                          Options="@AllRedemptionStates"
                                                          Label="@RedemptionLabel"
                                                          FieldLabel="Eingelöst"
                                                          Save="@(s => SaveRedemptionAsync(t, s))">
                                            <Display Context="state">
                                                <span class="ta-badge @RedemptionBadge(state)">@RedemptionLabel(state)</span>
                                            </Display>
                                        </InlineSelectEdit>
                                    }
                                    else
                                    {
                                        <span class="ta-badge ta-badge-draft">Offen</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="ta-visits-link" @onclick="() => _visitsFor = t">Besuche</button>
                                </td>
                                <td class="ta-col-actions">
                                    <button type="button" class="ta-icon-btn" title="@(HasEmail(t) ? "E-Mail senden" : "Keine E-Mail hinterlegt")" disabled="@(!HasEmail(t))" @onclick="() => _mailFor = t">✉</button>
                                    <button type="button" class="ta-icon-btn" title="Bearbeiten" @onclick="() => _editing = t">✎</button>
                                    <button type="button" class="ta-icon-btn" title="Als PDF drucken" @onclick="() => OpenSinglePrint(t.Uuid)">🖨</button>
                                    @if (Identity?.IsAdmin == true)
                                    {
                                        <button type="button" class="ta-icon-btn ta-icon-btn-danger" title="Löschen" @onclick="() => _deleteTarget = t">🗑</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_result.Tickets.Count == 0)
            {
                <div class="ta-placeholder">Keine Tickets passen zum Filter.</div>
            }
            <p class="ta-summary">
                @_result.Total Tickets · @_result.RedeemedCount eingelöst
                · @_result.OutsideCount draussen
                · @_result.OpenCount offen
            </p>
        }
    }
</section>

@if (_showCreate)
{
    <CreateEventTicketDialog EventId="SelectedEventId"
                             AdminUser="@AdminUser"
                             OnSaved="CreatedAsync"
                             OnClosed="() => _showCreate = false" />
}

@if (_editing is not null)
{
    <EditEventTicketDialog Ticket="_editing"
                           OnSaved="EditedAsync"
                           OnClosed="() => _editing = null" />
}

@if (_visitsFor is not null)
{
    <VisitsOverlay Uuid="@_visitsFor.Uuid"
                   Title="@($"Spielticket {AdminFormat.TicketNo(_visitsFor.Uuid)}")"
                   OnClose="() => _visitsFor = null" />
}

@if (_deleteTarget is not null)
{
    <ConfirmDialog Title="Ticket löschen"
                   Message="@($"Ticket {AdminFormat.TicketNo(_deleteTarget.Uuid)} endgültig löschen? Das kann nicht rückgängig gemacht werden.")"
                   ConfirmLabel="Löschen" Danger="true" Busy="_deleteBusy" Error="@_deleteError"
                   OnConfirm="DeleteConfirmedAsync" OnCancel="CancelDelete" />
}

@if (_showCreateBundle)
{
    <CreateEventTicketBundleDialog EventId="SelectedEventId"
                                   EventName="@_selectedEventName"
                                   AdminUser="@AdminUser"
                                   OnSaved="BundleCreatedAsync"
                                   OnClosed="() => _showCreateBundle = false" />
}

@if (_showImport)
{
    <div class="ta-overlay" @onmousedown="CloseImport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Spieltickets importieren</h2>

            <div class="ta-field">
                <label class="ta-label">Anlass</label>
                <div class="ta-readonly">@_selectedEventName</div>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="impEventCategory">Kategorie (Vorauswahl, Datei kann überschreiben)</label>
                <select id="impEventCategory" class="ta-select" @bind="_importCategory">
                    @foreach (var c in MainCategories)
                    {
                        <option value="@c">@c.DisplayName()</option>
                    }
                </select>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="impEventReference">Bundle</label>
                <input id="impEventReference" class="ta-input" type="text" maxlength="50" list="eventImportBundleOptions" placeholder="z. B. Sponsoren 2026" @bind="_importReference" />
                <datalist id="eventImportBundleOptions">
                    @foreach (var b in _result.Bundles) { <option value="@b.Reference" /> }
                </datalist>
                <p class="ta-hint">Gilt für Zeilen ohne eigene Bundle-Spalte; eine Bundle-Spalte in der Datei hat Vorrang.</p>
            </div>

            <div class="ta-field">
                <label class="ta-label">Datei (CSV oder Excel)</label>
                <InputFile OnChange="OnImportFileAsync" accept=".csv,.xlsx,text/csv" />
                <p class="ta-hint">
                    Spalten (alle optional): Karten-Nr, Bundle, Kategorie, Firma, Anrede, Name, Vorname, Strasse, Adresszusatz, PLZ, Ort, Land, E-Mail, Telefon, Geburtsdatum (dd.MM.yyyy).
                    Die Spalten werden automatisch erkannt; passt die Zuordnung nicht, unten von Hand anpassen.
                    Zeilen mit bestehender Ticket-Nr werden aktualisiert.
                    <a href="/admin/event-tickets/example.csv" target="_blank" rel="noopener">Beispieldatei herunterladen</a>
                </p>
            </div>

            @if (_importTable is not null && _importTable.Columns.Count > 0)
            {
                <div class="ta-field">
                    @if (!_showMapping)
                    {
                        <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => _showMapping = true">Spaltenzuordnung anpassen</button>
                    }
                    else
                    {
                        <label class="ta-label">Spaltenzuordnung</label>
                        <p class="ta-hint">Ordne jeder benötigten Spalte eine Spalte aus deiner Datei zu.</p>
                        <table class="ta-map">
                            @foreach (var field in TicketImportCsv.Fields)
                            {
                                <tr>
                                    <td class="ta-map-label">@field.Label</td>
                                    <td>
                                        <select class="ta-select" value="@MapValue(field.Key)" @onchange="e => SetMap(field.Key, e.Value?.ToString())">
                                            <option value="-1">(nicht zuordnen)</option>
                                            @for (var i = 0; i < _importTable.Columns.Count; i++)
                                            {
                                                var idx = i;
                                                <option value="@idx">@_importTable.Columns[idx]</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </table>
                        <div class="ta-modal-actions">
                            <button type="button" class="ta-btn ta-btn-primary" @onclick="ApplyMapping">Zuordnung übernehmen</button>
                        </div>
                    }
                </div>
            }

            @if (_importFileName is not null)
            {
                <div class="ta-parse">
                    <strong>@_importFileName</strong>: @_importRows.Count gültige Zeile@(_importRows.Count == 1 ? "" : "n") erkannt.
                    @if (_importWarnings.Count > 0)
                    {
                        <ul class="ta-warnings">
                            @foreach (var w in _importWarnings) { <li>@w</li> }
                        </ul>
                    }
                </div>
                @if (_importErrors.Count > 0)
                {
                    <div class="ta-error">
                        @_importErrors.Count Fehler, bitte in der Datei korrigieren:
                        <ul class="ta-warnings">
                            @foreach (var er in _importErrors) { <li>@er</li> }
                        </ul>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(_importError)) { <div class="ta-error">@_importError</div> }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseImport" disabled="@_importSaving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="RunImportAsync" disabled="@(_importSaving || _importRows.Count == 0 || _importErrors.Count > 0)">
                    @(_importSaving ? "Wird importiert …" : _importErrors.Count > 0 ? "Bitte Fehler beheben" : $"{_importRows.Count} Spieltickets importieren")
                </button>
            </div>
        </div>
    </div>
}

@if (_showExport)
{
    <div class="ta-overlay" @onmousedown="CloseExport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Spieltickets exportieren</h2>
            <p class="ta-modal-sub">Bundle wählen (Mehrfachauswahl möglich).</p>
            @if (_result.Bundles.Count == 0)
            {
                <p class="ta-muted-text">Für diesen Anlass sind keine Bundles erfasst.</p>
            }
            else
            {
                <div class="ta-export-list">
                    @foreach (var b in _result.Bundles)
                    {
                        <label class="ta-export-item">
                            <input type="checkbox" checked="@_exportSel.Contains(b.Id)"
                                   @onchange="e => ToggleExport(b.Id, (bool)(e.Value ?? false))" />
                            @b.Reference · @b.Category.DisplayName() · @b.TicketCount Stk.
                        </label>
                    }
                </div>
            }
            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseExport">Schliessen</button>
                @if (_exportSel.Count > 0)
                {
                    <a class="ta-btn ta-btn-primary" href="/admin/event-tickets/tickets.csv?ids=@string.Join(",", _exportSel)"
                       target="_blank" rel="noopener" @onclick="CloseExport">Herunterladen</a>
                }
            </div>
        </div>
    </div>
}

@if (_showPrint)
{
    <TicketPrintDialog Type="TicketType.EventTicket"
                       Title="Spieltickets als PDF drucken"
                       Subtitle="@_printSubtitle"
                       Layout="_printLayout"
                       OnClose="ClosePrint">
        <HiddenInputs>
            @if (_printUuid is { } u)
            {
                <input type="hidden" name="uuid" value="@u" />
            }
            else if (_printBundleId is { } b)
            {
                <input type="hidden" name="bundleId" value="@b" />
            }
        </HiddenInputs>
    </TicketPrintDialog>
}

@if (_mailFor is not null)
{
    <SendEventTicketMailDialog Ticket="_mailFor" OnClosed="() => _mailFor = null" />
}

@if (_showBulk)
{
    <SendEventTicketMailsDialog Tickets="_result.Tickets"
                                BundleSelected="_bundleFilter > 0"
                                OnClosed="() => _showBulk = false" />
}

@code {
    [Parameter] public string AdminUser { get; set; } = "";
    [CascadingParameter] public AdminIdentity? Identity { get; set; }

    [Inject] private GetSeasonChoices.Handler SeasonChoices { get; set; } = default!;
    [Inject] private GetEventsForAdmin.Handler EventsForAdmin { get; set; } = default!;
    [Inject] private GetEventTicketsForAdmin.Handler TicketList { get; set; } = default!;
    [Inject] private GetTicketPrintSettings.Handler PrintSettings { get; set; } = default!;
    [Inject] private ScanTicket.Handler TicketScans { get; set; } = default!;
    [Inject] private EditEventTicket.Handler TicketEdits { get; set; } = default!;
    [Inject] private DeleteEventTicket.Handler TicketDeletions { get; set; } = default!;
    [Inject] private ImportEventTickets.Handler TicketImports { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;

    private EventTicketRow? _mailFor;

    private static bool HasEmail(EventTicketRow t) => !string.IsNullOrWhiteSpace(t.Holder?.Email);

    private bool _showBulk;

    private bool _showPrint;
    private TicketPrintLayout _printLayout = TicketPrintLayout.Default;
    private int? _printBundleId;
    private Guid? _printUuid;
    private string _printSubtitle = "";

    private async Task OpenBundlePrint()
    {
        if (_bundleFilter <= 0) return;
        var bundle = _result.Bundles.FirstOrDefault(b => b.Id == _bundleFilter);
        _printBundleId = _bundleFilter;
        _printUuid = null;
        _printSubtitle = bundle is null ? "" : $"{bundle.Reference} · {bundle.TicketCount} Tickets · eine Seite pro Ticket";
        _printLayout = await PrintSettings.HandleAsync(new GetTicketPrintSettings.Query(TicketType.EventTicket));
        _showPrint = true;
    }

    private async Task OpenSinglePrint(Guid uuid)
    {
        _printUuid = uuid;
        _printBundleId = null;
        _printSubtitle = $"Ticket-Nr. {AdminFormat.TicketNo(uuid)}";
        _printLayout = await PrintSettings.HandleAsync(new GetTicketPrintSettings.Query(TicketType.EventTicket));
        _showPrint = true;
    }

    private void ClosePrint() => _showPrint = false;

    private EventTicketRow? _deleteTarget;
    private bool _deleteBusy;
    private string? _deleteError;

    private void CancelDelete() { _deleteTarget = null; _deleteError = null; }

    private async Task DeleteConfirmedAsync()
    {
        if (_deleteTarget is null) return;
        _deleteBusy = true;
        _deleteError = null;
        try
        {
            await TicketDeletions.HandleAsync(new DeleteEventTicket.Command(_deleteTarget.Uuid));
            _deleteTarget = null;
            await ReloadTicketsAsync();
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _deleteBusy = false; }
    }

    private static readonly TicketCategory[] AllCategories = Enum.GetValues<TicketCategory>();
    private static readonly TicketCategory[] MainCategories =
        [TicketCategory.Adult, TicketCategory.Youth, TicketCategory.Child];
    private static readonly TicketStatus[] AllStatuses = [TicketStatus.Valid, TicketStatus.Cancelled];
    private static readonly RedemptionState[] AllRedemptionStates = Enum.GetValues<RedemptionState>();
    private static readonly Func<RedemptionState, string> RedemptionLabel = s => s.DisplayName();

    private bool _loading = true;
    private IReadOnlyList<SeasonChoice> _seasons = [];
    private IReadOnlyList<EventForAdmin> _events = [];
    private EventTicketsForAdmin _result = EventTicketsForAdmin.Empty;
    private string _selectedEventName = "";
    private CancellationTokenSource? _searchDebounce;

    public int SelectedSeasonId { get; set; }
    public int SelectedEventId { get; set; }

    private string _sortCol = "category";
    private bool _sortAsc = true;

    private bool _showCreate;

    private async Task CreatedAsync()
    {
        _showCreate = false;
        await ReloadTicketsAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        var restoreEventId = AdminState.SelectedEventId;
        _seasons = await SeasonChoices.HandleAsync(new GetSeasonChoices.Query());
        SelectedSeasonId = AdminState.SelectedSeasonId is int id && _seasons.Any(s => s.Id == id)
            ? id
            : _seasons.FirstOrDefault(s => s.IsCurrent)?.Id ?? _seasons.FirstOrDefault()?.Id ?? 0;
        await OnSeasonChangedAsync();
        if (restoreEventId is int eid && eid != SelectedEventId && _events.Any(e => e.Id == eid))
        {
            SelectedEventId = eid;
            await ReloadTicketsAsync();
        }
        _loading = false;
    }

    private async Task OnSeasonChangedAsync()
    {
        AdminState.SelectedSeasonId = SelectedSeasonId > 0 ? SelectedSeasonId : null;
        _events = (await EventsForAdmin.HandleAsync(new GetEventsForAdmin.Query(SelectedSeasonId))).Events;
        SelectedEventId = DefaultEvent(_events)?.Id ?? 0;
        _bundleFilter = 0;
        await ReloadTicketsAsync();
    }

    private async Task ReloadTicketsAsync()
    {
        AdminState.SelectedEventId = SelectedEventId > 0 ? SelectedEventId : null;
        _selectedEventName = _events.FirstOrDefault(e => e.Id == SelectedEventId)?.Name ?? "";
        _result = await TicketList.HandleAsync(new GetEventTicketsForAdmin.Query(SelectedEventId, _bundleFilter, _search));
    }

    private async Task SearchAsync()
    {
        _searchDebounce?.Cancel();
        var debounce = _searchDebounce = new CancellationTokenSource();
        try { await Task.Delay(250, debounce.Token); }
        catch (TaskCanceledException) { return; }
        await ReloadTicketsAsync();
    }

    private static string RedemptionBadge(RedemptionState state) => state switch
    {
        RedemptionState.Redeemed => "ta-badge-redeemed",
        RedemptionState.Outside => "ta-badge-blocked",
        _ => "ta-badge-draft"
    };

    private static string OriginLabel(TicketType type) => type switch
    {
        TicketType.SeasonPass => "Saisonkarte",
        TicketType.MemberCard => "Mitgliederkarte",
        TicketType.SeasonSingle => "Flexticket",
        _ => "Karte"
    };

    private async Task SaveCategoryAsync(EventTicketRow t, TicketCategory category)
    {
        await EditAsync(t, category, t.Price, t.Status, t.Redeemed);
        await ReloadTicketsAsync();
    }

    private async Task SavePriceAsync(EventTicketRow t, decimal? price)
    {
        if (price is not { } p || p < 0) throw new DomainException("Der Abgabepreis darf nicht leer oder negativ sein.");
        await EditAsync(t, t.Category, p, t.Status, t.Redeemed);
        await ReloadTicketsAsync();
    }

    private async Task SaveStatusAsync(EventTicketRow t, TicketStatus status)
    {
        await EditAsync(t, t.Category, t.Price, status, t.Redeemed);
        await ReloadTicketsAsync();
    }

    private Task EditAsync(EventTicketRow t, TicketCategory category, decimal price, TicketStatus status, bool redeemed) =>
        TicketEdits.HandleAsync(new EditEventTicket.Command(t.Uuid, t.EventId, category, price, status, redeemed, null));

    private async Task SaveRedemptionAsync(EventTicketRow t, RedemptionState target)
    {
        var scannedBy = Identity?.Name ?? AdminUser;
        var current = t.Redemption;

        switch (target)
        {
            case RedemptionState.Redeemed:
                await ScanOrThrowAsync(t, ScanMode.CheckIn, scannedBy);
                break;
            case RedemptionState.Outside:
                if (current == RedemptionState.Open)
                    throw new DomainException("Ein offenes Ticket war nie drin und kann nicht auf „Draussen“ gesetzt werden.");
                await ScanOrThrowAsync(t, ScanMode.CheckOut, scannedBy);
                break;
            case RedemptionState.Open:
                if (current == RedemptionState.Redeemed && t.Inside == true)
                    await ScanOrThrowAsync(t, ScanMode.CheckOut, scannedBy);
                await EditAsync(t, t.Category, t.Price, t.Status, false);
                break;
        }
        await ReloadTicketsAsync();
    }

    private async Task ScanOrThrowAsync(EventTicketRow t, ScanMode mode, string scannedBy)
    {
        var outcome = await TicketScans.HandleAsync(new ScanTicket.Command(t.EventId, TicketType.EventTicket, t.Uuid, t.EventId, mode, scannedBy));
        if (!outcome.Ok) throw new DomainException(outcome.Reason ?? "Die Änderung wurde abgelehnt.");
    }

    private void Sort(string col) { _sortAsc = _sortCol == col ? !_sortAsc : true; _sortCol = col; }
    private string Ind(string col) => _sortCol == col ? (_sortAsc ? "▲" : "▼") : "";
    private string _search = "";
    private int _bundleFilter;

    private IEnumerable<EventTicketRow> Sorted()
    {
        var src = _result.Tickets;
        IEnumerable<EventTicketRow> q = _sortCol switch
        {
            "buyer" => src.OrderBy(t => t.BuyerName ?? "", StringComparer.OrdinalIgnoreCase),
            "created" => src.OrderBy(t => t.CreatedAt),
            "price" => src.OrderBy(t => t.Price),
            "status" => src.OrderBy(t => t.Status),
            "redeemed" => src.OrderBy(t => t.Redeemed),
            _ => src.OrderBy(t => t.Category),
        };
        return _sortAsc ? q : q.Reverse();
    }

