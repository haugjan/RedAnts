@using RedAnts.Ticketing.Domain
@using RedAnts.Ticketing.Domain.Sales

<section class="ta-page">
    <h1 class="ta-page-title">@TicketType.SeasonSingle.DisplayName()</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="seasonSelect">Saison</label>
                    <select id="seasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="OnSeasonChangedAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="bundleSelect">Bundle</label>
                    <select id="bundleSelect" class="ta-select" disabled="@(_bundles.Count == 0)"
                            @bind="SelectedBundleId" @bind:after="ReloadTicketsAsync">
                        @if (_bundles.Count == 0)
                        {
                            <option value="0">— keine Bundles —</option>
                        }
                        else
                        {
                            <option value="0">Alle anzeigen</option>
                            @foreach (var b in _bundles)
                            {
                                <option value="@b.Id">@b.Reference · @b.Category.DisplayName() · @b.TicketCount Stk.</option>
                            }
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="flexSearch">Suche</label>
                    <input id="flexSearch" class="ta-input" type="search" placeholder="Name, E-Mail …" @bind="_search" @bind:event="oninput" @bind:after="ReloadTicketsAsync" />
                </div>
            </div>
            <div class="ta-toolbar-actions">
                @if (SelectedBundle is not null)
                {
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => _showExport = true"
                            title="Ein oder mehrere Bundles als Excel/CSV exportieren (Karten-Nr + Bundle + Ticketlink)">Export CSV</button>
                    <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedBundle.TicketCount == 0)"
                            title="@(SelectedBundle.TicketCount == 0 ? "Leeres Bundle – keine Flextickets zum Drucken" : "Flextickets als druckfertiges PDF erzeugen (eine Karte pro Seite)")"
                            @onclick="OpenPrint">PDF drucken</button>
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => _editing = SelectedBundle">Bundle bearbeiten</button>
                    @if (Identity?.IsAdmin == true)
                    {
                        <button type="button" class="ta-btn ta-btn-ghost ta-btn-danger"
                                disabled="@(SelectedBundle.TicketCount > 0)"
                                title="@(SelectedBundle.TicketCount > 0 ? "Nur leere Bundles können gelöscht werden – bitte zuerst die Flextickets entfernen" : "Bundle löschen")"
                                @onclick="() => _deleteBundleTarget = SelectedBundle">Bundle löschen</button>
                    }
                }
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedSeasonId <= 0)" @onclick="() => _showImport = true">
                    Import CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_tickets.Count == 0)" @onclick="() => _showBulk = true"
                        title="Die aktuell gefilterten Flextickets mit E-Mail versenden">Tickets versenden</button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedSeasonId <= 0)" @onclick="() => _showCreateBundle = true">
                    Bundle erstellen
                </button>
                <button type="button" class="ta-btn ta-btn-primary" disabled="@(SelectedSeasonId <= 0)" @onclick="() => _showCreateSingle = true">
                    Einzelticket erstellen
                </button>
            </div>
        </div>

        @if (_bundles.Count == 0)
        {
            <div class="ta-placeholder">Für diese Saison sind keine Flexticket-Bundles erfasst.</div>
        }
        else if (_total == 0)
        {
            <div class="ta-placeholder">Dieses Bundle enthält keine Flextickets.</div>
        }
        else
        {
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Ticket-Nr.</th>
                            <th>Person</th>
                            <th class="ta-th-sort" @onclick='() => Sort("created")'>Erstellt <span class="ta-sort-ind">@Ind("created")</span></th>
                            <th>Bundle</th>
                            <th>Kategorie</th>
                            <th class="ta-th-sort" @onclick='() => Sort("status")'>Status <span class="ta-sort-ind">@Ind("status")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("redeemed")'>Eingelöst <span class="ta-sort-ind">@Ind("redeemed")</span></th>
                            <th>Event&shy;besuche</th>
                            <th class="ta-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Sorted())
                        {
                            <tr>
                                <td>
                                    <span class="ta-ticketno">
                                        <span class="ta-no">@AdminFormat.TicketNo(t.Uuid)</span>
                                        <a class="ta-qr-link" href="@t.TicketUrl" target="_blank" rel="noopener" title="Online-Ticket" aria-label="Online-Ticket">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17 14h.01M20 14v3M14 17h.01M17 20h3M20 20h.01"/></svg>
                                        </a>
                                    </span>
                                </td>
                                <td class="ta-cell-name"><PersonCell Holder="t.Holder" /></td>
                                <td class="ta-created" title="@AdminFormat.CreatedTooltip(t.CreatedAt, t.CreatorName, t.CreatorEmail, null)">
                                    @AdminFormat.CreatedShort(t.CreatedAt, t.CreatorName, null)
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(t.BundleReference)) { <span class="ta-badge ta-badge-buyer">@t.BundleReference</span> }
                                    else { <span class="ta-muted">–</span> }
                                    @if (t.BoxOffice)
                                    {
                                        <span class="ta-badge ta-badge-firma" title="Als Abendkassenticket markiert: gilt auch an Spezialanlässen, die Flextickets einschränken.">🎫 Abendkasse</span>
                                    }
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketCategory"
                                                      Value="@t.Category"
                                                      Options="@Categories"
                                                      Label="@(c => c.DisplayName())"
                                                      FieldLabel="Kategorie"
                                                      Save="@(c => SaveCategoryAsync(t, c))" />
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketStatus"
                                                      Value="@t.Status"
                                                      Options="@AllStatuses"
                                                      Label="@(s => s.DisplayName())"
                                                      FieldLabel="Status"
                                                      Save="@(s => SaveStatusAsync(t, s))">
                                        <Display Context="status">
                                            <span class="ta-badge ta-badge-@status.ToString().ToLowerInvariant()">@status.DisplayName()</span>
                                        </Display>
                                    </InlineSelectEdit>
                                </td>
                                <td>
                                    @if (t.Status == TicketStatus.Valid)
                                    {
                                        <button type="button" class="ta-badge-btn" title="Einlösung ändern" @onclick="() => _redeemFor = t">
                                            <span class="ta-badge @RedemptionBadge(StateOf(t))">@StateOf(t).DisplayName()</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="ta-badge @RedemptionBadge(StateOf(t))">@StateOf(t).DisplayName()</span>
                                    }
                                    @if (t.ConvertedForPurchase)
                                    {
                                        <span class="ta-conv-badge" title="Dieses Flexticket wurde für einen Ticketkauf (Umwandlung) an einem Spezialanlass gebraucht, nicht am Eingang gescannt.">↔ Umwandlung</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="ta-visits-link" @onclick="() => _visitsFor = t">Besuch</button>
                                </td>
                                <td class="ta-col-actions">
                                    <button type="button" class="ta-icon-btn" title="@(HasEmail(t) ? "E-Mail senden" : "Keine E-Mail hinterlegt")" disabled="@(!HasEmail(t))" @onclick="() => _mailFor = t">✉</button>
                                    <button type="button" class="ta-icon-btn" title="Personendaten bearbeiten" @onclick="() => _editPersonFor = t">✎</button>
                                    <button type="button" class="ta-icon-btn" title="Als PDF drucken" @onclick="() => OpenSinglePrint(t.Uuid)">🖨</button>
                                    @if (Identity?.IsAdmin == true)
                                    {
                                        <button type="button" class="ta-icon-btn ta-icon-btn-danger" title="Löschen" @onclick="() => _deleteTarget = t">🗑</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="ta-summary">
                @_tickets.Count Flextickets · @_tickets.Count(t => t.Redeemed) eingelöst · @_tickets.Count(t => t.Status == TicketStatus.Blocked) gesperrt
                @if (SelectedBundle is { CreatedByName: { Length: > 0 } by }) { <text> · erstellt von @by</text> }
            </p>
        }
    }
</section>

@if (_showExport)
{
    <ExportFlexBundlesDialog Bundles="_bundles"
                             SeasonName="@_selectedSeasonName"
                             SelectedBundleId="SelectedBundleId"
                             OnClosed="() => _showExport = false" />
}

@if (_showPrint)
{
    <PrintFlexTicketsDialog Uuid="_printUuid"
                            BundleId="_printBundleId"
                            Subtitle="@_printSubtitle"
                            OnClosed="() => _showPrint = false" />
}

@if (_mailFor is not null)
{
    <SendFlexTicketMailDialog Ticket="_mailFor" SeasonId="SelectedSeasonId" OnClosed="() => _mailFor = null" />
}

@if (_editPersonFor is not null)
{
    <EditFlexTicketHolderDialog Ticket="_editPersonFor"
                                OnSaved="HolderSavedAsync"
                                OnClosed="() => _editPersonFor = null" />
}

@if (_showBulk)
{
    <SendFlexTicketMailsDialog Tickets="_tickets" SeasonId="SelectedSeasonId" OnClosed="() => _showBulk = false" />
}

@if (_showCreateSingle)
{
    <CreateFlexTicketDialog SeasonId="SelectedSeasonId"
                            SeasonName="@_selectedSeasonName"
                            Bundles="_bundles"
                            AdminUser="@AdminUser"
                            OnSaved="SingleTicketCreatedAsync"
                            OnClosed="() => _showCreateSingle = false" />
}

@if (_showCreateBundle)
{
    <CreateFlexBundleDialog SeasonId="SelectedSeasonId"
                            SeasonName="@_selectedSeasonName"
                            Bundles="_bundles"
                            AdminUser="@AdminUser"
                            OnSaved="BundleCreatedAsync"
                            OnClosed="() => _showCreateBundle = false" />
}

@if (_showImport)
{
    <ImportFlexTicketsDialog SeasonId="SelectedSeasonId"
                             SeasonName="@_selectedSeasonName"
                             Bundles="_bundles"
                             AdminUser="@AdminUser"
                             OnSaved="ImportedAsync"
                             OnClosed="() => _showImport = false" />
}

@if (_editing is not null)
{
    <RenameFlexBundleDialog Bundle="_editing"
                            OnSaved="BundleRenamedAsync"
                            OnClosed="() => _editing = null" />
}

@if (_redeemFor is not null)
{
    <ChangeFlexRedemptionDialog Ticket="_redeemFor"
                                SeasonId="SelectedSeasonId"
                                AdminUser="@AdminUser"
                                OnSaved="RedemptionChangedAsync"
                                OnClosed="() => _redeemFor = null" />
}

@if (_visitsFor is not null)
{
    <VisitsOverlay Uuid="@_visitsFor.Uuid"
                   Title="@($"Flexticket {AdminFormat.TicketNo(_visitsFor.Uuid)}")"
                   Heading="Eventbesuch"
                   EmptyText="Noch kein Eventbesuch."
                   OnClose="() => _visitsFor = null" />
}

@if (_deleteTarget is not null)
{
    <DeleteFlexTicketDialog Ticket="_deleteTarget"
                            OnDeleted="TicketDeletedAsync"
                            OnClosed="() => _deleteTarget = null" />
}

@if (_deleteBundleTarget is not null)
{
    <DeleteFlexBundleDialog Bundle="_deleteBundleTarget"
                            OnDeleted="BundleDeletedAsync"
                            OnClosed="() => _deleteBundleTarget = null" />
}

@code {
    [Parameter] public string AdminUser { get; set; } = "";
    [CascadingParameter] public AdminIdentity? Identity { get; set; }

    [Inject] private GetSeasonChoices.Handler SeasonChoices { get; set; } = default!;
    [Inject] private GetFlexBundles.Handler BundleList { get; set; } = default!;
    [Inject] private GetFlexBundleTickets.Handler TicketList { get; set; } = default!;
    [Inject] private SetFlexTicketCategory.Handler CategoryChanges { get; set; } = default!;
    [Inject] private SetFlexTicketStatus.Handler StatusChanges { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;

    private static readonly TicketCategory[] Categories = Enum.GetValues<TicketCategory>();
    private static readonly TicketStatus[] AllStatuses = Enum.GetValues<TicketStatus>();

    private bool _loading = true;
    private IReadOnlyList<SeasonChoice> _seasons = [];
    private IReadOnlyList<FlexBundleRow> _bundles = [];
    private IReadOnlyList<FlexTicketRow> _tickets = [];
    private int _total;
    private string _selectedSeasonName = "";
    private string _search = "";
    private string _sortCol = "created";
    private bool _sortAsc = false;

    public int SelectedSeasonId { get; set; }
    public int SelectedBundleId { get; set; }

    private FlexBundleRow? SelectedBundle => _bundles.FirstOrDefault(b => b.Id == SelectedBundleId);

    protected override async Task OnInitializedAsync()
    {
        var restoreBundleId = AdminState.SelectedBundleId;
        _seasons = await SeasonChoices.HandleAsync(new GetSeasonChoices.Query());
        SelectedSeasonId = AdminState.SelectedSeasonId is int id && _seasons.Any(s => s.Id == id)
            ? id
            : _seasons.FirstOrDefault(s => s.IsCurrent)?.Id ?? _seasons.FirstOrDefault()?.Id ?? 0;
        await OnSeasonChangedAsync();
        if (restoreBundleId is int bid && bid != SelectedBundleId && _bundles.Any(b => b.Id == bid))
        {
            SelectedBundleId = bid;
            await ReloadTicketsAsync();
        }
        _loading = false;
    }

    private async Task OnSeasonChangedAsync()
    {
        AdminState.SelectedSeasonId = SelectedSeasonId > 0 ? SelectedSeasonId : null;
        _selectedSeasonName = _seasons.FirstOrDefault(s => s.Id == SelectedSeasonId)?.Name ?? "";
        await ReloadBundlesAsync();
        SelectedBundleId = _bundles.FirstOrDefault()?.Id ?? 0;
        await ReloadTicketsAsync();
    }

    private async Task ReloadBundlesAsync() =>
        _bundles = SelectedSeasonId > 0 ? await BundleList.HandleAsync(new GetFlexBundles.Query(SelectedSeasonId)) : [];

    private async Task ReloadTicketsAsync()
    {
        AdminState.SelectedBundleId = SelectedBundleId > 0 ? SelectedBundleId : null;
        var result = SelectedBundleId > 0 || (_bundles.Count > 0 && SelectedSeasonId > 0)
            ? await TicketList.HandleAsync(new GetFlexBundleTickets.Query(SelectedSeasonId, SelectedBundleId > 0 ? SelectedBundleId : null, _search))
            : new GetFlexBundleTickets.Result([], 0);
        _tickets = result.Tickets;
        _total = result.Total;
    }

    private void Sort(string col) { _sortAsc = _sortCol == col ? !_sortAsc : true; _sortCol = col; }

    private string Ind(string col) => _sortCol == col ? (_sortAsc ? "▲" : "▼") : "";

    private IEnumerable<FlexTicketRow> Sorted()
    {
        IEnumerable<FlexTicketRow> q = _sortCol switch
        {
            "status" => _tickets.OrderBy(t => t.Status),
            "redeemed" => _tickets.OrderBy(t => t.Redeemed),
            _ => _tickets.OrderBy(t => t.CreatedAt),
        };
        return _sortAsc ? q : q.Reverse();
    }

    private static bool HasEmail(FlexTicketRow t) => !string.IsNullOrWhiteSpace(t.Holder?.Email);

    private static RedemptionState StateOf(FlexTicketRow t) =>
        RedemptionStateExtensions.Derive(t.Redeemed, t.IsInside);

    private static string RedemptionBadge(RedemptionState state) => state switch
    {
        RedemptionState.Redeemed => "ta-badge-redeemed",
        RedemptionState.Outside => "ta-badge-blocked",
        _ => "ta-badge-draft"
    };

    private async Task SaveCategoryAsync(FlexTicketRow t, TicketCategory category)
    {
        await CategoryChanges.HandleAsync(new SetFlexTicketCategory.Command(t.Uuid, category));
        await ReloadTicketsAsync();
    }

    private async Task SaveStatusAsync(FlexTicketRow t, TicketStatus status)
    {
        await StatusChanges.HandleAsync(new SetFlexTicketStatus.Command(t.Uuid, status));
        await ReloadTicketsAsync();
    }

    private FlexTicketRow? _visitsFor;
    private FlexTicketRow? _mailFor;
    private FlexTicketRow? _editPersonFor;
    private FlexTicketRow? _redeemFor;
    private FlexTicketRow? _deleteTarget;
    private FlexBundleRow? _editing;
    private FlexBundleRow? _deleteBundleTarget;
    private bool _showCreateSingle;
    private bool _showCreateBundle;
    private bool _showImport;
    private bool _showExport;
    private bool _showBulk;

    private bool _showPrint;
    private int _printBundleId;
    private Guid? _printUuid;
    private string _printSubtitle = "";

    private void OpenPrint()
    {
        if (SelectedBundle is null || SelectedBundle.TicketCount == 0) return;
        _printBundleId = SelectedBundle.Id;
        _printUuid = null;
        _printSubtitle = $"{SelectedBundle.Reference} · {SelectedBundle.TicketCount} Karten · eine Seite pro Karte";
        _showPrint = true;
    }

    private void OpenSinglePrint(Guid uuid)
    {
        _printUuid = uuid;
        _printSubtitle = $"Ticket-Nr. {AdminFormat.TicketNo(uuid)}";
        _showPrint = true;
    }

    private async Task HolderSavedAsync()
    {
        _editPersonFor = null;
        await ReloadTicketsAsync();
    }

    private async Task RedemptionChangedAsync()
    {
        _redeemFor = null;
        await ReloadTicketsAsync();
    }

    private async Task TicketDeletedAsync()
    {
        _deleteTarget = null;
        await ReloadTicketsAsync();
    }

    private async Task SingleTicketCreatedAsync()
    {
        _showCreateSingle = false;
        await OnSeasonChangedAsync();
    }

    private async Task ImportedAsync()
    {
        _showImport = false;
        await OnSeasonChangedAsync();
    }

    private async Task BundleCreatedAsync(int bundleId)
    {
        _showCreateBundle = false;
        await ReloadBundlesAsync();
        SelectedBundleId = bundleId;
        await ReloadTicketsAsync();
    }

    private async Task BundleRenamedAsync()
    {
        _editing = null;
        await ReloadBundlesAsync();
    }

    private async Task BundleDeletedAsync()
    {
        _deleteBundleTarget = null;
        await ReloadBundlesAsync();
        SelectedBundleId = _bundles.FirstOrDefault()?.Id ?? 0;
        await ReloadTicketsAsync();
    }
}
