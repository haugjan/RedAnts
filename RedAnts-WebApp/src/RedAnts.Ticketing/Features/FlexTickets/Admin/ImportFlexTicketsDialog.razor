@using RedAnts.Ticketing.Domain.Sales

<div class="ta-overlay" @onmousedown="CloseAsync">
    <div class="ta-modal" @onmousedown:stopPropagation="true">
        <h2 class="ta-modal-title">Flextickets importieren</h2>

        <div class="ta-field">
            <label class="ta-label">Saison</label>
            <div class="ta-readonly">@SeasonName</div>
        </div>

        <div class="ta-field">
            <label class="ta-label" for="impFlexCategory">Kategorie (Vorauswahl, Datei kann überschreiben)</label>
            <select id="impFlexCategory" class="ta-select" @bind="_category">
                @foreach (var c in MainCategories)
                {
                    <option value="@c">@c.DisplayName()</option>
                }
            </select>
        </div>

        <div class="ta-field">
            <label class="ta-label" for="impFlexReference">Bundle</label>
            <input id="impFlexReference" class="ta-input" type="text" maxlength="50" list="flexImportBundleOptions" placeholder="z. B. Sponsoren 2026" @bind="_reference" />
            <datalist id="flexImportBundleOptions">
                @foreach (var b in Bundles) { <option value="@b.Reference" /> }
            </datalist>
            <p class="ta-hint">Gilt für Zeilen ohne eigene Bundle-Spalte; eine Bundle-Spalte in der Datei hat Vorrang.</p>
        </div>

        <div class="ta-field">
            <label class="ta-label">Datei (CSV oder Excel)</label>
            <InputFile OnChange="OnFileAsync" accept=".csv,.xlsx,text/csv" />
            <p class="ta-hint">
                Spalten (alle optional): Karten-Nr, Bundle, Kategorie, Firma, Anrede, Name, Vorname, Strasse, Adresszusatz, PLZ, Ort, Land, E-Mail, Telefon, Geburtsdatum (dd.MM.yyyy).
                Die Spalten werden automatisch erkannt; passt die Zuordnung nicht, unten von Hand anpassen.
                Zeilen mit bestehender Karten-Nr werden aktualisiert.
                <a href="/admin/flex-tickets/example.csv" target="_blank" rel="noopener">Beispieldatei herunterladen</a>
            </p>
        </div>

        @if (_table is not null && _table.Columns.Count > 0)
        {
            <div class="ta-field">
                @if (!_showMapping)
                {
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => _showMapping = true">Spaltenzuordnung anpassen</button>
                }
                else
                {
                    <label class="ta-label">Spaltenzuordnung</label>
                    <p class="ta-hint">Ordne jeder benötigten Spalte eine Spalte aus deiner Datei zu.</p>
                    <table class="ta-map">
                        @foreach (var field in TicketImportCsv.Fields)
                        {
                            <tr>
                                <td class="ta-map-label">@field.Label</td>
                                <td>
                                    <select class="ta-select" value="@MapValue(field.Key)" @onchange="e => SetMap(field.Key, e.Value?.ToString())">
                                        <option value="-1">(nicht zuordnen)</option>
                                        @for (var i = 0; i < _table.Columns.Count; i++)
                                        {
                                            var idx = i;
                                            <option value="@idx">@_table.Columns[idx]</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </table>
                    <div class="ta-modal-actions">
                        <button type="button" class="ta-btn ta-btn-primary" @onclick="ApplyMapping">Zuordnung übernehmen</button>
                    </div>
                }
            </div>
        }

        @if (_fileName is not null)
        {
            <div class="ta-parse">
                <strong>@_fileName</strong>: @_rows.Count gültige Zeile@(_rows.Count == 1 ? "" : "n") erkannt.
                @if (_warnings.Count > 0)
                {
                    <ul class="ta-warnings">
                        @foreach (var w in _warnings) { <li>@w</li> }
                    </ul>
                }
            </div>
            @if (_errors.Count > 0)
            {
                <div class="ta-error">
                    @_errors.Count Fehler, bitte in der Datei korrigieren:
                    <ul class="ta-warnings">
                        @foreach (var er in _errors) { <li>@er</li> }
                    </ul>
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(_error)) { <div class="ta-error">@_error</div> }

        <div class="ta-modal-actions">
            <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseAsync" disabled="@_saving">Abbrechen</button>
            <button type="button" class="ta-btn ta-btn-primary" @onclick="ImportAsync" disabled="@(_saving || _rows.Count == 0 || _errors.Count > 0)">
                @(_saving ? "Wird importiert …" : _errors.Count > 0 ? "Bitte Fehler beheben" : $"{_rows.Count} Flextickets importieren")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int SeasonId { get; set; }
    [Parameter] public string SeasonName { get; set; } = "";
    [Parameter] public IReadOnlyList<FlexBundleRow> Bundles { get; set; } = [];
    [Parameter] public string AdminUser { get; set; } = "";
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [CascadingParameter] public AdminIdentity? Identity { get; set; }

    [Inject] private ImportFlexTickets.Handler TicketImports { get; set; } = default!;

    private static readonly TicketCategory[] MainCategories =
        [TicketCategory.Adult, TicketCategory.Youth, TicketCategory.Child];

    private bool _saving;
    private string? _fileName;
    private string? _error;
    private string _reference = "";
    private TicketCategory _category = TicketCategory.Adult;
    private IReadOnlyList<TicketImportRow> _rows = [];
    private IReadOnlyList<string> _warnings = [];
    private IReadOnlyList<string> _errors = [];
    private TicketImportTable? _table;
    private Dictionary<string, int> _map = new();
    private bool _showMapping;

    private Task CloseAsync() => _saving ? Task.CompletedTask : OnClosed.InvokeAsync();

    private async Task OnFileAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var table = TicketImportCsv.ReadTable(buffer.ToArray(), e.File.Name);
            _fileName = e.File.Name;
            _table = table;
            _map = new Dictionary<string, int>(table.AutoMap);

            if (table.Columns.Count == 0 || table.Rows.Count == 0)
            {
                _rows = [];
                _warnings = [];
                _errors = ["Keine Datenzeilen gefunden. Bitte prüfe die Datei."];
                _showMapping = false;
                return;
            }

            if (TicketImportCsv.EssentialMapped(_map))
            {
                ApplyMapping();
            }
            else
            {
                _rows = [];
                _warnings = [];
                _errors = [];
                _error = "Spalten konnten nicht automatisch erkannt werden. Bitte unten von Hand zuordnen.";
                _showMapping = true;
            }
        }
        catch (Exception ex)
        {
            _fileName = null;
            _table = null;
            _rows = [];
            _warnings = [];
            _errors = [];
            _error = $"Datei konnte nicht gelesen werden: {ex.Message}";
        }
    }

    private int MapValue(string key) => _map.TryGetValue(key, out var idx) ? idx : -1;

    private void SetMap(string key, string? value)
    {
        if (int.TryParse(value, out var idx) && idx >= 0) _map[key] = idx;
        else _map.Remove(key);
    }

    private void ApplyMapping()
    {
        if (_table is null) return;
        _error = null;
        var result = TicketImportCsv.BuildRows(_table, _map);
        _rows = result.Rows;
        _warnings = result.Warnings;
        _errors = result.Errors;
        _showMapping = false;
    }

    private async Task ImportAsync()
    {
        _error = null;
        if (SeasonId <= 0) { _error = "Bitte zuerst eine Saison wählen."; return; }
        if (string.IsNullOrWhiteSpace(_reference)) { _error = "Bitte ein Bundle angeben."; return; }
        if (_errors.Count > 0) { _error = "Bitte zuerst die Fehler in der Datei beheben."; return; }
        if (_rows.Count == 0) { _error = "Bitte eine Datei mit mindestens einer Zeile wählen."; return; }
        _saving = true;
        try
        {
            await TicketImports.HandleAsync(new ImportFlexTickets.Command(SeasonId, _rows, _reference.Trim(),
                _category, Identity?.Name ?? AdminUser, Identity?.Email));
            await OnSaved.InvokeAsync();
        }
        catch (DomainException ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}
