@{
    Layout = null;
    var logoUrl = "https://redants.ch/uploads/232/admin/website_header/RA_Logo_transparent_300ppi.png";
    var title = ViewData["Title"] as string ?? "Red Ants Ticketing";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title – Red Ants</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/_content/RedAnts.Ticketing/css/next-quickbuy.css" asp-append-version="true" />
    @RenderSection("Head", required: false)
</head>
<body>
<header class="nq-bar">
    <a href="/ticketing/" class="nq-bar__logo" aria-label="Zur Übersicht">
        <img src="@logoUrl" alt="Red Ants Winterthur" />
    </a>
    <a href="/ticketing/" class="nq-bar__link">Alle Anlässe &rarr;</a>
</header>
<main class="nq-main">
    @RenderBody()
</main>
@RenderSection("Scripts", required: false)
</body>
</html>
