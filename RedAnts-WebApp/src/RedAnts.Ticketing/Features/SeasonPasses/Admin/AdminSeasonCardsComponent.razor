@using System.Text
@using RedAnts.Ticketing.Domain.Sales
@inject GetSeasonPasses.Handler PassList
@inject GetPriceTiers.Handler PriceTiers
@inject EditSeasonPass.Handler PassEdit

<section class="ta-page">
    <h1 class="ta-page-title">Saisonkarten</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="spSeasonSelect">Saison</label>
                    <select id="spSeasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="ReloadPassesAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="spBundleFilter">Bundle</label>
                    <select id="spBundleFilter" class="ta-select" @bind="_bundleFilter" @bind:after="ReloadPassesAsync">
                        <option value="">Alle anzeigen</option>
                        @foreach (var b in _bundles)
                        {
                            <option value="@b">@b</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="spSearch">Suche</label>
                    <input id="spSearch" type="search" class="ta-input"
                           placeholder="Name, E-Mail, Bundle …"
                           @bind="_search" @bind:event="oninput" @bind:after="ReloadPassesAsync" />
                </div>
            </div>
            <div class="ta-toolbar-actions">
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_total == 0)" @onclick="OpenExport">
                    Export CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedSeasonId <= 0)" @onclick="OpenImport">
                    Import CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_total == 0)" @onclick="OpenBulk"
                        title="Alle Karten eines Bundles per E-Mail versenden">Karten versenden</button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(string.IsNullOrEmpty(_bundleFilter))"
                        title="@(string.IsNullOrEmpty(_bundleFilter) ? "Zum Drucken zuerst ein Bundle wählen" : "Alle Karten dieses Bundles als PDF drucken")"
                        @onclick="OpenBundlePrint">PDF drucken</button>
                <button type="button" class="ta-btn ta-btn-primary" disabled="@(SelectedSeasonId <= 0)" @onclick="OpenCreate">
                    Saisonkarte erstellen
                </button>
            </div>
        </div>

        @if (_total == 0)
        {
            <div class="ta-placeholder">Für diese Saison sind keine Saisonkarten ausgestellt.</div>
        }
        else
        {
            var shown = Sorted().ToList();
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Karten-Nr.</th>
                            <th class="ta-th-sort" @onclick='() => Sort("buyer")'>Person <span class="ta-sort-ind">@Ind("buyer")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("created")'>Erstellt <span class="ta-sort-ind">@Ind("created")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("bundle")'>Bundle <span class="ta-sort-ind">@Ind("bundle")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("category")'>Kategorie <span class="ta-sort-ind">@Ind("category")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("price")'>Preis <span class="ta-sort-ind">@Ind("price")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("status")'>Status <span class="ta-sort-ind">@Ind("status")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("visits")'>Event&shy;besuche <span class="ta-sort-ind">@Ind("visits")</span></th>
                            <th>Zahlung</th>
                            <th class="ta-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in shown)
                        {
                            <tr>
                                <td>
                                    <span class="ta-ticketno">@AdminFormat.TicketNo(p.Uuid)</span>
                                    <a class="ta-qr-link" href="@p.TicketUrl" target="_blank" rel="noopener" title="Online-Ticket" aria-label="Online-Ticket">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17 14h.01M20 14v3M14 17h.01M17 20h3M20 20h.01"/></svg>
                                    </a>
                                </td>
                                <td class="ta-cell-name">
                                    <PersonCell Holder="p.Holder" />
                                </td>
                                <td title="@AdminFormat.CreatedTooltip(p.CreatedAt, p.CreatedByName, null, OnlineMarker(p))">@AdminFormat.CreatedShort(p.CreatedAt, p.CreatedByName, OnlineMarker(p))</td>
                                <td>@(string.IsNullOrEmpty(p.Reference) ? "–" : p.Reference)</td>
                                <td>
                                    <InlineSelectEdit TValue="int" Value="MainTierId(p)" FieldLabel="Kategorie"
                                                      Options="MainTierIds" Label="@(id => TierName(id))"
                                                      Save="@(id => SaveTierAsync(p, id))" />
                                </td>
                                <td class="ta-num">CHF @p.Price.ToString("N2")</td>
                                <td>
                                    <InlineSelectEdit TValue="TicketStatus" Value="p.Status" FieldLabel="Status"
                                                      Options="StatusOptions" Label="@StatusLabel"
                                                      Save="@(v => SaveStatusAsync(p, v))">
                                        <Display Context="st">
                                            <span class="ta-badge ta-badge-@st.ToString().ToLowerInvariant()">@StatusLabel(st)</span>
                                        </Display>
                                    </InlineSelectEdit>
                                </td>
                                <td class="ta-num">
                                    @if (p.EventVisits > 0)
                                    {
                                        <button type="button" class="ta-visits-link" @onclick="() => OpenVisits(p)">@p.EventVisits</button>
                                    }
                                    else
                                    {
                                        <span class="ta-muted">0</span>
                                    }
                                    @if (p.Conversions > 0)
                                    {
                                        <button type="button" class="ta-conv-badge ta-conv-link" title="Diese Saisonkarte wurde für Ticketumwandlung(en) an Spezialanlässen gebraucht. Details anzeigen." @onclick="() => OpenVisits(p)">↔ @p.Conversions Uml.</button>
                                    }
                                </td>
                                <td>
                                    @(p.PaymentState ?? "–")
                                    @if (!string.IsNullOrEmpty(p.OrderNumber)) { <div class="ta-addr-sub">@p.OrderNumber</div> }
                                </td>
                                <td class="ta-col-actions">
                                    <button type="button" class="ta-icon-btn" title="@(p.HasEmail ? "E-Mail senden" : "Keine E-Mail hinterlegt")" disabled="@(!p.HasEmail)" @onclick="() => OpenMail(p)">✉</button>
                                    <button type="button" class="ta-icon-btn" title="Bearbeiten" @onclick="() => OpenEdit(p)">✎</button>
                                    <button type="button" class="ta-icon-btn" title="Als PDF drucken" @onclick="() => OpenSinglePrint(p.Uuid)">🖨</button>
                                    @if (Identity.IsAdmin)
                                    {
                                        <button type="button" class="ta-icon-btn ta-icon-btn-danger" title="Löschen" @onclick="() => _deleteTarget = p">🗑</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (shown.Count == 0)
            {
                <div class="ta-placeholder">Keine Saisonkarte passt zur Suche „@_search".</div>
            }
            <p class="ta-summary">
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <text>@shown.Count von @_passes.Count Saisonkarten · Total CHF @shown.Sum(p => p.Price).ToString("N2")</text>
                }
                else
                {
                    <text>@_passes.Count Saisonkarte@(_passes.Count == 1 ? "" : "n") · Total CHF @_passes.Sum(p => p.Price).ToString("N2")</text>
                }
            </p>
        }
    }
</section>

<style>
    .ta-noemail { display: inline-block; margin-left: 0.4rem; padding: 0.1rem 0.4rem; border-radius: 3px; background: #fff8e1; color: #7a5c00; border: 1px solid #e0b400; font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
    .ta-textarea { min-height: 9rem; resize: vertical; font-family: inherit; line-height: 1.5; }
    .ta-field--grow { flex: 1 1 18rem; }
    .ta-cards-search { width: 100%; min-width: 14rem; }
</style>

@if (_showCreate)
{
    <CreateSeasonPassDialog SeasonId="SelectedSeasonId" Tiers="_tiers" Bundles="_bundles"
                            OnSaved="PassCreatedAsync" OnClosed="CloseCreate" />
}

@if (_editing is not null)
{
    <EditSeasonPassDialog Pass="_editing" OnSaved="PassSavedAsync" OnClosed="CancelEdit" />
}

@if (_visitsPass is not null)
{
    <VisitsOverlay Uuid="_visitsPass.Uuid" Title="@(_visitsPass.BuyerName ?? AdminFormat.TicketNo(_visitsPass.Uuid))" OnClose="CloseVisits" />
}

@if (_deleteTarget is not null)
{
    <DeleteSeasonPassDialog Pass="_deleteTarget" OnDeleted="PassDeletedAsync" OnClosed="CloseDelete" />
}

@if (_showImport)
{
    <ImportSeasonPassesDialog SeasonId="SelectedSeasonId" SeasonName="@SelectedSeasonName" Tiers="_tiers" Bundles="_bundles"
                              OnSaved="PassesImportedAsync" OnClosed="CloseImport" />
}

@if (_showExport)
{
    <ExportSeasonPassesDialog SeasonId="SelectedSeasonId" Bundles="_bundles" OnClosed="CloseExport" />
}

@if (_showBulk)
{
    <SendSeasonPassBundleMailDialog SeasonId="SelectedSeasonId" Bundles="_bundles" OnClosed="CloseBulk" />
}

@if (_mailFor is not null)
{
    <SendSeasonPassMailDialog Pass="_mailFor" OnClosed="CloseMail" />
}

@if (_showPrint)
{
    <PrintSeasonPassesDialog Uuid="_printUuid" SeasonId="SelectedSeasonId" Bundle="@_bundleFilter"
                             BundleCount="BundleCount" OnClosed="ClosePrint" />
}

@code {
    [Parameter] public string AdminUser { get; set; } = "";
    [CascadingParameter] public AdminIdentity Identity { get; set; } = new("admin", null);

    [Inject] private GetSeasonChoices.Handler SeasonChoices { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;

    private bool _showPrint;
    private Guid? _printUuid;

    private int BundleCount => _passes.Count(p => string.Equals(p.Reference, _bundleFilter, StringComparison.Ordinal));

    private void OpenBundlePrint()
    {
        if (string.IsNullOrEmpty(_bundleFilter)) return;
        _printUuid = null;
        _showPrint = true;
    }

    private void OpenSinglePrint(Guid uuid)
    {
        _printUuid = uuid;
        _showPrint = true;
    }

    private void ClosePrint() => _showPrint = false;

    private SeasonPassRow? _deleteTarget;

    private void CloseDelete() => _deleteTarget = null;

    private async Task PassDeletedAsync()
    {
        _deleteTarget = null;
        await ReloadPassesAsync();
    }

    private bool _loading = true;
    private IReadOnlyList<SeasonChoice> _seasons = [];
    private IReadOnlyList<SeasonPassRow> _passes = [];
    private IReadOnlyList<string> _bundles = [];
    private int _total;

    public int SelectedSeasonId { get; set; }

    private string _sortCol = "buyer";
    private bool _sortAsc = true;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        _seasons = await SeasonChoices.HandleAsync(new GetSeasonChoices.Query());
        SelectedSeasonId = AdminState.SelectedSeasonId is int id && _seasons.Any(s => s.Id == id)
            ? id
            : _seasons.FirstOrDefault(s => s.IsCurrent)?.Id ?? _seasons.FirstOrDefault()?.Id ?? 0;
        await ReloadPassesAsync();
        _loading = false;
    }

    private async Task ReloadPassesAsync()
    {
        AdminState.SelectedSeasonId = SelectedSeasonId > 0 ? SelectedSeasonId : null;
        var result = SelectedSeasonId > 0
            ? await PassList.HandleAsync(new GetSeasonPasses.Query(SelectedSeasonId, _bundleFilter, _search))
            : new GetSeasonPasses.Result([], [], 0);
        _passes = result.Passes;
        _bundles = result.Bundles;
        _total = result.Total;
        _tiers = SelectedSeasonId > 0 ? await PriceTiers.HandleAsync(new GetPriceTiers.Query(SelectedSeasonId)) : [];
    }

    private void Sort(string col) { _sortAsc = _sortCol == col ? !_sortAsc : true; _sortCol = col; }
    private string Ind(string col) => _sortCol == col ? (_sortAsc ? "▲" : "▼") : "";
    private IEnumerable<SeasonPassRow> Sorted()
    {
        var src = _passes;
        IEnumerable<SeasonPassRow> q = _sortCol switch
        {
            "category" => src.OrderBy(p => p.CategoryName),
            "price" => src.OrderBy(p => p.Price),
            "status" => src.OrderBy(p => p.Status),
            "visits" => src.OrderBy(p => p.EventVisits),
            "created" => src.OrderBy(p => p.CreatedAt),
            "bundle" => src.OrderBy(p => p.Reference ?? "￿"),
            _ => src.OrderBy(p => p.BuyerSortKey),
        };
        return _sortAsc ? q : q.Reverse();
    }

    private string _bundleFilter = "";

    private static int? OnlineMarker(SeasonPassRow p) => p.OrderNumber is null ? null : 0;

    private static readonly TicketStatus[] StatusOptions = [TicketStatus.Valid, TicketStatus.Cancelled];

    private async Task SaveStatusAsync(SeasonPassRow p, TicketStatus status)
    {
        await PassEdit.HandleAsync(new EditSeasonPass.Command(p.Uuid, p.Price, status, null, null, null));
        await ReloadPassesAsync();
    }

    private IReadOnlyList<int> MainTierIds => _tiers.Where(t => !t.IsPromo).Select(t => t.Id).ToList();
    private string TierName(int id) => _tiers.FirstOrDefault(t => t.Id == id)?.Name ?? "–";
    private int MainTierId(SeasonPassRow p) =>
        _tiers.FirstOrDefault(t => !t.IsPromo && t.Name == p.CategoryName)?.Id
        ?? (p.TierId is { } tid ? (_tiers.FirstOrDefault(t => t.Id == tid)?.PromoOfTierId ?? tid) : MainTierIds.FirstOrDefault());

    private async Task SaveTierAsync(SeasonPassRow p, int tierId)
    {
        await PassEdit.HandleAsync(new EditSeasonPass.Command(p.Uuid, p.Price, p.Status, tierId, null, null));
        await ReloadPassesAsync();
    }

    private SeasonPassRow? _visitsPass;
    private void OpenVisits(SeasonPassRow p) => _visitsPass = p;
    private void CloseVisits() => _visitsPass = null;

    private string SelectedSeasonName => _seasons.FirstOrDefault(s => s.Id == SelectedSeasonId)?.Name ?? "";

    private bool _showImport;

    private void OpenImport() => _showImport = true;

    private void CloseImport() => _showImport = false;

    private async Task PassesImportedAsync()
    {
        _showImport = false;
        await ReloadPassesAsync();
    }

    private bool _showExport;
    private void OpenExport() => _showExport = true;
    private void CloseExport() => _showExport = false;

    private static string StatusLabel(TicketStatus status) => status switch
    {
        TicketStatus.Valid => "Gültig",
        TicketStatus.Cancelled => "Storniert",
        TicketStatus.Blocked => "Gesperrt",
        _ => status.ToString()
    };

    private IReadOnlyList<PriceTierRow> _tiers = [];
    private bool _showCreate;

    private void OpenCreate() => _showCreate = true;

    private void CloseCreate() => _showCreate = false;

    private async Task PassCreatedAsync()
    {
        _showCreate = false;
        await ReloadPassesAsync();
    }

    private SeasonPassRow? _editing;

    private void OpenEdit(SeasonPassRow pass) => _editing = pass;

    private void CancelEdit() => _editing = null;

    private async Task PassSavedAsync()
    {
        _editing = null;
        await ReloadPassesAsync();
    }

    private SeasonPassRow? _mailFor;

    private void OpenMail(SeasonPassRow p) => _mailFor = p;

    private void CloseMail() => _mailFor = null;

    private bool _showBulk;

    private void OpenBulk() => _showBulk = true;

    private void CloseBulk() => _showBulk = false;
}
