@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using RedAnts.Ticketing.Domain.Sales
@inject GetSeasonPasses.Handler PassList
@inject GetSeasonPassMailTemplate.Handler MailTemplate
@inject GetPriceTiers.Handler PriceTiers
@inject CreateAdminOrder.Handler OrderCreation
@inject CreateSeasonPass.Handler PassCreation
@inject EditSeasonPass.Handler PassEdit
@inject SetSeasonPassHolder.Handler PassHolder
@inject ImportSeasonPasses.Handler PassImport
@inject SendSeasonPassMail.Handler PassMail

<section class="ta-page">
    <h1 class="ta-page-title">Saisonkarten</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="spSeasonSelect">Saison</label>
                    <select id="spSeasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="ReloadPassesAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="spBundleFilter">Bundle</label>
                    <select id="spBundleFilter" class="ta-select" @bind="_bundleFilter" @bind:after="ReloadPassesAsync">
                        <option value="">Alle anzeigen</option>
                        @foreach (var b in _bundles)
                        {
                            <option value="@b">@b</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="spSearch">Suche</label>
                    <input id="spSearch" type="search" class="ta-input"
                           placeholder="Name, E-Mail, Bundle …"
                           @bind="_search" @bind:event="oninput" @bind:after="ReloadPassesAsync" />
                </div>
            </div>
            <div class="ta-toolbar-actions">
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_total == 0)" @onclick="OpenExport">
                    Export CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedSeasonId <= 0)" @onclick="OpenImport">
                    Import CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_total == 0)" @onclick="OpenBulk"
                        title="Alle Karten eines Bundles per E-Mail versenden">Karten versenden</button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(string.IsNullOrEmpty(_bundleFilter))"
                        title="@(string.IsNullOrEmpty(_bundleFilter) ? "Zum Drucken zuerst ein Bundle wählen" : "Alle Karten dieses Bundles als PDF drucken")"
                        @onclick="OpenBundlePrint">PDF drucken</button>
                <button type="button" class="ta-btn ta-btn-primary" disabled="@(SelectedSeasonId <= 0)" @onclick="OpenCreate">
                    Saisonkarte erstellen
                </button>
            </div>
        </div>

        @if (_total == 0)
        {
            <div class="ta-placeholder">Für diese Saison sind keine Saisonkarten ausgestellt.</div>
        }
        else
        {
            var shown = Sorted().ToList();
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Karten-Nr.</th>
                            <th class="ta-th-sort" @onclick='() => Sort("buyer")'>Person <span class="ta-sort-ind">@Ind("buyer")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("created")'>Erstellt <span class="ta-sort-ind">@Ind("created")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("bundle")'>Bundle <span class="ta-sort-ind">@Ind("bundle")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("category")'>Kategorie <span class="ta-sort-ind">@Ind("category")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("price")'>Preis <span class="ta-sort-ind">@Ind("price")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("status")'>Status <span class="ta-sort-ind">@Ind("status")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("visits")'>Event&shy;besuche <span class="ta-sort-ind">@Ind("visits")</span></th>
                            <th>Zahlung</th>
                            <th class="ta-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in shown)
                        {
                            <tr>
                                <td>
                                    <span class="ta-ticketno">@AdminFormat.TicketNo(p.Uuid)</span>
                                    <a class="ta-qr-link" href="@p.TicketUrl" target="_blank" rel="noopener" title="Online-Ticket" aria-label="Online-Ticket">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17 14h.01M20 14v3M14 17h.01M17 20h3M20 20h.01"/></svg>
                                    </a>
                                </td>
                                <td class="ta-cell-name">
                                    <PersonCell Holder="p.Holder" />
                                </td>
                                <td title="@AdminFormat.CreatedTooltip(p.CreatedAt, p.CreatedByName, null, OnlineMarker(p))">@AdminFormat.CreatedShort(p.CreatedAt, p.CreatedByName, OnlineMarker(p))</td>
                                <td>@(string.IsNullOrEmpty(p.Reference) ? "–" : p.Reference)</td>
                                <td>
                                    <InlineSelectEdit TValue="int" Value="MainTierId(p)" FieldLabel="Kategorie"
                                                      Options="MainTierIds" Label="@(id => TierName(id))"
                                                      Save="@(id => SaveTierAsync(p, id))" />
                                </td>
                                <td class="ta-num">CHF @p.Price.ToString("N2")</td>
                                <td>
                                    <InlineSelectEdit TValue="TicketStatus" Value="p.Status" FieldLabel="Status"
                                                      Options="StatusOptions" Label="@StatusLabel"
                                                      Save="@(v => SaveStatusAsync(p, v))">
                                        <Display Context="st">
                                            <span class="ta-badge ta-badge-@st.ToString().ToLowerInvariant()">@StatusLabel(st)</span>
                                        </Display>
                                    </InlineSelectEdit>
                                </td>
                                <td class="ta-num">
                                    @if (p.EventVisits > 0)
                                    {
                                        <button type="button" class="ta-visits-link" @onclick="() => OpenVisits(p)">@p.EventVisits</button>
                                    }
                                    else
                                    {
                                        <span class="ta-muted">0</span>
                                    }
                                    @if (p.Conversions > 0)
                                    {
                                        <button type="button" class="ta-conv-badge ta-conv-link" title="Diese Saisonkarte wurde für Ticketumwandlung(en) an Spezialanlässen gebraucht. Details anzeigen." @onclick="() => OpenVisits(p)">↔ @p.Conversions Uml.</button>
                                    }
                                </td>
                                <td>
                                    @(p.PaymentState ?? "–")
                                    @if (!string.IsNullOrEmpty(p.OrderNumber)) { <div class="ta-addr-sub">@p.OrderNumber</div> }
                                </td>
                                <td class="ta-col-actions">
                                    <button type="button" class="ta-icon-btn" title="@(p.HasEmail ? "E-Mail senden" : "Keine E-Mail hinterlegt")" disabled="@(!p.HasEmail)" @onclick="() => OpenMail(p)">✉</button>
                                    <button type="button" class="ta-icon-btn" title="Bearbeiten" @onclick="() => OpenEdit(p)">✎</button>
                                    <button type="button" class="ta-icon-btn" title="Als PDF drucken" @onclick="() => OpenSinglePrint(p.Uuid)">🖨</button>
                                    @if (Identity.IsAdmin)
                                    {
                                        <button type="button" class="ta-icon-btn ta-icon-btn-danger" title="Löschen" @onclick="() => _deleteTarget = p">🗑</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (shown.Count == 0)
            {
                <div class="ta-placeholder">Keine Saisonkarte passt zur Suche „@_search".</div>
            }
            <p class="ta-summary">
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <text>@shown.Count von @_passes.Count Saisonkarten · Total CHF @shown.Sum(p => p.Price).ToString("N2")</text>
                }
                else
                {
                    <text>@_passes.Count Saisonkarte@(_passes.Count == 1 ? "" : "n") · Total CHF @_passes.Sum(p => p.Price).ToString("N2")</text>
                }
            </p>
        }
    }
</section>

<style>
    .ta-noemail { display: inline-block; margin-left: 0.4rem; padding: 0.1rem 0.4rem; border-radius: 3px; background: #fff8e1; color: #7a5c00; border: 1px solid #e0b400; font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
    .ta-textarea { min-height: 9rem; resize: vertical; font-family: inherit; line-height: 1.5; }
    .ta-field--grow { flex: 1 1 18rem; }
    .ta-cards-search { width: 100%; min-width: 14rem; }
</style>

@if (_showCreate)
{
    <div class="ta-overlay" @onmousedown="CloseCreate">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Saisonkarte erstellen</h2>

            <PersonFields Model="_newPerson" Prefix="newSp" EmailHint=" (optional, für den Kartenversand)" />

            <div class="ta-field">
                <label class="ta-label" for="newSpCategory">Kategorie</label>
                <select id="newSpCategory" class="ta-select" @bind="_newTierId">
                    @foreach (var t in _tiers)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="newSpPrice">Preis (CHF)</label>
                <input id="newSpPrice" type="number" step="0.01" min="0" class="ta-input" @bind="_newPrice" @bind:after="OnNewPriceChanged" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newSpPaymentSource">Zahlart</label>
                <select id="newSpPaymentSource" class="ta-select" @bind="_newPaymentSource">
                    @foreach (var ps in PaymentSourceExtensions.AdminChoicesForPrice(_newPrice))
                    {
                        <option value="@ps">@ps.DisplayName()</option>
                    }
                </select>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newSpReference">Bundle (optional)</label>
                <input id="newSpReference" class="ta-input" type="text" maxlength="100" list="spBundleOptions" placeholder="Neu oder bestehendes wählen" @bind="_newReference" />
                <datalist id="spBundleOptions">
                    @foreach (var b in _bundles) { <option value="@b" /> }
                </datalist>
            </div>

            @if (_createError is not null)
            {
                <p class="ta-modal-error">@_createError</p>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseCreate" disabled="@_creating">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="CreatePassAsync" disabled="@_creating">
                    @(_creating ? "Erstellt …" : "Erstellen")
                </button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="ta-overlay" @onmousedown="CancelEdit">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Saisonkarte bearbeiten</h2>
            <p class="ta-modal-sub">Karten-Nr. @AdminFormat.TicketNo(_editing.Uuid)</p>

            <PersonFields Model="_editPerson" Prefix="editSp" />

            <div class="ta-field">
                <label class="ta-label" for="editPrice">Preis (CHF)</label>
                <input id="editPrice" type="number" step="0.01" min="0" class="ta-input" @bind="_editPrice" @bind:after="() => _editPrice = decimal.Round(_editPrice, 2)" />
            </div>

            @if (_editError is not null)
            {
                <p class="ta-modal-error">@_editError</p>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CancelEdit" disabled="@_saving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SaveEdit" disabled="@_saving">
                    @(_saving ? "Speichert …" : "Speichern")
                </button>
            </div>
        </div>
    </div>
}

@if (_visitsPass is not null)
{
    <VisitsOverlay Uuid="_visitsPass.Uuid" Title="@(_visitsPass.BuyerName ?? AdminFormat.TicketNo(_visitsPass.Uuid))" OnClose="CloseVisits" />
}

@if (_deleteTarget is not null)
{
    <DeleteSeasonPassDialog Pass="_deleteTarget" OnDeleted="PassDeletedAsync" OnClosed="CloseDelete" />
}

@if (_showImport)
{
    <div class="ta-overlay" @onmousedown="CloseImport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Saisonkarten importieren</h2>

            <div class="ta-field">
                <label class="ta-label">Saison</label>
                <div class="ta-readonly">@SelectedSeasonName</div>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="impSpCategory">Kategorie (Vorauswahl, Datei kann überschreiben)</label>
                <select id="impSpCategory" class="ta-select" @bind="_importTierId">
                    @foreach (var t in _tiers.Where(t => !t.IsPromo))
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="impSpReference">Bundle</label>
                <input id="impSpReference" class="ta-input" type="text" maxlength="100" list="spImportBundleOptions" placeholder="z. B. Sponsoren 2026" @bind="_importReference" />
                <datalist id="spImportBundleOptions">
                    @foreach (var b in _bundles) { <option value="@b" /> }
                </datalist>
                <p class="ta-hint">Gilt für Zeilen ohne eigene Bundle-Spalte; eine Bundle-Spalte in der Datei hat Vorrang.</p>
            </div>

            <div class="ta-field">
                <label class="ta-label">Datei (CSV oder Excel)</label>
                <InputFile OnChange="OnImportFileAsync" accept=".csv,.xlsx,text/csv" />
                <p class="ta-hint">
                    Spalten (alle optional): Karten-Nr, Bundle, Kategorie, Firma, Anrede, Name, Vorname, Strasse, Adresszusatz, PLZ, Ort, Land, E-Mail, Telefon, Geburtsdatum (dd.MM.yyyy).
                    Die Spalten werden automatisch erkannt; passt die Zuordnung nicht, unten von Hand anpassen.
                    Zeilen mit bestehender Karten-Nr werden aktualisiert.
                    <a href="/admin/season-passes/example.csv" target="_blank" rel="noopener">Beispieldatei herunterladen</a>
                </p>
            </div>

            @if (_importTable is not null && _importTable.Columns.Count > 0)
            {
                <div class="ta-field">
                    @if (!_showMapping)
                    {
                        <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => _showMapping = true">Spaltenzuordnung anpassen</button>
                    }
                    else
                    {
                        <label class="ta-label">Spaltenzuordnung</label>
                        <p class="ta-hint">Ordne jeder benötigten Spalte eine Spalte aus deiner Datei zu.</p>
                        <table class="ta-map">
                            @foreach (var field in TicketImportCsv.Fields)
                            {
                                <tr>
                                    <td class="ta-map-label">@field.Label</td>
                                    <td>
                                        <select class="ta-select" value="@MapValue(field.Key)" @onchange="e => SetMap(field.Key, e.Value?.ToString())">
                                            <option value="-1">(nicht zuordnen)</option>
                                            @for (var i = 0; i < _importTable.Columns.Count; i++)
                                            {
                                                var idx = i;
                                                <option value="@idx">@_importTable.Columns[idx]</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </table>
                        <div class="ta-modal-actions">
                            <button type="button" class="ta-btn ta-btn-primary" @onclick="ApplyMapping">Zuordnung übernehmen</button>
                        </div>
                    }
                </div>
            }

            @if (_importFileName is not null)
            {
                <div class="ta-parse">
                    <strong>@_importFileName</strong>: @_importRows.Count gültige Zeile@(_importRows.Count == 1 ? "" : "n") erkannt.
                    @if (_importWarnings.Count > 0)
                    {
                        <ul class="ta-warnings">
                            @foreach (var w in _importWarnings) { <li>@w</li> }
                        </ul>
                    }
                </div>
                @if (_importErrors.Count > 0)
                {
                    <div class="ta-error">
                        @_importErrors.Count Fehler, bitte in der Datei korrigieren:
                        <ul class="ta-warnings">
                            @foreach (var er in _importErrors) { <li>@er</li> }
                        </ul>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(_importError)) { <div class="ta-error">@_importError</div> }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseImport" disabled="@_importSaving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="RunImportAsync" disabled="@(_importSaving || _importRows.Count == 0 || _importErrors.Count > 0)">
                    @(_importSaving ? "Wird importiert …" : _importErrors.Count > 0 ? "Bitte Fehler beheben" : $"{_importRows.Count} Saisonkarten importieren")
                </button>
            </div>
        </div>
    </div>
}

@if (_showExport)
{
    <ExportSeasonPassesDialog SeasonId="SelectedSeasonId" Bundles="_bundles" OnClosed="CloseExport" />
}

@if (_showBulk)
{
    <div class="ta-overlay" @onmousedown="CloseBulk">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Karten versenden</h2>

            @if (_bulkResult is not null)
            {
                <div class="ta-flash">@_bulkResult.Enqueued Karte@(_bulkResult.Enqueued == 1 ? "" : "n") eingereiht@(_bulkResult.Failed > 0 ? $", {_bulkResult.Failed} fehlgeschlagen" : "").</div>
                @if (_bulkResult.NoEmail.Count > 0)
                {
                    <p class="ta-hint">@_bulkResult.NoEmail.Count Karte@(_bulkResult.NoEmail.Count == 1 ? "" : "n") ohne E-Mail übersprungen:</p>
                    <ul class="ta-warnings">
                        @foreach (var p in _bulkResult.NoEmail)
                        {
                            <li>@(p.BuyerName ?? "(ohne Name)") · @AdminFormat.TicketNo(p.Uuid)</li>
                        }
                    </ul>
                }
                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="CloseBulk">Schliessen</button>
                </div>
            }
            else if (_bundles.Count == 0)
            {
                <p class="ta-muted-text">Für diese Saison sind keine Bundles vorhanden.</p>
                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseBulk">Schliessen</button>
                </div>
            }
            else
            {
                <div class="ta-field">
                    <label class="ta-label" for="bulkBundle">Bundle</label>
                    <select id="bulkBundle" class="ta-select" @bind="_bulkBundle" @bind:after="LoadBulkCardsAsync">
                        @foreach (var b in _bundles)
                        {
                            <option value="@b">@b</option>
                        }
                    </select>
                </div>
                <p class="ta-hint">@BundleWithEmail Karte@(BundleWithEmail == 1 ? "" : "n") mit E-Mail werden versendet · @BundleWithoutEmail ohne E-Mail werden übersprungen.</p>

                <div class="ta-field">
                    <label class="ta-label" for="bulkSubject">Betreff</label>
                    <input id="bulkSubject" class="ta-input" type="text" maxlength="200" @bind="_bulkSubject" />
                </div>
                <div class="ta-field">
                    <label class="ta-label" for="bulkBody">Text</label>
                    <textarea id="bulkBody" class="ta-input ta-textarea" @bind="_bulkBody"></textarea>
                    <p class="ta-hint">Platzhalter: {Name}, {Vorname}, {Nachname}, {Saison}. Markdown wird unterstützt. QR-Code, Online-Karte und PDF-Link werden je Karte angehängt.</p>
                </div>

                @if (!string.IsNullOrEmpty(_bulkError))
                {
                    <div class="ta-modal-error">@_bulkError</div>
                }

                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseBulk" disabled="@_bulkSending">Abbrechen</button>
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="SendBulk" disabled="@(_bulkSending || BundleWithEmail == 0)">
                        @(_bulkSending ? "Sendet …" : $"{BundleWithEmail} Karten senden")
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_mailFor is not null)
{
    <SendSeasonPassMailDialog Pass="_mailFor" OnClosed="CloseMail" />
}

@if (_showPrint)
{
    <PrintSeasonPassesDialog Uuid="_printUuid" SeasonId="SelectedSeasonId" Bundle="@_bundleFilter"
                             BundleCount="BundleCount" OnClosed="ClosePrint" />
}

@code {
    [Parameter] public string AdminUser { get; set; } = "";
    [CascadingParameter] public AdminIdentity Identity { get; set; } = new("admin", null);

    [Inject] private GetSeasonChoices.Handler SeasonChoices { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;

    private bool _showPrint;
    private Guid? _printUuid;

    private int BundleCount => _passes.Count(p => string.Equals(p.Reference, _bundleFilter, StringComparison.Ordinal));

    private void OpenBundlePrint()
    {
        if (string.IsNullOrEmpty(_bundleFilter)) return;
        _printUuid = null;
        _showPrint = true;
    }

    private void OpenSinglePrint(Guid uuid)
    {
        _printUuid = uuid;
        _showPrint = true;
    }

    private void ClosePrint() => _showPrint = false;

    private SeasonPassRow? _deleteTarget;

    private void CloseDelete() => _deleteTarget = null;

    private async Task PassDeletedAsync()
    {
        _deleteTarget = null;
        await ReloadPassesAsync();
    }

    private bool _loading = true;
    private IReadOnlyList<SeasonChoice> _seasons = [];
    private IReadOnlyList<SeasonPassRow> _passes = [];
    private IReadOnlyList<string> _bundles = [];
    private int _total;

    public int SelectedSeasonId { get; set; }

    private string _sortCol = "buyer";
    private bool _sortAsc = true;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        _seasons = await SeasonChoices.HandleAsync(new GetSeasonChoices.Query());
        SelectedSeasonId = AdminState.SelectedSeasonId is int id && _seasons.Any(s => s.Id == id)
            ? id
            : _seasons.FirstOrDefault(s => s.IsCurrent)?.Id ?? _seasons.FirstOrDefault()?.Id ?? 0;
        await ReloadPassesAsync();
        _loading = false;
    }

    private async Task ReloadPassesAsync()
    {
        AdminState.SelectedSeasonId = SelectedSeasonId > 0 ? SelectedSeasonId : null;
        var result = SelectedSeasonId > 0
            ? await PassList.HandleAsync(new GetSeasonPasses.Query(SelectedSeasonId, _bundleFilter, _search))
            : new GetSeasonPasses.Result([], [], 0);
        _passes = result.Passes;
        _bundles = result.Bundles;
        _total = result.Total;
        _tiers = SelectedSeasonId > 0 ? await PriceTiers.HandleAsync(new GetPriceTiers.Query(SelectedSeasonId)) : [];
    }

    private void Sort(string col) { _sortAsc = _sortCol == col ? !_sortAsc : true; _sortCol = col; }
    private string Ind(string col) => _sortCol == col ? (_sortAsc ? "▲" : "▼") : "";
    private IEnumerable<SeasonPassRow> Sorted()
    {
        var src = _passes;
        IEnumerable<SeasonPassRow> q = _sortCol switch
        {
            "category" => src.OrderBy(p => p.CategoryName),
            "price" => src.OrderBy(p => p.Price),
            "status" => src.OrderBy(p => p.Status),
            "visits" => src.OrderBy(p => p.EventVisits),
            "created" => src.OrderBy(p => p.CreatedAt),
            "bundle" => src.OrderBy(p => p.Reference ?? "￿"),
            _ => src.OrderBy(p => p.BuyerSortKey),
        };
        return _sortAsc ? q : q.Reverse();
    }

