    private IReadOnlyList<PriceTierRow> _tiers = [];
    private bool _showCreate;
    private bool _creating;
    private int _newTierId;
    private decimal _newPrice;
    private PaymentSource _newPaymentSource = PaymentSource.Sponsoring;
    private PersonForm _newPerson = new();
    private string _newReference = "";
    private string? _createError;

    private void OnNewPriceChanged()
    {
        _newPrice = decimal.Round(_newPrice, 2);
        var choices = PaymentSourceExtensions.AdminChoicesForPrice(_newPrice);
        if (!choices.Contains(_newPaymentSource)) _newPaymentSource = choices[0];
    }

    private static PaymentSource ClampPaymentSource(PaymentSource source, decimal price)
    {
        var choices = PaymentSourceExtensions.AdminChoicesForPrice(price);
        return choices.Contains(source) ? source : choices[0];
    }

    private void OpenCreate()
    {
        _newTierId = _tiers.FirstOrDefault(t => !t.IsPromo)?.Id ?? _tiers.FirstOrDefault()?.Id ?? 0;
        _newPrice = 0m;
        _newPaymentSource = PaymentSourceExtensions.AdminChoicesForPrice(0m)[0];
        _newPerson = new PersonForm();
        _newReference = "";
        _createError = null;
        _showCreate = true;
    }
    private void CloseCreate() { _showCreate = false; _createError = null; }

    private async Task CreatePassAsync()
    {
        if (_creating) return;
        if (SelectedSeasonId <= 0) { _createError = "Es ist keine Saison gewählt."; return; }
        if (_newTierId <= 0) { _createError = "Es ist keine Stufe gewählt."; return; }
        if (_newPrice < 0) { _createError = "Der Preis darf nicht negativ sein."; return; }
        _creating = true;
        _createError = null;
        try
        {
            var tier = _tiers.FirstOrDefault(t => t.Id == _newTierId);
            if (tier is null) { _createError = "Die gewählte Stufe wurde nicht gefunden."; return; }
            var lineCategory = tier.LegacyCategory is { } lc ? (TicketCategory)lc : TicketCategory.Adult;
            var buyer = _newPerson.ToBuyer();
            if (buyer is null) { _createError = "Bitte Vor-/Nachname oder Firmenname angeben."; return; }
            var paymentSource = ClampPaymentSource(_newPaymentSource, _newPrice);
            var order = await OrderCreation.HandleAsync(new CreateAdminOrder.Command(buyer, Identity.Email,
                [new AdminOrderLine(OrderItemKind.SeasonPass, SelectedSeasonId, lineCategory, tier.Name, 1, _newPrice)],
                Identity.Name, paymentSource));
            await PassCreation.HandleAsync(new CreateSeasonPass.Command(SelectedSeasonId, _newTierId, _newPrice, order.Id, buyer,
                string.IsNullOrWhiteSpace(_newReference) ? null : _newReference.Trim(),
                string.IsNullOrWhiteSpace(_newPerson.Email) ? null : _newPerson.Email!.Trim(),
                _newPerson.ToHolder(), Identity.Name, Identity.Email));
            _showCreate = false;
            await ReloadPassesAsync();
        }
        catch (DomainException ex) { _createError = ex.Message; }
        finally { _creating = false; }
    }

