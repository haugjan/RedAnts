    private bool _showBulk;
    private string _bulkBundle = "";
    private string _bulkSubject = "";
    private string _bulkBody = "";
    private bool _bulkSending;
    private string? _bulkError;
    private BulkResult? _bulkResult;

    private sealed record BulkResult(int Enqueued, int Failed, IReadOnlyList<SeasonPassRow> NoEmail);

    private IReadOnlyList<SeasonPassRow> _bulkCards = [];

    private int BundleWithEmail => _bulkCards.Count(p => p.HasEmail);
    private int BundleWithoutEmail => _bulkCards.Count(p => !p.HasEmail);

    private async Task OpenBulk()
    {
        _bulkBundle = _bundles.FirstOrDefault() ?? "";
        var template = await MailTemplate.HandleAsync(new GetSeasonPassMailTemplate.Query());
        _bulkSubject = template.Subject;
        _bulkBody = template.Body;
        _bulkResult = null;
        _bulkError = null;
        await LoadBulkCardsAsync();
        _showBulk = true;
    }

    private async Task LoadBulkCardsAsync()
    {
        var result = string.IsNullOrWhiteSpace(_bulkBundle)
            ? null
            : await PassList.HandleAsync(new GetSeasonPasses.Query(SelectedSeasonId, _bulkBundle));
        _bulkCards = result?.Passes.Where(p => p.Status != TicketStatus.Cancelled).ToList() ?? [];
    }

    private void CloseBulk() { if (!_bulkSending) { _showBulk = false; _bulkError = null; _bulkResult = null; } }

    private async Task SendBulk()
    {
        if (_bulkSending || string.IsNullOrWhiteSpace(_bulkBundle)) return;
        _bulkSending = true;
        _bulkError = null;
        _bulkResult = null;
        try
        {
            var targets = _bulkCards;
            var noEmail = targets.Where(p => !p.HasEmail).ToList();
            var enqueued = 0;
            var failed = 0;
            foreach (var p in targets.Where(p => p.HasEmail))
            {
                try
                {
                    var result = await SendToAsync(p, _bulkSubject, _bulkBody);
                    if (result.Success) enqueued++;
                    else failed++;
                }
                catch { failed++; }
            }
            _bulkResult = new BulkResult(enqueued, failed, noEmail);
        }
        catch (Exception ex) { _bulkError = ex.Message; }
        finally { _bulkSending = false; }
    }
}
