@using RedAnts.Ticketing.Domain.Sales
@inject GetSeasonPassMailTemplate.Handler MailTemplate
@inject GetSeasonPasses.Handler PassList
@inject SendSeasonPassMail.Handler PassMail

<div class="ta-overlay" @onmousedown="Close">
    <div class="ta-modal" @onmousedown:stopPropagation="true">
        <h2 class="ta-modal-title">Karten versenden</h2>

        @if (_result is not null)
        {
            <div class="ta-flash">@_result.Enqueued Karte@(_result.Enqueued == 1 ? "" : "n") eingereiht@(_result.Failed > 0 ? $", {_result.Failed} fehlgeschlagen" : "").</div>
            @if (_result.NoEmail.Count > 0)
            {
                <p class="ta-hint">@_result.NoEmail.Count Karte@(_result.NoEmail.Count == 1 ? "" : "n") ohne E-Mail übersprungen:</p>
                <ul class="ta-warnings">
                    @foreach (var p in _result.NoEmail)
                    {
                        <li>@(p.BuyerName ?? "(ohne Name)") · @AdminFormat.TicketNo(p.Uuid)</li>
                    }
                </ul>
            }
            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-primary" @onclick="Close">Schliessen</button>
            </div>
        }
        else if (Bundles.Count == 0)
        {
            <p class="ta-muted-text">Für diese Saison sind keine Bundles vorhanden.</p>
            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="Close">Schliessen</button>
            </div>
        }
        else
        {
            <div class="ta-field">
                <label class="ta-label" for="bulkBundle">Bundle</label>
                <select id="bulkBundle" class="ta-select" @bind="_bundle" @bind:after="LoadCardsAsync">
                    @foreach (var b in Bundles)
                    {
                        <option value="@b">@b</option>
                    }
                </select>
            </div>
            <p class="ta-hint">@WithEmail Karte@(WithEmail == 1 ? "" : "n") mit E-Mail werden versendet · @WithoutEmail ohne E-Mail werden übersprungen.</p>

            <div class="ta-field">
                <label class="ta-label" for="bulkSubject">Betreff</label>
                <input id="bulkSubject" class="ta-input" type="text" maxlength="200" @bind="_subject" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="bulkBody">Text</label>
                <textarea id="bulkBody" class="ta-input ta-textarea" @bind="_body"></textarea>
                <p class="ta-hint">Platzhalter: {Name}, {Vorname}, {Nachname}, {Saison}. Markdown wird unterstützt. QR-Code, Online-Karte und PDF-Link werden je Karte angehängt.</p>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="ta-modal-error">@_error</div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="Close" disabled="@_sending">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SendAsync" disabled="@(_sending || WithEmail == 0)">
                    @(_sending ? "Sendet …" : $"{WithEmail} Karten senden")
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int SeasonId { get; set; }
    [Parameter] public IReadOnlyList<string> Bundles { get; set; } = [];
    [Parameter] public EventCallback OnClosed { get; set; }

    private string _bundle = "";
    private string _subject = "";
    private string _body = "";
    private bool _sending;
    private string? _error;
    private BundleMailResult? _result;
    private IReadOnlyList<SeasonPassRow> _cards = [];

    private sealed record BundleMailResult(int Enqueued, int Failed, IReadOnlyList<SeasonPassRow> NoEmail);

    private int WithEmail => _cards.Count(p => p.HasEmail);
    private int WithoutEmail => _cards.Count(p => !p.HasEmail);

    protected override async Task OnInitializedAsync()
    {
        _bundle = Bundles.FirstOrDefault() ?? "";
        var template = await MailTemplate.HandleAsync(new GetSeasonPassMailTemplate.Query());
        _subject = template.Subject;
        _body = template.Body;
        await LoadCardsAsync();
    }

    private async Task LoadCardsAsync()
    {
        var result = string.IsNullOrWhiteSpace(_bundle)
            ? null
            : await PassList.HandleAsync(new GetSeasonPasses.Query(SeasonId, _bundle));
        _cards = result?.Passes.Where(p => p.Status != TicketStatus.Cancelled).ToList() ?? [];
    }

    private async Task SendAsync()
    {
        if (_sending || string.IsNullOrWhiteSpace(_bundle)) return;
        _sending = true;
        _error = null;
        _result = null;
        try
        {
            var targets = _cards;
            var noEmail = targets.Where(p => !p.HasEmail).ToList();
            var enqueued = 0;
            var failed = 0;
            foreach (var p in targets.Where(p => p.HasEmail))
            {
                try
                {
                    var result = await PassMail.HandleAsync(
                        new SendSeasonPassMail.Command(p.Uuid, p.CategoryName, p.Email, _subject, _body));
                    if (result.Success) enqueued++;
                    else failed++;
                }
                catch { failed++; }
            }
            _result = new BundleMailResult(enqueued, failed, noEmail);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _sending = false; }
    }

    private Task Close() => _sending ? Task.CompletedTask : OnClosed.InvokeAsync();
}
