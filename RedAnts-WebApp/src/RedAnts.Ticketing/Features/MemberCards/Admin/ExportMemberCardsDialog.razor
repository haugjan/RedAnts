<div class="ta-overlay" @onmousedown="Close">
    <div class="ta-modal" @onmousedown:stopPropagation="true">
        <h2 class="ta-modal-title">Mitglieder exportieren (CSV)</h2>
        <p class="ta-modal-sub">Bundle wählen (Mehrfachauswahl möglich).</p>

        @if (Bundles.Count == 0)
        {
            <p class="ta-muted-text">Für diese Saison sind keine Bundles vorhanden.</p>
        }
        else
        {
            <div class="ta-field">
                <label class="ta-label">Bundle</label>
                <div class="ta-export-list">
                    @foreach (var r in Bundles)
                    {
                        <label class="ta-export-item">
                            <input type="checkbox" checked="@_selected.Contains(r)"
                                   @onchange="e => Toggle(r, (bool)(e.Value ?? false))" /> @r
                        </label>
                    }
                </div>
            </div>
        }

        <div class="ta-modal-actions">
            <button type="button" class="ta-btn ta-btn-ghost" @onclick="Close">Schliessen</button>
            @if (_selected.Count > 0)
            {
                <a class="ta-btn ta-btn-primary" href="/admin/members/season/@SeasonId/cards.csv?bundles=@Uri.EscapeDataString(string.Join(",", _selected))"
                   target="_blank" rel="noopener" @onclick="Close">Herunterladen</a>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int SeasonId { get; set; }
    [Parameter] public IReadOnlyList<string> Bundles { get; set; } = [];
    [Parameter] public EventCallback OnClosed { get; set; }

    private readonly HashSet<string> _selected = [];

    private void Toggle(string bundle, bool on) { if (on) _selected.Add(bundle); else _selected.Remove(bundle); }

    private Task Close() => OnClosed.InvokeAsync();
}
