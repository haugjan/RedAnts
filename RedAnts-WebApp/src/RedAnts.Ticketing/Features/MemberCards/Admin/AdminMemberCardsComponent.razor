@using RedAnts.Ticketing.Domain
@using RedAnts.Ticketing.Domain.Sales

<section class="ta-page">
    <h1 class="ta-page-title">Mitglieder</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="mcSeasonSelect">Saison</label>
                    <select id="mcSeasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="ReloadCardsAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="mcBundleFilter">Bundle</label>
                    <select id="mcBundleFilter" class="ta-select" @bind="_bundleFilter" @bind:after="ReloadCardsAsync">
                        <option value="">Alle anzeigen</option>
                        @foreach (var b in _bundles)
                        {
                            <option value="@b">@b</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="mcSearch">Suche</label>
                    <input id="mcSearch" type="search" class="ta-input"
                           placeholder="Name, E-Mail, Bundle …"
                           @bind="_search" @bind:event="oninput" @bind:after="ReloadCardsAsync" />
                </div>
            </div>
            <div class="ta-toolbar-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="OpenExport" disabled="@(_total == 0)"
                        title="Mitglieder eines Bundles als CSV herunterladen">Export CSV</button>
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="OpenImport" disabled="@(SelectedSeasonId <= 0)">
                    Import CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="OpenBulk" disabled="@(_total == 0)"
                        title="Alle Karten eines Bundles per E-Mail versenden">Karten versenden</button>
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="OpenBundlePrint" disabled="@(string.IsNullOrEmpty(_bundleFilter))"
                        title="@(string.IsNullOrEmpty(_bundleFilter) ? "Zum Drucken zuerst ein Bundle wählen" : "Alle Karten dieses Bundles als PDF drucken")">PDF drucken</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="OpenCreate" disabled="@(SelectedSeasonId <= 0)">
                    Mitgliederkarte erstellen
                </button>
            </div>
        </div>

        @if (_total == 0)
        {
            <div class="ta-placeholder">Für diese Saison sind keine Mitgliederkarten erfasst.</div>
        }
        else
        {
            var shown = Sorted().ToList();
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Karten-Nr.</th>
                            <th class="ta-th-sort" @onclick='() => Sort("name")'>Person <span class="ta-sort-ind">@Ind("name")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("created")'>Erstellt <span class="ta-sort-ind">@Ind("created")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("reference")'>Bundle <span class="ta-sort-ind">@Ind("reference")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("category")'>Kategorie <span class="ta-sort-ind">@Ind("category")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("admissions")' title="Einlässe pro Event">Anzahl <span class="ta-sort-ind">@Ind("admissions")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("status")'>Status <span class="ta-sort-ind">@Ind("status")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("visits")'>Event&shy;besuche <span class="ta-sort-ind">@Ind("visits")</span></th>
                            <th class="ta-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in shown)
                        {
                            <tr>
                                <td>
                                    <span class="ta-ticketno">@AdminFormat.TicketNo(c.Uuid)</span>
                                    <a class="ta-qr-link" href="@c.TicketUrl" target="_blank" rel="noopener" title="Online-Ticket" aria-label="Online-Ticket">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17 14h.01M20 14v3M14 17h.01M17 20h3M20 20h.01"/></svg>
                                    </a>
                                </td>
                                <td class="ta-cell-name">
                                    <PersonCell Holder="c.Holder" />
                                </td>
                                <td title="@AdminFormat.CreatedTooltip(c.CreatedAt, c.CreatedByName, null, null)">@AdminFormat.CreatedShort(c.CreatedAt, c.CreatedByName, null)</td>
                                <td>@(string.IsNullOrEmpty(c.Reference) ? "–" : c.Reference)</td>
                                <td>
                                    <InlineSelectEdit TValue="MemberCategory" Value="c.Category" FieldLabel="Kategorie"
                                                      Options="MemberCategoryOptions" Label="@(m => m.DisplayName())"
                                                      Save="@(m => SaveCategoryAsync(c, m))">
                                        <Display Context="cat">
                                            <span class="ta-badge @CategoryBadgeClass(cat)">@cat.DisplayName()</span>
                                        </Display>
                                    </InlineSelectEdit>
                                </td>
                                <td class="ta-num">
                                    @if (c.Admissions > 1)
                                    {
                                        <span class="ta-badge ta-badge-block4" title="@c.Admissions Einlässe pro Event">@c.Admissions×</span>
                                    }
                                    else
                                    {
                                        <span class="ta-muted">1</span>
                                    }
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketStatus" Value="c.Status" FieldLabel="Status"
                                                      Options="MemberStatusOptions" Label="@StatusLabel"
                                                      Save="@(s => SaveStatusAsync(c, s))">
                                        <Display Context="st">
                                            <span class="ta-badge @(st == TicketStatus.Cancelled ? "ta-badge-cancelled" : "ta-badge-valid")">@StatusLabel(st)</span>
                                        </Display>
                                    </InlineSelectEdit>
                                </td>
                                <td class="ta-num">
                                    @if (c.EventVisits > 0)
                                    {
                                        <button type="button" class="ta-visits-link" @onclick="() => OpenVisits(c)">@c.EventVisits</button>
                                    }
                                    else
                                    {
                                        <span class="ta-muted">0</span>
                                    }
                                    @if (c.Conversions > 0)
                                    {
                                        <button type="button" class="ta-conv-badge ta-conv-link" title="Diese Mitgliederkarte wurde für Ticketumwandlung(en) an Spezialanlässen gebraucht. Details anzeigen." @onclick="() => OpenVisits(c)">↔ @c.Conversions Uml.</button>
                                    }
                                </td>
                                <td class="ta-col-actions">
                                    <button type="button" class="ta-icon-btn" title="@(c.HasEmail ? "E-Mail senden" : "Keine E-Mail hinterlegt")" disabled="@(!c.HasEmail)" @onclick="() => OpenMail(c)">✉</button>
                                    <button type="button" class="ta-icon-btn" title="Bearbeiten" @onclick="() => OpenEdit(c)">✎</button>
                                    <button type="button" class="ta-icon-btn" title="Als PDF drucken" @onclick="() => OpenSinglePrint(c.Uuid)">🖨</button>
                                    @if (Identity.IsAdmin)
                                    {
                                        <button type="button" class="ta-icon-btn ta-icon-btn-danger" title="Löschen" @onclick="() => _deleteTarget = c">🗑</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (shown.Count == 0)
            {
                <div class="ta-placeholder">Keine Mitgliederkarte passt zur Suche „@_search".</div>
            }
            <p class="ta-summary">
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <text>@shown.Count von @_total Mitgliederkarten</text>
                }
                else
                {
                    <text>@_total Mitgliederkarte@(_total == 1 ? "" : "n")</text>
                }
            </p>
        }
    }
</section>

<style>
    .ta-noemail { display: inline-block; margin-left: 0.4rem; padding: 0.1rem 0.4rem; border-radius: 3px; background: #fff8e1; color: #7a5c00; border: 1px solid #e0b400; font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
    .ta-textarea { min-height: 9rem; resize: vertical; font-family: inherit; line-height: 1.5; }
    .ta-field--grow { flex: 1 1 18rem; }
    .ta-cards-search { width: 100%; min-width: 14rem; }
    .ta-modal-section { margin: 1.1rem 0 0.4rem; font-weight: 700; font-size: 0.85rem; color: var(--ta-muted); border-top: 1px solid var(--ta-border); padding-top: 0.9rem; }
    .ta-modal--members { width: min(94vw, 680px); max-width: 680px; }
    .ta-mc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.25rem; }
    .ta-mc-grid > .ta-modal-section { grid-column: 1 / -1; margin-top: 0.6rem; }
    @@media (max-width: 560px) { .ta-mc-grid { grid-template-columns: 1fr; } }
</style>

@if (_showCreate)
{
    <CreateMemberCardDialog SeasonId="SelectedSeasonId" SeasonName="@_selectedSeasonName" Bundles="_bundles"
                            OnSaved="CardCreatedAsync" OnClosed="CloseCreate" />
}

@if (_showExport)
{
    <ExportMemberCardsDialog SeasonId="SelectedSeasonId" Bundles="_bundles" OnClosed="CloseExport" />
}

@if (_showImport)
{
    <ImportMemberCardsDialog SeasonId="SelectedSeasonId" SeasonName="@_selectedSeasonName"
                             OnSaved="CardsImportedAsync" OnClosed="CloseImport" />
}

@if (_editing is not null)
{
    <EditMemberCardDialog Card="_editing" OnSaved="CardSavedAsync" OnClosed="CancelEdit" />
}

@if (_showBulk)
{
    <SendMemberCardBundleMailDialog Batches="_batches" OnClosed="CloseBulk" />
}

@if (_mailFor is not null)
{
    <SendMemberCardMailDialog Card="_mailFor" OnClosed="CloseMail" />
}

@if (_visitsCard is not null)
{
    <VisitsOverlay Uuid="_visitsCard.Uuid" Title="@(_visitsCard.HasName ? _visitsCard.HolderName : AdminFormat.TicketNo(_visitsCard.Uuid))" OnClose="CloseVisits" />
}

@if (_deleteTarget is not null)
{
    <DeleteMemberCardDialog Card="_deleteTarget" OnDeleted="CardDeletedAsync" OnClosed="CloseDelete" />
}

@if (_showPrint)
{
    <PrintMemberCardsDialog Uuid="_printUuid" SeasonId="SelectedSeasonId" Bundle="@_bundleFilter"
                            BundleCount="BundleCount" OnClosed="ClosePrint" />
}

@code {
    [Parameter] public string AdminUser { get; set; } = "";
    [CascadingParameter] public AdminIdentity Identity { get; set; } = new("admin", null);

    [Inject] private GetSeasonChoices.Handler SeasonChoices { get; set; } = default!;
    [Inject] private GetMemberCards.Handler CardList { get; set; } = default!;
    [Inject] private SetMemberCardStatus.Handler CardStatus { get; set; } = default!;
    [Inject] private SetMemberCardCategory.Handler CardCategory { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;

    private bool _showPrint;
    private Guid? _printUuid;

    private int BundleCount => _cards.Count(c => string.Equals(c.Reference, _bundleFilter, StringComparison.Ordinal));

    private void OpenBundlePrint()
    {
        if (string.IsNullOrEmpty(_bundleFilter)) return;
        _printUuid = null;
        _showPrint = true;
    }

    private void OpenSinglePrint(Guid uuid)
    {
        _printUuid = uuid;
        _showPrint = true;
    }

    private void ClosePrint() => _showPrint = false;

    private MemberCardRow? _deleteTarget;

    private void CloseDelete() => _deleteTarget = null;

    private async Task CardDeletedAsync()
    {
        _deleteTarget = null;
        await ReloadCardsAsync();
    }

    private bool _loading = true;
    private IReadOnlyList<SeasonChoice> _seasons = [];
    private IReadOnlyList<MemberCardRow> _cards = [];
    private IReadOnlyList<string> _bundles = [];
    private IReadOnlyList<MemberCardMailBatch> _batches = [];
    private int _total;

    public int SelectedSeasonId { get; set; }
    private string _selectedSeasonName = "";

    private string _sortCol = "category";
    private bool _sortAsc = true;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        _seasons = await SeasonChoices.HandleAsync(new GetSeasonChoices.Query());
        SelectedSeasonId = AdminState.SelectedSeasonId is int id && _seasons.Any(s => s.Id == id)
            ? id
            : _seasons.FirstOrDefault(s => s.IsCurrent)?.Id ?? _seasons.FirstOrDefault()?.Id ?? 0;
        await ReloadCardsAsync();
        _loading = false;
    }

    private async Task ReloadCardsAsync()
    {
        AdminState.SelectedSeasonId = SelectedSeasonId > 0 ? SelectedSeasonId : null;
        _selectedSeasonName = _seasons.FirstOrDefault(s => s.Id == SelectedSeasonId)?.Name ?? "";
        var result = SelectedSeasonId > 0
            ? await CardList.HandleAsync(new GetMemberCards.Query(SelectedSeasonId, _bundleFilter, _search))
            : new GetMemberCards.Result([], [], [], 0);
        _cards = result.Cards;
        _bundles = result.Bundles;
        _batches = result.MailBatches;
        _total = result.Total;
    }

    private void Sort(string col) { _sortAsc = _sortCol == col ? !_sortAsc : true; _sortCol = col; }
    private string Ind(string col) => _sortCol == col ? (_sortAsc ? "▲" : "▼") : "";
    private IEnumerable<MemberCardRow> Sorted()
    {
        var src = _cards;
        IEnumerable<MemberCardRow> q = _sortCol switch
        {
            "category" => src.OrderBy(c => c.Category).ThenBy(c => c.SortKey),
            "admissions" => src.OrderBy(c => c.Admissions),
            "reference" => src.OrderBy(c => c.Reference ?? "￿"),
            "status" => src.OrderBy(c => c.Status),
            "visits" => src.OrderBy(c => c.EventVisits),
            "created" => src.OrderBy(c => c.CreatedAt),
            _ => src.OrderBy(c => c.SortKey),
        };
        return _sortAsc ? q : q.Reverse();
    }

    private string _bundleFilter = "";

    private bool _showCreate;

    private void OpenCreate() => _showCreate = true;

    private void CloseCreate() => _showCreate = false;

    private async Task CardCreatedAsync()
    {
        _showCreate = false;
        await ReloadCardsAsync();
    }

    private bool _showExport;

    private void OpenExport() => _showExport = true;

    private void CloseExport() => _showExport = false;

    private bool _showImport;

    private void OpenImport() => _showImport = true;

    private void CloseImport() => _showImport = false;

    private async Task CardsImportedAsync()
    {
        _showImport = false;
        await ReloadCardsAsync();
    }

    private MemberCardRow? _editing;

    private void OpenEdit(MemberCardRow c) => _editing = c;

    private void CancelEdit() => _editing = null;

    private async Task CardSavedAsync()
    {
        _editing = null;
        await ReloadCardsAsync();
    }

    private MemberCardRow? _visitsCard;
    private void OpenVisits(MemberCardRow c) => _visitsCard = c;
    private void CloseVisits() => _visitsCard = null;

    private MemberCardRow? _mailFor;

    private void OpenMail(MemberCardRow c) => _mailFor = c;

    private void CloseMail() => _mailFor = null;

    private bool _showBulk;

    private void OpenBulk() => _showBulk = true;

    private void CloseBulk() => _showBulk = false;

    private static string CategoryBadgeClass(MemberCategory category) => category switch
    {
        MemberCategory.Block4 => "ta-badge-block4",
        MemberCategory.Company => "ta-badge-firma",
        _ => "ta-badge-redants"
    };

    private static readonly MemberCategory[] MemberCategoryOptions = [MemberCategory.RedAnts, MemberCategory.Block4, MemberCategory.Company];
    private static readonly TicketStatus[] MemberStatusOptions = [TicketStatus.Valid, TicketStatus.Cancelled];
    private static string StatusLabel(TicketStatus status) => status == TicketStatus.Cancelled ? "Storniert" : "Gültig";

    private async Task SaveCategoryAsync(MemberCardRow c, MemberCategory category)
    {
        await CardCategory.HandleAsync(new SetMemberCardCategory.Command(c.Uuid, category));
        await ReloadCardsAsync();
    }

    private async Task SaveStatusAsync(MemberCardRow c, TicketStatus status)
    {
        await CardStatus.HandleAsync(new SetMemberCardStatus.Command(c.Uuid, status));
        await ReloadCardsAsync();
    }
}
