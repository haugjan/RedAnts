@using RedAnts.Ticketing.Domain.Sales
@inject GetTicketPrintSettings.Handler PrintSettings

@if (_layout is { } layout)
{
    <TicketPrintDialog Type="TicketType.MemberCard"
                       Title="Mitgliederkarten als PDF drucken"
                       Subtitle="@Subtitle"
                       Layout="layout"
                       OnClose="OnClosed">
        <HiddenInputs>
            @if (Uuid is { } u)
            {
                <input type="hidden" name="uuid" value="@u" />
            }
            else
            {
                <input type="hidden" name="seasonId" value="@SeasonId" />
                <input type="hidden" name="reference" value="@Bundle" />
            }
        </HiddenInputs>
    </TicketPrintDialog>
}

@code {
    [Parameter] public Guid? Uuid { get; set; }
    [Parameter] public int SeasonId { get; set; }
    [Parameter] public string? Bundle { get; set; }
    [Parameter] public int BundleCount { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private TicketPrintLayout? _layout;

    protected override async Task OnInitializedAsync() =>
        _layout = await PrintSettings.HandleAsync(new GetTicketPrintSettings.Query(TicketType.MemberCard));

    private string Subtitle => Uuid is { } u
        ? $"Karten-Nr. {AdminFormat.TicketNo(u)}"
        : $"{Bundle} · {BundleCount} Karten · eine Seite pro Karte";
}
