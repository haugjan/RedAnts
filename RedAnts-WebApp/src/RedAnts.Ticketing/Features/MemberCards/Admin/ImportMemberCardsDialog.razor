@using Microsoft.AspNetCore.Components.Forms
@using RedAnts.Ticketing.Domain.Sales
@inject ImportMemberCards.Handler CardImport

<div class="ta-overlay" @onmousedown="Close">
    <div class="ta-modal" @onmousedown:stopPropagation="true">
        <h2 class="ta-modal-title">Mitglieder importieren</h2>

        <div class="ta-field">
            <label class="ta-label">Saison</label>
            <div class="ta-readonly">@SeasonName</div>
        </div>

        <div class="ta-field">
            <label class="ta-label" for="impCategory">Kategorie (gilt für alle Zeilen)</label>
            <select id="impCategory" class="ta-select" @bind="_category">
                @foreach (var cat in Categories)
                {
                    <option value="@cat">@cat.DisplayName()</option>
                }
            </select>
        </div>

        <div class="ta-field">
            <label class="ta-label" for="impReference">Bundle</label>
            <input id="impReference" class="ta-input" type="text" maxlength="100" placeholder="z. B. Mitglieder 2026" @bind="_reference" />
        </div>

        <div class="ta-field">
            <label class="ta-label">Datei (CSV oder Excel)</label>
            <InputFile OnChange="OnFileSelectedAsync" accept=".csv,.xlsx,text/csv" />
            <p class="ta-hint">
                Alle Zeilen werden als @(_category.DisplayName())-Mitglieder importiert (Kategorie oben wählen, nicht in der Datei).
                Spalten (alle optional): Anzahl (Einlässe pro Event, Standard 1), Firma, Anrede, Name, Vorname, Strasse, Adresszusatz, PLZ, Ort, Land, E-Mail, Telefon, Geburtsdatum (dd.MM.yyyy).
                Die Spalten werden automatisch erkannt. Passt die Zuordnung nicht, kannst du sie unten von Hand anpassen.
                Exportierte Zeilen mit einer bestehenden Karten-Nr werden beim erneuten Import aktualisiert.
                <a href="/admin/members/example.csv" target="_blank" rel="noopener">Beispieldatei herunterladen</a>
            </p>
        </div>

        @if (_table is not null && _table.Columns.Count > 0)
        {
            <div class="ta-field">
                @if (!_showMapping)
                {
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => _showMapping = true">Spaltenzuordnung anpassen</button>
                }
                else
                {
                    <label class="ta-label">Spaltenzuordnung</label>
                    <p class="ta-hint">Ordne jeder benötigten Spalte eine Spalte aus deiner Datei zu.</p>
                    <table class="ta-map">
                        @foreach (var field in TicketImportCsv.Fields)
                        {
                            <tr>
                                <td class="ta-map-label">@field.Label</td>
                                <td>
                                    <select class="ta-select" value="@MapValue(field.Key)" @onchange="e => SetMap(field.Key, e.Value?.ToString())">
                                        <option value="-1">(nicht zuordnen)</option>
                                        @for (var i = 0; i < _table.Columns.Count; i++)
                                        {
                                            var idx = i;
                                            <option value="@idx">@_table.Columns[idx]</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </table>
                    <div class="ta-modal-actions">
                        <button type="button" class="ta-btn ta-btn-primary" @onclick="ApplyMapping">Zuordnung übernehmen</button>
                    </div>
                }
            </div>
        }

        @if (_fileName is not null)
        {
            <div class="ta-parse">
                <strong>@_fileName</strong>: @_rows.Count gültige Zeile@(_rows.Count == 1 ? "" : "n") erkannt.
                @if (_warnings.Count > 0)
                {
                    <ul class="ta-warnings">
                        @foreach (var w in _warnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                }
            </div>
            @if (_parseErrors.Count > 0)
            {
                <div class="ta-error">
                    @_parseErrors.Count Fehler, bitte in der Datei korrigieren, dann erneut wählen:
                    <ul class="ta-warnings">
                        @foreach (var er in _parseErrors)
                        {
                            <li>@er</li>
                        }
                    </ul>
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="ta-error">@_error</div>
        }

        <div class="ta-modal-actions">
            <button type="button" class="ta-btn ta-btn-ghost" @onclick="Close" disabled="@_saving">Abbrechen</button>
            <button type="button" class="ta-btn ta-btn-primary" @onclick="ImportAsync" disabled="@(_saving || _rows.Count == 0 || _parseErrors.Count > 0)">
                @(_saving ? "Wird importiert …" : _parseErrors.Count > 0 ? "Bitte Fehler beheben" : $"{_rows.Count} Mitglieder importieren")
            </button>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public AdminIdentity Identity { get; set; } = new("admin", null);

    [Parameter] public int SeasonId { get; set; }
    [Parameter] public string SeasonName { get; set; } = "";
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private static readonly MemberCategory[] Categories = Enum.GetValues<MemberCategory>();

    private bool _saving;
    private string? _error;
    private string _reference = "";
    private MemberCategory _category = MemberCategory.RedAnts;
    private string? _fileName;
    private IReadOnlyList<MemberImportRow> _rows = [];
    private IReadOnlyList<string> _warnings = [];
    private IReadOnlyList<string> _parseErrors = [];
    private TicketImportTable? _table;
    private Dictionary<string, int> _map = new();
    private bool _showMapping;

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var table = TicketImportCsv.ReadTable(buffer.ToArray(), file.Name);
            _fileName = file.Name;
            _table = table;
            _map = new Dictionary<string, int>(table.AutoMap);

            if (table.Columns.Count == 0 || table.Rows.Count == 0)
            {
                _rows = [];
                _warnings = [];
                _parseErrors = ["Keine Datenzeilen gefunden. Bitte prüfe die Datei."];
                _showMapping = false;
                return;
            }

            if (TicketImportCsv.EssentialMapped(_map))
            {
                ApplyMapping();
            }
            else
            {
                _rows = [];
                _warnings = [];
                _parseErrors = [];
                _error = "Spalten konnten nicht automatisch erkannt werden. Bitte unten von Hand zuordnen.";
                _showMapping = true;
            }
        }
        catch (Exception ex)
        {
            _fileName = null;
            _table = null;
            _rows = [];
            _warnings = [];
            _error = $"Datei konnte nicht gelesen werden: {ex.Message}";
        }
    }

    private int MapValue(string key) => _map.TryGetValue(key, out var idx) ? idx : -1;

    private void SetMap(string key, string? value)
    {
        if (int.TryParse(value, out var idx) && idx >= 0) _map[key] = idx;
        else _map.Remove(key);
    }

    private void ApplyMapping()
    {
        if (_table is null) return;
        _error = null;
        var result = TicketImportCsv.BuildRows(_table, _map);
        _rows = result.Rows.Select(ToMemberRow).ToList();
        _warnings = result.Warnings;
        _parseErrors = result.Errors;
        _showMapping = false;
    }

    private static MemberImportRow ToMemberRow(TicketImportRow row)
    {
        var h = row.Holder;
        return new MemberImportRow(h.LastName, h.FirstName, h.Birthday, h.Email?.Value, row.CardNo,
            MemberAddress.Create(h.Salutation, h.Company, h.Street, h.AddressLine2,
                h.PostalCode, h.City, h.Country, h.Phone),
            row.Admissions ?? 1, row.Bundle);
    }

    private async Task ImportAsync()
    {
        _error = null;
        if (SeasonId <= 0) { _error = "Bitte zuerst eine Saison wählen."; return; }
        if (string.IsNullOrWhiteSpace(_reference)) { _error = "Bitte ein Bundle angeben."; return; }
        if (_parseErrors.Count > 0) { _error = "Bitte zuerst die Fehler in der Datei beheben."; return; }
        if (_rows.Count == 0) { _error = "Bitte eine CSV-Datei mit mindestens einer Zeile wählen."; return; }

        _saving = true;
        try
        {
            var reference = _reference.Trim();
            await CardImport.HandleAsync(new ImportMemberCards.Command(SeasonId, reference, _category, _rows, Identity.Name, Identity.Email));
            await OnSaved.InvokeAsync();
        }
        catch (DomainException ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private Task Close() => _saving ? Task.CompletedTask : OnClosed.InvokeAsync();
}
