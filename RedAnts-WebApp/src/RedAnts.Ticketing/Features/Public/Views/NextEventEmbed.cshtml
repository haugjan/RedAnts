@model RedAnts.Ticketing.Features.Public.NextEventEmbedModel
@using RedAnts.Ticketing.Features.Catalog.Shop
@{
    Layout = null;
    var culture = DisplayCulture.From(Context.Request);
    var homeGame = Model.HomeGame;

    string LongDate(EmbedGame game)
    {
        var text = game.Date.ToDateTime(game.StartTime).ToString("dddd, dd.MM.yyyy", culture);
        return game.TimeUnknown ? text : $"{text} · {game.StartTime:HH:mm} Uhr";
    }

    string ShortDate(EmbedGame game) =>
        game.Date.ToDateTime(game.StartTime).ToString("ddd dd.MM.", culture);
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nächster Anlass – Red Ants</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root { --red: #C8102E; --red-dark: #A50D26; --ink: rgba(97, 97, 97, 1); --display: 'Roboto', Arial, Helvetica, sans-serif; }
        * { box-sizing: border-box; }
        html, body { margin: 0; height: 100%; }
        body { font-family: var(--display); color: var(--ink); background: transparent; min-height: 100%; display: flex; align-items: stretch; justify-content: center; overflow: hidden; }
        .ne { max-width: 680px; width: 100%; height: 100%; margin: 0 auto; display: flex; flex-direction: column; text-align: center; }
        .ne-stage { position: relative; flex: 1 1 auto; width: 100%; }
        .ne-slide { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: space-evenly; gap: clamp(0.25rem, 1.4vh, 0.9rem); padding: clamp(0.4rem, 2vh, 0.65rem) 0 0; opacity: 0; transition: opacity 0.5s ease; pointer-events: none; }
        .ne-slide.is-on { opacity: 1; pointer-events: auto; transition-delay: 0.5s; }
        .ne-title { width: 100%; text-align: left; text-transform: uppercase; font-weight: 700; font-size: clamp(1.15rem, 6vw, 2.3rem); line-height: 1.05; margin: 0; padding-right: clamp(58px, 18vw, 82px); }
        .ne-title::after { content: ""; display: block; width: 40px; height: 3px; background: var(--red); margin: clamp(0.35rem, 1.6vh, 0.6rem) 0 0; }
        .ne-date { text-transform: uppercase; letter-spacing: 0.05em; color: #555; font-size: clamp(0.85rem, 3.2vw, 1.2rem); margin: 0; }
        .ne-logos { display: flex; align-items: center; justify-content: center; gap: clamp(1rem, 4.5vw, 2rem); margin: 0; }
        .ne-logos img { height: clamp(38px, min(15vh, 15vw), 90px); width: auto; object-fit: contain; }
        .ne-vs { font-weight: 700; text-transform: uppercase; font-size: clamp(1.2rem, 5vw, 2rem); color: #999; }
        .ne-empty { text-transform: uppercase; color: #777; letter-spacing: 0.05em; padding: 1.5rem; margin: auto; }

        .ne-corner { --corner: clamp(74px, 23vw, 106px); position: absolute; top: 0; right: 0; width: var(--corner); height: var(--corner); overflow: hidden; pointer-events: none; z-index: 1; }
        .ne-corner span { position: absolute; width: calc(var(--corner) * 1.42); right: calc(var(--corner) * -0.36); top: calc(var(--corner) * 0.24); transform: rotate(45deg); background: var(--red); color: #fff; text-align: center; padding: 0.16rem 0; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: clamp(0.52rem, 2vw, 0.68rem); }
        .ne-place { margin: 0; font-size: clamp(0.63rem, 2.4vw, 0.78rem); text-transform: uppercase; letter-spacing: 0.05em; color: #9a9a9a; max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .ne-home { flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; width: 100%; margin-top: clamp(0.3rem, 1.4vh, 0.6rem); padding: 0.52rem 0.6rem; background: var(--red); color: #fff; text-decoration: none; transition: background 0.15s; }
        .ne-home:hover { background: var(--red-dark); color: #fff; }
        .ne-home-text { flex: 1 1 auto; min-width: 0; text-align: left; text-transform: uppercase; color: #fff; }
        .ne-home-kicker { display: block; font-size: clamp(0.54rem, 2.1vw, 0.66rem); font-weight: 700; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.78); line-height: 1.2; }
        .ne-home-line { display: block; font-weight: 700; font-size: clamp(0.66rem, 2.6vw, 0.84rem); letter-spacing: 0.03em; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .ne-home-go { flex: 0 0 auto; text-transform: uppercase; font-weight: 700; letter-spacing: 0.06em; font-size: clamp(0.64rem, 2.5vw, 0.8rem); background: #fff; color: var(--red); padding: 0.3rem 0.6rem; }
        .ne-home:hover .ne-home-go { color: var(--red-dark); }

        .ne-dots { flex: 0 0 auto; display: flex; justify-content: flex-end; align-items: center; gap: 0.35rem; padding: 0.3rem 0.15rem 0.15rem; }
        .ne-dot { width: 0.52rem; height: 0.52rem; border-radius: 50%; border: 1px solid #c4c4c4; background: #fff; padding: 0; cursor: pointer; }
        .ne-dot--home { border-color: var(--red); }
        .ne-dot[aria-current="true"] { background: var(--red); border-color: var(--red); }
        .ne-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

        @@media (prefers-reduced-motion: reduce) { .ne-slide { transition: none; } }
    </style>
</head>
<body>
    @if (!Model.HasGames)
    {
        <div class="ne"><p class="ne-empty">Aktuell ist kein Anlass geplant.</p></div>
    }
    else
    {
        <div class="ne">
            <div class="ne-stage">
                @foreach (var game in Model.Games)
                {
                    <div class="ne-slide @(game.IsAway ? "ne-slide--away" : "ne-slide--home")">
                        @if (game.IsAway)
                        {
                            <span class="ne-corner"><span>Auswärts</span></span>
                        }
                        <h1 class="ne-title">@game.Title</h1>
                        <p class="ne-date">@LongDate(game)</p>
                        @if (!string.IsNullOrEmpty(game.LeftLogoUrl) || !string.IsNullOrEmpty(game.RightLogoUrl))
                        {
                            <div class="ne-logos">
                                @if (!string.IsNullOrEmpty(game.LeftLogoUrl))
                                {
                                    <img src="@game.LeftLogoUrl" alt="Heimteam" />
                                }
                                <span class="ne-vs">vs</span>
                                @if (!string.IsNullOrEmpty(game.RightLogoUrl))
                                {
                                    <img src="@game.RightLogoUrl" alt="Gastteam" />
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(game.Place))
                        {
                            <p class="ne-place">@game.Place</p>
                        }
                        @if (homeGame is not null)
                        {
                            <a class="ne-home" href="@RedAnts.Ticketing.Features.Public.NextEventEmbedModel.TicketsUrl(homeGame)" target="_top" rel="noopener">
                                <span class="ne-home-text">
                                    <span class="ne-home-kicker">@(game.IsAway ? "Nächstes Heimspiel" : "Dieses Heimspiel")</span>
                                    <span class="ne-home-line">@ShortDate(homeGame) · @(game.IsAway || string.IsNullOrWhiteSpace(homeGame.Place)
                                                                                 ? RedAnts.Ticketing.Features.Public.NextEventEmbedModel.Opponent(homeGame)
                                                                                 : homeGame.Place)</span>
                                </span>
                                <span class="ne-home-go">Tickets kaufen</span>
                            </a>
                        }
                    </div>
                }
            </div>
            @if (Model.Games.Count > 1)
            {
                <div class="ne-dots">
                    @for (var i = 0; i < Model.Games.Count; i++)
                    {
                        var game = Model.Games[i];
                        <button class="ne-dot @(game.IsAway ? "" : "ne-dot--home")" type="button" aria-current="@(i == 0 ? "true" : "false")">
                            <span class="ne-sr">@(game.IsAway ? "Auswärtsspiel" : "Heimspiel") @game.Title</span>
                        </button>
                    }
                </div>
            }
        </div>
        <script>
            (function () {
                var slides = [].slice.call(document.querySelectorAll('.ne-slide'));
                if (!slides.length) return;
                if (slides.length < 2) { slides[0].classList.add('is-on'); return; }

                var dots = [].slice.call(document.querySelectorAll('.ne-dot'));
                var index = 0, timer = null;

                function show(next) {
                    index = (next + slides.length) % slides.length;
                    slides.forEach(function (slide, i) { slide.classList.toggle('is-on', i === index); });
                    dots.forEach(function (dot, i) { dot.setAttribute('aria-current', i === index ? 'true' : 'false'); });
                }

                function stop() { if (timer) { clearInterval(timer); timer = null; } }

                function start() {
                    stop();
                    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
                    timer = setInterval(function () { show(index + 1); }, 10000);
                }

                dots.forEach(function (dot, i) {
                    dot.addEventListener('click', function () { show(i); start(); });
                });
                document.addEventListener('mouseenter', stop, true);
                document.addEventListener('mouseleave', start, true);

                show(0);
                start();
            })();
        </script>
    }
</body>
</html>
