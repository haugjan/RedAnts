@model RedAnts.Ticketing.Features.Public.NextQuickBuyModel
@using System.Globalization
@using RedAnts.Ticketing.Features.Shared
@{
    Layout = "_QuickBuyLayout";
    ViewData["Title"] = Model.HasEvent ? Model.Title : "Direktkauf";
    var culture = DisplayCulture.From(Context.Request);
    var selected = Model.Categories
        .Where(c => c.Available && Model.QuantityOf(c.TierId) > 0)
        .Select(c => $"{Model.QuantityOf(c.TierId)} × {c.Name}")
        .ToList();
}

@if (!Model.HasEvent)
{
    <p class="nq-empty">Aktuell steht kein Anlass zum Direktkauf bereit.</p>
}
else
{
    <h1 class="nq-title">@Model.Title</h1>
    <div class="nq-rule"></div>
    <div class="nq-meta">
        @if (!string.IsNullOrEmpty(Model.HomeLogoUrl))
        {
            <img src="@Model.HomeLogoUrl" alt="Heimteam" />
        }
        @if (!string.IsNullOrEmpty(Model.AwayLogoUrl))
        {
            <img src="@Model.AwayLogoUrl" alt="Auswärtsteam" />
        }
        <span class="nq-meta__text">
            @Model.Date.ToDateTime(TimeOnly.MinValue).ToString("ddd dd.MM.yyyy", culture)@if (!Model.TimeUnknown)
            {<text> · @Model.StartTime.ToString("HH:mm") Uhr</text>}@if (!string.IsNullOrWhiteSpace(Model.VenueName))
            {<text> · @Model.VenueName</text>}
        </span>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="nq-error" role="alert">@Model.Error</p>
    }

    <form class="nq-form" id="nqForm" method="post" action="/next/buy" data-nq-max="@Model.MaxPerCategory">
        @Html.AntiForgeryToken()
        <input type="hidden" name="eventId" value="@Model.EventId" />

        @if (Model.Categories.Count == 0)
        {
            <p class="nq-empty">Für diesen Anlass sind aktuell keine Tickets verfügbar.</p>
        }
        else
        {
            foreach (var cat in Model.Categories)
            {
                var quantity = Model.QuantityOf(cat.TierId);
                <div class="nq-cat @(quantity > 0 ? "nq-cat--active" : "")"
                     data-nq-row data-nq-name="@cat.Name" data-nq-limit="@Model.LimitOf(cat)"
                     data-nq-price="@cat.Price.ToString(CultureInfo.InvariantCulture)">
                    <div class="nq-cat__text">
                        <span class="nq-cat__name">@cat.Name</span>
                        <span class="nq-cat__meta">
                            @if (cat.AgeText is { } ageText)
                            {<text>@ageText · </text>}@if (cat.OriginalPrice is { } original)
                            {<s>CHF @MoneyFormat.Chf(original)</s><text> </text>}CHF @MoneyFormat.Chf(cat.Price)@if (!string.IsNullOrWhiteSpace(cat.ActionText))
                            {<text> · </text><span class="nq-cat__action">@cat.ActionText</span>}@if (cat.AvailableUntil is { } until)
                            {<text> · bis @until.ToString("dd.MM.yyyy")</text>}@if (cat.Available && cat.Remaining is { } remaining && remaining <= 10)
                            {<text> · </text><span class="nq-cat__low">@(remaining == 1 ? "nur noch 1" : $"nur noch {remaining}")</span>}
                        </span>
                    </div>
                    @if (cat.Available)
                    {
                        <div class="nq-step">
                            <button type="button" class="nq-step__btn" data-nq-step="-1" aria-label="@cat.Name: ein Ticket weniger">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#101010" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path></svg>
                            </button>
                            <input class="nq-step__value @(quantity > 0 ? "" : "nq-step__value--zero")" type="number"
                                   inputmode="numeric" min="0" max="@Model.LimitOf(cat)" step="1"
                                   name="quantities[@cat.TierId]" value="@quantity"
                                   data-nq-input aria-label="Anzahl @cat.Name" />
                            <button type="button" class="nq-step__btn nq-step__btn--plus" data-nq-step="1" aria-label="@cat.Name: ein Ticket mehr">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
                            </button>
                        </div>
                    }
                    else
                    {
                        <span class="nq-cat__out">Ausverkauft</span>
                    }
                </div>
            }
        }

        <label class="nq-label" for="nqEmail">E-Mail für die Tickets *</label>
        <input class="nq-input" type="email" id="nqEmail" name="email" required
               autocomplete="email" inputmode="email" placeholder="name@@example.ch" value="@Model.Email" />

        <div class="nq-check">
            <input type="checkbox" name="acceptPrivacy" value="true" id="nqPrivacy" required />
            <label for="nqPrivacy">
                Ich akzeptiere <a href="/agb" target="_blank" rel="noopener">AGB</a> und
                <a href="/datenschutz" target="_blank" rel="noopener">Datenschutz</a>. *
            </label>
        </div>
        <div class="nq-check">
            <input type="checkbox" name="acceptNewsletter" value="true" id="nqNewsletter" />
            <label for="nqNewsletter">Newsletter der Red Ants abonnieren</label>
        </div>

        @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
        {
            <div class="nq-captcha cf-turnstile" data-sitekey="@Model.TurnstileSiteKey" data-size="flexible"></div>
        }

        <button class="nq-buy" type="submit" id="nqBuy">
            <span class="nq-buy__label" id="nqBuyLabel">@(Model.TotalQuantity == 0 ? "Anzahl wählen" : $"Kaufen · CHF {MoneyFormat.Chf(Model.Total)}")</span>
            <span class="nq-buy__detail" id="nqBuyDetail">@(selected.Count == 0 ? "noch nichts gewählt" : string.Join(", ", selected))</span>
        </button>

        <p class="nq-fine">
            Alle Tickets kommen in einer E-Mail, jedes mit eigenem QR-Code. Alle Preise verstehen sich ohne MwSt.,
            der Verein ist nicht mehrwertsteuerpflichtig.
            @if (!string.IsNullOrEmpty(Model.EventUrl))
            {
                <a href="@Model.EventUrl">Saisonkarten und grössere Mengen</a><text> · </text>
            }
            <a href="/impressum">Impressum</a>
        </p>
    </form>
}

@section Scripts {
    <script src="/_content/RedAnts.Ticketing/js/next-quickbuy.js" asp-append-version="true"></script>
    @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
}
