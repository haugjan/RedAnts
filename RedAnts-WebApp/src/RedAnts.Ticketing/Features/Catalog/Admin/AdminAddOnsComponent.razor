@using RedAnts.Ticketing.Domain.Sales

<section class="ta-page">
    <h1 class="ta-page-title">Zusatzoptionen</h1>

    @if (_flash is not null)
    {
        <div class="ta-flash" @onclick="() => _flash = null" title="Ausblenden">@_flash</div>
    }

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field">
                    <label class="ta-label" for="addonSeasonSelect">Saison</label>
                    <select id="addonSeasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="ReloadAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--grow">
                    <label class="ta-label" for="addonSearch">Suche</label>
                    <input id="addonSearch" type="search" class="ta-input ta-addons-search"
                           placeholder="Besteller, E-Mail, Bestell-Nr., Zusatzoption …"
                           @bind="_search" @bind:event="oninput" @bind:after="SearchAsync" />
                </div>
                <div class="ta-field">
                    <label class="ta-label" for="addonOnlyOpen">Anzeige</label>
                    <label class="ta-check-inline">
                        <input id="addonOnlyOpen" type="checkbox" @bind="_onlyOpen" @bind:after="ReloadAsync" />
                        <span>Nur offene</span>
                    </label>
                </div>
            </div>
        </div>

        @if (_result.Total == 0)
        {
            <div class="ta-placeholder">Für diese Saison wurden keine Zusatzoptionen bestellt.</div>
        }
        else
        {
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Bestell-Nr.</th>
                            <th>Besteller</th>
                            <th>Kaufdatum</th>
                            <th>Bezahlt</th>
                            <th>Zusatzoption</th>
                            <th>Kategorie</th>
                            <th class="ta-num">Anzahl</th>
                            <th class="ta-addon-delivered">Geliefert</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in _result.AddOns)
                        {
                            <tr class="@(it.Delivered ? "ta-row-done" : "")">
                                <td><code class="ta-uuid">@it.OrderNumber</code></td>
                                <td class="ta-cell-address">
                                    <div class="ta-addr-name">@it.BuyerName</div>
                                    <div class="ta-addr-sub">@it.Email</div>
                                </td>
                                <td>@SwissTime.ToSwiss(it.CreatedAt).ToString("dd.MM.yyyy HH:mm")</td>
                                <td><span class="ta-badge @StatusClass(it.OrderStatus)">@it.OrderStatus.DisplayName()</span></td>
                                <td>@it.Label</td>
                                <td>@it.CategoryName</td>
                                <td class="ta-num">@it.Quantity</td>
                                <td class="ta-addon-delivered">
                                    <label class="ta-check-inline">
                                        <input type="checkbox" checked="@it.Delivered" @onchange="() => ToggleDeliveredAsync(it)" />
                                        <span>@(it.Delivered ? "geliefert" : "offen")</span>
                                    </label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_result.AddOns.Count == 0)
            {
                <div class="ta-placeholder">Keine Zusatzoption passt zum Filter.</div>
            }
            <p class="ta-summary">
                @_result.DeliveredCount von @_result.Total geliefert ·
                @_result.TotalQuantity Stück gesamt
            </p>
        }
    }
</section>

<style>
    .ta-field--grow { flex: 1 1 18rem; }
    .ta-addons-search { width: 100%; min-width: 14rem; }
    .ta-check-inline { display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; white-space: nowrap; }
    .ta-row-done { opacity: 0.62; }
    .ta-addon-delivered { white-space: nowrap; }
</style>

@code {
    [Parameter] public string AdminUser { get; set; } = "";

    [Inject] private GetSeasonsForAdmin.Handler Seasons { get; set; } = default!;
    [Inject] private GetOrderAddOnsForAdmin.Handler AddOns { get; set; } = default!;
    [Inject] private SetOrderAddOnDelivered.Handler Deliveries { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;

    private bool _loading = true;
    private IReadOnlyList<SeasonForAdmin> _seasons = [];
    private OrderAddOnsForAdmin _result = OrderAddOnsForAdmin.Empty;
    private string _search = "";
    private bool _onlyOpen;
    private string? _flash;
    private CancellationTokenSource? _searchDebounce;

    public int SelectedSeasonId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _seasons = await Seasons.HandleAsync(new GetSeasonsForAdmin.Query());
        SelectedSeasonId = AdminState.SelectedSeasonId is int id && _seasons.Any(s => s.Id == id)
            ? id
            : CurrentSeason(_seasons)?.Id ?? _seasons.FirstOrDefault()?.Id ?? 0;
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        AdminState.SelectedSeasonId = SelectedSeasonId > 0 ? SelectedSeasonId : null;
        _result = await AddOns.HandleAsync(new GetOrderAddOnsForAdmin.Query(SelectedSeasonId, _search, _onlyOpen));
    }

    private async Task SearchAsync()
    {
        _searchDebounce?.Cancel();
        var debounce = _searchDebounce = new CancellationTokenSource();
        try { await Task.Delay(250, debounce.Token); }
        catch (TaskCanceledException) { return; }
        await ReloadAsync();
    }

    private async Task ToggleDeliveredAsync(OrderAddOnRow item)
    {
        var delivered = !item.Delivered;
        try
        {
            await Deliveries.HandleAsync(new SetOrderAddOnDelivered.Command(item.Id, delivered));
            _flash = delivered
                ? $"„{item.Label}“ für {item.BuyerName} als geliefert markiert."
                : $"„{item.Label}“ für {item.BuyerName} als offen markiert.";
        }
        catch (Exception ex)
        {
            _flash = "Konnte nicht gespeichert werden: " + ex.Message;
        }
        await ReloadAsync();
    }

    private static SeasonForAdmin? CurrentSeason(IReadOnlyList<SeasonForAdmin> seasons)
    {
        var today = SwissTime.Today;
        return seasons.FirstOrDefault(s => s.StartDate <= today && today <= s.EndDate)
            ?? seasons.Where(s => s.StartDate <= today).MaxBy(s => s.StartDate);
    }

    private static string StatusClass(OrderStatus status) => status switch
    {
        OrderStatus.Paid => "ta-badge-valid",
        OrderStatus.Draft => "ta-badge-draft",
        OrderStatus.Cancelled => "ta-badge-cancelled",
        OrderStatus.Refunded => "ta-badge-intern",
        OrderStatus.PartiallyRefunded => "ta-badge-redeemed",
        _ => "ta-badge-draft"
    };
}
