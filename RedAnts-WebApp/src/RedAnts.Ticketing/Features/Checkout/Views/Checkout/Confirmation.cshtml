@model RedAnts.Ticketing.Features.Checkout.CheckoutConfirmationView
@using RedAnts.Ticketing.Features.Checkout
@using RedAnts.Ticketing.Features.Shared
@using RedAnts.Ticketing.Features.Tickets
@using RedAnts.Ticketing.Domain.Sales
@{
    Layout = "_TicketsLayout";
    ViewData["Title"] = "Bestellung bestätigt";
}

<link rel="stylesheet" href="/_content/RedAnts.Ticketing/css/ticket-card.css" asp-append-version="true" />
<link rel="stylesheet" href="/_content/RedAnts.Ticketing/css/checkout-done.css" asp-append-version="true" />

<div class="rc-done">
    <div class="rc-done__mark">&#10003;</div>
    <h1>Vielen Dank!</h1>
    <p class="rc-done__note">Deine Bestellung war erfolgreich.</p>
</div>

<div class="card p-4 rc-summary">
    <div class="rc-summary__row mb-1">
        <span class="text-muted">Bestellnummer</span><strong>@Model.OrderNumber</strong>
    </div>
    <div class="rc-summary__row mb-1">
        <span class="text-muted">Zahlungsart</span><span>@Model.PaymentLabel</span>
    </div>
    <div class="rc-summary__row">
        <span class="text-muted">Total</span><strong>CHF @MoneyFormat.Chf(Model.Total)</strong>
    </div>
    <hr />
    <p class="mb-2">Deine Tickets gehen per E-Mail an <strong>@Model.Email</strong>. Du kannst die QR-Codes auch direkt hier am Eingang scannen lassen:</p>

    @if (Model.AddOnInfoTexts.Count > 0)
    {
        <h2 class="rc-section-title">Zu deinen Zusatzoptionen</h2>
        @foreach (var info in Model.AddOnInfoTexts)
        {
            <div class="ra-addon-note small mb-2">@info</div>
        }
    }

    <h2 class="rc-section-title">Deine Tickets</h2>
    <div class="ra-ticket-grid">
        @foreach (var t in Model.Tickets)
        {
            var card = new TicketCardModel(
                Kicker: TicketDisplay.Kicker((TicketType)t.Type),
                TypeLabel: TicketDisplay.TypeLabel((TicketType)t.Type),
                ScopeName: t.EventName,
                DateText: t.DateText,
                CategoryLabel: t.CategoryName,
                HolderName: t.HolderName,
                Serial: t.Uuid.ToString("N")[..8].ToUpperInvariant(),
                QrMarkup: $"<img src=\"/ticket/{t.Token}/qr.png\" alt=\"Ticket-QR\" />",
                VenueName: t.VenueName);
            var shareUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/ticket/{t.Token}";
            var waHref = "https://wa.me/?text=" + Uri.EscapeDataString($"{TicketDisplay.TypeLabel((TicketType)t.Type)} – {t.EventName}\n{shareUrl}");
            <div class="ra-ticket-cell">
                <partial name="~/Features/Tickets/Views/Partials/_TicketCard.cshtml" model="card" />
                <div class="rc-actions">
                    <a class="rc-btn rc-btn--open" href="/ticket/@t.Token" target="_blank" rel="noopener">Online-Karte öffnen</a>
                    <a class="rc-btn rc-btn--pdf" href="/ticket/@t.Token/pdf">Als PDF herunterladen</a>
                    <a class="rc-btn rc-btn--wa" href="@waHref" target="_blank" rel="noopener">Per WhatsApp teilen</a>
                </div>
            </div>
        }
    </div>

    <p class="rc-summary__hint mt-3 mb-0">Die Bestätigungsmail kann ein paar Minuten dauern. Falls sie nicht ankommt, schau bitte auch im Spam-Ordner.</p>
</div>

<div class="mt-4">
    <a href="/" class="btn btn-outline-secondary">Zur Startseite</a>
</div>
