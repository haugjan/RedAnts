@using RedAnts.Domain

<section class="ta-page">
    <h1 class="ta-page-title">E-Mails</h1>

    @if (_secretWarning is not null)
    {
        <div class="ta-secret-warning @(_secretExpired ? "ta-secret-warning--expired" : "")">@_secretWarning</div>
    }

    @if (_flash is not null)
    {
        <div class="ta-flash" @onclick="() => _flash = null" title="Ausblenden">@_flash</div>
    }

    <div class="ta-toolbar">
        <div class="ta-toolbar-filters">
            <label class="ta-checkbox-label">
                <input type="checkbox" @bind="_includeSent" @bind:after="ReloadAsync" />
                Gesendete der letzten 30 Tage anzeigen
            </label>
        </div>
        <div class="ta-toolbar-actions">
            <button type="button" class="ta-btn ta-btn-ghost" @onclick="ReloadAsync">Aktualisieren</button>
        </div>
    </div>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_outbox.Mails.Count == 0)
    {
        <div class="ta-placeholder">
            @(_includeSent ? "Keine E-Mails in den letzten 30 Tagen." : "Keine offenen E-Mails. Alles versendet.")
        </div>
    }
    else
    {
        <div class="ta-table-wrap">
            <table class="ta-table">
                <thead>
                    <tr>
                        <th>Zeitpunkt</th>
                        <th>Empfänger</th>
                        <th>Betreff</th>
                        <th>Quelle</th>
                        <th>Status</th>
                        <th>Versand</th>
                        <th class="ta-num">Versuche</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _outbox.Mails)
                    {
                        <tr>
                            <td>
                                @SwissTime.ToSwiss(m.CreatedAt).ToString("dd.MM.yyyy HH:mm")
                                @if (m.Status == OutboxStatus.Sent && m.SentAt is { } sent)
                                {
                                    <div class="ta-addr-sub">gesendet @SwissTime.ToSwiss(sent).ToString("dd.MM.yyyy HH:mm")</div>
                                }
                                else if (m.Status != OutboxStatus.Sent && m.NextAttemptAt > SwissTime.Timestamp)
                                {
                                    <div class="ta-addr-sub">nächster Versuch @SwissTime.ToSwiss(m.NextAttemptAt).ToString("HH:mm")</div>
                                }
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(m.ToName) ? m.ToEmail : m.ToName)
                                @if (!string.IsNullOrWhiteSpace(m.ToName))
                                {
                                    <div class="ta-addr-sub">@m.ToEmail</div>
                                }
                            </td>
                            <td>@m.Subject</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(m.Source) ? "—" : m.Source)
                                @if (!string.IsNullOrWhiteSpace(m.Reference))
                                {
                                    <div class="ta-addr-sub">@m.Reference</div>
                                }
                            </td>
                            <td>
                                <span class="ta-badge @StatusClass(m.Status)">@StatusLabel(m.Status)</span>
                                @if (m.Status == OutboxStatus.Failed && !string.IsNullOrWhiteSpace(m.LastError))
                                {
                                    <div class="ta-addr-sub" title="@m.LastError">@Truncate(m.LastError, 80)</div>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(m.SentVia) ? "—" : m.SentVia)</td>
                            <td class="ta-num">@m.Attempts</td>
                            <td class="ta-col-actions">
                                @if (m.Status is OutboxStatus.Failed or OutboxStatus.Pending)
                                {
                                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => RequeueAsync(m.Id)">Erneut senden</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="ta-summary">
            @_outbox.OpenCount offen · @_outbox.FailedCount fehlgeschlagen@(_includeSent ? $" · {_outbox.SentCount} gesendet" : "")
        </p>
    }
</section>

<style>
    .ta-checkbox-label { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.9rem; color: var(--ta-ink); cursor: pointer; }
    .ta-checkbox-label input { width: 1rem; height: 1rem; }
    .ta-secret-warning { margin: 0 0 1rem; padding: 0.7rem 1rem; border-radius: 4px; border: 1px solid #e0b400; background: #fff8e1; color: #7a5c00; font-size: 0.9rem; }
    .ta-secret-warning--expired { border-color: #d02d38; background: #fdecee; color: #a11722; font-weight: 600; }
</style>

@code {
    [Parameter] public string AdminUser { get; set; } = "";

    [Inject] private GetOutbox.Handler Outbox { get; set; } = default!;
    [Inject] private RetryOutboxMail.Handler Retries { get; set; } = default!;

    private bool _loading = true;
    private bool _includeSent;
    private string? _flash;
    private string? _secretWarning;
    private bool _secretExpired;
    private OutboxForAdmin _outbox = OutboxForAdmin.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private void ComputeSecretWarning(DateOnly? expires)
    {
        _secretWarning = null;
        _secretExpired = false;
        if (expires is not { } expiry) return;

        var days = expiry.DayNumber - SwissTime.Today.DayNumber;
        if (days < 0)
        {
            _secretExpired = true;
            _secretWarning = $"Das Graph Client-Secret ist am {expiry:dd.MM.yyyy} abgelaufen. Der E-Mail-Versand ist gestört. " +
                             "Bitte in Entra ein neues Secret für die App 'Red Ants Web App' erstellen, in den App-Settings hinterlegen und Graph:ClientSecretExpires aktualisieren.";
        }
        else if (days <= 30)
        {
            _secretWarning = $"Das Graph Client-Secret läuft am {expiry:dd.MM.yyyy} ab (in {days} Tagen). " +
                             "Bitte rechtzeitig in Entra erneuern und Graph:ClientSecretExpires aktualisieren.";
        }
    }

    private async Task ReloadAsync()
    {
        _outbox = await Outbox.HandleAsync(new GetOutbox.Query(_includeSent));
        ComputeSecretWarning(_outbox.GraphSecretExpires);
    }

    private async Task RequeueAsync(int id)
    {
        _flash = await Retries.HandleAsync(new RetryOutboxMail.Command(id))
            ? "E-Mail wurde erneut in die Warteschlange gestellt."
            : "E-Mail konnte nicht erneut gesendet werden.";
        await ReloadAsync();
    }

    private static string StatusLabel(OutboxStatus status) => status switch
    {
        OutboxStatus.Pending => "Offen",
        OutboxStatus.Sending => "Wird gesendet",
        OutboxStatus.Sent => "Gesendet",
        OutboxStatus.Failed => "Fehlgeschlagen",
        _ => status.ToString()
    };

    private static string StatusClass(OutboxStatus status) => status switch
    {
        OutboxStatus.Sent => "ta-badge-valid",
        OutboxStatus.Failed => "ta-badge-cancelled",
        _ => "ta-badge-draft"
    };

    private static string Truncate(string value, int max) => value.Length > max ? value[..max] + "…" : value;
}
