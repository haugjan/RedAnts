@model RedAnts.Features.Ticketing.Tickets.MyTicketsViewModel
@using RedAnts.Domain.Ticketing.Sales
@using RedAnts.Features.Ticketing.Tickets
@{
    Layout = null;
    var title = "Meine Tickets – Red Ants Winterthur";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Meine Tickets" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@title</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; background: #f4f4f5; color: #14171A; font-family: Verdana, Geneva, Tahoma, sans-serif; -webkit-font-smoothing: antialiased; }
        .mt-header { background: #D02D38; padding: 1.1rem 1.25rem .9rem; display: flex; align-items: center; gap: .75rem; }
        .mt-header img { width: 36px; height: 36px; border-radius: 50%; }
        .mt-header-title { font-family: 'Oswald', Impact, sans-serif; text-transform: uppercase; color: #fff; font-size: 1.25rem; font-weight: 700; letter-spacing: .04em; line-height: 1; }
        .mt-header-sub { color: rgba(255,255,255,.75); font-size: .72rem; margin-top: 2px; }
        .mt-body { padding: 1rem; max-width: 480px; margin: 0 auto; }
        .mt-empty { background: #fff; border: 1px solid #e6e8ec; border-radius: 14px; text-align: center; padding: 2.5rem 1.4rem; margin-top: .5rem; }
        .mt-empty h1 { font-family: 'Oswald', Impact, sans-serif; text-transform: uppercase; font-size: 1.3rem; margin: 0 0 .5rem; }
        .mt-empty p { color: #6b7178; margin: 0; font-size: .9rem; line-height: 1.5; }
        .mt-section-label { font-family: 'Oswald', Impact, sans-serif; text-transform: uppercase; color: #6b7178; font-size: .78rem; letter-spacing: .08em; margin: 1rem 0 .5rem .25rem; }
        .mt-card { background: #fff; border: 1px solid #e6e8ec; border-radius: 14px; margin-bottom: .6rem; text-decoration: none; color: inherit; display: flex; align-items: stretch; overflow: hidden; transition: box-shadow .15s; }
        .mt-card:hover, .mt-card:focus { box-shadow: 0 2px 12px rgba(0,0,0,.1); outline: none; }
        .mt-card-stripe { width: 5px; flex-shrink: 0; }
        .mt-card-body { padding: .85rem 1rem .85rem .9rem; flex: 1; min-width: 0; }
        .mt-card-kicker { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: #6b7178; margin-bottom: 2px; }
        .mt-card-type { font-family: 'Oswald', Impact, sans-serif; text-transform: uppercase; font-size: 1rem; font-weight: 700; line-height: 1.15; }
        .mt-card-scope { font-size: .88rem; color: #14171A; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .mt-card-date { font-size: .78rem; color: #6b7178; margin-top: 2px; }
        .mt-card-badge { display: inline-block; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; border-radius: 4px; padding: 2px 6px; margin-top: 4px; }
        .mt-card-badge--cancelled { background: #fde8e8; color: #b91c1c; }
        .mt-card-badge--valid { display: none; }
        .mt-card-arrow { display: flex; align-items: center; padding: 0 .9rem 0 0; color: #c0c5cc; }
        .mt-card-arrow svg { width: 1rem; height: 1rem; }
        .mt-hint { background: #fff; border: 1px solid #e6e8ec; border-radius: 14px; padding: .9rem 1rem; margin-top: 1.25rem; font-size: .82rem; color: #6b7178; line-height: 1.5; display: flex; gap: .65rem; align-items: flex-start; }
        .mt-hint svg { flex-shrink: 0; width: 1.1rem; height: 1.1rem; margin-top: 1px; color: #9ca3af; }
        @@media (prefers-color-scheme: dark) {
            body { background: #111; color: #f4f4f5; }
            .mt-card { background: #1c1c1e; border-color: #2c2c2e; }
            .mt-empty { background: #1c1c1e; border-color: #2c2c2e; }
            .mt-hint { background: #1c1c1e; border-color: #2c2c2e; }
        }
    </style>
</head>
<body>
    <div class="mt-header">
        <img src="/favicons/apple-touch-icon.png" alt="Red Ants" />
        <div>
            <div class="mt-header-title">Meine Tickets</div>
            <div class="mt-header-sub">Red Ants Winterthur</div>
        </div>
    </div>
    <div class="mt-body">
        @if (!Model.Found)
        {
            <div class="mt-empty">
                <h1>Link ungültig</h1>
                <p>Dieser Link ist abgelaufen oder ungültig. Bitte den Link aus der Bestellbestätigung verwenden.</p>
            </div>
        }
        else if (Model.Tickets is null || Model.Tickets.Count == 0)
        {
            <div class="mt-empty" style="margin-top:.5rem;">
                <h1>Keine Tickets</h1>
                <p>Für diese E-Mail-Adresse wurden keine Tickets gefunden.</p>
            </div>
        }
        else
        {
            <div class="mt-section-label">@Model.Tickets.Count Ticket@(Model.Tickets.Count != 1 ? "s" : "")</div>
            @foreach (var entry in Model.Tickets)
            {
                var stripeColor = entry.Type switch {
                    TicketType.EventTicket => "#C8102E",
                    TicketType.SeasonSingle => "#E4720F",
                    TicketType.SeasonPass => "#1F5FBF",
                    TicketType.MemberCard => "#1A7F37",
                    _ => "#C8102E"
                };
                var cancelled = entry.Status != TicketStatus.Valid;
                <a href="/ticket/@entry.Token" class="mt-card">
                    <div class="mt-card-stripe" style="background:@stripeColor;"></div>
                    <div class="mt-card-body">
                        <div class="mt-card-kicker">@entry.Kicker</div>
                        <div class="mt-card-type" style="color:@stripeColor;">@entry.TypeLabel</div>
                        <div class="mt-card-scope">@entry.ScopeName</div>
                        @if (!string.IsNullOrEmpty(entry.DateText))
                        {
                            <div class="mt-card-date">@entry.DateText</div>
                        }
                        @if (cancelled)
                        {
                            <span class="mt-card-badge mt-card-badge--cancelled">Storniert</span>
                        }
                    </div>
                    <div class="mt-card-arrow">
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/></svg>
                    </div>
                </a>
            }
            <div class="mt-hint">
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd"/></svg>
                <span>Tipp: Füge diese Seite zum Startbildschirm hinzu (iOS: Teilen → Zum Home-Bildschirm; Android: Menü → Zum Startbildschirm hinzufügen), um deine Tickets immer griffbereit zu haben.</span>
            </div>
        }
    </div>
</body>
</html>
