@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <meta name="robots" content="noindex,nofollow" />
    <base href="/" />
    <title>Soundboard – Red Ants</title>
    <link rel="manifest" href="/_content/RedAnts.DJ/dj/manifest.webmanifest" crossorigin="use-credentials" />
    <meta name="theme-color" content="#141418" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Soundboard" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link rel="stylesheet" href="/_content/RedAnts.DJ/dj/soundboard.css" asp-append-version="true" />
</head>
<body>
    <component type="typeof(RedAnts.DJ.Features.Board.DJBoardComponent)" render-mode="Server" />
    <script src="/_content/RedAnts.DJ/dj/soundboard.js" asp-append-version="true"></script>
    <script src="/_framework/blazor.server.js" autostart="false"></script>
    <script src="/js/circuit-reload.js" asp-append-version="true"></script>
    <script>window.redants.startCircuit();</script>
</body>
</html>
