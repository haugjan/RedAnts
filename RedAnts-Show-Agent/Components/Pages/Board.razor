@page "/bord"
@using RedAnts.Show.Agent.Cloud
@using RedAnts.Show.Agent.Deck
@using RedAnts.Show.Agent.Music
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject PayloadStore Payload
@inject Deck Deck
@inject LiveGame Live
@inject ShowStates States
@inject IJSRuntime JS

<PageTitle>@Payload.Hall.Name</PageTitle>

<div class="hb">
<header class="bar">
    <span class="hall">@Payload.Hall.Name</span>
    <span class="lamp on"></span>
    @if (Payload.Hall.Offers.Clock)
    {
        <span class="score">@Live.HomeScore : @Live.AwayScore</span>
        <span class="time">@Live.Time</span>
        <span class="period">@Live.PeriodLabel</span>
    }
    <span class="spacer"></span>
    @foreach (var state in ShowStates.Known)
    {
        var value = States.Value(state.Id);
        <span class="pill @(value != state.First ? "on" : "")" @key="state.Id">@state.Name: @value</span>
    }
    <button class="panic" @onclick="PanicAsync">PANIC</button>
</header>

@if (Decks.Count == 0)
{
    <main><p class="hint">Diese Halle hat noch kein Deck eingerichtet.</p></main>
}
else
{
    @if (Decks.Count > 1)
    {
        <nav class="decks">
            @foreach (var id in Decks)
            {
                var deckId = id;
                <button class="tab @(deckId == _deck ? "active" : "")" @onclick="() => Select(deckId)" @key="deckId">@(Deck.Layout(deckId)?.Name ?? deckId)</button>
            }
        </nav>
    }

    <main>
        <h1>@Deck.Title(_deck)</h1>
        <div class="grid" style="--cols:@Columns; --rows:@Rows">
            @foreach (var slot in Deck.Slots(_deck))
            {
                var music = Payload.MusicOf(slot.MusicId);
                <button class="key @(slot.Pressable ? "" : "flat") @(slot.Active ? "active" : "")"
                        style="background:@Hex(slot.Color); color:@Hex(slot.TextColor)"
                        disabled="@(!slot.Pressable)"
                        data-id="@($"{_deck}:{slot.Number}")"
                        data-play="@(music is null ? null : "songs")"
                        data-songs="@music?.SongsJson"
                        data-random="@(music is { Random: true } ? "1" : "0")"
                        data-label="@slot.Label"
                        @onclick="() => PressAsync(slot)"
                        @key="slot.Number">
                    @if (slot.Symbol is { Length: > 0 } symbol)
                    {
                        <span class="symbol">@symbol</span>
                    }
                    <span class="label">
                        @foreach (var line in slot.Label.Split('\n'))
                        {
                            <span>@line</span>
                        }
                    </span>
                    @if (slot.Subtitle is { Length: > 0 } subtitle)
                    {
                        <span class="sub">@subtitle</span>
                    }
                    @if (music is { Songs: > 1 })
                    {
                        <span class="badge">@music.Songs @(music.Random ? "🔀" : "🔁")</span>
                    }
                    <em>@slot.Number</em>
                </button>
            }
        </div>
        <p class="hint">Musik spielt auf diesem Rechner, Tasten laufen in der Halle.</p>
    </main>

    <footer class="now">
        <span class="np">@(_playing is { Length: > 0 } playing ? playing : "keine Musik")</span>
        <button class="ctl" @onclick="@(() => Control("pause"))">Pause</button>
        <button class="ctl" @onclick="@(() => Control("previous"))">◀◀</button>
        <button class="ctl" @onclick="@(() => Control("next"))">▶▶</button>
        <button class="ctl" @onclick="@(() => Control("fade"))">Fade</button>
        <button class="ctl stop" @onclick="@(() => Control("stop"))">Stopp</button>
    </footer>
}
</div>

@code {
    private string _deck = "";
    private string? _playing;
    private long _version;
    private CancellationTokenSource? _watch;
    private DotNetObjectReference<Board>? _self;
    private bool _ready;

    private IReadOnlyList<string> Decks => Deck.Decks;

    private int Columns => Deck.Layout(_deck)?.Columns ?? 8;

    private int Rows => Deck.Layout(_deck)?.Rows ?? 4;

    protected override void OnInitialized()
    {
        _deck = Decks.FirstOrDefault() ?? "";
        _watch = new CancellationTokenSource();
        _ = WatchAsync(_watch.Token);
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("hallBoard.start", _self);
        _ready = true;
    }

    [JSInvokable]
    public Task Playing(string label)
    {
        _playing = label.Length > 0 ? label : null;
        return InvokeAsync(StateHasChanged);
    }

    private void Select(string deckId)
    {
        _deck = deckId;
        StateHasChanged();
    }

    private async Task PressAsync(DeckSlot slot)
    {
        if (slot.MusicId is { Length: > 0 }) return;
        await Deck.PressAsync(_deck, slot.Number);
    }

    private Task PanicAsync() => Deck.PanicAsync(CancellationToken.None);

    private Task Control(string what) => JS.InvokeVoidAsync("hallBoard." + what).AsTask();

    private async Task WatchAsync(CancellationToken stop)
    {
        while (!stop.IsCancellationRequested)
        {
            await Deck.WaitAsync(_version, TimeSpan.FromSeconds(20), stop);
            _version = Deck.Version;
            if (_ready) await FollowMusicAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private string _music = "";

    private async Task FollowMusicAsync()
    {
        var slot = Deck.Slots(_deck).FirstOrDefault(s => s.Active && s.MusicId is { Length: > 0 });
        var wanted = slot?.MusicId ?? "";
        if (wanted == _music) return;
        _music = wanted;
        if (wanted.Length == 0)
        {
            await JS.InvokeVoidAsync("hallBoard.stop");
            return;
        }
        if (Payload.MusicOf(wanted) is not { } music) return;
        await JS.InvokeVoidAsync("hallBoard.play", music.Id, music.SongsJson, music.Random, music.Display);
    }

    private static string Hex(int color) => "#" + color.ToString("X6");

    public async ValueTask DisposeAsync()
    {
        if (_watch is not null)
        {
            await _watch.CancelAsync();
            _watch.Dispose();
        }
        _self?.Dispose();
    }
}
