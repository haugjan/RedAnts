@page "/uhr"
@implements IDisposable
@inject LiveGame Live
@inject PayloadStore Payload

<div class="tv">
    <div class="teams">
        <span class="team home">@Home</span>
        <span class="result"><span class="digits">@Live.HomeScore</span><span class="colon">:</span><span class="digits">@Live.AwayScore</span></span>
        <span class="team away">@Away</span>
    </div>
    <div class="clock @(Live.ClockLive ? "" : "dead")">
        <span class="digits big">@(Live.ClockLive ? Live.Time : "--:--")</span>
    </div>
    <div class="period">@(Live.ClockLive ? Live.PeriodLabel : "keine Daten von der Matchuhr")</div>
    @if (Penalties.Count > 0)
    {
        <div class="penalties">
            @foreach (var line in Penalties)
            {
                <span @key="line">@line</span>
            }
        </div>
    }
</div>

@code {
    private Timer? _tick;

    private string Home => Payload.Game.Home.ShortName is { Length: > 0 } name ? name : "Heim";

    private string Away => Payload.Game.Away.ShortName is { Length: > 0 } name ? name : "Gast";

    private IReadOnlyList<string> Penalties => Live.ClockLive
        ? Live.Clock.HomePenalties.Select(p => $"{Home} {p.Player} {p.Time}")
            .Concat(Live.Clock.GuestPenalties.Select(p => $"{Away} {p.Player} {p.Time}"))
            .ToList()
        : [];

    protected override void OnInitialized() =>
        _tick = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromMilliseconds(200), TimeSpan.FromMilliseconds(200));

    public void Dispose() => _tick?.Dispose();
}
