@page "/uhr"
@implements IDisposable
@inject LiveGame Live
@inject PayloadStore Payload

<div class="screen @(State.IsBreak ? "pause" : "") @(Offline ? "offline" : "")">
    <div class="stage">
        <div class="time @(State.IsLastMinute && State.IsGameTime ? "last-minute" : "")"><ClockDigits Value="@State.Time" /></div>
        <div class="row">
            <PenaltyList Penalties="State.HomePenalties" Side="home" />
            <TeamBadge Name="@HomeName" Logo="@HomeLogo" Class="ra" />
            <span class="score">@State.HomeScore : @State.GuestScore</span>
            <TeamBadge Name="@AwayName" Logo="@AwayLogo" />
            <PenaltyList Penalties="State.GuestPenalties" Side="guest" />
        </div>
        <div class="per @(State.Period is ClockState.Overtime or ClockState.Shootout && State.IsGameTime ? "extra" : "")">@State.PeriodLabel</div>
    </div>
    <div class="status"><i></i><span>@StatusText</span></div>
</div>

@code {
    static readonly TimeSpan OfflineAfter = TimeSpan.FromSeconds(3);

    private Timer? _watchdog;

    private ClockState State => Live.Clock;

    private TimeSpan Age => DateTime.Now - State.Received;

    private bool Offline => !State.HasData || Age > OfflineAfter;

    private string StatusText => !State.HasData
        ? "Warte auf Matchuhr …"
        : Offline ? $"Keine Daten von der Matchuhr seit {Age.TotalSeconds:0} s" : "live";

    private string HomeName => Name(Payload.Game.Home.ShortName, State.Home, "Heim");

    private string AwayName => Name(Payload.Game.Away.ShortName, State.Guest, "Gast");

    private string HomeLogo => Payload.Game.Home.LogoUrl ?? "";

    private string AwayLogo => Payload.Game.Away.LogoUrl ?? "";

    private static string Name(string fromGame, string fromClock, string fallback) =>
        fromGame.Length > 0 ? fromGame : fromClock.Length > 0 ? fromClock : fallback;

    protected override void OnInitialized() =>
        _watchdog = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromMilliseconds(200), TimeSpan.FromMilliseconds(200));

    public void Dispose() => _watchdog?.Dispose();
}
