@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using RedAnts.Domain.Ticketing
@using RedAnts.Domain.Ticketing.Sales
@using RedAnts.Features.Ticketing.Email
@using RedAnts.Features.Ticketing.Ports
@inject IPublicBaseUrl PublicUrl
@inject ITicketTokens Tokens

<section class="ta-page">
    <h1 class="ta-page-title">Mitglieder</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field">
                    <label class="ta-label" for="mcSeasonSelect">Saison</label>
                    <select id="mcSeasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="ReloadCardsAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--grow">
                    <label class="ta-label" for="mcSearch">Suche</label>
                    <input id="mcSearch" type="search" class="ta-input ta-cards-search"
                           placeholder="Name, Firma, E-Mail, Bundle, Kategorie …"
                           @bind="_search" @bind:event="oninput" />
                </div>
            </div>
            <div class="ta-toolbar-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="OpenExport" disabled="@(_cards.Count == 0)"
                        title="Mitglieder eines Bundles als CSV herunterladen">Export CSV</button>
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="OpenImport" disabled="@(SelectedSeasonId <= 0)">
                    Import CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="OpenBulk" disabled="@(_cards.Count == 0)"
                        title="Alle Karten eines Bundles per E-Mail versenden">Karten versenden</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="OpenCreate" disabled="@(SelectedSeasonId <= 0)">
                    Mitgliederkarte erstellen
                </button>
            </div>
        </div>

        @if (_cards.Count == 0)
        {
            <div class="ta-placeholder">Für diese Saison sind keine Mitgliederkarten erfasst.</div>
        }
        else
        {
            var shown = Sorted().ToList();
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Karten-Nr.</th>
                            <th class="ta-th-sort" @onclick='() => Sort("name")'>Inhaber:in <span class="ta-sort-ind">@Ind("name")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("created")'>Erstellt <span class="ta-sort-ind">@Ind("created")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("reference")'>Bundle <span class="ta-sort-ind">@Ind("reference")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("category")'>Kategorie <span class="ta-sort-ind">@Ind("category")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("admissions")' title="Einlässe pro Event">Anzahl <span class="ta-sort-ind">@Ind("admissions")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("status")'>Status <span class="ta-sort-ind">@Ind("status")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("visits")'>Event&shy;besuche <span class="ta-sort-ind">@Ind("visits")</span></th>
                            <th class="ta-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in shown)
                        {
                            <tr>
                                <td>
                                    <span class="ta-ticketno">@AdminFormat.TicketNo(c.Uuid)</span>
                                    <a class="ta-qr-link" href="@PublicUrl.TicketUrl(Tokens.CreateShort(c.Uuid))" target="_blank" rel="noopener" title="Online-Ticket" aria-label="Online-Ticket">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17 14h.01M20 14v3M14 17h.01M17 20h3M20 20h.01"/></svg>
                                    </a>
                                </td>
                                <td class="ta-cell-name">
                                    @if (c.BuyerDisplay is { } name) { @name }
                                    else { <span class="ta-muted">(ohne Name)</span> }
                                    <span class="ta-badge @(c.IsCompany ? "ta-badge-firma" : "ta-badge-privat")">@(c.IsCompany ? "Firma" : "Privat")</span>
                                    @if (c.Birthday is { } b) { <span class="ta-muted"> (@b.ToString("dd.MM.yyyy"))</span> }
                                    @if (c.HasEmail)
                                    {
                                        <div class="ta-addr-sub">@c.Email</div>
                                    }
                                    else
                                    {
                                        <span class="ta-noemail" title="Keine E-Mail hinterlegt">ohne E-Mail</span>
                                    }
                                </td>
                                <td title="@AdminFormat.CreatedTooltip(c.CreatedAt, c.CreatedByName, null, null)">@AdminFormat.CreatedShort(c.CreatedAt, c.CreatedByName, null)</td>
                                <td>@(string.IsNullOrEmpty(c.Reference) ? "–" : c.Reference)</td>
                                <td><span class="ta-badge @CategoryBadgeClass(c.Category)">@c.CategoryLabel</span></td>
                                <td class="ta-num">
                                    @if (c.Admissions > 1)
                                    {
                                        <span class="ta-badge ta-badge-block4" title="@c.Admissions Einlässe pro Event">@c.Admissions×</span>
                                    }
                                    else
                                    {
                                        <span class="ta-muted">1</span>
                                    }
                                </td>
                                <td>
                                    <span class="ta-badge @(c.IsCancelled ? "ta-badge-cancelled" : "ta-badge-valid")">
                                        @(c.IsCancelled ? "Storniert" : "Gültig")
                                    </span>
                                </td>
                                <td class="ta-num">
                                    @if (c.EventVisits > 0)
                                    {
                                        <button type="button" class="ta-visits-link" @onclick="() => OpenVisits(c)">@c.EventVisits</button>
                                    }
                                    else
                                    {
                                        <span class="ta-muted">0</span>
                                    }
                                    @if (c.Conversions > 0)
                                    {
                                        <button type="button" class="ta-conv-badge ta-conv-link" title="Diese Mitgliederkarte wurde für Ticketumwandlung(en) an Spezialanlässen gebraucht. Details anzeigen." @onclick="() => OpenVisits(c)">↔ @c.Conversions Uml.</button>
                                    }
                                </td>
                                <td class="ta-col-actions">
                                    <button type="button" class="ta-icon-btn" title="@(c.HasEmail ? "E-Mail senden" : "Keine E-Mail hinterlegt")" disabled="@(!c.HasEmail)" @onclick="() => OpenMail(c)">✉</button>
                                    <button type="button" class="ta-icon-btn" title="Bearbeiten" @onclick="() => OpenEdit(c)">✎</button>
                                    @if (Identity.IsAdmin)
                                    {
                                        <button type="button" class="ta-icon-btn ta-icon-btn-danger" title="Löschen" @onclick="() => _deleteTarget = c">🗑</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (shown.Count == 0)
            {
                <div class="ta-placeholder">Keine Mitgliederkarte passt zur Suche „@_search".</div>
            }
            <p class="ta-summary">
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <text>@shown.Count von @_cards.Count Mitgliederkarten</text>
                }
                else
                {
                    <text>@_cards.Count Mitgliederkarte@(_cards.Count == 1 ? "" : "n")</text>
                }
            </p>
        }
    }
</section>

<style>
    .ta-noemail { display: inline-block; margin-left: 0.4rem; padding: 0.1rem 0.4rem; border-radius: 3px; background: #fff8e1; color: #7a5c00; border: 1px solid #e0b400; font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
    .ta-textarea { min-height: 9rem; resize: vertical; font-family: inherit; line-height: 1.5; }
    .ta-field--grow { flex: 1 1 18rem; }
    .ta-cards-search { width: 100%; min-width: 14rem; }
    .ta-modal-section { margin: 1.1rem 0 0.4rem; font-weight: 700; font-size: 0.85rem; color: var(--ta-muted); border-top: 1px solid var(--ta-border); padding-top: 0.9rem; }
    .ta-modal--members { width: min(94vw, 680px); max-width: 680px; }
    .ta-mc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.25rem; }
    .ta-mc-grid > .ta-modal-section { grid-column: 1 / -1; margin-top: 0.6rem; }
    @@media (max-width: 560px) { .ta-mc-grid { grid-template-columns: 1fr; } }
</style>

@if (_showCreate)
{
    <div class="ta-overlay" @onmousedown="CloseCreate">
        <div class="ta-modal ta-modal--members" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Mitgliederkarte erstellen</h2>
            <p class="ta-modal-sub">@_selectedSeasonName</p>

            <div class="ta-mc-grid">
            <div class="ta-field">
                <label class="ta-label" for="newMcCategory">Kategorie</label>
                <select id="newMcCategory" class="ta-select" @bind="_newCategory">
                    @foreach (var cat in Categories)
                    {
                        <option value="@cat">@cat.DisplayName()</option>
                    }
                </select>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcAdmissions">Anzahl Einlässe pro Event</label>
                <input id="newMcAdmissions" class="ta-input" type="number" min="1" step="1" @bind="_newAdmissions" />
                <p class="ta-field-hint">Wie oft diese Karte pro Anlass eingelassen wird (z. B. Block 4 = mehrere Personen). Standard: 1.</p>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcCompany">Firma (optional)</label>
                <input id="newMcCompany" class="ta-input" type="text" maxlength="200" @bind="_newCompany" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcLastName">Name (optional)</label>
                <input id="newMcLastName" class="ta-input" type="text" maxlength="100" @bind="_newLastName" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcFirstName">Vorname (optional)</label>
                <input id="newMcFirstName" class="ta-input" type="text" maxlength="100" @bind="_newFirstName" />
            </div>
            <div class="ta-field">
                <label class="ta-label">Geburtsdatum (optional)</label>
                <DateBox @bind-Value="_newBirthday" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcReference">Bundle</label>
                <input id="newMcReference" class="ta-input" type="text" maxlength="100" placeholder="Eindeutig pro Saison" @bind="_newReference" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcEmail">E-Mail (optional)</label>
                <input id="newMcEmail" class="ta-input" type="email" maxlength="200" placeholder="für den Kartenversand" @bind="_newEmail" />
            </div>

            <p class="ta-modal-section">Adresse (optional, z. B. für Serienbriefe)</p>
            <div class="ta-field">
                <label class="ta-label" for="newMcSalutation">Anrede (optional)</label>
                <input id="newMcSalutation" class="ta-input" type="text" maxlength="50" placeholder="z. B. Frau / Herr" @bind="_newSalutation" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcStreet">Strasse (optional)</label>
                <input id="newMcStreet" class="ta-input" type="text" maxlength="200" @bind="_newStreet" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcAddressLine2">Adresszusatz (optional)</label>
                <input id="newMcAddressLine2" class="ta-input" type="text" maxlength="200" @bind="_newAddressLine2" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcPostalCode">PLZ (optional)</label>
                <input id="newMcPostalCode" class="ta-input" type="text" maxlength="20" @bind="_newPostalCode" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcCity">Ort (optional)</label>
                <input id="newMcCity" class="ta-input" type="text" maxlength="100" @bind="_newCity" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcCountry">Land (optional)</label>
                <input id="newMcCountry" class="ta-input" type="text" maxlength="100" placeholder="Schweiz" @bind="_newCountry" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newMcPhone">Telefon (optional)</label>
                <input id="newMcPhone" class="ta-input" type="text" maxlength="50" @bind="_newPhone" />
            </div>
            </div>

            @if (!string.IsNullOrEmpty(_createError))
            {
                <p class="ta-modal-error">@_createError</p>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseCreate" disabled="@_creating">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="CreateCardAsync" disabled="@_creating">
                    @(_creating ? "Erstellt …" : "Erstellen")
                </button>
            </div>
        </div>
    </div>
}

@if (_showExport)
{
    <div class="ta-overlay" @onmousedown="CloseExport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Mitglieder exportieren (CSV)</h2>

            @if (_references.Count == 0)
            {
                <p class="ta-muted-text">Für diese Saison sind keine Bundles vorhanden.</p>
            }
            else
            {
                <div class="ta-field">
                    <label class="ta-label" for="expReference">Bundle</label>
                    <select id="expReference" class="ta-select" @bind="_exportReference">
                        @foreach (var r in _references)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseExport">Schliessen</button>
                @if (!string.IsNullOrEmpty(_exportReference))
                {
                    <a class="ta-btn ta-btn-primary" href="/admin/members/export.csv?referenz=@Uri.EscapeDataString(_exportReference)"
                       target="_blank" rel="noopener" @onclick="CloseExport">Herunterladen</a>
                }
            </div>
        </div>
    </div>
}

@if (_showImport)
{
    <div class="ta-overlay" @onmousedown="CloseImport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Mitglieder importieren</h2>

            <div class="ta-field">
                <label class="ta-label">Saison</label>
                <div class="ta-readonly">@_selectedSeasonName</div>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="impCategory">Kategorie (gilt für alle Zeilen)</label>
                <select id="impCategory" class="ta-select" @bind="_importCategory">
                    @foreach (var cat in Categories)
                    {
                        <option value="@cat">@cat.DisplayName()</option>
                    }
                </select>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="impReference">Bundle</label>
                <input id="impReference" class="ta-input" type="text" maxlength="100" placeholder="z. B. Mitglieder 2026" @bind="_importReference" />
            </div>

            <div class="ta-field">
                <label class="ta-label">Datei (CSV oder Excel)</label>
                <InputFile OnChange="OnFileSelectedAsync" accept=".csv,.xlsx,text/csv" />
                <p class="ta-hint">
                    Alle Zeilen werden als @(_importCategory.DisplayName())-Mitglieder importiert (Kategorie oben wählen, nicht in der Datei).
                    Spalten (alle optional): Anzahl (Einlässe pro Event, Standard 1), Firma, Anrede, Name, Vorname, Strasse, Adresszusatz, PLZ, Ort, Land, E-Mail, Telefon, Geburtsdatum (dd.MM.yyyy).
                    Die Spalten werden automatisch erkannt. Passt die Zuordnung nicht, kannst du sie unten von Hand anpassen.
                    Exportierte Zeilen mit einer bestehenden Karten-Nr werden beim erneuten Import aktualisiert.
                    <a href="/admin/members/example.csv" target="_blank" rel="noopener">Beispieldatei herunterladen</a>
                </p>
            </div>

            @if (_table is not null && _table.Columns.Count > 0)
            {
                <div class="ta-field">
                    @if (!_showMapping)
                    {
                        <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => _showMapping = true">Spaltenzuordnung anpassen</button>
                    }
                    else
                    {
                        <label class="ta-label">Spaltenzuordnung</label>
                        <p class="ta-hint">Ordne jeder benötigten Spalte eine Spalte aus deiner Datei zu.</p>
                        <table class="ta-map">
                            @foreach (var field in MemberCsv.Fields)
                            {
                                <tr>
                                    <td class="ta-map-label">@field.Label</td>
                                    <td>
                                        <select class="ta-select" value="@MapValue(field.Key)" @onchange="e => SetMap(field.Key, e.Value?.ToString())">
                                            <option value="-1">(nicht zuordnen)</option>
                                            @for (var i = 0; i < _table.Columns.Count; i++)
                                            {
                                                var idx = i;
                                                <option value="@idx">@_table.Columns[idx]</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </table>
                        <div class="ta-modal-actions">
                            <button type="button" class="ta-btn ta-btn-primary" @onclick="ApplyMapping">Zuordnung übernehmen</button>
                        </div>
                    }
                </div>
            }

            @if (_fileName is not null)
            {
                <div class="ta-parse">
                    <strong>@_fileName</strong>: @_parsedRows.Count gültige Zeile@(_parsedRows.Count == 1 ? "" : "n") erkannt.
                    @if (_parseWarnings.Count > 0)
                    {
                        <ul class="ta-warnings">
                            @foreach (var w in _parseWarnings)
                            {
                                <li>@w</li>
                            }
                        </ul>
                    }
                </div>
                @if (_parseErrors.Count > 0)
                {
                    <div class="ta-error">
                        @_parseErrors.Count Fehler, bitte in der Datei korrigieren, dann erneut wählen:
                        <ul class="ta-warnings">
                            @foreach (var er in _parseErrors)
                            {
                                <li>@er</li>
                            }
                        </ul>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(_importError))
            {
                <div class="ta-error">@_importError</div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseImport" disabled="@_saving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="ImportAsync" disabled="@(_saving || _parsedRows.Count == 0 || _parseErrors.Count > 0)">
                    @(_saving ? "Wird importiert …" : _parseErrors.Count > 0 ? "Bitte Fehler beheben" : $"{_parsedRows.Count} Mitglieder importieren")
                </button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="ta-overlay" @onmousedown="CancelEdit">
        <div class="ta-modal ta-modal--members" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Mitglied bearbeiten</h2>
            <p class="ta-modal-sub">Karten-Nr. @AdminFormat.TicketNo(_editing.Uuid)</p>

            <div class="ta-mc-grid">
            <div class="ta-field">
                <label class="ta-label" for="editCompany">Firma (optional)</label>
                <input id="editCompany" class="ta-input" type="text" maxlength="200" @bind="_editCompany" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editLastName">Name (optional)</label>
                <input id="editLastName" class="ta-input" type="text" maxlength="100" @bind="_editLastName" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editFirstName">Vorname (optional)</label>
                <input id="editFirstName" class="ta-input" type="text" maxlength="100" @bind="_editFirstName" />
            </div>
            <div class="ta-field">
                <label class="ta-label">Geburtsdatum (optional)</label>
                <DateBox @bind-Value="_editBirthday" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editCategory">Kategorie</label>
                <select id="editCategory" class="ta-select" @bind="_editCategory">
                    @foreach (var cat in Categories)
                    {
                        <option value="@cat">@cat.DisplayName()</option>
                    }
                </select>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editAdmissions">Anzahl Einlässe pro Event</label>
                <input id="editAdmissions" class="ta-input" type="number" min="1" step="1" @bind="_editAdmissions" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editReference">Bundle</label>
                <input id="editReference" class="ta-input" type="text" maxlength="100" @bind="_editReference" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editEmail">E-Mail (optional)</label>
                <input id="editEmail" class="ta-input" type="email" maxlength="200" @bind="_editEmail" />
            </div>

            <p class="ta-modal-section">Adresse (optional)</p>
            <div class="ta-field">
                <label class="ta-label" for="editSalutation">Anrede</label>
                <input id="editSalutation" class="ta-input" type="text" maxlength="50" placeholder="z. B. Frau / Herr" @bind="_editSalutation" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editStreet">Strasse</label>
                <input id="editStreet" class="ta-input" type="text" maxlength="200" @bind="_editStreet" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editAddressLine2">Adresszusatz</label>
                <input id="editAddressLine2" class="ta-input" type="text" maxlength="200" @bind="_editAddressLine2" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editPostalCode">PLZ</label>
                <input id="editPostalCode" class="ta-input" type="text" maxlength="20" @bind="_editPostalCode" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editCity">Ort</label>
                <input id="editCity" class="ta-input" type="text" maxlength="100" @bind="_editCity" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editCountry">Land</label>
                <input id="editCountry" class="ta-input" type="text" maxlength="100" placeholder="Schweiz" @bind="_editCountry" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="editPhone">Telefon</label>
                <input id="editPhone" class="ta-input" type="text" maxlength="50" @bind="_editPhone" />
            </div>

            <div class="ta-field">
                <label class="ta-label" for="editStatus">Status</label>
                <select id="editStatus" class="ta-select" @bind="_editStatus">
                    <option value="@TicketStatus.Valid">Gültig</option>
                    <option value="@TicketStatus.Cancelled">Storniert</option>
                </select>
            </div>
            </div>

            @if (!string.IsNullOrEmpty(_editError))
            {
                <div class="ta-modal-error">@_editError</div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CancelEdit" disabled="@_savingEdit">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SaveEditAsync" disabled="@_savingEdit">
                    @(_savingEdit ? "Speichert …" : "Speichern")
                </button>
            </div>
        </div>
    </div>
}

@if (_showBulk)
{
    <div class="ta-overlay" @onmousedown="CloseBulk">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Karten versenden</h2>

            @if (_bulkResult is not null)
            {
                <div class="ta-flash">@_bulkResult.Enqueued Karte@(_bulkResult.Enqueued == 1 ? "" : "n") eingereiht@(_bulkResult.Failed > 0 ? $", {_bulkResult.Failed} fehlgeschlagen" : "").</div>
                @if (_bulkResult.NoEmail.Count > 0)
                {
                    <p class="ta-hint">@_bulkResult.NoEmail.Count Karte@(_bulkResult.NoEmail.Count == 1 ? "" : "n") ohne E-Mail übersprungen:</p>
                    <ul class="ta-warnings">
                        @foreach (var c in _bulkResult.NoEmail)
                        {
                            <li>@(c.HasName ? c.HolderName : "(ohne Name)") · @AdminFormat.TicketNo(c.Uuid)</li>
                        }
                    </ul>
                }
                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="CloseBulk">Schliessen</button>
                </div>
            }
            else if (_references.Count == 0)
            {
                <p class="ta-muted-text">Für diese Saison sind keine Bundles vorhanden.</p>
                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseBulk">Schliessen</button>
                </div>
            }
            else
            {
                <div class="ta-field">
                    <label class="ta-label" for="bulkReference">Bundle</label>
                    <select id="bulkReference" class="ta-select" @bind="_bulkReference">
                        @foreach (var r in _references)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
                <p class="ta-hint">@BundleWithEmail Karte@(BundleWithEmail == 1 ? "" : "n") mit E-Mail werden versendet · @BundleWithoutEmail ohne E-Mail werden übersprungen.</p>
                <p class="ta-hint">Je Karte wird der hinterlegte Text der jeweiligen Mitgliedschaft verschickt (Red Ants, Block 4 Privat oder Block 4 Firma). Die Texte pflegst du unter „E-Mail-Texte" im Backoffice.</p>

                @if (!string.IsNullOrEmpty(_bulkError))
                {
                    <div class="ta-modal-error">@_bulkError</div>
                }

                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseBulk" disabled="@_bulkSending">Abbrechen</button>
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="SendBulk" disabled="@(_bulkSending || BundleWithEmail == 0)">
                        @(_bulkSending ? "Sendet …" : $"{BundleWithEmail} Karten senden")
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_mailFor is not null)
{
    <div class="ta-overlay" @onmousedown="CloseMail">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Mitgliederkarte senden</h2>
            <p class="ta-modal-sub">@(_mailFor.HasName ? _mailFor.HolderName : AdminFormat.TicketNo(_mailFor.Uuid)) · @_mailFor.Email</p>

            <div class="ta-field">
                <label class="ta-label" for="mcMailSubject">Betreff</label>
                <input id="mcMailSubject" class="ta-input" type="text" maxlength="200" @bind="_mailSubject" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="mcMailBody">Text</label>
                <textarea id="mcMailBody" class="ta-input ta-textarea" @bind="_mailBody"></textarea>
                <p class="ta-hint">Platzhalter: {Vorname}, {Nachname}, {Saison}, {Anzahl}. Markdown wird unterstützt (**fett**, Listen mit -, [Links](https://…)). QR-Code, Online-Karte und PDF-Link werden automatisch angehängt.</p>
            </div>

            @if (_mailSent)
            {
                <div class="ta-flash">E-Mail wurde in den Versand gegeben.</div>
            }
            @if (!string.IsNullOrEmpty(_mailError))
            {
                <div class="ta-modal-error">@_mailError</div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseMail" disabled="@_mailSending">Schliessen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SendMail" disabled="@(_mailSending || _mailSent)">
                    @(_mailSent ? "Gesendet ✓" : _mailSending ? "Sendet …" : "Senden")
                </button>
            </div>
        </div>
    </div>
}

@if (_visitsCard is not null)
{
    <VisitsOverlay Uuid="_visitsCard.Uuid" Title="@(_visitsCard.HasName ? _visitsCard.HolderName : AdminFormat.TicketNo(_visitsCard.Uuid))" OnClose="CloseVisits" />
}

@if (_deleteTarget is not null)
{
    <ConfirmDialog Title="Mitgliederkarte löschen"
                   Message="@($"Mitgliederkarte {AdminFormat.TicketNo(_deleteTarget.Uuid)} endgültig löschen? Das kann nicht rückgängig gemacht werden.")"
                   ConfirmLabel="Löschen" Danger="true" Busy="_deleteBusy" Error="@_deleteError"
                   OnConfirm="DeleteConfirmedAsync" OnCancel="CancelDelete" />
}

@code {
    [Parameter] public string AdminUser { get; set; } = "";
    [CascadingParameter] public AdminIdentity Identity { get; set; } = new("admin", null);

    [Inject] private ISeasons Seasons { get; set; } = default!;
    [Inject] private IMemberCardAdminReport Report { get; set; } = default!;
    [Inject] private IMemberCards Members { get; set; } = default!;
    [Inject] private IMemberCardEditor MemberEditor { get; set; } = default!;
    [Inject] private IMemberCardMailer Mailer { get; set; } = default!;
    [Inject] private IAdminTicketDeletion Deletion { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;

    private MemberCardListItem? _deleteTarget;
    private bool _deleteBusy;
    private string? _deleteError;

    private void CancelDelete() { _deleteTarget = null; _deleteError = null; }

    private async Task DeleteConfirmedAsync()
    {
        if (_deleteTarget is null) return;
        _deleteBusy = true;
        _deleteError = null;
        try
        {
            await Deletion.DeleteMemberCardAsync(_deleteTarget.Uuid);
            _deleteTarget = null;
            await ReloadCardsAsync();
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _deleteBusy = false; }
    }

    private static readonly MemberCategory[] Categories = Enum.GetValues<MemberCategory>();

    private bool _loading = true;
    private IReadOnlyList<Season> _seasons = [];
    private IReadOnlyList<MemberCardListItem> _cards = [];

    public int SelectedSeasonId { get; set; }
    private string _selectedSeasonName = "";

    private string _sortCol = "category";
    private bool _sortAsc = true;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        _seasons = (await Seasons.GetAllAsync()).OrderByDescending(s => s.StartDate).ToList();
        SelectedSeasonId = AdminState.SelectedSeasonId is int id && _seasons.Any(s => s.Id == id)
            ? id
            : CurrentSeason(_seasons)?.Id ?? _seasons.FirstOrDefault()?.Id ?? 0;
        await ReloadCardsAsync();
        _loading = false;
    }

    private async Task ReloadCardsAsync()
    {
        AdminState.SelectedSeasonId = SelectedSeasonId > 0 ? SelectedSeasonId : null;
        _selectedSeasonName = _seasons.FirstOrDefault(s => s.Id == SelectedSeasonId)?.Name ?? "";
        _cards = SelectedSeasonId > 0 ? await Report.GetBySeasonAsync(SelectedSeasonId) : [];
    }

    private void Sort(string col) { _sortAsc = _sortCol == col ? !_sortAsc : true; _sortCol = col; }
    private string Ind(string col) => _sortCol == col ? (_sortAsc ? "▲" : "▼") : "";
    private IEnumerable<MemberCardListItem> Sorted()
    {
        var src = Filtered();
        IEnumerable<MemberCardListItem> q = _sortCol switch
        {
            "category" => src.OrderBy(c => c.Category).ThenBy(c => c.SortKey),
            "admissions" => src.OrderBy(c => c.Admissions),
            "reference" => src.OrderBy(c => c.Reference ?? "￿"),
            "status" => src.OrderBy(c => c.Status),
            "visits" => src.OrderBy(c => c.EventVisits),
            "created" => src.OrderBy(c => c.CreatedAt),
            _ => src.OrderBy(c => c.SortKey),
        };
        return _sortAsc ? q : q.Reverse();
    }

    private IEnumerable<MemberCardListItem> Filtered()
    {
        var terms = (_search ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return terms.Length == 0
            ? _cards
            : _cards.Where(c => terms.All(t => Haystack(c).Contains(t, StringComparison.OrdinalIgnoreCase)));
    }

    private static string Haystack(MemberCardListItem c) => string.Join(' ', new[]
    {
        AdminFormat.TicketNo(c.Uuid), c.FirstName ?? "", c.LastName ?? "", c.Address?.Company ?? "",
        c.Email ?? "", c.Reference ?? "", c.CategoryLabel, c.IsCancelled ? "Storniert" : "Gültig"
    });

    private bool _showCreate;
    private bool _creating;
    private MemberCategory _newCategory = MemberCategory.RedAnts;
    private string _newFirstName = "";
    private string _newLastName = "";
    private DateOnly? _newBirthday;
    private int _newAdmissions = 1;
    private string _newReference = "";
    private string _newEmail = "";
    private string _newSalutation = "";
    private string _newCompany = "";
    private string _newStreet = "";
    private string _newAddressLine2 = "";
    private string _newPostalCode = "";
    private string _newCity = "";
    private string _newCountry = "";
    private string _newPhone = "";
    private string? _createError;

    private void OpenCreate()
    {
        _newCategory = MemberCategory.RedAnts;
        _newFirstName = _newLastName = _newReference = _newEmail = "";
        _newSalutation = _newCompany = _newStreet = _newAddressLine2 = "";
        _newPostalCode = _newCity = _newCountry = _newPhone = "";
        _newBirthday = null;
        _newAdmissions = 1;
        _createError = null;
        _showCreate = true;
    }
    private void CloseCreate() { if (!_creating) { _showCreate = false; _createError = null; } }

    private async Task CreateCardAsync()
    {
        if (_creating) return;
        if (SelectedSeasonId <= 0) { _createError = "Bitte zuerst eine Saison wählen."; return; }
        if (string.IsNullOrWhiteSpace(_newReference)) { _createError = "Bitte ein Bundle angeben."; return; }
        if (_newAdmissions < 1) { _createError = "Die Anzahl Einlässe muss mindestens 1 sein."; return; }
        var contactError = ValidateContact(_newEmail, _newBirthday);
        if (contactError is not null) { _createError = contactError; return; }
        _creating = true;
        _createError = null;
        try
        {
            var first = string.IsNullOrWhiteSpace(_newFirstName) ? null : _newFirstName;
            var last = string.IsNullOrWhiteSpace(_newLastName) ? null : _newLastName;
            var address = MemberAddress.Create(_newSalutation, _newCompany, _newStreet, _newAddressLine2,
                _newPostalCode, _newCity, _newCountry, _newPhone);
            await Members.CreateAsync(SelectedSeasonId, _newCategory, first, last,
                _newBirthday, _newReference.Trim(),
                email: string.IsNullOrWhiteSpace(_newEmail) ? null : _newEmail.Trim(),
                createdByName: Identity.Name, createdByEmail: Identity.Email, address: address,
                admissions: _newAdmissions);
            _showCreate = false;
            await ReloadCardsAsync();
        }
        catch (DomainException ex) { _createError = ex.Message; }
        finally { _creating = false; }
    }

    private bool _showExport;
    private IReadOnlyList<string> _references = [];
    private string _exportReference = "";

    private void OpenExport()
    {
        _references = _cards
            .Where(c => !string.IsNullOrWhiteSpace(c.Reference))
            .Select(c => c.Reference!)
            .Distinct()
            .OrderBy(r => r)
            .ToList();
        _exportReference = _references.FirstOrDefault() ?? "";
        _showExport = true;
    }
    private void CloseExport() => _showExport = false;

    private bool _showImport;
    private bool _saving;
    private string? _importError;
    private string _importReference = "";
    private MemberCategory _importCategory = MemberCategory.RedAnts;
    private string? _fileName;
    private IReadOnlyList<MemberImportRow> _parsedRows = [];
    private IReadOnlyList<string> _parseWarnings = [];
    private IReadOnlyList<string> _parseErrors = [];
    private MemberTable? _table;
    private Dictionary<string, int> _map = new();
    private bool _showMapping;

    private void OpenImport()
    {
        _importError = null;
        _importReference = "";
        _importCategory = MemberCategory.RedAnts;
        _fileName = null;
        _parsedRows = [];
        _parseWarnings = [];
        _parseErrors = [];
        _table = null;
        _map = new();
        _showMapping = false;
        _showImport = true;
    }

    private void CloseImport() { if (!_saving) _showImport = false; }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _importError = null;
        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var table = MemberCsv.ReadTable(buffer.ToArray(), file.Name);
            _fileName = file.Name;
            _table = table;
            _map = new Dictionary<string, int>(table.AutoMap);

            if (table.Columns.Count == 0 || table.Rows.Count == 0)
            {
                _parsedRows = [];
                _parseWarnings = [];
                _parseErrors = ["Keine Datenzeilen gefunden. Bitte prüfe die Datei."];
                _showMapping = false;
                return;
            }

            if (MemberCsv.EssentialMapped(_map))
            {
                ApplyMapping();
            }
            else
            {
                _parsedRows = [];
                _parseWarnings = [];
                _parseErrors = [];
                _importError = "Spalten konnten nicht automatisch erkannt werden. Bitte unten von Hand zuordnen.";
                _showMapping = true;
            }
        }
        catch (Exception ex)
        {
            _fileName = null;
            _table = null;
            _parsedRows = [];
            _parseWarnings = [];
            _importError = $"Datei konnte nicht gelesen werden: {ex.Message}";
        }
    }

    private int MapValue(string key) => _map.TryGetValue(key, out var idx) ? idx : -1;

    private void SetMap(string key, string? value)
    {
        if (int.TryParse(value, out var idx) && idx >= 0) _map[key] = idx;
        else _map.Remove(key);
    }

    private void ApplyMapping()
    {
        if (_table is null) return;
        _importError = null;
        var result = MemberCsv.BuildRows(_table, _map);
        _parsedRows = result.Rows;
        _parseWarnings = result.Warnings;
        _parseErrors = result.Errors;
        _showMapping = false;
    }

    private async Task ImportAsync()
    {
        _importError = null;
        if (SelectedSeasonId <= 0) { _importError = "Bitte zuerst eine Saison wählen."; return; }
        if (string.IsNullOrWhiteSpace(_importReference)) { _importError = "Bitte ein Bundle angeben."; return; }
        if (_parseErrors.Count > 0) { _importError = "Bitte zuerst die Fehler in der Datei beheben."; return; }
        if (_parsedRows.Count == 0) { _importError = "Bitte eine CSV-Datei mit mindestens einer Zeile wählen."; return; }

        _saving = true;
        try
        {
            var reference = _importReference.Trim();
            await Members.ImportAsync(SelectedSeasonId, reference, _importCategory, _parsedRows, Identity.Name, Identity.Email);
            _showImport = false;
            await ReloadCardsAsync();
        }
        catch (DomainException ex) { _importError = ex.Message; }
        finally { _saving = false; }
    }

    private MemberCardListItem? _editing;
    private string _editFirstName = "";
    private string _editLastName = "";
    private DateOnly? _editBirthday;
    private MemberCategory _editCategory;
    private int _editAdmissions = 1;
    private string _editReference = "";
    private string _editEmail = "";
    private string _editSalutation = "";
    private string _editCompany = "";
    private string _editStreet = "";
    private string _editAddressLine2 = "";
    private string _editPostalCode = "";
    private string _editCity = "";
    private string _editCountry = "";
    private string _editPhone = "";
    private TicketStatus _editStatus;
    private bool _savingEdit;
    private string? _editError;

    private void OpenEdit(MemberCardListItem c)
    {
        _editing = c;
        _editFirstName = c.FirstName ?? "";
        _editLastName = c.LastName ?? "";
        _editBirthday = c.Birthday;
        _editCategory = c.Category;
        _editAdmissions = c.Admissions;
        _editReference = c.Reference ?? "";
        _editEmail = c.Email ?? "";
        var a = c.Address ?? MemberAddress.Empty;
        _editSalutation = a.Salutation ?? "";
        _editCompany = a.Company ?? "";
        _editStreet = a.Street ?? "";
        _editAddressLine2 = a.AddressLine2 ?? "";
        _editPostalCode = a.PostalCode ?? "";
        _editCity = a.City ?? "";
        _editCountry = a.Country ?? "";
        _editPhone = a.Phone ?? "";
        _editStatus = c.Status;
        _editError = null;
    }

    private void CancelEdit() { if (!_savingEdit) { _editing = null; _editError = null; } }

    private async Task SaveEditAsync()
    {
        if (_editing is null) return;
        if (_editAdmissions < 1) { _editError = "Die Anzahl Einlässe muss mindestens 1 sein."; return; }
        var contactError = ValidateContact(_editEmail, _editBirthday);
        if (contactError is not null) { _editError = contactError; return; }
        _savingEdit = true;
        _editError = null;
        try
        {
            var address = MemberAddress.Create(_editSalutation, _editCompany, _editStreet, _editAddressLine2,
                _editPostalCode, _editCity, _editCountry, _editPhone);
            await MemberEditor.SetDetailsAsync(_editing.Uuid, _editFirstName, _editLastName, _editBirthday,
                _editCategory, _editStatus, _editReference, _editEmail, address, _editAdmissions);
            _editing = null;
            await ReloadCardsAsync();
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _savingEdit = false; }
    }

    private MemberCardListItem? _visitsCard;
    private void OpenVisits(MemberCardListItem c) => _visitsCard = c;
    private void CloseVisits() => _visitsCard = null;

    private MemberCardListItem? _mailFor;
    private string _mailSubject = "";
    private string _mailBody = "";
    private bool _mailSending;
    private bool _mailSent;
    private string? _mailError;

    private void OpenMail(MemberCardListItem c)
    {
        _mailFor = c;
        _mailSubject = Mailer.DefaultSubjectFor(c.Category, c.IsCompany);
        _mailBody = Mailer.DefaultBodyFor(c.Category, c.IsCompany);
        _mailSent = false;
        _mailError = null;
    }

    private void CloseMail() { if (!_mailSending) { _mailFor = null; _mailError = null; _mailSent = false; } }

    private async Task SendMail()
    {
        if (_mailFor is null || _mailSending || _mailSent) return;
        _mailSending = true;
        _mailError = null;
        _mailSent = false;
        try
        {
            var result = await Mailer.SendAsync(ToDomain(_mailFor), _mailSubject, _mailBody);
            if (!result.Success)
            {
                _mailError = result.Error ?? "E-Mail konnte nicht versendet werden.";
                return;
            }
            _mailSent = true;
            _mailSending = false;
            StateHasChanged();
            await Task.Delay(1400);
            _mailFor = null;
            _mailSent = false;
        }
        catch (Exception ex) { _mailError = ex.Message; }
        finally { _mailSending = false; }
    }

    private MemberCard ToDomain(MemberCardListItem c) => MemberCard.FromPersistence(
        0, c.Uuid, SelectedSeasonId, c.Category, null, c.Status, c.CreatedAt,
        c.FirstName, c.LastName, c.Birthday, c.Email, c.Reference, address: c.Address, admissions: c.Admissions);

    private bool _showBulk;
    private string _bulkReference = "";
    private bool _bulkSending;
    private string? _bulkError;
    private BulkResult? _bulkResult;

    private sealed record BulkResult(int Enqueued, int Failed, IReadOnlyList<MemberCardListItem> NoEmail);

    private List<MemberCardListItem> BundleCards() =>
        _cards.Where(c => !c.IsCancelled && c.Reference == _bulkReference).ToList();

    private int BundleWithEmail => BundleCards().Count(c => c.HasEmail);
    private int BundleWithoutEmail => BundleCards().Count(c => !c.HasEmail);

    private void OpenBulk()
    {
        _references = _cards
            .Where(c => !string.IsNullOrWhiteSpace(c.Reference))
            .Select(c => c.Reference!)
            .Distinct()
            .OrderBy(r => r)
            .ToList();
        _bulkReference = _references.FirstOrDefault() ?? "";
        _bulkResult = null;
        _bulkError = null;
        _showBulk = true;
    }

    private void CloseBulk() { if (!_bulkSending) { _showBulk = false; _bulkError = null; _bulkResult = null; } }

    private async Task SendBulk()
    {
        if (_bulkSending || string.IsNullOrWhiteSpace(_bulkReference)) return;
        _bulkSending = true;
        _bulkError = null;
        _bulkResult = null;
        try
        {
            var targets = BundleCards();
            var noEmail = targets.Where(c => !c.HasEmail).ToList();
            var enqueued = 0;
            var failed = 0;
            foreach (var c in targets.Where(c => c.HasEmail))
            {
                try
                {
                    var result = await Mailer.SendAsync(ToDomain(c),
                        Mailer.DefaultSubjectFor(c.Category, c.IsCompany),
                        Mailer.DefaultBodyFor(c.Category, c.IsCompany));
                    if (result.Success) enqueued++;
                    else failed++;
                }
                catch { failed++; }
            }
            _bulkResult = new BulkResult(enqueued, failed, noEmail);
        }
        catch (Exception ex) { _bulkError = ex.Message; }
        finally { _bulkSending = false; }
    }

    private static Season? CurrentSeason(IReadOnlyList<Season> seasons)
    {
        var today = SwissTime.Today;
        return seasons.FirstOrDefault(s => s.StartDate <= today && today <= s.EndDate)
            ?? seasons.Where(s => s.StartDate <= today).MaxBy(s => s.StartDate);
    }

    private static string? ValidateContact(string? email, DateOnly? birthday)
    {
        if (!string.IsNullOrWhiteSpace(email))
        {
            var e = email.Trim();
            var at = e.IndexOf('@');
            if (at <= 0 || at == e.Length - 1 || !e[(at + 1)..].Contains('.') || e.EndsWith('.'))
                return "Bitte eine gültige E-Mail-Adresse angeben (oder das Feld leer lassen).";
        }
        if (birthday is { } b)
        {
            if (b > SwissTime.Today) return "Das Geburtsdatum darf nicht in der Zukunft liegen.";
            if (b.Year < 1900) return "Bitte ein gültiges Geburtsdatum angeben.";
        }
        return null;
    }

    private static string CategoryBadgeClass(MemberCategory category) => category switch
    {
        MemberCategory.Block4 => "ta-badge-block4",
        _ => "ta-badge-redants"
    };
}
