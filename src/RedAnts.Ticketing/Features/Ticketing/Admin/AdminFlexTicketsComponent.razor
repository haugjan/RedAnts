    private FlexTicketView? _redeemFor;
    private RedemptionState _redeemTarget;
    private int _redeemEventId;
    private bool _redeemBusy;
    private string? _redeemError;
    private IReadOnlyList<Event> _seasonEvents = [];

    private async Task OpenRedeem(FlexTicketView t)
    {
        _seasonEvents = SelectedSeasonId > 0
            ? (await Events.GetBySeasonAsync(SelectedSeasonId)).OrderBy(e => e.Date).ThenBy(e => e.StartTime).ToList()
            : [];
        _redeemFor = t;
        _redeemTarget = StateOf(t);
        _redeemEventId = t.RedeemedEventId ?? NextEvent(_seasonEvents)?.Id ?? 0;
        _redeemError = null;
    }

    private void CloseRedeem() { if (!_redeemBusy) { _redeemFor = null; _redeemError = null; } }

    private async Task SaveRedeemAsync()
    {
        if (_redeemFor is null) return;
        var t = _redeemFor;
        var current = StateOf(t);
        if (_redeemTarget == current) { CloseRedeem(); return; }

        _redeemBusy = true;
        _redeemError = null;
        try
        {
            var scannedBy = Identity?.Name ?? AdminUser;
            switch (_redeemTarget)
            {
                case RedemptionState.Redeemed:
                    var eventId = t.RedeemedEventId ?? _redeemEventId;
                    if (eventId <= 0) throw new DomainException("Bitte einen Anlass wählen.");
                    await ScanOrThrowAsync(t, eventId, ScanMode.CheckIn, scannedBy);
                    break;
                case RedemptionState.Outside:
                    if (t.RedeemedEventId is not { } outEvent || current != RedemptionState.Redeemed)
                        throw new DomainException("Nur ein eingelöstes Flexticket kann auf „Draussen“ gesetzt werden.");
                    await ScanOrThrowAsync(t, outEvent, ScanMode.CheckOut, scannedBy);
                    break;
                case RedemptionState.Open:
                    if (t.RedeemedEventId is { } inEvent && t.IsInside == true)
                        await ScanOrThrowAsync(t, inEvent, ScanMode.CheckOut, scannedBy);
                    await Bundles.SetTicketRedeemedAsync(t.Uuid, false);
                    break;
            }
            _redeemFor = null;
            await ReloadTicketsAsync();
        }
        catch (Exception ex) { _redeemError = ex.Message; }
        finally { _redeemBusy = false; }
    }

    private async Task ScanOrThrowAsync(FlexTicketView t, int eventId, ScanMode mode, string scannedBy)
    {
        var outcome = await Admission.ScanTicketAsync(eventId, TicketType.SeasonSingle, t.Uuid, SelectedSeasonId, mode, scannedBy);
        if (!outcome.Ok) throw new DomainException(outcome.Reason ?? "Die Änderung wurde abgelehnt.");
    }

    private static Event? NextEvent(IReadOnlyList<Event> events)
    {
        var today = SwissTime.Today;
        return events.FirstOrDefault(e => e.Date >= today) ?? events.MaxBy(e => e.Date);
    }

    private void OpenCreate()
    {
        _createError = null;
        _newCategory = TicketCategory.Adult;
        _newReference = "";
        _newQuantity = 1;
        _newPaymentSource = PaymentSource.Sponsoring;
        _showCreate = true;
    }

    private void CloseCreate() { if (!_saving) _showCreate = false; }

    private async Task CreateBundleAsync()
    {
        _createError = null;
        var reference = (_newReference ?? "").Trim();

        if (SelectedSeasonId <= 0) { _createError = "Bitte zuerst eine Saison wählen."; return; }
        if (reference.Length == 0) { _createError = "Bitte ein Bundle angeben."; return; }
        if (reference.Length > FlexTicketBundle.ReferenceMaxLength)
        { _createError = $"Das Bundle darf höchstens {FlexTicketBundle.ReferenceMaxLength} Zeichen lang sein."; return; }
        if (_newQuantity < 0) { _createError = "Die Anzahl darf nicht negativ sein."; return; }

        _saving = true;
        try
        {
            if (await Bundles.ReferenceExistsAsync(SelectedSeasonId, reference))
            {
                var existingBundle = _bundles.FirstOrDefault(b =>
                    string.Equals(b.Reference, reference, StringComparison.OrdinalIgnoreCase));
                if (existingBundle is null || _newQuantity < 1)
                {
                    _createError = existingBundle is null
                        ? $"Das Bundle „{reference}“ ist in dieser Saison bereits vergeben."
                        : $"Das Bundle „{reference}“ existiert bereits. Für weitere Tickets bitte Anzahl mindestens 1 wählen.";
                    return;
                }
                _confirmAddBundle = existingBundle;
                return;
            }
            FlexTicketBundleView created;
            if (_newQuantity == 0)
            {
                created = await Bundles.CreateEmptyAsync(SelectedSeasonId, _newCategory, reference,
                    Identity?.Name ?? AdminUser, Identity?.Email);
            }
            else
            {
                var order = await OrderFactory.CreateAsync(Buyer.Create(BuyerType.Company, null, null, reference), Identity?.Email,
                    [new AdminOrderLine(OrderItemKind.SeasonSingle, SelectedSeasonId, _newCategory, $"Flexticket · {reference}", _newQuantity, 0m)],
                    Identity?.Name ?? AdminUser, _newPaymentSource);
                created = await Bundles.CreateAsync(SelectedSeasonId, _newCategory, reference, _newQuantity,
                    Identity?.Name ?? AdminUser, Identity?.Email, order.Id);
            }
            _showCreate = false;
            _bundles = await Bundles.GetBySeasonAsync(SelectedSeasonId);
            SelectedBundleId = created.Id;
            await ReloadTicketsAsync();
        }
        catch (DomainException ex) { _createError = ex.Message; }
        finally { _saving = false; }
    }

    private FlexTicketBundleView? _confirmAddBundle;
    private bool _confirmAddBusy;
    private string? _confirmAddError;

    private void CancelAddToExisting() { if (!_confirmAddBusy) _confirmAddBundle = null; }

    private async Task AddToExistingBundleConfirmedAsync()
    {
        if (_confirmAddBundle is null) return;
        _confirmAddError = null;
        _confirmAddBusy = true;
        try
        {
            var reference = _confirmAddBundle.Reference;
            var order = await OrderFactory.CreateAsync(Buyer.Create(BuyerType.Company, null, null, reference), Identity?.Email,
                [new AdminOrderLine(OrderItemKind.SeasonSingle, SelectedSeasonId, _newCategory, $"Flexticket · {reference}", _newQuantity, 0m)],
                Identity?.Name ?? AdminUser, _newPaymentSource);
            var updated = await Bundles.AddTicketsAsync(_confirmAddBundle.Id, _newCategory, _newQuantity,
                Identity?.Name ?? AdminUser, Identity?.Email, order.Id);
            _confirmAddBundle = null;
            _showCreate = false;
            _bundles = await Bundles.GetBySeasonAsync(SelectedSeasonId);
            SelectedBundleId = updated.Id;
            await ReloadTicketsAsync();
        }
        catch (DomainException ex) { _confirmAddError = ex.Message; }
        finally { _confirmAddBusy = false; }
    }

    private FlexTicketBundleView? _editing;
    private string _editReference = "";
    private string? _editError;

    private void OpenEdit(FlexTicketBundleView b)
    {
        _editing = b;
        _editReference = b.Reference;
        _editError = null;
    }

    private void CancelEdit() { if (!_saving) { _editing = null; _editError = null; } }

    private async Task SaveEditAsync()
    {
        if (_editing is null) return;
        var reference = (_editReference ?? "").Trim();
        if (reference == _editing.Reference) { _editing = null; return; }
        _saving = true;
        _editError = null;
        try
        {
            await BundleEditor.RenameAsync(_editing.Id, _editing.SeasonId, reference);
            _editing = null;
            _bundles = await Bundles.GetBySeasonAsync(SelectedSeasonId);
        }
        catch (DomainException ex) { _editError = ex.Message; }
        finally { _saving = false; }
    }

    private static Season? CurrentSeason(IReadOnlyList<Season> seasons)
    {
        var today = SwissTime.Today;
        return seasons.FirstOrDefault(s => s.StartDate <= today && today <= s.EndDate)
            ?? seasons.Where(s => s.StartDate <= today).MaxBy(s => s.StartDate);
    }
