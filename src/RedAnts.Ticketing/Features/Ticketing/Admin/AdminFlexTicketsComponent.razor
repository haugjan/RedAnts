@using RedAnts.Domain.Ticketing
@using RedAnts.Domain.Ticketing.Sales
@using RedAnts.Features.Ticketing.Email
@using RedAnts.Features.Ticketing.Ports
@using RedAnts.Features.Ticketing.Scanning
@inject IPublicBaseUrl PublicUrl
@inject ITicketTokens Tokens

<section class="ta-page">
    <h1 class="ta-page-title">@TicketType.SeasonSingle.DisplayName()</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="seasonSelect">Saison</label>
                    <select id="seasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="OnSeasonChangedAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="bundleSelect">Bundle</label>
                    <select id="bundleSelect" class="ta-select" disabled="@(_bundles.Count == 0)"
                            @bind="SelectedBundleId" @bind:after="ReloadTicketsAsync">
                        @if (_bundles.Count == 0)
                        {
                            <option value="0">— keine Bundles —</option>
                        }
                        else
                        {
                            <option value="0">Alle anzeigen</option>
                            @foreach (var b in _bundles)
                            {
                                <option value="@b.Id">@b.Reference · @b.Category.DisplayName() · @b.TicketCount Stk.</option>
                            }
                        }
                    </select>
                </div>
                <div class="ta-field ta-field--filter">
                    <label class="ta-label" for="flexSearch">Suche</label>
                    <input id="flexSearch" class="ta-input" type="search" placeholder="Name, E-Mail …" @bind="_search" @bind:event="oninput" />
                </div>
            </div>
            <div class="ta-toolbar-actions">
                @if (SelectedBundle is not null)
                {
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="OpenExport"
                            title="Ein oder mehrere Bundles als Excel/CSV exportieren (Karten-Nr + Bundle + Ticketlink)">Export CSV</button>
                    <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedBundle.TicketCount == 0)"
                            title="@(SelectedBundle.TicketCount == 0 ? "Leeres Bundle – keine Flextickets zum Drucken" : "Flextickets als druckfertiges PDF erzeugen (eine Karte pro Seite)")"
                            @onclick="OpenPrint">PDF drucken</button>
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => OpenEdit(SelectedBundle)">Bundle bearbeiten</button>
                    @if (Identity?.IsAdmin == true)
                    {
                        <button type="button" class="ta-btn ta-btn-ghost ta-btn-danger"
                                disabled="@(SelectedBundle.TicketCount > 0)"
                                title="@(SelectedBundle.TicketCount > 0 ? "Nur leere Bundles können gelöscht werden – bitte zuerst die Flextickets entfernen" : "Bundle löschen")"
                                @onclick="OpenDeleteBundle">Bundle löschen</button>
                    }
                }
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedSeasonId <= 0)" @onclick="OpenImport">
                    Import CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_tickets.Count == 0)" @onclick="OpenBulk"
                        title="Die aktuell gefilterten Flextickets mit E-Mail versenden">Tickets versenden</button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedSeasonId <= 0)" @onclick="OpenCreateBundle">
                    Bundle erstellen
                </button>
                <button type="button" class="ta-btn ta-btn-primary" disabled="@(SelectedSeasonId <= 0)" @onclick="OpenCreateSingle">
                    Einzelticket erstellen
                </button>
            </div>
        </div>

        @if (_bundles.Count == 0)
        {
            <div class="ta-placeholder">Für diese Saison sind keine Flexticket-Bundles erfasst.</div>
        }
        else if (_tickets.Count == 0)
        {
            <div class="ta-placeholder">Dieses Bundle enthält keine Flextickets.</div>
        }
        else
        {
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Ticket-Nr.</th>
                            <th>Person</th>
                            <th class="ta-th-sort" @onclick='() => Sort("created")'>Erstellt <span class="ta-sort-ind">@Ind("created")</span></th>
                            <th>Bundle</th>
                            <th>Kategorie</th>
                            <th class="ta-th-sort" @onclick='() => Sort("status")'>Status <span class="ta-sort-ind">@Ind("status")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("redeemed")'>Eingelöst <span class="ta-sort-ind">@Ind("redeemed")</span></th>
                            <th>Event&shy;besuche</th>
                            <th class="ta-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Sorted())
                        {
                            <tr>
                                <td>
                                    <span class="ta-ticketno">
                                        <span class="ta-no">@AdminFormat.TicketNo(t.Uuid)</span>
                                        <a class="ta-qr-link" href="@PublicUrl.TicketUrl(Tokens.CreateShort(t.Uuid))" target="_blank" rel="noopener" title="Online-Ticket" aria-label="Online-Ticket">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17 14h.01M20 14v3M14 17h.01M17 20h3M20 20h.01"/></svg>
                                        </a>
                                    </span>
                                </td>
                                <td class="ta-cell-name"><PersonCell Holder="t.Holder" /></td>
                                <td class="ta-created" title="@AdminFormat.CreatedTooltip(t.CreatedAt, t.CreatorName, t.CreatorEmail, null)">
                                    @AdminFormat.CreatedShort(t.CreatedAt, t.CreatorName, null)
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(t.BundleReference)) { <span class="ta-badge ta-badge-buyer">@t.BundleReference</span> }
                                    else { <span class="ta-muted">–</span> }
                                    @if (t.BoxOffice)
                                    {
                                        <span class="ta-badge ta-badge-firma" title="Als Abendkassenticket markiert: gilt auch an Spezialanlässen, die Flextickets einschränken.">🎫 Abendkasse</span>
                                    }
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketCategory"
                                                      Value="@t.Category"
                                                      Options="@Categories"
                                                      Label="@(c => c.DisplayName())"
                                                      FieldLabel="Kategorie"
                                                      Save="@(c => SaveCategoryAsync(t, c))" />
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketStatus"
                                                      Value="@t.Status"
                                                      Options="@AllStatuses"
                                                      Label="@(s => s.DisplayName())"
                                                      FieldLabel="Status"
                                                      Save="@(s => SaveStatusAsync(t, s))">
                                        <Display Context="status">
                                            <span class="ta-badge ta-badge-@status.ToString().ToLowerInvariant()">@status.DisplayName()</span>
                                        </Display>
                                    </InlineSelectEdit>
                                </td>
                                <td>
                                    @if (t.Status == TicketStatus.Valid)
                                    {
                                        <button type="button" class="ta-badge-btn" title="Einlösung ändern" @onclick="() => OpenRedeem(t)">
                                            <span class="ta-badge @RedemptionBadge(StateOf(t))">@StateOf(t).DisplayName()</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="ta-badge @RedemptionBadge(StateOf(t))">@StateOf(t).DisplayName()</span>
                                    }
                                    @if (t.ConvertedForPurchase)
                                    {
                                        <span class="ta-conv-badge" title="Dieses Flexticket wurde für einen Ticketkauf (Umwandlung) an einem Spezialanlass gebraucht, nicht am Eingang gescannt.">↔ Umwandlung</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="ta-visits-link" @onclick="() => _visitsFor = t">Besuch</button>
                                </td>
                                <td class="ta-col-actions">
                                    <button type="button" class="ta-icon-btn" title="@(HasEmail(t) ? "E-Mail senden" : "Keine E-Mail hinterlegt")" disabled="@(!HasEmail(t))" @onclick="() => OpenMail(t)">✉</button>
                                    <button type="button" class="ta-icon-btn" title="Personendaten bearbeiten" @onclick="() => OpenEditPerson(t)">✎</button>
                                    <button type="button" class="ta-icon-btn" title="Als PDF drucken" @onclick="() => OpenSinglePrint(t.Uuid)">🖨</button>
                                    @if (Identity?.IsAdmin == true)
                                    {
                                        <button type="button" class="ta-icon-btn ta-icon-btn-danger" title="Löschen" @onclick="() => _deleteTarget = t">🗑</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="ta-summary">
                @_tickets.Count Flextickets · @_tickets.Count(t => t.Redeemed) eingelöst · @_tickets.Count(t => t.Status == TicketStatus.Blocked) gesperrt
                @if (SelectedBundle is { CreatedByName: { Length: > 0 } by }) { <text> · erstellt von @by</text> }
            </p>
        }
    }
</section>

@if (_showExport)
{
    <div class="ta-overlay" @onmousedown="CloseExport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Bundles exportieren</h2>
            <p class="ta-modal-sub">@_selectedSeasonName · Karten-Nr, Bundle und Ticketlink je Karte</p>

            @if (_bundles.Count == 0)
            {
                <div class="ta-placeholder">Für diese Saison sind keine Bundles erfasst.</div>
            }
            else
            {
                <div class="ta-export-tools">
                    <button type="button" class="ta-linkish" @onclick="SelectAllExport">Alle</button>
                    <button type="button" class="ta-linkish" @onclick="ClearExport">Keine</button>
                </div>
                <div class="ta-export-list">
                    @foreach (var b in _bundles)
                    {
                        <label class="ta-export-item">
                            <input type="checkbox" checked="@_exportSelection.Contains(b.Id)"
                                   @onchange="@(e => ToggleExport(b.Id, e.Value is true))" />
                            <span>@b.Reference <span class="ta-muted">· @b.Category.DisplayName() · @b.TicketCount Stk.</span></span>
                        </label>
                    }
                </div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseExport">Schliessen</button>
                @if (_exportSelection.Count > 0)
                {
                    <a class="ta-btn ta-btn-primary" href="@ExportUrl()" target="_blank" rel="noopener" @onclick="CloseExport">
                        Export CSV (@_exportSelection.Count)
                    </a>
                }
                else
                {
                    <button type="button" class="ta-btn ta-btn-primary" disabled>Export CSV</button>
                }
            </div>
        </div>
    </div>
}

@if (_showPrint)
{
    <TicketPrintDialog Type="TicketType.SeasonSingle"
                       Title="Flextickets als PDF drucken"
                       Subtitle="@_printSubtitle"
                       Layout="_printLayout"
                       OnClose="ClosePrint">
        <HiddenInputs>
            @if (_printUuid is { } u)
            {
                <input type="hidden" name="uuid" value="@u" />
            }
            else
            {
                <input type="hidden" name="bundleId" value="@_printBundleId" />
            }
        </HiddenInputs>
    </TicketPrintDialog>
}

@if (_mailFor is not null)
{
    <div class="ta-overlay" @onmousedown="CloseMail">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Flexticket senden</h2>
            <p class="ta-modal-sub">@(_mailFor.Holder?.DisplayName ?? AdminFormat.TicketNo(_mailFor.Uuid)) · @_mailFor.Holder?.Email</p>

            <div class="ta-field">
                <label class="ta-label" for="ftMailSubject">Betreff</label>
                <input id="ftMailSubject" class="ta-input" type="text" maxlength="200" @bind="_mailSubject" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="ftMailBody">Text</label>
                <textarea id="ftMailBody" class="ta-input ta-textarea" @bind="_mailBody"></textarea>
                <p class="ta-hint">Platzhalter: {Name}, {Saison}. Markdown wird unterstützt. QR-Code, Online-Ticket und PDF-Link werden automatisch angehängt.</p>
            </div>

            @if (_mailSent) { <div class="ta-flash">E-Mail wurde in den Versand gegeben.</div> }
            @if (!string.IsNullOrEmpty(_mailError)) { <div class="ta-modal-error">@_mailError</div> }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseMail" disabled="@_mailSending">Schliessen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SendMail" disabled="@(_mailSending || _mailSent)">
                    @(_mailSent ? "Gesendet ✓" : _mailSending ? "Sendet …" : "Senden")
                </button>
            </div>
        </div>
    </div>
}

@if (_editPersonFor is not null)
{
    <div class="ta-overlay" @onmousedown="CloseEditPerson">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Flexticket bearbeiten</h2>
            <p class="ta-modal-sub">Ticket-Nr. @AdminFormat.TicketNo(_editPersonFor.Uuid)</p>

            <PersonEditor Model="_editPersonForm" Prefix="editFt" EmailHint=" (für den Ticketversand)" />

            @if (!string.IsNullOrEmpty(_editPersonError)) { <div class="ta-modal-error">@_editPersonError</div> }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseEditPerson" disabled="@_editPersonSaving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SaveEditPerson" disabled="@_editPersonSaving">
                    @(_editPersonSaving ? "Speichert …" : "Speichern")
                </button>
            </div>
        </div>
    </div>
}

@if (_showBulk)
{
    <div class="ta-overlay" @onmousedown="CloseBulk">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Flextickets versenden</h2>

            @if (_bulkResult is not null)
            {
                <div class="ta-flash">@_bulkResult.Enqueued Ticket@(_bulkResult.Enqueued == 1 ? "" : "s") eingereiht@(_bulkResult.Failed > 0 ? $", {_bulkResult.Failed} fehlgeschlagen" : "").</div>
                @if (_bulkResult.NoEmail > 0)
                {
                    <p class="ta-hint">@_bulkResult.NoEmail Ticket@(_bulkResult.NoEmail == 1 ? "" : "s") ohne E-Mail übersprungen.</p>
                }
                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="CloseBulk">Schliessen</button>
                </div>
            }
            else
            {
                <p class="ta-hint">@BulkWithEmail Ticket@(BulkWithEmail == 1 ? "" : "s") mit E-Mail werden versendet · @BulkWithoutEmail ohne E-Mail werden übersprungen. Grundlage ist die aktuelle Filterung.</p>

                <div class="ta-field">
                    <label class="ta-label" for="ftBulkSubject">Betreff</label>
                    <input id="ftBulkSubject" class="ta-input" type="text" maxlength="200" @bind="_bulkSubject" />
                </div>
                <div class="ta-field">
                    <label class="ta-label" for="ftBulkBody">Text</label>
                    <textarea id="ftBulkBody" class="ta-input ta-textarea" @bind="_bulkBody"></textarea>
                    <p class="ta-hint">Platzhalter: {Name}, {Saison}. Markdown wird unterstützt. QR-Code, Online-Ticket und PDF-Link werden je Ticket angehängt.</p>
                </div>

                @if (!string.IsNullOrEmpty(_bulkError)) { <div class="ta-modal-error">@_bulkError</div> }

                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseBulk" disabled="@_bulkSending">Abbrechen</button>
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="SendBulk" disabled="@(_bulkSending || BulkWithEmail == 0)">
                        @(_bulkSending ? "Sendet …" : $"{BulkWithEmail} Tickets senden")
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_showCreate)
{
    <div class="ta-overlay" @onmousedown="CloseCreate">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">@(_createSingle ? "Flexticket erstellen" : "Flexticket-Bundle erstellen")</h2>

            <div class="ta-field">
                <label class="ta-label">Saison</label>
                <div class="ta-readonly">@_selectedSeasonName</div>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newCategory">Ticketkategorie</label>
                <select id="newCategory" class="ta-select" @bind="_newCategory">
                    @foreach (var c in Categories)
                    {
                        <option value="@c">@c.DisplayName()</option>
                    }
                </select>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newReference">Bundle</label>
                <input id="newReference" class="ta-input" type="text" maxlength="50" list="flexBundleOptions" placeholder="Neu oder bestehendes wählen" @bind="_newReference" />
                <datalist id="flexBundleOptions">
                    @foreach (var b in _bundles) { <option value="@b.Reference" /> }
                </datalist>
            </div>

            @if (_createSingle)
            {
                <PersonEditor Model="_newPerson" Prefix="newFt" EmailHint=" (optional, für den Ticketversand)" />
            }
            else
            {
                <div class="ta-field">
                    <label class="ta-label" for="newQuantity">Anzahl Flextickets</label>
                    <input id="newQuantity" class="ta-input" type="number" min="0" max="2000" @bind="_newQuantity" />
                    <p class="ta-field-hint">0 = leeres Bundle (nur als Umbuchungsziel, ohne Tickets).</p>
                </div>
                @if (_newQuantity > 0)
                {
                    <div class="ta-field">
                        <label class="ta-label" for="newFlexPaymentSource">Zahlart</label>
                        <select id="newFlexPaymentSource" class="ta-select" @bind="_newPaymentSource">
                            @foreach (var ps in PaymentSourceExtensions.AdminChoicesForPrice(0m))
                            {
                                <option value="@ps">@ps.DisplayName()</option>
                            }
                        </select>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(_createError))
            {
                <div class="ta-error">@_createError</div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseCreate" disabled="@_saving">Abbrechen</button>
                @if (_createSingle)
                {
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="CreateSingleTicketAsync" disabled="@_saving">
                        @(_saving ? "Wird erstellt …" : "Einzelticket erstellen")
                    </button>
                }
                else
                {
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="CreateBundleAsync" disabled="@_saving">
                        @(_saving ? "Wird erstellt …" : "Bundle erstellen")
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_showImport)
{
    <div class="ta-overlay" @onmousedown="CloseImport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Flextickets importieren</h2>

            <div class="ta-field">
                <label class="ta-label">Saison</label>
                <div class="ta-readonly">@_selectedSeasonName</div>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="impFlexCategory">Kategorie (Vorauswahl, Datei kann überschreiben)</label>
                <select id="impFlexCategory" class="ta-select" @bind="_importCategory">
                    @foreach (var c in MainCategories)
                    {
                        <option value="@c">@c.DisplayName()</option>
                    }
                </select>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="impFlexReference">Bundle</label>
                <input id="impFlexReference" class="ta-input" type="text" maxlength="50" list="flexImportBundleOptions" placeholder="z. B. Sponsoren 2026" @bind="_importReference" />
                <datalist id="flexImportBundleOptions">
                    @foreach (var b in _bundles) { <option value="@b.Reference" /> }
                </datalist>
                <p class="ta-hint">Gilt für Zeilen ohne eigene Bundle-Spalte; eine Bundle-Spalte in der Datei hat Vorrang.</p>
            </div>

            <div class="ta-field">
                <label class="ta-label">Datei (CSV oder Excel)</label>
                <InputFile OnChange="OnImportFileAsync" accept=".csv,.xlsx,text/csv" />
                <p class="ta-hint">
                    Spalten (alle optional): Karten-Nr, Bundle, Kategorie, Firma, Anrede, Name, Vorname, Strasse, Adresszusatz, PLZ, Ort, Land, E-Mail, Telefon, Geburtsdatum (dd.MM.yyyy).
                    Die Spalten werden automatisch erkannt; passt die Zuordnung nicht, unten von Hand anpassen.
                    Zeilen mit bestehender Karten-Nr werden aktualisiert.
                    <a href="/admin/flex-tickets/example.csv" target="_blank" rel="noopener">Beispieldatei herunterladen</a>
                </p>
            </div>

            @if (_importTable is not null && _importTable.Columns.Count > 0)
            {
                <div class="ta-field">
                    @if (!_showMapping)
                    {
                        <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => _showMapping = true">Spaltenzuordnung anpassen</button>
                    }
                    else
                    {
                        <label class="ta-label">Spaltenzuordnung</label>
                        <p class="ta-hint">Ordne jeder benötigten Spalte eine Spalte aus deiner Datei zu.</p>
                        <table class="ta-map">
                            @foreach (var field in TicketImportCsv.Fields)
                            {
                                <tr>
                                    <td class="ta-map-label">@field.Label</td>
                                    <td>
                                        <select class="ta-select" value="@MapValue(field.Key)" @onchange="e => SetMap(field.Key, e.Value?.ToString())">
                                            <option value="-1">(nicht zuordnen)</option>
                                            @for (var i = 0; i < _importTable.Columns.Count; i++)
                                            {
                                                var idx = i;
                                                <option value="@idx">@_importTable.Columns[idx]</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </table>
                        <div class="ta-modal-actions">
                            <button type="button" class="ta-btn ta-btn-primary" @onclick="ApplyMapping">Zuordnung übernehmen</button>
                        </div>
                    }
                </div>
            }

            @if (_importFileName is not null)
            {
                <div class="ta-parse">
                    <strong>@_importFileName</strong>: @_importRows.Count gültige Zeile@(_importRows.Count == 1 ? "" : "n") erkannt.
                    @if (_importWarnings.Count > 0)
                    {
                        <ul class="ta-warnings">
                            @foreach (var w in _importWarnings) { <li>@w</li> }
                        </ul>
                    }
                </div>
                @if (_importErrors.Count > 0)
                {
                    <div class="ta-error">
                        @_importErrors.Count Fehler, bitte in der Datei korrigieren:
                        <ul class="ta-warnings">
                            @foreach (var er in _importErrors) { <li>@er</li> }
                        </ul>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(_importError)) { <div class="ta-error">@_importError</div> }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseImport" disabled="@_importSaving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="RunImportAsync" disabled="@(_importSaving || _importRows.Count == 0 || _importErrors.Count > 0)">
                    @(_importSaving ? "Wird importiert …" : _importErrors.Count > 0 ? "Bitte Fehler beheben" : $"{_importRows.Count} Flextickets importieren")
                </button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="ta-overlay" @onmousedown="CancelEdit">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Bundle bearbeiten</h2>
