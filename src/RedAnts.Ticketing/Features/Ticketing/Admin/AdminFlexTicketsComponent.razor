}

@if (_redeemFor is not null)
{
    <div class="ta-overlay" @onmousedown="CloseRedeem">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Einlösung ändern</h2>
