</style>

@code {
    [Parameter] public string AdminUser { get; set; } = "";
    [CascadingParameter] public AdminIdentity? Identity { get; set; }

    [Inject] private ISeasons Seasons { get; set; } = default!;
    [Inject] private IEvents Events { get; set; } = default!;
    [Inject] private IFlexTicketBundles Bundles { get; set; } = default!;
    [Inject] private IFlexBundleEditor BundleEditor { get; set; } = default!;
    [Inject] private IAdmissionService Admission { get; set; } = default!;
    [Inject] private IAdminOrderFactory OrderFactory { get; set; } = default!;
    [Inject] private IAdminTicketDeletion Deletion { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;
    [Inject] private ITicketPrintSettings PrintSettings { get; set; } = default!;
    [Inject] private IFlexTicketMailer Mailer { get; set; } = default!;

    private bool _showPrint;
    private int _printBundleId;
    private Guid? _printUuid;
    private string _printSubtitle = "";
    private TicketPrintLayout _printLayout = TicketPrintLayout.Default;

    private async Task OpenPrint()
    {
        if (SelectedBundle is null || SelectedBundle.TicketCount == 0) return;
        _printBundleId = SelectedBundle.Id;
        _printUuid = null;
        _printSubtitle = $"{SelectedBundle.Reference} · {SelectedBundle.TicketCount} Karten · eine Seite pro Karte";
        _printLayout = await PrintSettings.GetAsync(TicketType.SeasonSingle);
        _showPrint = true;
    }

    private async Task OpenSinglePrint(Guid uuid)
    {
        _printUuid = uuid;
        _printSubtitle = $"Ticket-Nr. {AdminFormat.TicketNo(uuid)}";
        _printLayout = await PrintSettings.GetAsync(TicketType.SeasonSingle);
        _showPrint = true;
    }

    private void ClosePrint() => _showPrint = false;

    private static bool HasEmail(FlexTicketView t) => !string.IsNullOrWhiteSpace(t.Holder?.Email);

    private FlexTicketView? _editPersonFor;
    private PersonForm _editPersonForm = new();
    private bool _editPersonSaving;
    private string? _editPersonError;

    private void OpenEditPerson(FlexTicketView t)
    {
        _editPersonFor = t;
        _editPersonForm = PersonForm.From(t.Holder);
        _editPersonError = null;
    }

    private void CloseEditPerson() { if (!_editPersonSaving) { _editPersonFor = null; _editPersonError = null; } }

    private async Task SaveEditPerson()
    {
        if (_editPersonFor is null) return;
        _editPersonSaving = true;
        _editPersonError = null;
        try
        {
            await Bundles.SetHolderAsync(_editPersonFor.Uuid, _editPersonForm.ToHolder());
            _editPersonFor = null;
            await ReloadTicketsAsync();
        }
        catch (DomainException ex) { _editPersonError = ex.Message; }
        finally { _editPersonSaving = false; }
    }

    private FlexTicketView? _mailFor;
    private string _mailSubject = "";
    private string _mailBody = "";
    private bool _mailSending;
    private bool _mailSent;
    private string? _mailError;

    private void OpenMail(FlexTicketView t)
    {
        _mailFor = t;
        _mailSubject = Mailer.DefaultSubject;
        _mailBody = Mailer.DefaultBody;
        _mailSent = false;
        _mailError = null;
    }

    private void CloseMail() { if (!_mailSending) { _mailFor = null; _mailError = null; } }

    private async Task SendMail()
    {
        if (_mailFor is null) return;
        _mailSending = true;
        _mailError = null;
        try
        {
            var result = await SendOneAsync(_mailFor, _mailSubject, _mailBody);
            if (result.Success) { _mailSent = true; await Task.Delay(1400); _mailFor = null; }
            else _mailError = result.Error;
        }
        finally { _mailSending = false; }
    }

    private Task<EmailSendResult> SendOneAsync(FlexTicketView t, string subject, string body) =>
        Mailer.SendAsync(new FlexMailTicket(t.Uuid, t.Holder?.Email, t.Holder?.DisplayName, SelectedSeasonId,
            t.Category.DisplayName()), subject, body);

    private bool _showBulk;
    private bool _bulkSending;
    private string _bulkSubject = "";
    private string _bulkBody = "";
    private string? _bulkError;
    private BulkResult? _bulkResult;
    private sealed record BulkResult(int Enqueued, int Failed, int NoEmail);

    private int BulkWithEmail => Filtered().Count(HasEmail);
    private int BulkWithoutEmail => Filtered().Count(t => !HasEmail(t));

    private void OpenBulk()
    {
        _bulkSubject = Mailer.DefaultSubject;
        _bulkBody = Mailer.DefaultBody;
        _bulkResult = null;
        _bulkError = null;
        _showBulk = true;
    }

    private void CloseBulk() { if (!_bulkSending) _showBulk = false; }

    private async Task SendBulk()
    {
        _bulkSending = true;
        _bulkError = null;
        try
        {
            int enqueued = 0, failed = 0, noEmail = 0;
            foreach (var t in Filtered().ToList())
            {
                if (!HasEmail(t)) { noEmail++; continue; }
                var r = await SendOneAsync(t, _bulkSubject, _bulkBody);
                if (r.Success) enqueued++; else failed++;
            }
            _bulkResult = new BulkResult(enqueued, failed, noEmail);
        }
        finally { _bulkSending = false; }
    }

    private FlexTicketView? _deleteTarget;
    private bool _deleteBusy;
    private string? _deleteError;

    private void CancelDelete() { _deleteTarget = null; _deleteError = null; }

    private FlexTicketBundleView? _deleteBundleTarget;
    private bool _deleteBundleBusy;
    private string? _deleteBundleError;

    private void OpenDeleteBundle()
    {
        _deleteBundleTarget = SelectedBundle;
        _deleteBundleError = null;
    }

    private void CancelDeleteBundle() { _deleteBundleTarget = null; _deleteBundleError = null; }

    private async Task DeleteBundleConfirmedAsync()
    {
        if (_deleteBundleTarget is null) return;
        _deleteBundleBusy = true;
        _deleteBundleError = null;
        try
        {
            if (!await Bundles.DeleteEmptyAsync(_deleteBundleTarget.Id))
            {
                _deleteBundleError = "Nur leere Bundles können gelöscht werden. Bitte zuerst die Flextickets entfernen.";
                return;
            }
            _deleteBundleTarget = null;
            _bundles = await Bundles.GetBySeasonAsync(SelectedSeasonId);
            SelectedBundleId = _bundles.FirstOrDefault()?.Id ?? 0;
            await ReloadTicketsAsync();
        }
        catch (Exception ex) { _deleteBundleError = ex.Message; }
        finally { _deleteBundleBusy = false; }
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_deleteTarget is null) return;
        _deleteBusy = true;
        _deleteError = null;
        try
        {
            await Deletion.DeleteFlexTicketAsync(_deleteTarget.Uuid);
            _deleteTarget = null;
            await ReloadTicketsAsync();
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _deleteBusy = false; }
    }

    private static readonly TicketCategory[] Categories = Enum.GetValues<TicketCategory>();
    private static readonly TicketCategory[] MainCategories =
        [TicketCategory.Adult, TicketCategory.Youth, TicketCategory.Child];

    private bool _loading = true;
    private IReadOnlyList<Season> _seasons = [];
    private IReadOnlyList<FlexTicketBundleView> _bundles = [];
    private IReadOnlyList<FlexTicketView> _tickets = [];

    public int SelectedSeasonId { get; set; }
    public int SelectedBundleId { get; set; }
    private string _selectedSeasonName = "";

    private FlexTicketBundleView? SelectedBundle => _bundles.FirstOrDefault(b => b.Id == SelectedBundleId);

    private bool _showExport;
    private readonly HashSet<int> _exportSelection = [];

    private void OpenExport()
    {
        _exportSelection.Clear();
        if (SelectedBundleId > 0) _exportSelection.Add(SelectedBundleId);
        _showExport = true;
    }

    private void CloseExport() => _showExport = false;

    private void ToggleExport(int bundleId, bool on)
    {
        if (on) _exportSelection.Add(bundleId); else _exportSelection.Remove(bundleId);
    }

    private void SelectAllExport() { foreach (var b in _bundles) _exportSelection.Add(b.Id); }
    private void ClearExport() => _exportSelection.Clear();

    private string ExportUrl() => $"/admin/flex-tickets/bundles.csv?ids={string.Join(',', _exportSelection)}";

    private string _sortCol = "created";
    private bool _sortAsc = false;

    private bool _showCreate;
    private bool _saving;
    private string? _createError;
    private bool _createSingle = true;
    private TicketCategory _newCategory = TicketCategory.Adult;
    private PaymentSource _newPaymentSource = PaymentSource.Sponsoring;
    private string _newReference = "";
    private int _newQuantity = 1;
    private PersonForm _newPerson = new();

    private async Task CreateSingleTicketAsync()
    {
        if (SelectedSeasonId <= 0) { _createError = "Es ist keine Saison gewählt."; return; }
        var reference = (_newReference ?? "").Trim();
        if (reference.Length == 0) { _createError = "Bitte ein Bundle angeben."; return; }
        var holder = _newPerson.ToHolder();
        if (!holder.HasName) { _createError = "Bitte Vor-/Nachname oder Firmenname angeben."; return; }
        _saving = true;
        _createError = null;
        try
        {
            await Bundles.CreateSingleAsync(SelectedSeasonId, _newCategory, reference, holder,
                Identity?.Name ?? AdminUser, Identity?.Email);
            _showCreate = false;
            await OnSeasonChangedAsync();
        }
        catch (DomainException ex) { _createError = ex.Message; }
        finally { _saving = false; }
    }

    private bool _showImport;
    private bool _importSaving;
    private string? _importFileName;
    private string? _importError;
    private string _importReference = "";
    private TicketCategory _importCategory = TicketCategory.Adult;
    private IReadOnlyList<TicketImportRow> _importRows = [];
    private IReadOnlyList<string> _importWarnings = [];
    private IReadOnlyList<string> _importErrors = [];
    private TicketImportTable? _importTable;
    private Dictionary<string, int> _map = new();
    private bool _showMapping;

    private void OpenImport()
    {
        _importFileName = null;
        _importReference = "";
        _importCategory = TicketCategory.Adult;
        _importRows = [];
        _importWarnings = [];
        _importErrors = [];
        _importError = null;
        _importTable = null;
        _map = new();
        _showMapping = false;
        _showImport = true;
    }
    private void CloseImport() { if (!_importSaving) _showImport = false; }

    private async Task OnImportFileAsync(InputFileChangeEventArgs e)
    {
        _importError = null;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var table = TicketImportCsv.ReadTable(buffer.ToArray(), e.File.Name);
            _importFileName = e.File.Name;
            _importTable = table;
            _map = new Dictionary<string, int>(table.AutoMap);

            if (table.Columns.Count == 0 || table.Rows.Count == 0)
            {
                _importRows = [];
                _importWarnings = [];
                _importErrors = ["Keine Datenzeilen gefunden. Bitte prüfe die Datei."];
                _showMapping = false;
                return;
            }

            if (TicketImportCsv.EssentialMapped(_map))
            {
                ApplyMapping();
            }
            else
            {
                _importRows = [];
                _importWarnings = [];
                _importErrors = [];
                _importError = "Spalten konnten nicht automatisch erkannt werden. Bitte unten von Hand zuordnen.";
                _showMapping = true;
            }
        }
        catch (Exception ex)
        {
            _importFileName = null;
            _importTable = null;
            _importRows = [];
            _importWarnings = [];
            _importErrors = [];
            _importError = $"Datei konnte nicht gelesen werden: {ex.Message}";
        }
    }

    private int MapValue(string key) => _map.TryGetValue(key, out var idx) ? idx : -1;

    private void SetMap(string key, string? value)
    {
        if (int.TryParse(value, out var idx) && idx >= 0) _map[key] = idx;
        else _map.Remove(key);
    }

    private void ApplyMapping()
    {
        if (_importTable is null) return;
        _importError = null;
        var result = TicketImportCsv.BuildRows(_importTable, _map);
        _importRows = result.Rows;
        _importWarnings = result.Warnings;
        _importErrors = result.Errors;
        _showMapping = false;
    }

    private async Task RunImportAsync()
    {
        _importError = null;
        if (SelectedSeasonId <= 0) { _importError = "Bitte zuerst eine Saison wählen."; return; }
        if (string.IsNullOrWhiteSpace(_importReference)) { _importError = "Bitte ein Bundle angeben."; return; }
        if (_importErrors.Count > 0) { _importError = "Bitte zuerst die Fehler in der Datei beheben."; return; }
        if (_importRows.Count == 0) { _importError = "Bitte eine Datei mit mindestens einer Zeile wählen."; return; }
        _importSaving = true;
        try
        {
            await Bundles.ImportUnifiedAsync(SelectedSeasonId, _importRows, _importReference.Trim(),
                _importCategory, Identity?.Name ?? AdminUser, Identity?.Email);
            _showImport = false;
            await OnSeasonChangedAsync();
        }
        catch (DomainException ex) { _importError = ex.Message; }
        finally { _importSaving = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        var restoreBundleId = AdminState.SelectedBundleId;
        _seasons = (await Seasons.GetAllAsync()).OrderByDescending(s => s.StartDate).ToList();
        SelectedSeasonId = AdminState.SelectedSeasonId is int id && _seasons.Any(s => s.Id == id)
            ? id
            : CurrentSeason(_seasons)?.Id ?? _seasons.FirstOrDefault()?.Id ?? 0;
        await OnSeasonChangedAsync();
        if (restoreBundleId is int bid && bid != SelectedBundleId && _bundles.Any(b => b.Id == bid))
        {
            SelectedBundleId = bid;
            await ReloadTicketsAsync();
        }
        _loading = false;
    }

    private async Task OnSeasonChangedAsync()
    {
        AdminState.SelectedSeasonId = SelectedSeasonId > 0 ? SelectedSeasonId : null;
        _selectedSeasonName = _seasons.FirstOrDefault(s => s.Id == SelectedSeasonId)?.Name ?? "";
        _bundles = SelectedSeasonId > 0 ? await Bundles.GetBySeasonAsync(SelectedSeasonId) : [];
        SelectedBundleId = _bundles.FirstOrDefault()?.Id ?? 0;
        await ReloadTicketsAsync();
    }

    private async Task ReloadTicketsAsync()
    {
        AdminState.SelectedBundleId = SelectedBundleId > 0 ? SelectedBundleId : null;
        _tickets = SelectedBundleId > 0
            ? await Bundles.GetTicketsAsync(SelectedBundleId)
            : _bundles.Count > 0 && SelectedSeasonId > 0
                ? await Bundles.GetTicketsBySeasonAsync(SelectedSeasonId)
                : [];
    }

    private void Sort(string col) { _sortAsc = _sortCol == col ? !_sortAsc : true; _sortCol = col; }
    private string Ind(string col) => _sortCol == col ? (_sortAsc ? "▲" : "▼") : "";
    private string _search = "";

    private IEnumerable<FlexTicketView> Filtered()
    {
        var terms = (_search ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return terms.Length == 0
            ? _tickets
            : _tickets.Where(t => terms.All(term => Haystack(t).Contains(term, StringComparison.OrdinalIgnoreCase)));
    }

    private static string Haystack(FlexTicketView t)
    {
        var h = t.Holder;
        return string.Join(' ', new[]
        {
            AdminFormat.TicketNo(t.Uuid), h?.Company ?? "", h?.FirstName ?? "", h?.LastName ?? "", h?.Email ?? "",
            t.Category.DisplayName(), t.Status.DisplayName()
        });
    }

    private IEnumerable<FlexTicketView> Sorted()
    {
        IEnumerable<FlexTicketView> q = _sortCol switch
        {
            "status" => Filtered().OrderBy(t => t.Status),
            "redeemed" => Filtered().OrderBy(t => t.Redeemed),
            _ => Filtered().OrderBy(t => t.CreatedAt),
        };
        return _sortAsc ? q : q.Reverse();
    }

    private FlexTicketView? _visitsFor;

    private static readonly TicketStatus[] AllStatuses = Enum.GetValues<TicketStatus>();
    private static readonly RedemptionState[] AllRedemptionStates = Enum.GetValues<RedemptionState>();

    private static RedemptionState StateOf(FlexTicketView t) =>
        RedemptionStateExtensions.Derive(t.Redeemed, t.IsInside);

    private static string RedemptionBadge(RedemptionState state) => state switch
    {
        RedemptionState.Redeemed => "ta-badge-redeemed",
        RedemptionState.Outside => "ta-badge-blocked",
        _ => "ta-badge-draft"
    };

    private async Task SaveCategoryAsync(FlexTicketView t, TicketCategory category)
    {
        await Bundles.SetTicketCategoryAsync(t.Uuid, category);
        await ReloadTicketsAsync();
    }

    private async Task SaveStatusAsync(FlexTicketView t, TicketStatus status)
    {
        await Bundles.SetTicketStatusAsync(t.Uuid, status);
        await ReloadTicketsAsync();
    }

    private FlexTicketView? _redeemFor;
    private RedemptionState _redeemTarget;
    private int _redeemEventId;
    private bool _redeemBusy;
    private string? _redeemError;
    private IReadOnlyList<Event> _seasonEvents = [];

    private async Task OpenRedeem(FlexTicketView t)
    {
        _seasonEvents = SelectedSeasonId > 0
            ? (await Events.GetBySeasonAsync(SelectedSeasonId)).OrderBy(e => e.Date).ThenBy(e => e.StartTime).ToList()
            : [];
        _redeemFor = t;
        _redeemTarget = StateOf(t);
        _redeemEventId = t.RedeemedEventId ?? NextEvent(_seasonEvents)?.Id ?? 0;
        _redeemError = null;
    }

    private void CloseRedeem() { if (!_redeemBusy) { _redeemFor = null; _redeemError = null; } }

    private async Task SaveRedeemAsync()
    {
        if (_redeemFor is null) return;
        var t = _redeemFor;
        var current = StateOf(t);
        if (_redeemTarget == current) { CloseRedeem(); return; }

        _redeemBusy = true;
        _redeemError = null;
        try
        {
            var scannedBy = Identity?.Name ?? AdminUser;
            switch (_redeemTarget)
            {
                case RedemptionState.Redeemed:
                    var eventId = t.RedeemedEventId ?? _redeemEventId;
                    if (eventId <= 0) throw new DomainException("Bitte einen Anlass wählen.");
                    await ScanOrThrowAsync(t, eventId, ScanMode.CheckIn, scannedBy);
                    break;
                case RedemptionState.Outside:
                    if (t.RedeemedEventId is not { } outEvent || current != RedemptionState.Redeemed)
                        throw new DomainException("Nur ein eingelöstes Flexticket kann auf „Draussen“ gesetzt werden.");
                    await ScanOrThrowAsync(t, outEvent, ScanMode.CheckOut, scannedBy);
                    break;
                case RedemptionState.Open:
                    if (t.RedeemedEventId is { } inEvent && t.IsInside == true)
                        await ScanOrThrowAsync(t, inEvent, ScanMode.CheckOut, scannedBy);
                    await Bundles.SetTicketRedeemedAsync(t.Uuid, false);
                    break;
            }
            _redeemFor = null;
            await ReloadTicketsAsync();
        }
        catch (Exception ex) { _redeemError = ex.Message; }
        finally { _redeemBusy = false; }
    }

    private async Task ScanOrThrowAsync(FlexTicketView t, int eventId, ScanMode mode, string scannedBy)
    {
        var outcome = await Admission.ScanTicketAsync(eventId, TicketType.SeasonSingle, t.Uuid, SelectedSeasonId, mode, scannedBy);
        if (!outcome.Ok) throw new DomainException(outcome.Reason ?? "Die Änderung wurde abgelehnt.");
    }

    private static Event? NextEvent(IReadOnlyList<Event> events)
    {
        var today = SwissTime.Today;
        return events.FirstOrDefault(e => e.Date >= today) ?? events.MaxBy(e => e.Date);
    }

    private void OpenCreateSingle() => OpenCreate(true);
    private void OpenCreateBundle() => OpenCreate(false);

    private void OpenCreate(bool single)
    {
        _createError = null;
        _createSingle = single;
        _newPerson = new PersonForm();
        _newCategory = TicketCategory.Adult;
        _newReference = "";
        _newQuantity = 1;
        _newPaymentSource = PaymentSource.Sponsoring;
        _showCreate = true;
    }

    private void CloseCreate() { if (!_saving) _showCreate = false; }

    private async Task CreateBundleAsync()
    {
        _createError = null;
        var reference = (_newReference ?? "").Trim();

        if (SelectedSeasonId <= 0) { _createError = "Bitte zuerst eine Saison wählen."; return; }
        if (reference.Length == 0) { _createError = "Bitte ein Bundle angeben."; return; }
        if (reference.Length > FlexTicketBundle.ReferenceMaxLength)
        { _createError = $"Das Bundle darf höchstens {FlexTicketBundle.ReferenceMaxLength} Zeichen lang sein."; return; }
        if (_newQuantity < 0) { _createError = "Die Anzahl darf nicht negativ sein."; return; }

        _saving = true;
        try
        {
            var existing = _bundles.FirstOrDefault(b =>
                string.Equals(b.Reference, reference, StringComparison.OrdinalIgnoreCase));
            FlexTicketBundleView result;
            if (existing is not null)
            {
                result = existing;
                if (_newQuantity >= 1)
                {
                    var order = await OrderFactory.CreateAsync(Buyer.Create(BuyerType.Company, null, null, reference), Identity?.Email,
                        [new AdminOrderLine(OrderItemKind.SeasonSingle, SelectedSeasonId, _newCategory, $"Flexticket · {reference}", _newQuantity, 0m)],
                        Identity?.Name ?? AdminUser, _newPaymentSource);
                    result = await Bundles.AddTicketsAsync(existing.Id, _newCategory, _newQuantity,
                        Identity?.Name ?? AdminUser, Identity?.Email, order.Id);
                }
            }
            else if (_newQuantity == 0)
            {
                result = await Bundles.CreateEmptyAsync(SelectedSeasonId, _newCategory, reference,
                    Identity?.Name ?? AdminUser, Identity?.Email);
            }
            else
            {
                var order = await OrderFactory.CreateAsync(Buyer.Create(BuyerType.Company, null, null, reference), Identity?.Email,
                    [new AdminOrderLine(OrderItemKind.SeasonSingle, SelectedSeasonId, _newCategory, $"Flexticket · {reference}", _newQuantity, 0m)],
                    Identity?.Name ?? AdminUser, _newPaymentSource);
                result = await Bundles.CreateAsync(SelectedSeasonId, _newCategory, reference, _newQuantity,
                    Identity?.Name ?? AdminUser, Identity?.Email, order.Id);
            }
            _showCreate = false;
            _bundles = await Bundles.GetBySeasonAsync(SelectedSeasonId);
            SelectedBundleId = result.Id;
            await ReloadTicketsAsync();
        }
        catch (DomainException ex) { _createError = ex.Message; }
        finally { _saving = false; }
    }

    private FlexTicketBundleView? _confirmAddBundle;
    private bool _confirmAddBusy;
    private string? _confirmAddError;

    private void CancelAddToExisting() { if (!_confirmAddBusy) _confirmAddBundle = null; }

    private async Task AddToExistingBundleConfirmedAsync()
    {
        if (_confirmAddBundle is null) return;
        _confirmAddError = null;
        _confirmAddBusy = true;
        try
        {
            var reference = _confirmAddBundle.Reference;
            var order = await OrderFactory.CreateAsync(Buyer.Create(BuyerType.Company, null, null, reference), Identity?.Email,
                [new AdminOrderLine(OrderItemKind.SeasonSingle, SelectedSeasonId, _newCategory, $"Flexticket · {reference}", _newQuantity, 0m)],
                Identity?.Name ?? AdminUser, _newPaymentSource);
            var updated = await Bundles.AddTicketsAsync(_confirmAddBundle.Id, _newCategory, _newQuantity,
                Identity?.Name ?? AdminUser, Identity?.Email, order.Id);
            _confirmAddBundle = null;
            _showCreate = false;
            _bundles = await Bundles.GetBySeasonAsync(SelectedSeasonId);
            SelectedBundleId = updated.Id;
            await ReloadTicketsAsync();
        }
        catch (DomainException ex) { _confirmAddError = ex.Message; }
        finally { _confirmAddBusy = false; }
    }

    private FlexTicketBundleView? _editing;
    private string _editReference = "";
    private string? _editError;

    private void OpenEdit(FlexTicketBundleView b)
    {
        _editing = b;
        _editReference = b.Reference;
        _editError = null;
    }

    private void CancelEdit() { if (!_saving) { _editing = null; _editError = null; } }

    private async Task SaveEditAsync()
    {
        if (_editing is null) return;
        var reference = (_editReference ?? "").Trim();
        if (reference == _editing.Reference) { _editing = null; return; }
        _saving = true;
        _editError = null;
        try
        {
            await BundleEditor.RenameAsync(_editing.Id, _editing.SeasonId, reference);
            _editing = null;
            _bundles = await Bundles.GetBySeasonAsync(SelectedSeasonId);
        }
        catch (DomainException ex) { _editError = ex.Message; }
        finally { _saving = false; }
    }

    private static Season? CurrentSeason(IReadOnlyList<Season> seasons)
    {
        var today = SwissTime.Today;
        return seasons.FirstOrDefault(s => s.StartDate <= today && today <= s.EndDate)
            ?? seasons.Where(s => s.StartDate <= today).MaxBy(s => s.StartDate);
    }
}
