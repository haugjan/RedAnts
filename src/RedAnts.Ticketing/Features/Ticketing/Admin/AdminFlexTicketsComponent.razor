                    <select id="redeemEvent" class="ta-select" @bind="_redeemEventId">
                        @foreach (var e in _seasonEvents)
                        {
                            <option value="@e.Id">@e.Date.ToString("dd.MM.yyyy") · @e.Name</option>
                        }
                    </select>
                    <p class="ta-field-hint">Die Einlösung wird als Eingangsscan an diesem Anlass erfasst.</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(_redeemError))
            {
                <div class="ta-modal-error">@_redeemError</div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseRedeem" disabled="@_redeemBusy">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SaveRedeemAsync" disabled="@_redeemBusy">
                    @(_redeemBusy ? "Speichert …" : "Ändern")
                </button>
            </div>
        </div>
    </div>
}

@if (_visitsFor is not null)
{
    <VisitsOverlay Uuid="@_visitsFor.Uuid"
                   Title="@($"Flexticket {AdminFormat.TicketNo(_visitsFor.Uuid)}")"
