@if (_deleteTarget is not null)
{
    <ConfirmDialog Title="Flexticket löschen"
                   Message="@($"Flexticket {AdminFormat.TicketNo(_deleteTarget.Uuid)} endgültig löschen? Das kann nicht rückgängig gemacht werden.")"
