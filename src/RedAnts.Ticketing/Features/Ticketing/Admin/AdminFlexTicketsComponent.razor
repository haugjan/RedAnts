@using RedAnts.Domain.Ticketing
@using RedAnts.Domain.Ticketing.Sales
@using RedAnts.Features.Ticketing.Ports
@using RedAnts.Features.Ticketing.Scanning
@inject IPublicBaseUrl PublicUrl
@inject ITicketTokens Tokens

<section class="ta-page">
    <h1 class="ta-page-title">@TicketType.SeasonSingle.DisplayName()</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field">
                    <label class="ta-label" for="seasonSelect">Saison</label>
                    <select id="seasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="OnSeasonChangedAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="ta-field">
                    <label class="ta-label" for="bundleSelect">Bundle</label>
                    <select id="bundleSelect" class="ta-select" disabled="@(_bundles.Count == 0)"
                            @bind="SelectedBundleId" @bind:after="ReloadTicketsAsync">
                        @if (_bundles.Count == 0)
                        {
                            <option value="0">— keine Bundles —</option>
                        }
                        else
                        {
                            @foreach (var b in _bundles)
                            {
                                <option value="@b.Id">@b.Reference · @b.Category.DisplayName() · @b.TicketCount Stk.</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="ta-toolbar-actions">
                @if (SelectedBundle is not null)
                {
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="OpenExport"
                            title="Ein oder mehrere Bundles als Excel/CSV exportieren (Karten-Nr + Bundle + Ticketlink)">Export CSV</button>
                    <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedBundle.TicketCount == 0)"
                            title="@(SelectedBundle.TicketCount == 0 ? "Leeres Bundle – keine Flextickets zum Drucken" : "Flextickets als druckfertiges PDF erzeugen (eine Karte pro Seite)")"
                            @onclick="OpenPrint">PDF drucken</button>
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="() => OpenEdit(SelectedBundle)">Bundle bearbeiten</button>
                    @if (Identity?.IsAdmin == true)
                    {
                        <button type="button" class="ta-btn ta-btn-ghost ta-btn-danger"
                                disabled="@(SelectedBundle.TicketCount > 0)"
                                title="@(SelectedBundle.TicketCount > 0 ? "Nur leere Bundles können gelöscht werden – bitte zuerst die Flextickets entfernen" : "Bundle löschen")"
                                @onclick="OpenDeleteBundle">Bundle löschen</button>
                    }
                }
                <button type="button" class="ta-btn ta-btn-primary" disabled="@(SelectedSeasonId <= 0)" @onclick="OpenCreate">
                    Bundle erstellen
                </button>
            </div>
        </div>

        @if (_bundles.Count == 0)
        {
            <div class="ta-placeholder">Für diese Saison sind keine Flexticket-Bundles erfasst.</div>
        }
        else if (_tickets.Count == 0)
        {
            <div class="ta-placeholder">Dieses Bundle enthält keine Flextickets.</div>
        }
        else
        {
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Ticket-Nr.</th>
                            <th class="ta-th-sort" @onclick='() => Sort("created")'>Erstellt <span class="ta-sort-ind">@Ind("created")</span></th>
                            <th>Kategorie</th>
                            <th class="ta-th-sort" @onclick='() => Sort("status")'>Status <span class="ta-sort-ind">@Ind("status")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("redeemed")'>Eingelöst <span class="ta-sort-ind">@Ind("redeemed")</span></th>
                            <th>Event&shy;besuche</th>
                            <th class="ta-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Sorted())
                        {
                            <tr>
                                <td>
                                    <span class="ta-ticketno">
                                        <span class="ta-no">@AdminFormat.TicketNo(t.Uuid)</span>
                                        <a class="ta-qr-link" href="@PublicUrl.TicketUrl(Tokens.CreateShort(t.Uuid))" target="_blank" rel="noopener" title="Online-Ticket" aria-label="Online-Ticket">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17 14h.01M20 14v3M14 17h.01M17 20h3M20 20h.01"/></svg>
                                        </a>
                                    </span>
                                </td>
                                <td class="ta-created" title="@AdminFormat.CreatedTooltip(t.CreatedAt, t.BoxOffice ? null : SelectedBundle?.CreatedByName, t.BoxOffice ? null : SelectedBundle?.CreatedByEmail, null)">
                                    @AdminFormat.CreatedShort(t.CreatedAt, t.BoxOffice ? null : SelectedBundle?.CreatedByName, null)
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketCategory"
                                                      Value="@t.Category"
                                                      Options="@Categories"
                                                      Label="@(c => c.DisplayName())"
                                                      FieldLabel="Kategorie"
                                                      Save="@(c => SaveCategoryAsync(t, c))" />
                                </td>
                                <td>
                                    <InlineSelectEdit TValue="TicketStatus"
                                                      Value="@t.Status"
                                                      Options="@AllStatuses"
                                                      Label="@(s => s.DisplayName())"
                                                      FieldLabel="Status"
                                                      Save="@(s => SaveStatusAsync(t, s))">
                                        <Display Context="status">
                                            <span class="ta-badge ta-badge-@status.ToString().ToLowerInvariant()">@status.DisplayName()</span>
                                        </Display>
                                    </InlineSelectEdit>
                                </td>
                                <td>
                                    @if (t.Status == TicketStatus.Valid)
                                    {
                                        <button type="button" class="ta-badge-btn" title="Einlösung ändern" @onclick="() => OpenRedeem(t)">
                                            <span class="ta-badge @RedemptionBadge(StateOf(t))">@StateOf(t).DisplayName()</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="ta-badge @RedemptionBadge(StateOf(t))">@StateOf(t).DisplayName()</span>
                                    }
                                    @if (t.ConvertedForPurchase)
                                    {
                                        <span class="ta-conv-badge" title="Dieses Flexticket wurde für einen Ticketkauf (Umwandlung) an einem Spezialanlass gebraucht, nicht am Eingang gescannt.">↔ Umwandlung</span>
                                    }
                                    @if (t.BoxOffice)
                                    {
                                        <span class="ta-conv-badge" title="Als Abendkassenticket markiert: gilt auch an Spezialanlässen, die Flextickets einschränken. Das „Abendkasse“-Bundle dient nur der Gruppierung.">🎫 Abendkasse</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="ta-visits-link" @onclick="() => _visitsFor = t">Besuch</button>
                                </td>
                                <td class="ta-col-actions">
                                    @if (Identity?.IsAdmin == true)
                                    {
                                        <button type="button" class="ta-icon-btn ta-icon-btn-danger" title="Löschen" @onclick="() => _deleteTarget = t">🗑</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="ta-summary">
                @_tickets.Count Flextickets · @_tickets.Count(t => t.Redeemed) eingelöst · @_tickets.Count(t => t.Status == TicketStatus.Blocked) gesperrt
                @if (SelectedBundle is { CreatedByName: { Length: > 0 } by }) { <text> · erstellt von @by</text> }
            </p>
        }
    }
</section>

@if (_showExport)
{
    <div class="ta-overlay" @onmousedown="CloseExport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Bundles exportieren</h2>
            <p class="ta-modal-sub">@_selectedSeasonName · Karten-Nr, Bundle und Ticketlink je Karte</p>

            @if (_bundles.Count == 0)
            {
                <div class="ta-placeholder">Für diese Saison sind keine Bundles erfasst.</div>
            }
            else
            {
                <div class="ta-export-tools">
                    <button type="button" class="ta-linkish" @onclick="SelectAllExport">Alle</button>
                    <button type="button" class="ta-linkish" @onclick="ClearExport">Keine</button>
                </div>
                <div class="ta-export-list">
                    @foreach (var b in _bundles)
                    {
                        <label class="ta-export-item">
                            <input type="checkbox" checked="@_exportSelection.Contains(b.Id)"
                                   @onchange="@(e => ToggleExport(b.Id, e.Value is true))" />
                            <span>@b.Reference <span class="ta-muted">· @b.Category.DisplayName() · @b.TicketCount Stk.</span></span>
                        </label>
                    }
                </div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseExport">Schliessen</button>
                @if (_exportSelection.Count > 0)
                {
                    <a class="ta-btn ta-btn-primary" href="@ExportUrl()" target="_blank" rel="noopener" @onclick="CloseExport">
                        Export CSV (@_exportSelection.Count)
                    </a>
                }
                else
                {
                    <button type="button" class="ta-btn ta-btn-primary" disabled>Export CSV</button>
                }
            </div>
        </div>
    </div>
}

@if (_showPrint)
{
    <div class="ta-overlay" @onmousedown="ClosePrint">
        <div class="ta-modal ta-modal-wide" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Flextickets als PDF drucken</h2>
            <p class="ta-modal-sub">@SelectedBundle?.Reference · @SelectedBundle?.TicketCount Karten · eine Seite pro Karte</p>

            <form id="fpForm" method="post" action="/admin/flex-tickets/print" enctype="multipart/form-data" target="_blank">
                <input type="hidden" name="bundleId" value="@_printBundleId" />

                <div class="ta-field" style="flex-shrink:0">
                    <label class="ta-label" for="fpFile">Vorlage (druckfertiges CMYK-PDF, eine Karte)</label>
                    <input id="fpFile" name="template" class="ta-input" type="file" accept="application/pdf,.pdf" required />
                    <p class="ta-field-hint">Die Vorlage wird 1:1 als Hintergrund übernommen. QR-Code und Kartennummer werden in reinem Schwarz darübergelegt, mit einem obligatorischen weissen Rand (2 mm) hinter dem QR-Code.</p>
                </div>

                <div class="fp-zoombar">
                    <label class="ta-label" for="fpZoom">Zoom</label>
                    <input id="fpZoom" type="range" min="100" max="1000" step="10" value="100" />
                    <span id="fpZoomVal" class="fp-zoomval">100%</span>
                    <span class="fp-zoomhint">Vorlage vergrössern für präzises Platzieren</span>
                </div>
                <div class="fp-stage" id="fpStage">
                    <div class="fp-scroll" id="fpScroll">
                        <canvas id="fpCanvas" class="fp-canvas"></canvas>
                        <div id="fpQrBox" class="fp-qrbox"><span class="fp-handle-tl"></span><span class="fp-handle"></span></div>
                        <div id="fpCodeLabel" class="fp-codelabel">A1B2C3D4</div>
                        <svg id="fpMarks" class="fp-marks"></svg>
                    </div>
                </div>

                <div class="fp-grid" style="flex-shrink:0">
                    <div class="ta-field">
                        <label class="ta-label" for="fpPageW">Seite Breite (mm)</label>
                        <input id="fpPageW" name="pageW" class="ta-input" type="number" step="0.1" min="10" value="91" />
                    </div>
                    <div class="ta-field">
                        <label class="ta-label" for="fpPageH">Seite Höhe (mm)</label>
                        <input id="fpPageH" name="pageH" class="ta-input" type="number" step="0.1" min="10" value="61" />
                    </div>
                    <div class="ta-field">
                        <label class="ta-label" for="fpQrX">QR X (mm)</label>
                        <input id="fpQrX" name="qrX" class="ta-input" type="number" step="0.1" min="0" value="5" />
                    </div>
                    <div class="ta-field">
                        <label class="ta-label" for="fpQrY">QR Y (mm)</label>
                        <input id="fpQrY" name="qrY" class="ta-input" type="number" step="0.1" min="0" value="5" />
                    </div>
                    <div class="ta-field">
                        <label class="ta-label" for="fpQrSize">QR Grösse (mm)</label>
                        <input id="fpQrSize" name="qrSize" class="ta-input" type="number" step="0.1" min="5" value="25" />
                    </div>
                    <div class="ta-field">
                        <label class="ta-label" for="fpFontPt">Code Schriftgrösse (pt)</label>
                        <input id="fpFontPt" name="fontPt" class="ta-input" type="number" step="0.5" min="4" value="8" />
                    </div>
                </div>

                <label class="fp-check" style="flex-shrink:0">
                    <input id="fpShowCode" name="showCode" type="checkbox" value="true" checked /> Kartennummer unter dem QR-Code drucken
                </label>

                <div class="ta-modal-actions" style="flex-shrink:0">
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="ClosePrint">Schliessen</button>
                    <button id="fpSubmit" type="submit" class="ta-btn ta-btn-primary" disabled>PDF erzeugen</button>
                </div>
            </form>
        </div>
    </div>
}

@if (_showCreate)
{
    <div class="ta-overlay" @onmousedown="CloseCreate">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Flexticket-Bundle erstellen</h2>

            <div class="ta-field">
                <label class="ta-label">Saison</label>
                <div class="ta-readonly">@_selectedSeasonName</div>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newCategory">Ticketkategorie</label>
                <select id="newCategory" class="ta-select" @bind="_newCategory">
                    @foreach (var c in Categories)
                    {
                        <option value="@c">@c.DisplayName()</option>
                    }
                </select>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newReference">Bundle</label>
                <input id="newReference" class="ta-input" type="text" maxlength="50" placeholder="z. B. Charge 2026-A" @bind="_newReference" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newQuantity">Anzahl Flextickets</label>
                <input id="newQuantity" class="ta-input" type="number" min="0" max="2000" @bind="_newQuantity" />
                <p class="ta-field-hint">0 = leeres Bundle (nur als Umbuchungsziel, ohne Tickets).</p>
            </div>
            @if (_newQuantity > 0)
            {
                <div class="ta-field">
                    <label class="ta-label" for="newFlexPaymentSource">Zahlart</label>
                    <select id="newFlexPaymentSource" class="ta-select" @bind="_newPaymentSource">
                        @foreach (var ps in PaymentSourceExtensions.AdminChoicesForPrice(0m))
                        {
                            <option value="@ps">@ps.DisplayName()</option>
                        }
                    </select>
                </div>
            }

            @if (!string.IsNullOrEmpty(_createError))
            {
                <div class="ta-error">@_createError</div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseCreate" disabled="@_saving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="CreateBundleAsync" disabled="@_saving">
                    @(_saving ? "Wird erstellt …" : "Bundle erstellen")
                </button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="ta-overlay" @onmousedown="CancelEdit">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Bundle bearbeiten</h2>
            <p class="ta-modal-sub">@_editing.Category.DisplayName() · @_editing.TicketCount Flextickets</p>

            <div class="ta-field">
                <label class="ta-label" for="editReference">Bundle</label>
                <input id="editReference" class="ta-input" type="text" maxlength="50" @bind="_editReference" />
                <p class="ta-field-hint">Kategorie und Anzahl eines ausgestellten Bundles sind nicht änderbar.</p>
            </div>

            @if (!string.IsNullOrEmpty(_editError))
            {
                <div class="ta-modal-error">@_editError</div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CancelEdit" disabled="@_saving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SaveEditAsync" disabled="@_saving">
                    @(_saving ? "Speichert …" : "Speichern")
                </button>
            </div>
        </div>
    </div>
}

@if (_redeemFor is not null)
{
    <div class="ta-overlay" @onmousedown="CloseRedeem">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Einlösung ändern</h2>
            <p class="ta-modal-sub">Flexticket @AdminFormat.TicketNo(_redeemFor.Uuid) · aktuell @StateOf(_redeemFor).DisplayName()</p>

            <div class="ta-field">
                <label class="ta-label" for="redeemTarget">Neuer Zustand</label>
                <select id="redeemTarget" class="ta-select" @bind="_redeemTarget">
                    @foreach (var s in AllRedemptionStates)
                    {
                        <option value="@s">@s.DisplayName()</option>
                    }
                </select>
            </div>

            @if (_redeemTarget == RedemptionState.Redeemed && _redeemFor.RedeemedEventId is null)
            {
                <div class="ta-field">
                    <label class="ta-label" for="redeemEvent">Anlass</label>
                    <select id="redeemEvent" class="ta-select" @bind="_redeemEventId">
                        @foreach (var e in _seasonEvents)
                        {
                            <option value="@e.Id">@e.Date.ToString("dd.MM.yyyy") · @e.Name</option>
                        }
                    </select>
                    <p class="ta-field-hint">Die Einlösung wird als Eingangsscan an diesem Anlass erfasst.</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(_redeemError))
            {
                <div class="ta-modal-error">@_redeemError</div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseRedeem" disabled="@_redeemBusy">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SaveRedeemAsync" disabled="@_redeemBusy">
                    @(_redeemBusy ? "Speichert …" : "Ändern")
                </button>
            </div>
        </div>
    </div>
}

@if (_visitsFor is not null)
{
    <VisitsOverlay Uuid="@_visitsFor.Uuid"
                   Title="@($"Flexticket {AdminFormat.TicketNo(_visitsFor.Uuid)}")"
                   Heading="Eventbesuch"
                   EmptyText="Noch kein Eventbesuch."
                   OnClose="() => _visitsFor = null" />
}

@if (_deleteTarget is not null)
{
    <ConfirmDialog Title="Flexticket löschen"
                   Message="@($"Flexticket {AdminFormat.TicketNo(_deleteTarget.Uuid)} endgültig löschen? Das kann nicht rückgängig gemacht werden.")"
                   ConfirmLabel="Löschen" Danger="true" Busy="_deleteBusy" Error="@_deleteError"
                   OnConfirm="DeleteConfirmedAsync" OnCancel="CancelDelete" />
}

@if (_deleteBundleTarget is not null)
{
    <ConfirmDialog Title="Bundle löschen"
                   Message="@($"Bundle „{_deleteBundleTarget.Reference}“ endgültig löschen?")"
                   ConfirmLabel="Löschen" Danger="true" Busy="_deleteBundleBusy" Error="@_deleteBundleError"
                   OnConfirm="DeleteBundleConfirmedAsync" OnCancel="CancelDeleteBundle" />
}

@if (_confirmAddBundle is not null)
{
    <ConfirmDialog Title="Bundle existiert bereits"
                   Message="@($"Ein Bundle „{_confirmAddBundle.Reference}“ existiert in dieser Saison bereits ({_confirmAddBundle.TicketCount} Tickets). {_newQuantity} weitere{(_newQuantity == 1 ? "s" : "")} Ticket{(_newQuantity == 1 ? "" : "s")} ({_newCategory.DisplayName()}) unter demselben Bundle erstellen?")"
                   ConfirmLabel="Hinzufügen" Busy="_confirmAddBusy" Error="@_confirmAddError"
                   OnConfirm="AddToExistingBundleConfirmedAsync" OnCancel="CancelAddToExisting" />
}

<style>
    .ta-export-tools { display: flex; gap: 1rem; margin: 0 0 .5rem; }
    .ta-linkish { background: none; border: 0; padding: 0; color: var(--ta-accent); font-size: .85rem; cursor: pointer; text-decoration: underline; }
    .ta-export-list { display: flex; flex-direction: column; gap: .35rem; max-height: 320px; overflow-y: auto; padding: .2rem 0; }
    .ta-export-item { display: flex; align-items: center; gap: .5rem; }
    .ta-export-item .ta-muted { color: var(--ta-muted); }
    .ta-modal-wide { max-width: 620px; height: min(820px, calc(100dvh - 3rem)); display: flex; flex-direction: column; overflow: hidden; }
    .ta-modal-wide > form { flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }
    .ta-modal-wide .ta-field { margin-bottom: .6rem; }
    .ta-modal-wide .ta-field-hint { margin: .25rem 0 0; }
    @@media (max-width: 640px) { .ta-modal-wide { height: calc(100dvh - 1.2rem); } }
    .fp-zoombar { display: flex; align-items: center; gap: .5rem; margin: .6rem 0 .2rem; flex-shrink: 0; }
    .fp-zoombar input[type=range] { flex: 1; max-width: 240px; }
    .fp-zoomval { font-variant-numeric: tabular-nums; min-width: 3.2em; }
    .fp-zoomhint { color: var(--ta-muted); font-size: .8rem; }
    .fp-stage { width: 100%; flex: 1 1 auto; min-height: 90px; overflow: auto; margin: 0 0 .5rem; background: repeating-conic-gradient(#eee 0% 25%, #fff 0% 50%) 0 / 16px 16px; border: 1px solid #ccc; }
    .fp-scroll { position: relative; width: max-content; line-height: 0; }
    .fp-canvas { display: block; }
    .fp-qrbox { position: absolute; display: none; border: 2px solid var(--ta-accent, #d02d38); background: rgba(208,45,56,.16); box-sizing: border-box; cursor: move; touch-action: none; z-index: 2; }
    .fp-qrbox .fp-handle { position: absolute; right: -7px; bottom: -7px; width: 13px; height: 13px; background: var(--ta-accent, #d02d38); border-radius: 2px; cursor: nwse-resize; touch-action: none; }
    .fp-qrbox .fp-handle-tl { position: absolute; left: -7px; top: -7px; width: 13px; height: 13px; background: var(--ta-accent, #d02d38); border-radius: 2px; cursor: nwse-resize; touch-action: none; }
    .fp-codelabel { position: absolute; display: none; color: #000; text-align: center; line-height: 1; white-space: nowrap; overflow: hidden; pointer-events: none; z-index: 2; font-family: 'Lato', sans-serif; }
    .fp-marks { position: absolute; left: 0; top: 0; pointer-events: none; overflow: visible; z-index: 3; }
    .fp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .35rem 1rem; }
    .fp-check { display: flex; align-items: center; gap: .5rem; margin: .6rem 0 .2rem; font-size: .9rem; }
</style>

@code {
    [Parameter] public string AdminUser { get; set; } = "";
    [CascadingParameter] public AdminIdentity? Identity { get; set; }

    [Inject] private ISeasons Seasons { get; set; } = default!;
    [Inject] private IEvents Events { get; set; } = default!;
    [Inject] private IFlexTicketBundles Bundles { get; set; } = default!;
    [Inject] private IFlexBundleEditor BundleEditor { get; set; } = default!;
    [Inject] private IAdmissionService Admission { get; set; } = default!;
    [Inject] private IAdminOrderFactory OrderFactory { get; set; } = default!;
    [Inject] private IAdminTicketDeletion Deletion { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool _showPrint;
    private bool _printInited;
    private int _printBundleId;

    private void OpenPrint()
    {
        if (SelectedBundle is null || SelectedBundle.TicketCount == 0) return;
        _printBundleId = SelectedBundle.Id;
        _printInited = false;
        _showPrint = true;
    }

    private void ClosePrint()
    {
        _showPrint = false;
        _printInited = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showPrint && !_printInited)
        {
            _printInited = true;
            await JS.InvokeVoidAsync("flexPrint.init");
        }
    }

    private FlexTicketView? _deleteTarget;
    private bool _deleteBusy;
    private string? _deleteError;

    private void CancelDelete() { _deleteTarget = null; _deleteError = null; }

    private FlexTicketBundleView? _deleteBundleTarget;
    private bool _deleteBundleBusy;
    private string? _deleteBundleError;

    private void OpenDeleteBundle()
    {
        _deleteBundleTarget = SelectedBundle;
        _deleteBundleError = null;
    }

    private void CancelDeleteBundle() { _deleteBundleTarget = null; _deleteBundleError = null; }

    private async Task DeleteBundleConfirmedAsync()
    {
        if (_deleteBundleTarget is null) return;
        _deleteBundleBusy = true;
        _deleteBundleError = null;
        try
        {
            if (!await Bundles.DeleteEmptyAsync(_deleteBundleTarget.Id))
            {
                _deleteBundleError = "Nur leere Bundles können gelöscht werden. Bitte zuerst die Flextickets entfernen.";
                return;
            }
            _deleteBundleTarget = null;
            _bundles = await Bundles.GetBySeasonAsync(SelectedSeasonId);
            SelectedBundleId = _bundles.FirstOrDefault()?.Id ?? 0;
            await ReloadTicketsAsync();
        }
        catch (Exception ex) { _deleteBundleError = ex.Message; }
        finally { _deleteBundleBusy = false; }
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_deleteTarget is null) return;
        _deleteBusy = true;
        _deleteError = null;
        try
        {
            await Deletion.DeleteFlexTicketAsync(_deleteTarget.Uuid);
            _deleteTarget = null;
            await ReloadTicketsAsync();
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _deleteBusy = false; }
    }

