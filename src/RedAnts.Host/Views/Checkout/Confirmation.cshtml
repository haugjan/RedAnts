@model RedAnts.Features.Ticketing.Cart.CheckoutConfirmationView
@using RedAnts.Features.Ticketing.Tickets
@using RedAnts.Domain.Ticketing.Sales
@{
    Layout = "~/Views/Shared/_TicketsLayout.cshtml";
    ViewData["Title"] = "Bestellung bestätigt";
}

<link rel="stylesheet" href="/css/ticket-card.css" asp-append-version="true" />

<div class="text-center py-3">
    <div style="font-size:3rem; line-height:1; color:#1c7c43;">&#10003;</div>
    <h1 class="mt-2">Vielen Dank!</h1>
    <p class="text-muted">Deine Bestellung war erfolgreich.</p>
</div>

<div class="card p-4">
    <div class="d-flex justify-content-between mb-1">
        <span class="text-muted">Bestellnummer</span><strong>@Model.OrderNumber</strong>
    </div>
    <div class="d-flex justify-content-between mb-1">
        <span class="text-muted">Zahlungsart</span><span>@Model.PaymentLabel</span>
    </div>
    <div class="d-flex justify-content-between">
        <span class="text-muted">Total</span><strong>CHF @MoneyFormat.Chf(Model.Total)</strong>
    </div>
    <hr />
    <p class="mb-2">Deine Tickets gehen per E-Mail an <strong>@Model.Email</strong>. Du kannst die QR-Codes auch direkt hier am Eingang scannen lassen:</p>
    <p class="text-muted small mb-3">Die Bestätigungsmail kann ein paar Minuten dauern. Falls sie nicht ankommt, schau bitte auch im Spam-Ordner.</p>

    @if (Model.AddOnInfoTexts.Count > 0)
    {
        <h2 class="h5 mb-2">Zu deinen Zusatzoptionen</h2>
        @foreach (var info in Model.AddOnInfoTexts)
        {
            <div class="ra-addon-note small mb-2">@info</div>
        }
    }

    <h2 class="h5 mb-3">Deine Tickets</h2>
    <div class="ra-ticket-grid">
        @foreach (var t in Model.Tickets)
        {
            var card = new TicketCardModel(
                Kicker: TicketDisplay.Kicker((TicketType)t.Type),
                TypeLabel: TicketDisplay.TypeLabel((TicketType)t.Type),
                ScopeName: t.EventName,
                DateText: t.DateText,
                CategoryLabel: t.CategoryName,
                HolderName: t.HolderName,
                Serial: t.Uuid.ToString("N")[..8].ToUpperInvariant(),
                QrMarkup: $"<img src=\"/ticket/{t.Token}/qr.png\" alt=\"Ticket-QR\" />",
                VenueName: t.VenueName);
            var shareUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/ticket/{t.Token}";
            var waHref = "https://wa.me/?text=" + Uri.EscapeDataString($"{TicketDisplay.TypeLabel((TicketType)t.Type)} – {t.EventName}\n{shareUrl}");
            <div class="ra-ticket-cell">
                <partial name="~/Views/Partials/_TicketCard.cshtml" model="card" />
                <div class="rc-actions">
                    <a class="rc-btn rc-btn--open" href="/ticket/@t.Token" target="_blank" rel="noopener">Online-Karte öffnen</a>
                    <a class="rc-btn rc-btn--pdf" href="/ticket/@t.Token/pdf">Als PDF herunterladen</a>
                    <a class="rc-btn rc-btn--wa" href="@waHref" target="_blank" rel="noopener">Per WhatsApp teilen</a>
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-4">
    <a href="/" class="btn btn-outline-secondary">Zur Startseite</a>
</div>

<style>
    .ra-ticket-grid { display: flex; flex-wrap: wrap; gap: 22px; justify-content: center; background: #f4f4f5; border-radius: 14px; padding: 24px 18px; }
    .ra-ticket-cell { display: flex; flex-direction: column; align-items: center; width: 300px; max-width: 100%; }
    .ra-ticket-cell .rtk-card { --rtk-notch: #f4f4f5; }
    .rc-actions { display: flex; flex-direction: column; gap: .5rem; width: 100%; margin-top: .75rem; }
    .rc-btn { display: flex; align-items: center; justify-content: center; text-decoration: none; font-family: 'Oswald', Impact, sans-serif; text-transform: uppercase; letter-spacing: .04em; font-weight: 600; font-size: .92rem; padding: .62rem 1rem; border-radius: 10px; color: #fff; }
    .rc-btn--open { background: #D02D38; } .rc-btn--open:hover { background: #B0242E; color: #fff; }
    .rc-btn--pdf { background: #14171A; } .rc-btn--pdf:hover { background: #2a2e33; color: #fff; }
    .rc-btn--wa { background: #25D366; } .rc-btn--wa:hover { background: #1ebe5b; color: #fff; }
    .ra-addon-note { white-space: pre-line; background: #f4f4f5; border-left: 4px solid #C8102E; border-radius: 4px; padding: 12px 14px; color: #323232; }
</style>
