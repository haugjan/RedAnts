{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Runtime": {
        "Mode": "BackofficeDevelopment"
      },
      "Global": {
        "Id": "e1d81128-b18a-45f2-93a5-84608d044693",
        "DefaultUILanguage": "de-de",
        "UseHttps": true,
        "Smtp": {
          "From": "tickets@redants.ch",
          "Host": "smtp-relay.brevo.com",
          "Port": 587,
          "SecureSocketOptions": "StartTls"
        }
      },
      "Hosting": {
        "LocalTempStorageLocation": "EnvironmentTemp"
      },
      "Examine": {
        "LuceneDirectoryFactory": "SyncedTempFileSystemDirectoryFactory"
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://tickets.redants.ch"
      },
      "Content": {
        "Notifications": {
          "Email": "tickets@redants.ch"
        },
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        },
        "LoginBackgroundImage": "img/login-bg.jpg",
        "LoginLogoImage": "img/logo-redants.png",
        "LoginLogoImageAlternative": "img/logo-redants.png"
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": ""
      }
    },
    "Storage": {
      "AzureBlob": {
        "Media": {
          "AccountUrl": "",
          "ContainerName": "media",
          "ConnectionString": ""
        }
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient",
    "showDbDSN": ""
  },
  "Migrations": {
    "RunAtBoot": false,
    "ForceToken": ""
  },
  "Show": {
    "BoardPassword": "stockschlag",
    "Storage": {
      "AccountUrl": "",
      "ConnectionString": "",
      "Container": "show",
      "PublicBaseUrl": "https://stredantsprod.blob.core.windows.net/show"
    }
  },
  "Spotify": {
    "ClientId": ""
  },
  "Graph": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "Sender": "tickets@redants.ch",
    "SaveToSentItems": false,
    "ClientSecretExpires": "2028-07-29"
  },
  "BackOfficeAuth": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "Email": {
    "Transports": "Graph",
    "Outbox": {
      "RetentionDays": 30
    }
  },
  "Payrexx": {
    "Instance": "",
    "ApiSecret": ""
  },
  "Turnstile": {
    "SiteKey": "",
    "SecretKey": ""
  },
  "Ticketing": {
    "MyTicketsSecret": ""
  }
}