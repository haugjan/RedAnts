@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>Show Admin</title>
    <style>
        html, body { height: 100%; margin: 0; background: #141418; font-family: 'Segoe UI', Roboto, sans-serif; }
    </style>
</head>
<body>
    <component type="typeof(RedAnts.Features.Show.ShowAdminEditor)" render-mode="Server" />
    <script src="/_content/RedAnts.Show/show/soundboard.js"></script>
    <script>
        var showEditAudio = null;
        window.showEditTest = function (url, startSec) {
            try { if (showEditAudio) { showEditAudio.pause(); } } catch (e) { }
            showEditAudio = new Audio(url);
            if (startSec > 0) showEditAudio.currentTime = startSec;
            showEditAudio.play().catch(function () { });
        };
        window.showEditTestSpotify = async function (uri, startSec) {
            if (!uri) { alert('Kein Spotify-Track/URI gesetzt.'); return; }
            if (!window.showBoard) { alert('Spotify-Player nicht geladen.'); return; }
            if (!showBoard.isLoggedIn()) { alert('Zuerst auf dem Board (▶ Board öffnen → Zahnrad) mit Spotify verbinden.'); return; }
            var ready = await showBoard.ensureSpotify();
            if (!ready) { alert('Spotify-Player noch nicht bereit – kurz warten und erneut.'); return; }
            var status = await showBoard.playSpotify(uri, (startSec || 0) * 1000);
            if (status !== 'ok') { alert('Spotify: ' + status); }
        };
        // Drag-and-drop auf die Upload-Zone: Dateien an das versteckte File-Input weiterreichen.
        document.addEventListener('dragover', function (e) {
            var z = e.target.closest && e.target.closest('.se-drop');
            if (z) { e.preventDefault(); z.classList.add('busy'); }
        });
        document.addEventListener('dragleave', function (e) {
            var z = e.target.closest && e.target.closest('.se-drop');
            if (z) z.classList.remove('busy');
        });
        document.addEventListener('drop', function (e) {
            var z = e.target.closest && e.target.closest('.se-drop');
            if (!z) return;
            e.preventDefault();
            z.classList.remove('busy');
            var input = z.querySelector('input[type=file]');
            if (input && e.dataTransfer && e.dataTransfer.files.length) {
                input.files = e.dataTransfer.files;
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });

        // Kachel-Raster: verschieben (Kachel greifen) und Grösse ziehen (Ecke).
        (function () {
            var gd = null, drag = null;
            window.showGridInit = function (ref) { gd = ref; };
            function metrics(canvas) {
                var r = canvas.getBoundingClientRect(), pad = 6, gap = 4;
                return { r: r, pad: pad, gap: gap,
                    cw: (r.width - pad * 2 - gap * 11) / 12, ch: (r.height - pad * 2 - gap * 7) / 8 };
            }
            function cellAt(canvas, cx, cy) {
                var m = metrics(canvas);
                var col = Math.floor((cx - m.r.left - m.pad) / (m.cw + m.gap));
                var row = Math.floor((cy - m.r.top - m.pad) / (m.ch + m.gap));
                return { col: Math.max(0, Math.min(11, col)), row: Math.max(0, Math.min(7, row)) };
            }
            document.addEventListener('pointerdown', function (e) {
                var tile = e.target.closest && e.target.closest('.se-ct');
                if (!tile) return;
                var canvas = tile.closest('.se-canvas');
                if (!canvas) return;
                var tx = +tile.getAttribute('data-x'), ty = +tile.getAttribute('data-y');
                var cell = cellAt(canvas, e.clientX, e.clientY);
                drag = {
                    id: tile.getAttribute('data-id'), canvas: canvas,
                    resize: !!(e.target.closest && e.target.closest('.se-ct-resize')),
                    tx: tx, ty: ty, tw: +tile.getAttribute('data-w'), th: +tile.getAttribute('data-h'),
                    offCol: cell.col - tx, offRow: cell.row - ty, last: ''
                };
                if (tile.setPointerCapture) { try { tile.setPointerCapture(e.pointerId); } catch (x) { } }
            });
            document.addEventListener('pointermove', function (e) {
                if (!drag || !gd) return;
                var cell = cellAt(drag.canvas, e.clientX, e.clientY);
                var x, y, w, h;
                if (drag.resize) { x = drag.tx; y = drag.ty; w = Math.max(1, cell.col - drag.tx + 1); h = Math.max(1, cell.row - drag.ty + 1); }
                else { x = cell.col - drag.offCol; y = cell.row - drag.offRow; w = drag.tw; h = drag.th; }
                var key = x + ',' + y + ',' + w + ',' + h;
                if (key === drag.last) return;
                drag.last = key;
                gd.invokeMethodAsync('SetRect', drag.id, x, y, w, h);
            });
            document.addEventListener('pointerup', function () { drag = null; });
            document.addEventListener('pointercancel', function () { drag = null; });
        })();
    </script>
    <script src="/_framework/blazor.server.js"></script>
</body>
</html>
