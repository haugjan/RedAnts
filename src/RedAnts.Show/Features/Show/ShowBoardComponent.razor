@using Microsoft.Extensions.Options
@using RedAnts.Infrastructure.Show
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IOptions<ShowStorageOptions> Storage
@inject IShowProfileStore Store
@inject IShowSettingsStore Settings
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<div class="sb-app">
    <header class="sb-header">
        <img class="sb-logo" src="/img/logo-redants-white.png" alt="Red Ants Winterthur" />
        <div class="sb-profiles">
            @foreach (var p in Profiles)
            {
                <button class="sb-profile @(p.Id == _profileId ? "active" : "")"
                        style="--profile-color:@(p.Color ?? "#8ecae6")"
                        @onclick="() => SelectProfile(p.Id)">@p.Name</button>
            }
        </div>
        <div class="sb-spotify">
            @if (_loggedIn)
            {
                <span class="sb-connected">
                    <span class="sb-dot @(_playerReady ? "ready" : "")"></span>
                    @(_displayName ?? "Spotify")
                    <button class="sb-link" @onclick="LogoutAsync">trennen</button>
                </span>
            }
            else
            {
                <button class="sb-login" disabled="@(string.IsNullOrWhiteSpace(_clientId))" @onclick="LoginAsync">Mit Spotify verbinden</button>
            }
            <button class="sb-gear" title="Einstellungen" @onclick="() => _settingsOpen = true">⚙️</button>
        </div>
    </header>

    <nav class="sb-breadcrumb">
        <button class="sb-crumb" @onclick="() => _path.Clear()">@Profile.Name</button>
        @{
            var crumbs = Breadcrumb();
        }
        @for (var i = 0; i < crumbs.Count; i++)
        {
            var idx = i;
            <span class="sb-sep">›</span>
            <button class="sb-crumb" @onclick="() => TrimPath(idx + 1)">@crumbs[idx]</button>
        }
    </nav>

    @{
        var tiles = CurrentNodes();
        var hasBack = _path.Count > 0;
        var layout = ShowLayout.Resolve(tiles, hasBack);
    }
    <main class="sb-board">
        @if (hasBack)
        {
            <button class="sb-tile back" style="grid-column:1 / span 4; grid-row:1 / span 3" @onclick="() => TrimPath(_path.Count - 1)">
                <span class="sb-tile-icon">↩</span>
                <span class="sb-tile-label">Zurück</span>
            </button>
        }
        @foreach (var node in tiles)
        {
            var isFolder = node.IsFolder;
            var isSpotify = node.Sound?.Kind == SoundKind.Spotify;
            var isActive = _activeLocalIds.Contains(node.Id) || _nowPlaying?.ButtonId == node.Id;
            var pos = layout[node.Id];
            <button class="sb-tile @(isFolder ? "folder" : "") @(node.IsRandom ? "random" : "") @(isActive ? "active" : "")"
                    style="--tile-color:@(node.Color ?? "#555"); grid-column:@(pos.X + 1) / span @pos.W; grid-row:@(pos.Y + 1) / span @pos.H"
                    @attributes="TileAttrs(node)"
                    @onclick="() => HandleButtonAsync(node)">
                @if (isFolder)
                {
                    <span class="sb-fhead"><span class="sb-fico">📂</span>@node.Label</span>
                    <span class="sb-tile-icon fbody">@(node.Icon ?? "📁")</span>
                }
                else
                {
                    <span class="sb-tile-icon">@(node.Icon ?? "🔊")</span>
                    <span class="sb-tile-label">@node.Label</span>
                    @if (!string.IsNullOrEmpty(node.Subtitle))
                    {
                        <span class="sb-tile-sub">@node.Subtitle</span>
                    }
                }
                @if (isSpotify)
                {
                    <span class="sb-badge spotify">Spotify</span>
                }
                @if (isActive)
                {
                    <span class="sb-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                }
            </button>
        }
    </main>

    @{
        var isPlaying = _activeLocalIds.Length > 0 || _nowPlaying is not null;
    }
    <footer class="sb-footer">
        <div class="sb-nowplaying">
            @if (_nowPlaying is { } np)
            {
                <span>🎵</span>
                <span class="sb-np-label">@np.Label</span>
                @if (_remainingSec is int rem)
                {
                    <span>@rem s</span>
                }
            }
            else
            {
                <span>@(_activeLocalIds.Length > 0 ? $"{_activeLocalIds.Length} Sound(s) aktiv" : "Bereit")</span>
            }
        </div>
        @if (isPlaying)
        {
            <div class="sb-transport">
                @if (_paused)
                {
                    <button class="sb-tp play" @onclick="ResumeAsync">▶ Play</button>
                }
                else
                {
                    <button class="sb-tp" @onclick="PauseAsync">⏸ Pause</button>
                }
                <button class="sb-tp fade" @onclick="FadeOutAsync">🔉 Fade-out</button>
                <button class="sb-tp stop" @onclick="StopAllAsync">⏹ Stopp</button>
            </div>
        }
        <label class="sb-volume">🔊
            <input type="range" min="0" max="1" step="0.05" value="@_volume"
                   @onchange="OnVolumeChanged" />
        </label>
    </footer>

    @if (_settingsOpen)
    {
        <div class="sb-backdrop" @onclick="() => _settingsOpen = false">
            <div class="sb-dialog" @onclick:stopPropagation="true">
                <h2>Spotify einrichten</h2>
                <ol>
                    <li>Auf <a href="https://developer.spotify.com/dashboard" target="_blank" rel="noreferrer">developer.spotify.com/dashboard</a> eine App erstellen</li>
                    <li>
                        Redirect-URI eintragen:
                        <span class="sb-copyrow">
                            <code>@_redirectUri</code>
                            <button type="button" class="sb-copy" @onclick="() => CopyAsync(_redirectUri)">@(_copied == _redirectUri ? "✓ Kopiert" : "📋 Kopieren")</button>
                        </span>
                    </li>
                    <li>API: „Web Playback SDK" und „Web API" auswählen</li>
                    <li>Client-ID hier einfügen (Spotify Premium erforderlich)</li>
                </ol>
                <input type="text" placeholder="Spotify Client-ID" @bind="_clientIdDraft" />
                <div class="sb-dialog-actions">
                    <button @onclick="() => _settingsOpen = false">Abbrechen</button>
                    <button class="primary" disabled="@(string.IsNullOrWhiteSpace(_clientIdDraft))" @onclick="SaveSettingsAsync">Speichern</button>
                </div>
            </div>
        </div>
    }

    <div class="sb-toasts">
        @foreach (var t in _toasts)
        {
            <div class="sb-toast">@t.Text</div>
        }
    </div>
</div>

@code {
    private const string AppBase = "/show/";

    private string SoundBase => string.IsNullOrWhiteSpace(Storage.Value.PublicBaseUrl)
        ? "/_content/RedAnts.Show/show/"
        : Storage.Value.PublicBaseUrl!.TrimEnd('/') + "/";

    private static int TileWeight(ShowButton b) => b.Size switch
    {
        TileSize.Big => 4,
        TileSize.Wide or TileSize.Tall => 2,
        _ => 1
    };

    private static int ColumnsFor(int cellCount) =>
        Math.Clamp((int)Math.Ceiling(Math.Sqrt(Math.Max(1, cellCount) * 1.35)), 2, 6);

    private IReadOnlyList<ShowProfile> _profiles = ShowConfig.Profiles;
    private IReadOnlyList<ShowProfile> Profiles => _profiles;

    private string _profileId = ShowConfig.Profiles[0].Id;

    protected override async Task OnInitializedAsync()
    {
        var loaded = await Store.GetAllAsync();
        var src = loaded.Count > 0 ? loaded : _profiles;
        _profiles = src.Select(p => p with { Root = p.Root.Where(b => !b.Panic).ToList() }).ToList();
        if (_profiles.All(p => p.Id != _profileId)) _profileId = _profiles[0].Id;
    }
    private readonly List<string> _path = new();
    private string[] _activeLocalIds = [];
    private NowPlaying? _nowPlaying;
    private int? _remainingSec;
    private double _volume = 0.9;

    private string _clientId = "";
    private string _clientIdDraft = "";
    private bool _loggedIn;
    private bool _playerReady;
    private string? _displayName;
    private bool _settingsOpen;
    private string _redirectUri = "";

    private readonly List<ToastItem> _toasts = new();
    private int _toastCounter;

    private DotNetObjectReference<ShowBoardComponent>? _ref;
    private System.Timers.Timer? _timer;

    private ShowProfile Profile => Profiles.FirstOrDefault(p => p.Id == _profileId) ?? Profiles[0];

    private IReadOnlyList<ShowButton> CurrentNodes()
    {
        var nodes = Profile.Root;
        foreach (var id in _path)
        {
            var folder = nodes.FirstOrDefault(n => n.Id == id);
            if (folder?.Children is not { } children) return Profile.Root;
            nodes = children;
        }
        return nodes;
    }

    private List<string> Breadcrumb()
    {
        var labels = new List<string>();
        var nodes = Profile.Root;
        foreach (var id in _path)
        {
            var folder = nodes.FirstOrDefault(n => n.Id == id);
            if (folder?.Children is not { } children) break;
            labels.Add(folder.Label);
            nodes = children;
        }
        return labels;
    }

    private void SelectProfile(string id)
    {
        _profileId = id;
        _path.Clear();
    }

    private void TrimPath(int count)
    {
        while (_path.Count > count) _path.RemoveAt(_path.Count - 1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        _timer = new System.Timers.Timer(500) { AutoReset = true };
        _timer.Elapsed += (_, _) => _ = TickAsync();
        _timer.Start();
        try
        {
            var configuredId = (Settings.Get("Spotify:ClientId") ?? Config["Spotify:ClientId"] ?? "").Trim();
            if (configuredId.Length > 0)
            {
                await JS.InvokeVoidAsync("showBoard.setClientId", configuredId);
            }
            var init = await JS.InvokeAsync<InitResult>("showBoard.init", _ref, SoundBase, AppBase);
            _loggedIn = init.LoggedIn;
            _redirectUri = init.RedirectUri;
            _clientId = await JS.InvokeAsync<string>("showBoard.getClientId");
            _clientIdDraft = _clientId;
            if (!init.HasClientId && configuredId.Length == 0) _settingsOpen = true;
            StateHasChanged();
        }
        catch
        {
            // Interop noch nicht bereit; nicht kritisch fürs lokale Board
        }
    }

    private void HandleButtonAsync(ShowButton node)
    {
        // Ordner navigieren. Alle Sounds (lokal, Zufall, Spotify) laufen
        // client-seitig direkt im Klick-Event (iOS-Nutzergeste), siehe soundboard.js.
        if (node.IsFolder) _path.Add(node.Id);
    }

    private Dictionary<string, object> TileAttrs(ShowButton node)
    {
        var a = new Dictionary<string, object> { ["data-id"] = node.Id };
        if (node.IsFolder) return a;
        if (node.IsRandom)
        {
            a["data-play"] = "random";
            a["data-pool"] = System.Text.Json.JsonSerializer.Serialize(
                node.Pool!.Where(p => p.Kind == SoundKind.Local)
                    .Select(p => new { r = SoundUrl(p.Ref), s = p.StartSec, d = p.DurationSec }));
        }
        else if (node.Sound is { Kind: SoundKind.Local } s)
        {
            a["data-play"] = "local";
            a["data-ref"] = SoundUrl(s.Ref);
            a["data-start"] = Num(s.StartSec);
            if (s.DurationSec is { } d) a["data-dur"] = Num(d);
        }
        else if (node.Sound is { Kind: SoundKind.Spotify } sp && !string.IsNullOrWhiteSpace(sp.Ref))
        {
            a["data-play"] = "spotify";
            a["data-uri"] = sp.Ref;
            a["data-startms"] = ((long)Math.Round(sp.StartSec * 1000)).ToString(System.Globalization.CultureInfo.InvariantCulture);
            a["data-shuffle"] = sp.Shuffle ? "1" : "0";
            a["data-label"] = node.Label;
            if (sp.DurationSec is { } d) a["data-dur"] = Num(d);
        }
        return a;
    }

    private string SoundUrl(string reff) => reff.StartsWith("http") ? reff : SoundBase + reff;

    private static string Num(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);

    [JSInvokable]
    public Task OnLocalStarted()
    {
        _nowPlaying = null;
        _remainingSec = null;
        _paused = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSpotifyStarted(string id, string label, double? durationSec)
    {
        _paused = false;
        var endsAt = durationSec is { } d ? DateTime.UtcNow.AddSeconds(d) : (DateTime?)null;
        _nowPlaying = new NowPlaying(id, label, endsAt);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSpotifyStopped()
    {
        _nowPlaying = null;
        _remainingSec = null;
        _paused = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSpotifyStatus(string status)
    {
        Toast(status switch
        {
            "not-logged-in" => "Zuerst mit Spotify verbinden (Button oben rechts)",
            "not-ready" => "Spotify-Player ist noch nicht bereit, einen Moment...",
            _ => "Spotify: " + status
        });
        return InvokeAsync(StateHasChanged);
    }

    private async Task TickAsync()
    {
        int? newRemaining = null;
        var stop = false;
        if (_nowPlaying?.EndsAt is DateTime end)
        {
            var secs = (int)Math.Ceiling((end - DateTime.UtcNow).TotalSeconds);
            newRemaining = Math.Max(0, secs);
            if (DateTime.UtcNow >= end) stop = true;
        }
        if (stop)
        {
            await InvokeAsync(() => StopSpotifyAsync(true));
            return;
        }
        if (newRemaining != _remainingSec)
        {
            _remainingSec = newRemaining;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool _paused;

    private async Task PauseAsync() { _paused = true; await JS.InvokeVoidAsync("showBoard.pause"); }
    private async Task ResumeAsync() { _paused = false; await JS.InvokeVoidAsync("showBoard.resume"); }
    private async Task StopAllAsync() { _paused = false; _nowPlaying = null; _remainingSec = null; await JS.InvokeVoidAsync("showBoard.stopAll"); }
    private async Task FadeOutAsync() { _paused = false; _nowPlaying = null; _remainingSec = null; await JS.InvokeVoidAsync("showBoard.fadeOut"); }

    private async Task StopSpotifyAsync(bool fade)
    {
        _nowPlaying = null;
        _remainingSec = null;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("showBoard.stopSpotify", fade); } catch { }
    }

    private async Task OnVolumeChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            _volume = v;
            await JS.InvokeVoidAsync("showBoard.setVolume", v);
        }
    }

    private async Task LoginAsync()
    {
        try { await JS.InvokeVoidAsync("showBoard.startLogin"); }
        catch (Exception ex) { Toast(ex.Message); }
    }

    private async Task LogoutAsync()
    {
        await JS.InvokeVoidAsync("showBoard.logout");
        _loggedIn = false;
        _playerReady = false;
        _displayName = null;
    }

    private async Task SaveSettingsAsync()
    {
        await JS.InvokeVoidAsync("showBoard.setClientId", _clientIdDraft);
        _clientId = _clientIdDraft.Trim();
        _settingsOpen = false;
    }

    private string? _copied;

    private async Task CopyAsync(string text)
    {
        if (string.IsNullOrEmpty(text)) return;
        var ok = await JS.InvokeAsync<bool>("showBoard.copyText", text);
        if (ok) { _copied = text; StateHasChanged(); }
    }

    private void Toast(string text)
    {
        var id = ++_toastCounter;
        _toasts.Add(new ToastItem(id, text));
        _ = RemoveToastLaterAsync(id);
        StateHasChanged();
    }

    private async Task RemoveToastLaterAsync(int id)
    {
        await Task.Delay(5000);
        _toasts.RemoveAll(t => t.Id == id);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnActiveChanged(string[] ids)
    {
        _activeLocalIds = ids;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnPlayerReady()
    {
        _playerReady = true;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnDisplayName(string name)
    {
        _displayName = name;
        _loggedIn = true;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnToast(string message) => Toast(message);

    [JSInvokable]
    public async Task OnEscape()
    {
        await StopAllAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        try { await JS.InvokeVoidAsync("showBoard.stopAll"); } catch { }
        _ref?.Dispose();
    }

    private sealed record NowPlaying(string ButtonId, string Label, DateTime? EndsAt);
    private sealed record ToastItem(int Id, string Text);
    private sealed record InitResult(bool LoggedIn, bool HasClientId, string RedirectUri);
}
