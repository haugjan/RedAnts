@using Microsoft.Extensions.Options
@using RedAnts.Infrastructure.Show
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IOptions<ShowStorageOptions> Storage
@inject IShowProfileStore Store
@inject IShowRemote Remote
@inject IShowSettingsStore Settings
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<div class="sb-app">
    <header class="sb-header">
        <img class="sb-logo" src="/img/logo-redants-white.png" alt="Red Ants Winterthur" />
        <div class="sb-profiles">
            @foreach (var p in Profiles)
            {
                <button class="sb-profile @(p.Id == _profileId ? "active" : "")"
                        style="--profile-color:@(p.Color ?? "#8ecae6")"
                        @onclick="() => SelectProfile(p.Id)">@p.Name</button>
            }
        </div>
        <div class="sb-spotify">
            @if (_loggedIn)
            {
                <span class="sb-connected">
                    <span class="sb-dot @(_playerReady ? "ready" : "")"></span>
                    @(_displayName ?? "Spotify")
                    <button class="sb-link" @onclick="LogoutAsync">trennen</button>
                </span>
            }
            else if (string.IsNullOrWhiteSpace(_clientId))
            {
                <span class="sb-hint">Spotify-Client-ID im Admin-Bereich hinterlegen</span>
            }
            else
            {
                <button class="sb-login" @onclick="LoginAsync">Mit Spotify verbinden</button>
            }
        </div>
    </header>

    <nav class="sb-breadcrumb">
        <button class="sb-crumb" @onclick="() => _path.Clear()">@Profile.Name</button>
        @{
            var crumbs = Breadcrumb();
        }
        @for (var i = 0; i < crumbs.Count; i++)
        {
            var idx = i;
            <span class="sb-sep">›</span>
            <button class="sb-crumb" @onclick="() => TrimPath(idx + 1)">@crumbs[idx]</button>
        }
    </nav>

    @if (!_activated)
    {
        <div class="sb-activate">👆 Einmal tippen, damit auch die Fernsteuerung / das Streamdeck Ton abspielt.</div>
    }

    @{
        var tiles = CurrentNodes();
        var hasBack = _path.Count > 0;
        var layout = ShowLayout.Resolve(tiles, hasBack);
    }
    <main class="sb-board">
        @if (hasBack)
        {
            <button class="sb-tile back" style="grid-column:1 / span 1; grid-row:1 / span 1" @onclick="() => TrimPath(_path.Count - 1)">
                <span class="sb-tile-icon">↩</span>
                <span class="sb-tile-label">Zurück</span>
            </button>
        }
        @foreach (var node in tiles)
        {
            var songs = node.EffectiveSongs;
            var isFolder = node.IsFolder;
            var isSpotify = songs.Any(s => s.Kind == SoundKind.Spotify);
            var isMulti = songs.Count(s => !string.IsNullOrWhiteSpace(s.Ref)) > 1;
            var isActive = _activeLocalIds.Contains(node.Id) || _nowPlaying?.ButtonId == node.Id;
            var pos = layout[node.Id];
            <button class="sb-tile @(isFolder ? "folder" : "") @(isActive ? "active" : "")"
                    style="--tile-color:@(node.Color ?? "#555"); grid-column:@(pos.X + 1) / span @pos.W; grid-row:@(pos.Y + 1) / span @pos.H"
                    @attributes="TileAttrs(node)"
                    @onclick="() => HandleButtonAsync(node)">
                @if (isFolder)
                {
                    <span class="sb-fhead"><span class="sb-fico">📂</span>@node.Label</span>
                    <span class="sb-tile-icon fbody">@(node.Icon ?? "📁")</span>
                }
                else
                {
                    <span class="sb-tile-icon">@(node.Icon ?? "🔊")</span>
                    <span class="sb-tile-label">@node.Label</span>
                    @if (!string.IsNullOrEmpty(node.Subtitle))
                    {
                        <span class="sb-tile-sub">@node.Subtitle</span>
                    }
                }
                @if (isMulti)
                {
                    <span class="sb-badge multi">@songs.Count(s => !string.IsNullOrWhiteSpace(s.Ref)) Songs @(node.SongsRandom ? "🔀" : "🔁")</span>
                }
                @if (isSpotify)
                {
                    <span class="sb-badge spotify">Spotify</span>
                }
                @if (isActive)
                {
                    <span class="sb-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                }
            </button>
        }
    </main>

    @if (_songMenu is { } menu)
    {
        <div class="sb-backdrop" @onclick="() => _songMenu = null">
            <div class="sb-songmenu" @onclick:stopPropagation="true">
                <div class="sb-songmenu-head">
                    <span>@menu.Label</span>
                    <button class="sb-link" @onclick="() => _songMenu = null">✕</button>
                </div>
                @for (var i = 0; i < menu.Songs.Count; i++)
                {
                    var song = menu.Songs[i];
                    var nr = i + 1;
                    <button class="sb-songitem" data-play="songs" data-force="1"
                            data-id="@($"{menu.Id}:{i}")"
                            data-songs="@SongsJson(new[] { song })"
                            data-label="@menu.Label"
                            @onclick="() => _songMenu = null">
                        <span class="sb-songitem-nr">@nr</span>
                        <span class="sb-songitem-name">@SongLabel(song)</span>
                        <span class="sb-songitem-badge">@(song.Kind == SoundKind.Spotify ? "Spotify" : "Datei")</span>
                    </button>
                }
            </div>
        </div>
    }

    @{
        var isPlaying = _activeLocalIds.Length > 0 || _nowPlaying is not null;
    }
    <footer class="sb-footer">
        <div class="sb-nowplaying">
            @{ var cur = CurrentPlaying(); }
            @if (cur is { } c)
            {
                <span class="sb-np-ico">@c.Icon</span>
                <span class="sb-np-info">
                    <span class="sb-np-title">@c.Title</span>
                    @if (!string.IsNullOrEmpty(c.Sub))
                    {
                        <span class="sb-np-sub">@c.Sub</span>
                    }
                </span>
                <span class="sb-np-time">@(_remainingSec is int rem ? $"{rem}s" : "")</span>
            }
            else
            {
                <span class="sb-np-ico">🔇</span>
                <span class="sb-np-info"><span class="sb-np-title">Bereit</span></span>
                <span class="sb-np-time"></span>
            }
        </div>
        <div class="sb-transport" style="@(isPlaying ? "" : "visibility:hidden")">
            @if (_paused)
            {
                <button class="sb-tp play" @onclick="ResumeAsync">▶ Play</button>
            }
            else
            {
                <button class="sb-tp" @onclick="PauseAsync">⏸ Pause</button>
            }
            <button class="sb-tp fade" @onclick="FadeOutAsync">🔉 Fade-out</button>
            <button class="sb-tp stop" @onclick="StopAllAsync">⏹ Stopp</button>
        </div>
        <label class="sb-volume">🔊
            <input type="range" min="0" max="1" step="0.05" value="@_volume"
                   @onchange="OnVolumeChanged" />
        </label>
        <a class="sb-companion" href="/show/companion" target="_blank" title="Companion / Streamdeck-Konfiguration">⤓ Companion</a>
    </footer>


    <div class="sb-toasts">
        @foreach (var t in _toasts)
        {
            <div class="sb-toast">@t.Text</div>
        }
    </div>
</div>

@code {
    private const string AppBase = "/show/";

    private string SoundBase => string.IsNullOrWhiteSpace(Storage.Value.PublicBaseUrl)
        ? "/_content/RedAnts.Show/show/"
        : Storage.Value.PublicBaseUrl!.TrimEnd('/') + "/";

    private IReadOnlyList<ShowProfile> _profiles = ShowConfig.Profiles;
    private IReadOnlyList<ShowProfile> Profiles => _profiles;

    private string _profileId = ShowConfig.Profiles[0].Id;

    protected override async Task OnInitializedAsync()
    {
        var loaded = await Store.GetAllAsync();
        var src = loaded.Count > 0 ? loaded : _profiles;
        _profiles = src.Select(p => p with { Root = p.Root.Where(b => !b.Panic).ToList() }).ToList();
        if (_profiles.All(p => p.Id != _profileId)) _profileId = _profiles[0].Id;
    }
    private readonly List<string> _path = new();
    private string[] _activeLocalIds = [];
    private NowPlaying? _nowPlaying;
    private int? _remainingSec;
    private double _volume = 0.9;

    private string _clientId = "";
    private bool _loggedIn;
    private bool _playerReady;
    private string? _displayName;

    private readonly List<ToastItem> _toasts = new();
    private int _toastCounter;

    private DotNetObjectReference<ShowBoardComponent>? _ref;
    private System.Timers.Timer? _timer;

    private ShowProfile Profile => Profiles.FirstOrDefault(p => p.Id == _profileId) ?? Profiles[0];

    private IReadOnlyList<ShowButton> CurrentNodes()
    {
        var nodes = Profile.Root;
        foreach (var id in _path)
        {
            var folder = nodes.FirstOrDefault(n => n.Id == id);
            if (folder?.Children is not { } children) return Profile.Root;
            nodes = children;
        }
        return nodes;
    }

    private List<string> Breadcrumb()
    {
        var labels = new List<string>();
        var nodes = Profile.Root;
        foreach (var id in _path)
        {
            var folder = nodes.FirstOrDefault(n => n.Id == id);
            if (folder?.Children is not { } children) break;
            labels.Add(folder.Label);
            nodes = children;
        }
        return labels;
    }

    private (string Icon, string Title, string? Sub)? CurrentPlaying()
    {
        string? id = _nowPlaying?.ButtonId ?? (_activeLocalIds.Length > 0 ? _activeLocalIds[^1] : null);
        if (id is null) return null;
        var n = FindNode(id);
        if (n is not null) return (n.Icon ?? "🎵", n.Label, n.Subtitle);
        return ("🎵", _nowPlaying?.Label ?? "", null);
    }

    private ShowButton? FindNode(string id)
    {
        static ShowButton? Search(IReadOnlyList<ShowButton> nodes, string id)
        {
            foreach (var n in nodes)
            {
                if (n.Id == id) return n;
                if (n.Children is { } c && Search(c, id) is { } hit) return hit;
            }
            return null;
        }
        return Search(Profile.Root, id);
    }

    private SongMenu? _songMenu;
    private sealed record SongMenu(string Id, string Label, IReadOnlyList<ShowSound> Songs);

    [JSInvokable]
    public Task OnLongPress(string id)
    {
        var n = FindNode(id);
        if (n is not null)
        {
            var songs = n.EffectiveSongs.Where(s => !string.IsNullOrWhiteSpace(s.Ref)).ToList();
            if (songs.Count > 1) _songMenu = new SongMenu(id, n.Label, songs);
        }
        return InvokeAsync(StateHasChanged);
    }

    private static string SongLabel(ShowSound s)
    {
        if (s.Kind == SoundKind.Spotify)
        {
            var p = ShowSpotifyLink.Parse(s.Ref);
            return p is { } v ? $"Spotify · {v.Kind} {v.Id[..Math.Min(8, v.Id.Length)]}…" : "Spotify-Track";
        }
        var r = s.Ref;
        if (r.StartsWith("sounds/")) r = r["sounds/".Length..];
        var slash = r.LastIndexOf('/');
        if (slash >= 0) r = r[(slash + 1)..];
        return r;
    }

    private void SelectProfile(string id)
    {
        _profileId = id;
        _path.Clear();
    }

    private void TrimPath(int count)
    {
        while (_path.Count > count) _path.RemoveAt(_path.Count - 1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        _remoteReg = Remote.Register(HandleRemoteAsync);
        _timer = new System.Timers.Timer(500) { AutoReset = true };
        _timer.Elapsed += (_, _) => _ = TickAsync();
        _timer.Start();
        try
        {
            var configuredId = (Settings.Get("Spotify:ClientId") ?? Config["Spotify:ClientId"] ?? "").Trim();
            if (configuredId.Length > 0)
            {
                await JS.InvokeVoidAsync("showBoard.setClientId", configuredId);
            }
            var init = await JS.InvokeAsync<InitResult>("showBoard.init", _ref, SoundBase, AppBase);
            _loggedIn = init.LoggedIn;
            _clientId = await JS.InvokeAsync<string>("showBoard.getClientId");
            StateHasChanged();
        }
        catch
        {
            // Interop noch nicht bereit; nicht kritisch fürs lokale Board
        }
    }

    private void HandleButtonAsync(ShowButton node)
    {
        // Ordner navigieren. Alle Sounds (lokal, Zufall, Spotify) laufen
        // client-seitig direkt im Klick-Event (iOS-Nutzergeste), siehe soundboard.js.
        if (node.IsFolder) _path.Add(node.Id);
    }

    private Dictionary<string, object> TileAttrs(ShowButton node)
    {
        var a = new Dictionary<string, object> { ["data-id"] = node.Id };
        if (node.IsFolder) return a;
        var songs = node.EffectiveSongs.Where(s => !string.IsNullOrWhiteSpace(s.Ref)).ToList();
        if (songs.Count == 0) return a;
        a["data-play"] = "songs";
        a["data-songs"] = SongsJson(songs);
        a["data-random"] = node.SongsRandom ? "1" : "0";
        a["data-label"] = node.Label;
        if (songs.Count > 1) a["data-multi"] = "1";
        return a;
    }

    private string SongsJson(IEnumerable<ShowSound> songs) =>
        System.Text.Json.JsonSerializer.Serialize(songs.Select(x => new
        {
            t = x.Kind == SoundKind.Spotify ? "spotify" : "local",
            r = x.Kind == SoundKind.Spotify ? x.Ref : SoundUrl(x.Ref),
            s = x.StartSec,
            d = x.DurationSec,
            sh = x.Shuffle,
        }));

    private string SoundUrl(string reff) => reff.StartsWith("http") ? reff : SoundBase + reff;

    private static string Num(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);

    [JSInvokable]
    public Task OnLocalStarted()
    {
        _nowPlaying = null;
        _remainingSec = null;
        _paused = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSpotifyStarted(string id, string label, double? durationSec)
    {
        _paused = false;
        var endsAt = durationSec is { } d ? DateTime.UtcNow.AddSeconds(d) : (DateTime?)null;
        _nowPlaying = new NowPlaying(id, label, endsAt);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSpotifyStopped()
    {
        _nowPlaying = null;
        _remainingSec = null;
        _paused = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSpotifyStatus(string status)
    {
        string msg;
        if (status == "not-logged-in") msg = "Zuerst mit Spotify verbinden (Button oben rechts)";
        else if (status == "not-ready") msg = "Spotify-Player ist noch nicht bereit, einen Moment...";
        else if (status.Contains("PREMIUM_REQUIRED", StringComparison.OrdinalIgnoreCase))
            msg = "Spotify Premium erforderlich: Der eingeloggte Account muss ein Premium-Abo haben.";
        else if (status.Contains("403"))
            msg = "Spotify 403: Account nicht berechtigt (Premium nötig, und im Development-Modus der App unter User Management freischalten). Detail: " + status;
        else msg = "Spotify: " + status;
        Toast(msg);
        return InvokeAsync(StateHasChanged);
    }

    private async Task TickAsync()
    {
        int? newRemaining = null;
        var stop = false;
        if (_nowPlaying?.EndsAt is DateTime end)
        {
            var secs = (int)Math.Ceiling((end - DateTime.UtcNow).TotalSeconds);
            newRemaining = Math.Max(0, secs);
            if (DateTime.UtcNow >= end) stop = true;
        }
        if (stop)
        {
            await InvokeAsync(() => StopSpotifyAsync(true));
            return;
        }
        if (newRemaining != _remainingSec)
        {
            _remainingSec = newRemaining;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool _paused;

    private async Task PauseAsync() { _paused = true; await JS.InvokeVoidAsync("showBoard.pause"); }
    private async Task ResumeAsync() { _paused = false; await JS.InvokeVoidAsync("showBoard.resume"); }
    private async Task StopAllAsync() { _paused = false; _nowPlaying = null; _remainingSec = null; await JS.InvokeVoidAsync("showBoard.stopAll"); }
    private async Task FadeOutAsync() { _paused = false; _nowPlaying = null; _remainingSec = null; await JS.InvokeVoidAsync("showBoard.fadeOut"); }

    private async Task StopSpotifyAsync(bool fade)
    {
        _nowPlaying = null;
        _remainingSec = null;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("showBoard.stopSpotify", fade); } catch { }
    }

    private async Task OnVolumeChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            _volume = v;
            await JS.InvokeVoidAsync("showBoard.setVolume", v);
        }
    }

    private async Task LoginAsync()
    {
        try { await JS.InvokeVoidAsync("showBoard.startLogin"); }
        catch (Exception ex) { Toast(ex.Message); }
    }

    private async Task LogoutAsync()
    {
        await JS.InvokeVoidAsync("showBoard.logout");
        _loggedIn = false;
        _playerReady = false;
        _displayName = null;
    }

    private void Toast(string text)
    {
        var id = ++_toastCounter;
        _toasts.Add(new ToastItem(id, text));
        _ = RemoveToastLaterAsync(id);
        StateHasChanged();
    }

    private async Task RemoveToastLaterAsync(int id)
    {
        await Task.Delay(5000);
        _toasts.RemoveAll(t => t.Id == id);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnActiveChanged(string[] ids)
    {
        _activeLocalIds = ids;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnPlayerReady()
    {
        _playerReady = true;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnDisplayName(string name)
    {
        _displayName = name;
        _loggedIn = true;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnToast(string message) => Toast(message);

    [JSInvokable]
    public async Task OnEscape()
    {
        await StopAllAsync();
        await InvokeAsync(StateHasChanged);
    }

    private bool _activated;

    [JSInvokable]
    public Task OnActivated()
    {
        if (_activated) return Task.CompletedTask;
        _activated = true;
        return InvokeAsync(StateHasChanged);
    }

    private IDisposable? _remoteReg;

    private async Task HandleRemoteAsync(ShowCommand cmd)
    {
        await InvokeAsync(async () =>
        {
            switch (cmd.Action)
            {
                case "stop": await StopAllAsync(); break;
                case "pause": await PauseAsync(); break;
                case "resume": await ResumeAsync(); break;
                case "fade": await FadeOutAsync(); break;
                case "back": if (_path.Count > 0) TrimPath(_path.Count - 1); break;
                case "home": _path.Clear(); break;
                case "profile": if (cmd.ProfileId is { } pid && Profiles.Any(p => p.Id == pid)) SelectProfile(pid); break;
                case "folder": if (cmd.TileId is { } fid && FindNode(fid) is { IsFolder: true }) _path.Add(fid); break;
                case "play": if (cmd.TileId is { } id) await RemotePlayAsync(id, null); break;
                case "song": if (cmd.TileId is { } sid) await RemotePlayAsync(sid, cmd.SongIndex); break;
            }
            StateHasChanged();
        });
    }

    private async Task RemotePlayAsync(string id, int? songIndex)
    {
        var n = FindNode(id);
        if (n is null) return;
        if (n.IsFolder) { _path.Add(id); return; }
        var songs = n.EffectiveSongs.Where(s => !string.IsNullOrWhiteSpace(s.Ref)).ToList();
        if (songs.Count == 0) return;
        if (songIndex is { } si && si >= 0 && si < songs.Count) songs = new() { songs[si] };
        var arr = songs.Select(x => new
        {
            t = x.Kind == SoundKind.Spotify ? "spotify" : "local",
            r = x.Kind == SoundKind.Spotify ? x.Ref : SoundUrl(x.Ref),
            s = x.StartSec,
            d = x.DurationSec,
            sh = x.Shuffle,
        }).ToArray();
        _nowPlaying = null;
        _paused = false;
        await JS.InvokeVoidAsync("showBoard.playSongs", id, arr, n.SongsRandom && songIndex is null);
    }

    public async ValueTask DisposeAsync()
    {
        _remoteReg?.Dispose();
        _timer?.Dispose();
        try { await JS.InvokeVoidAsync("showBoard.stopAll"); } catch { }
        _ref?.Dispose();
    }

    private sealed record NowPlaying(string ButtonId, string Label, DateTime? EndsAt);
    private sealed record ToastItem(int Id, string Text);
    private sealed record InitResult(bool LoggedIn, bool HasClientId, string RedirectUri);
}
