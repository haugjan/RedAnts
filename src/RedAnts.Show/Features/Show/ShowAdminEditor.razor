@using Microsoft.Extensions.Options
@using RedAnts.Infrastructure.Show
@using System.Text.Json
@inject IShowProfileStore Store
@inject IShowSoundUploader Uploader
@inject IShowSpotifySearch Search
@inject IOptions<ShowStorageOptions> Storage
@inject IJSRuntime JS
@implements IDisposable

<div class="se">
    <header class="se-top">
        <h1>Show · Soundboard-Konfiguration</h1>
        <div class="se-actions">
            <button class="se-btn primary" @onclick="SaveAsync">💾 Speichern</button>
            <button class="se-btn" @onclick="LoadAsync">↺ Neu laden</button>
            <button class="se-btn" @onclick="() => _showIo = !_showIo">⇅ Import/Export</button>
            <button class="se-btn" @onclick="ResetAsync">⟲ Vorlage</button>
            <a class="se-btn" href="/show" target="_blank">▶ Board öffnen</a>
            @if (_status is { Length: > 0 })
            {
                <span class="se-status">@_status</span>
            }
        </div>
    </header>

    @if (_showIo)
    {
        <div class="se-io">
            <textarea @bind="_ioText" spellcheck="false" placeholder="JSON hier einfügen und &quot;Importieren&quot; klicken"></textarea>
            <div class="se-io-actions">
                <button class="se-btn" @onclick="ExportJson">Export → Textfeld</button>
                <button class="se-btn" @onclick="ImportJson">Importieren</button>
                @if (_ioError is { Length: > 0 })
                {
                    <span class="se-err">@_ioError</span>
                }
            </div>
        </div>
    }

    @if (_profile is null)
    {
        <p class="se-muted">Wird geladen …</p>
    }
    else
    {
        <div class="se-tabs">
            @foreach (var p in _profiles)
            {
                <button class="se-tab @(p == _profile ? "active" : "")" @onclick="() => SelectProfile(p)">@p.Name</button>
            }
            <button class="se-tab add" title="Neues Profil" @onclick="AddProfile">+ Profil</button>
        </div>

        <div class="se-body">
            <div class="se-tree">
                <div class="se-prof-head">
                    <input class="se-in" @bind="_profile.Name" @bind:event="oninput" />
                    <input class="se-color" type="color" @bind="_profile.Color" />
                    <button class="se-btn sm" title="Profil duplizieren" @onclick="DuplicateProfile">⧉</button>
                    <button class="se-btn sm danger" title="Profil löschen" @onclick="DeleteProfile">🗑</button>
                </div>
                <div class="se-ftree">
                    <button class="se-fnode @(_levelStack.Count == 0 ? "cur" : "")" @onclick="() => GoLevel(0)">🏠 Hauptseite</button>
                    @RenderFolders(_profile.Root, 1)
                </div>
                <button class="se-btn sm" @onclick="() => AddChild(CurrentLevel(), NodeKind.Folder)">+ Unterordner (aktuelle Ebene)</button>
            </div>

            <div class="se-detail">
                <div class="se-canvas-head">
                    <strong>Anordnung (Raster ziehen)</strong>
                    <button class="se-crumb2" @onclick="() => GoLevel(0)">@_profile.Name</button>
                    @for (var d = 0; d < _levelStack.Count; d++)
                    {
                        var depth = d;
                        <span class="se-sep2">›</span>
                        <button class="se-crumb2" @onclick="() => GoLevel(depth + 1)">@_levelStack[depth].Label</button>
                    }
                </div>
                @{ var level = CurrentLevel(); ShowLayout.EnsureEdit(level); }
                <div class="se-canvas">
                    @foreach (var node in level)
                    {
                        <div class="se-ct @(node == _selected ? "sel" : "")"
                             data-id="@node.Id" data-x="@node.X" data-y="@node.Y" data-w="@node.W" data-h="@node.H"
                             @onclick="() => Select(node)"
                             style="grid-column:@(node.X + 1) / span @node.W; grid-row:@(node.Y + 1) / span @node.H; --c:@node.Color">
                            <span class="se-ct-ico">@(string.IsNullOrEmpty(node.Icon) ? (node.Kind == NodeKind.Folder ? "📁" : "🔊") : node.Icon)</span>
                            <span class="se-ct-lbl">@node.Label</span>
                            @if (node.Kind == NodeKind.Folder)
                            {
                                <button class="se-ct-open" @onclick:stopPropagation="true" @onclick="() => EnterLevel(node)">öffnen ↳</button>
                            }
                            <span class="se-ct-resize" title="Grösse ziehen"></span>
                        </div>
                    }
                </div>

                <div class="se-add-tiles">
                    <button class="se-btn sm" @onclick="() => AddChild(CurrentLevel(), NodeKind.Sound)">+ Sound</button>
                    <button class="se-btn sm" @onclick="() => AddChild(CurrentLevel(), NodeKind.Random)">+ Zufall</button>
                    <button class="se-btn sm" @onclick="() => AddChild(CurrentLevel(), NodeKind.Folder)">+ Ordner</button>
                </div>

                @if (_selected is not null)
                {
                    var n = _selected;
                    <div class="se-editwrap" @onclick="() => _selected = null">
                    <div class="se-editcard" @onclick:stopPropagation="true">
                    <button class="se-editclose" @onclick="() => _selected = null">✕</button>
                    <div class="se-preview" style="--c:@n.Color">
                        <span class="se-pv-icon">@(string.IsNullOrEmpty(n.Icon) ? "🔊" : n.Icon)</span>
                        <span class="se-pv-label">@n.Label</span>
                        @if (!string.IsNullOrEmpty(n.Subtitle))
                        {
                            <span class="se-pv-sub">@n.Subtitle</span>
                        }
                    </div>

                    <div class="se-grid">
                        <label>Beschriftung <input @bind="n.Label" @bind:event="oninput" /></label>
                        <label>Untertitel (Song) <input @bind="n.Subtitle" @bind:event="oninput" /></label>
                        <div class="se-fieldcol">
                            <span class="se-lbl">Icon</span>
                            <button type="button" class="se-emoji-btn" @onclick="() => _emojiOpen = !_emojiOpen">
                                <span>@(string.IsNullOrEmpty(n.Icon) ? "＋" : n.Icon)</span> auswählen
                            </button>
                            @if (_emojiOpen)
                            {
                                <div class="se-emoji-pop">
                                    @foreach (var e in Emojis)
                                    {
                                        <button type="button" @onclick="@(() => { n.Icon = e; _emojiOpen = false; })">@e</button>
                                    }
                                    <button type="button" class="clear" @onclick="@(() => { n.Icon = null; _emojiOpen = false; })">✕</button>
                                </div>
                            }
                        </div>
                        <label>Farbe <input type="color" @bind="n.Color" /></label>
                    </div>

                    @if (n.Kind == NodeKind.Sound)
                    {
                        <h3>Sound</h3>
                        <div class="se-src-tabs">
                            <button type="button" class="@(n.Sound.Kind == SoundKind.Local ? "active" : "")" @onclick="() => n.Sound.Kind = SoundKind.Local">🎵 Datei</button>
                            <button type="button" class="@(n.Sound.Kind == SoundKind.Spotify ? "active" : "")" @onclick="() => n.Sound.Kind = SoundKind.Spotify">🟢 Spotify</button>
                        </div>

                        @if (n.Sound.Kind == SoundKind.Local)
                        {
                            <div class="se-full">
                                <span class="se-lbl">Aktuelle Datei</span>
                                <div class="se-current">@FriendlyName(n.Sound.Ref)</div>
                            </div>
                            <label class="se-drop @(_uploading ? "busy" : "")">
                                <InputFile OnChange="e => OnUploadAsync(e, n.Sound)" accept="audio/*" />
                                <span>@(_uploading ? "Lädt hoch …" : "Datei ziehen oder klicken – ersetzt sofort")</span>
                            </label>
                        }
                        else
                        {
                            @if (Search.Configured)
                            {
                                <div class="se-search">
                                    <input class="se-search-in" @bind="_query" @bind:event="oninput" @onkeyup="OnSearchKey" placeholder="Song auf Spotify suchen …" />
                                    <button class="se-btn primary" @onclick="DoSearch">🔍 Suchen</button>
                                </div>
                                @if (_searching)
                                {
                                    <p class="se-muted">Suche …</p>
                                }
                                @if (_results.Count > 0)
                                {
                                    <div class="se-results">
                                        @foreach (var t in _results)
                                        {
                                            <button class="se-result" @onclick="() => PickTrack(t)">
                                                <span class="se-result-name">@t.Name</span>
                                                <span class="se-result-artist">@t.Artist</span>
                                            </button>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="se-muted">Spotify-Suche inaktiv (Client-ID + Secret hinterlegen). Solange manuell:</p>
                                <label class="se-full">Spotify-URI
                                    <input @bind="n.Sound.Ref" @bind:event="oninput" placeholder="spotify:track:…" />
                                </label>
                            }
                            <div class="se-full">
                                <span class="se-lbl">Aktueller Track</span>
                                <div class="se-current">@(string.IsNullOrWhiteSpace(n.Sound.Ref) ? "— keiner —" : n.Sound.Ref)</div>
                            </div>
                        }

                        <div class="se-grid">
                            <label>Cue-Start (Sek.) <input type="number" min="0" @bind="n.Sound.StartSec" /></label>
                            <label>Dauer (Sek., leer = ganz) <input type="number" min="0" @bind="n.Sound.DurationSec" /></label>
                        </div>
                        <button class="se-btn" @onclick="() => TestAsync(n.Sound)">▶ Test</button>
                        @if (_uploadError is { Length: > 0 })
                        {
                            <p class="se-err">@_uploadError</p>
                        }
                    }
                    else if (n.Kind == NodeKind.Random)
                    {
                        <h3>Zufalls-Pool (Blob-Pfade)</h3>
                        @for (var i = 0; i < n.Pool.Count; i++)
                        {
                            var idx = i;
                            <div class="se-pool-row">
                                <input @bind="n.Pool[idx].Ref" @bind:event="oninput" placeholder="sounds/xy.mp3" />
                                <button class="se-btn sm" @onclick="() => TestAsync(n.Pool[idx])">▶</button>
                                <button class="se-btn sm danger" @onclick="() => n.Pool.RemoveAt(idx)">🗑</button>
                            </div>
                        }
                        <button class="se-btn" @onclick="() => n.Pool.Add(new EditSound())">+ Sound zum Pool</button>
                    }
                    else
                    {
                        <p class="se-muted">Ordner: mit „öffnen" (Raster) oder links reingehen, dann darin Kacheln anlegen.</p>
                    }
                    <button class="se-btn sm danger se-editdel" @onclick="DeleteSelected">🗑 Kachel löschen</button>
                    </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<EditProfile> _profiles = new();
    private EditProfile? _profile;
    private EditButton? _selected;
    private string _status = "";
    private bool _showIo;
    private string _ioText = "";
    private string _ioError = "";
    private bool _emojiOpen;
    private bool _uploading;
    private string _uploadError = "";
    private readonly List<EditButton> _levelStack = new();
    private DotNetObjectReference<ShowAdminEditor>? _gridRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _gridRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("showGridInit", _gridRef);
    }

    public void Dispose() => _gridRef?.Dispose();

    [JSInvokable]
    public Task SetRect(string id, int x, int y, int w, int h)
    {
        var level = CurrentLevel();
        var n = level.FirstOrDefault(b => b.Id == id);
        if (n is null) return Task.CompletedTask;
        w = Math.Clamp(w, 1, ShowLayout.Cols);
        h = Math.Clamp(h, 1, ShowLayout.Rows);
        x = Math.Clamp(x, 0, ShowLayout.Cols - w);
        y = Math.Clamp(y, 0, ShowLayout.Rows - h);
        if (Overlaps(level, n, x, y, w, h)) return Task.CompletedTask;
        if (n.X == x && n.Y == y && n.W == w && n.H == h) return Task.CompletedTask;
        n.X = x; n.Y = y; n.W = w; n.H = h;
        return InvokeAsync(StateHasChanged);
    }

    private static bool Overlaps(List<EditButton> level, EditButton self, int x, int y, int w, int h)
    {
        foreach (var o in level)
        {
            if (o == self) continue;
            int ox = Math.Max(0, o.X), oy = Math.Max(0, o.Y);
            int ow = o.W <= 0 ? 3 : o.W, oh = o.H <= 0 ? 2 : o.H;
            if (x < ox + ow && x + w > ox && y < oy + oh && y + h > oy) return true;
        }
        return false;
    }

    private static string FriendlyName(string? r)
    {
        if (string.IsNullOrWhiteSpace(r)) return "— keine —";
        return r.StartsWith("sounds/") ? r["sounds/".Length..] : r;
    }

    private List<EditButton> CurrentLevel()
    {
        if (_profile is null) return new();
        while (_levelStack.Count > 0 && !Contains(_profile.Root, _levelStack[^1]))
            _levelStack.RemoveAt(_levelStack.Count - 1);
        return _levelStack.Count > 0 ? _levelStack[^1].Children : _profile.Root;
    }

    private static bool Contains(List<EditButton> nodes, EditButton target)
    {
        foreach (var n in nodes)
        {
            if (n == target) return true;
            if (n.Kind == NodeKind.Folder && Contains(n.Children, target)) return true;
        }
        return false;
    }

    private void GoLevel(int depth) { while (_levelStack.Count > depth) _levelStack.RemoveAt(_levelStack.Count - 1); }
    private void EnterLevel(EditButton folder) { if (folder.Kind == NodeKind.Folder) { _levelStack.Add(folder); _selected = null; } }

    private void Resize(EditButton n, int dw, int dh)
    {
        n.W = Math.Clamp((n.W <= 0 ? 3 : n.W) + dw, 1, ShowLayout.Cols);
        n.H = Math.Clamp((n.H <= 0 ? 2 : n.H) + dh, 1, ShowLayout.Rows);
        if (n.X < 0) n.X = 0;
        n.X = Math.Clamp(n.X, 0, ShowLayout.Cols - n.W);
        if (n.Y < 0) n.Y = 0;
    }

    private static readonly string[] Emojis =
    [
        "🥅", "🏒", "⚽", "🏆", "🏅", "🎯", "💪", "🙌", "👏", "📣", "📢", "🚨", "⏱️", "🔔",
        "🎵", "🎶", "🎤", "🥁", "🎸", "🎺", "🎬", "🎉", "🎲", "🔥", "⭐", "⚡", "💥", "🌪️",
        "🐯", "🦗", "💰", "🪙", "😇", "🛝", "💿", "😬", "😱", "😄", "🕺", "🎧",
    ];

    private async Task OnUploadAsync(InputFileChangeEventArgs e, EditSound sound)
    {
        var file = e.File;
        if (file is null) return;
        _uploading = true;
        _uploadError = "";
        try
        {
            await using var stream = file.OpenReadStream(50L * 1024 * 1024);
            sound.Ref = await Uploader.UploadAsync(file.Name, stream, file.ContentType);
        }
        catch (Exception ex) { _uploadError = "Upload fehlgeschlagen: " + ex.Message; }
        finally { _uploading = false; }
    }

    private string SoundBase => string.IsNullOrWhiteSpace(Storage.Value.PublicBaseUrl)
        ? "/_content/RedAnts.Show/show/"
        : Storage.Value.PublicBaseUrl!.TrimEnd('/') + "/";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var loaded = await Store.GetAllAsync();
        _profiles = loaded.Select(EditProfile.From).ToList();
        _profile = _profiles.FirstOrDefault();
        _selected = null;
        _status = "";
    }

    private async Task SaveAsync()
    {
        try
        {
            await Store.SaveAllAsync(_profiles.Select(p => p.ToModel()).ToList());
            _status = $"Gespeichert · {DateTime.Now:HH:mm:ss}";
        }
        catch (Exception ex) { _status = "Fehler: " + ex.Message; }
    }

    private void SelectProfile(EditProfile p) { _profile = p; _selected = null; }

    private void AddProfile()
    {
        var p = new EditProfile { Name = "Neues Profil" };
        _profiles.Add(p);
        _profile = p;
        _selected = null;
    }

    private void DuplicateProfile()
    {
        if (_profile is null) return;
        var json = JsonSerializer.Serialize(_profile.ToModel(), ShowJson.Options);
        var copy = EditProfile.From(JsonSerializer.Deserialize<ShowProfile>(json, ShowJson.Options)!);
        copy.Id = Guid.NewGuid().ToString("N")[..6];
        copy.Name = _profile.Name + " (Kopie)";
        _profiles.Add(copy);
        _profile = copy;
        _selected = null;
    }

    private async Task DeleteProfile()
    {
        if (_profile is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Profil „{_profile.Name}“ wirklich löschen?")) return;
        _profiles.Remove(_profile);
        _profile = _profiles.FirstOrDefault();
        _selected = null;
    }

    private void Select(EditButton node) => _selected = node;

    private void AddChild(List<EditButton> list, NodeKind kind)
    {
        var b = new EditButton { Kind = kind, Label = kind == NodeKind.Folder ? "Ordner" : kind == NodeKind.Random ? "Überraschung" : "Neu", Icon = kind == NodeKind.Folder ? "📁" : kind == NodeKind.Random ? "🎲" : "🔊" };
        list.Add(b);
        _selected = b;
    }

    private void Move(EditButton node, List<EditButton> list, int delta)
    {
        var i = list.IndexOf(node);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= list.Count) return;
        (list[i], list[j]) = (list[j], list[i]);
    }

    private async Task Delete(EditButton node, List<EditButton> list)
    {
        var what = node.Kind == NodeKind.Folder && node.Children.Count > 0
            ? $"Ordner „{node.Label}“ samt {node.Children.Count} Einträgen löschen?"
            : $"„{node.Label}“ löschen?";
        if (!await JS.InvokeAsync<bool>("confirm", what)) return;
        list.Remove(node);
        if (_selected == node) _selected = null;
    }

    private void NavigateTo(EditButton folder)
    {
        if (_profile is null) return;
        var path = new List<EditButton>();
        if (FindPath(_profile.Root, folder, path)) { _levelStack.Clear(); _levelStack.AddRange(path); }
        _selected = null;
    }

    private static bool FindPath(List<EditButton> nodes, EditButton target, List<EditButton> path)
    {
        foreach (var n in nodes.Where(x => x.Kind == NodeKind.Folder))
        {
            path.Add(n);
            if (n == target) return true;
            if (FindPath(n.Children, target, path)) return true;
            path.RemoveAt(path.Count - 1);
        }
        return false;
    }

    private static bool RemoveFrom(List<EditButton> nodes, EditButton target)
    {
        if (nodes.Remove(target)) return true;
        foreach (var n in nodes.Where(x => x.Kind == NodeKind.Folder))
            if (RemoveFrom(n.Children, target)) return true;
        return false;
    }

    private async Task DeleteSelected()
    {
        if (_selected is null || _profile is null) return;
        var s = _selected;
        var what = s.Kind == NodeKind.Folder && s.Children.Count > 0
            ? $"Ordner „{s.Label}“ samt {s.Children.Count} Einträgen löschen?"
            : $"„{s.Label}“ löschen?";
        if (!await JS.InvokeAsync<bool>("confirm", what)) return;
        RemoveFrom(_profile.Root, s);
        _selected = null;
    }

    private async Task ResetAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Alle Profile auf die Standard-Vorlage zurücksetzen? Gespeicherte Änderungen gehen verloren.")) return;
        await Store.SaveAllAsync(ShowConfig.Profiles);
        await LoadAsync();
        _status = "Auf Vorlage zurückgesetzt.";
    }

    private RenderFragment RenderFolders(List<EditButton> nodes, int depth) =>
    @<text>
        @foreach (var f in nodes.Where(n => n.Kind == NodeKind.Folder))
        {
            <div class="se-fnode-row">
                <button class="se-fnode @(_levelStack.Count > 0 && _levelStack[^1] == f ? "cur" : "")"
                        style="padding-left:@(depth * 14)px" @onclick="() => NavigateTo(f)">📁 @f.Label</button>
            </div>
            @RenderFolders(f.Children, depth + 1)
        }
    </text>;

    private async Task TestAsync(EditSound s)
    {
        if (s.Kind == SoundKind.Local)
        {
            if (string.IsNullOrWhiteSpace(s.Ref)) { await JS.InvokeVoidAsync("alert", "Noch keine Datei hinterlegt."); return; }
            var url = s.Ref.StartsWith("http") ? s.Ref : SoundBase + s.Ref;
            await JS.InvokeVoidAsync("showEditTest", url, s.StartSec);
        }
        else
        {
            await JS.InvokeVoidAsync("showEditTestSpotify", s.Ref, s.StartSec);
        }
    }

    private string _query = "";
    private IReadOnlyList<SpotifyTrack> _results = [];
    private bool _searching;

    private async Task DoSearch()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;
        _searching = true;
        _uploadError = "";
        try { _results = await Search.SearchAsync(_query); }
        catch (Exception ex) { _uploadError = "Suche: " + ex.Message; _results = []; }
        finally { _searching = false; }
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSearch();
    }

    private void PickTrack(SpotifyTrack t)
    {
        if (_selected is null) return;
        _selected.Sound.Kind = SoundKind.Spotify;
        _selected.Sound.Ref = t.Uri;
        if (string.IsNullOrWhiteSpace(_selected.Label) || _selected.Label == "Neu") _selected.Label = t.Name;
        _selected.Subtitle = t.Artist;
        _results = [];
        _query = "";
    }

    private void ExportJson()
    {
        _ioText = JsonSerializer.Serialize(_profiles.Select(p => p.ToModel()).ToList(), ShowJson.Options);
        _ioError = "";
    }

    private void ImportJson()
    {
        try
        {
            var list = JsonSerializer.Deserialize<List<ShowProfile>>(_ioText, ShowJson.Options);
            if (list is null || list.Count == 0) { _ioError = "Kein gültiges Profil-JSON."; return; }
            _profiles = list.Select(EditProfile.From).ToList();
            _profile = _profiles.First();
            _selected = null;
            _ioError = "Importiert (noch nicht gespeichert).";
        }
        catch (Exception ex) { _ioError = "Fehler: " + ex.Message; }
    }

    private RenderFragment RenderNode(EditButton node, List<EditButton> siblings) =>
    @<div class="tn">
        <div class="tn-row @(node == _selected ? "sel" : "")">
            <button class="tn-label" @onclick="() => Select(node)">
                <span class="tn-ico">@(string.IsNullOrEmpty(node.Icon) ? (node.Kind == NodeKind.Folder ? "📁" : "🔊") : node.Icon)</span>
                <span>@node.Label</span>
                <span class="tn-kind">@(node.Kind == NodeKind.Folder ? "Ordner" : node.Kind == NodeKind.Random ? "Zufall" : "")</span>
            </button>
            <span class="tn-ctrl">
                <button title="Nach oben" @onclick="() => Move(node, siblings, -1)">↑</button>
                <button title="Nach unten" @onclick="() => Move(node, siblings, 1)">↓</button>
                <button title="Löschen" class="danger" @onclick="() => Delete(node, siblings)">🗑</button>
            </span>
        </div>
        @if (node.Kind == NodeKind.Folder)
        {
            <div class="tn-children">
                @foreach (var c in node.Children)
                {
                    @RenderNode(c, node.Children)
                }
                <div class="tn-add">
                    <button @onclick="() => AddChild(node.Children, NodeKind.Sound)">+ Sound</button>
                    <button @onclick="() => AddChild(node.Children, NodeKind.Folder)">+ Ordner</button>
                    <button @onclick="() => AddChild(node.Children, NodeKind.Random)">+ Zufall</button>
                </div>
            </div>
        }
    </div>;
}

<style>
    :root {
        --ra-red: #E11330; --ra-bg: #141418; --ra-panel: #1d1d24; --ra-panel2: #26262f;
