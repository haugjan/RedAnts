@using Microsoft.Extensions.Options
@using RedAnts.Infrastructure.Show
@using System.Text.Json
@using System.IO.Compression
@using Microsoft.JSInterop
@inject IShowProfileStore Store
@inject IShowSoundUploader Uploader
@inject IShowSpotifySearch Search
@inject IShowSettingsStore Settings
@inject IOptions<ShowStorageOptions> Storage
@inject IJSRuntime JS
@implements IDisposable

<div class="se">
    <header class="se-top">
        <h1>Show · Soundboard-Konfiguration</h1>
        <div class="se-actions">
            <button class="se-btn primary" @onclick="SaveAsync">💾 Speichern</button>
            <button class="se-btn" @onclick="LoadAsync">↺ Neu laden</button>
            <button class="se-btn" @onclick="() => _showIo = !_showIo">⇅ Import/Export</button>
            <button class="se-btn" @onclick="OpenSpotifySettings">🟢 Spotify</button>
            <button class="se-btn" @onclick="ResetAsync">⟲ Vorlage</button>
            <a class="se-btn" href="/show" target="_blank">▶ Board öffnen</a>
            @if (_status is { Length: > 0 })
            {
                <span class="se-status">@_status</span>
            }
        </div>
    </header>

    @if (_showIo)
    {
        <div class="se-io">
            <div class="se-io-actions">
                <button class="se-btn primary" @onclick="ExportBundleAsync" disabled="@_ioBusy">⬇ Bundle exportieren (ZIP mit Dateien)</button>
                <label class="se-btn @(_ioBusy ? "disabled" : "")">⬆ Bundle importieren (ZIP)
                    <InputFile OnChange="ImportBundleAsync" accept=".zip" style="display:none" disabled="@_ioBusy" />
                </label>
                @if (_ioBusy)
                {
                    <span class="se-muted">Arbeite …</span>
                }
                @if (_ioStatus is { Length: > 0 })
                {
                    <span class="se-status">@_ioStatus</span>
                }
                @if (_ioError is { Length: > 0 })
                {
                    <span class="se-err">@_ioError</span>
                }
            </div>
            <details class="se-io-json">
                <summary>Nur JSON (ohne Dateien)</summary>
                <textarea @bind="_ioText" spellcheck="false" placeholder="JSON hier einfügen und &quot;Importieren&quot; klicken"></textarea>
                <div class="se-io-actions">
                    <button class="se-btn" @onclick="ExportJson">Export → Textfeld</button>
                    <button class="se-btn" @onclick="ImportJson">Importieren</button>
                </div>
            </details>
        </div>
    }

    @if (_showSpotify)
    {
        <div class="se-editwrap" @onclick="() => _showSpotify = false">
            <div class="se-editcard se-spotifycard" @onclick:stopPropagation="true">
                <button class="se-editclose" @onclick="() => _showSpotify = false">✕</button>
                <h3 class="se-spotifyh">🟢 Spotify-Zugang</h3>

                <div class="se-spotifycur">
                    <div>Aktuell gespeicherte Client-ID</div>
                    <strong>@(string.IsNullOrWhiteSpace(_savedClientId) ? "— keine hinterlegt —" : _savedClientId)</strong>
                    <div class="se-muted">Client-Secret: @(_hasSecret ? "gesetzt ✓" : "nicht gesetzt")</div>
                </div>

                <label class="se-full">Client-ID
                    <input @bind="_spotifyClientId" placeholder="z. B. 20dc00b2e3db4ab790fad325e510897d" />
                </label>
                <label class="se-full">Client-Secret (nur für die Suche; leer lassen = unverändert)
                    <input type="password" @bind="_spotifyClientSecret" placeholder="leer lassen = unverändert" />
                </label>

                <div class="se-testrow">
                    <button class="se-btn primary" @onclick="SaveSpotifyAsync" disabled="@_spotifyBusy">💾 Speichern</button>
                    <button class="se-btn" @onclick="TestSpotifyAsync" disabled="@_spotifyBusy">🔍 Testen</button>
                    <button class="se-btn" @onclick="() => _showSpotify = false">Schliessen</button>
                </div>
                @if (_spotifyTestResult is { Length: > 0 })
                {
                    <p class="@(_spotifyTestOk ? "se-savedbanner" : "se-err")">@_spotifyTestResult</p>
                }
                @if (_spotifyStatus is { Length: > 0 })
                {
                    <p class="se-savedbanner">✓ @_spotifyStatus</p>
                }
                @if (_spotifyError is { Length: > 0 })
                {
                    <p class="se-err">@_spotifyError</p>
                }

                <p class="se-muted" style="margin-top:14px">Wird zentral in der Datenbank gespeichert und gilt für alle Geräte dieser Umgebung (dev und prod haben getrennte Datenbanken). In deiner Spotify-App müssen diese Redirect-URIs eingetragen sein:</p>
                <ul class="se-redirects">
                    <li><code>https://show.redants.ch/show/callback</code></li>
                    <li><code>https://show-dev.redants.ch/show/callback</code></li>
                    <li><code>http://127.0.0.1:5603/show/callback</code></li>
                </ul>
            </div>
        </div>
    }

    @if (_profile is null)
    {
        <p class="se-muted">Wird geladen …</p>
    }
    else
    {
        <div class="se-tabs">
            @foreach (var p in _profiles)
            {
                <button class="se-tab @(p == _profile ? "active" : "")" @onclick="() => SelectProfile(p)">@p.Name</button>
            }
            <button class="se-tab add" title="Neues Profil" @onclick="AddProfile">+ Profil</button>
        </div>

        <div class="se-body">
            <div class="se-tree">
                <div class="se-prof-head">
                    <input class="se-in" @bind="_profile.Name" @bind:event="oninput" />
                    <input class="se-color" type="color" @bind="_profile.Color" title="Profilfarbe" />
                </div>
                <div class="se-prof-btns">
                    <button class="se-btn sm" @onclick="DuplicateProfile">⧉ Duplizieren</button>
                    <button class="se-btn sm danger" @onclick="DeleteProfile">🗑 Löschen</button>
                </div>
                <div class="se-ftree">
                    <button class="se-fnode @(_levelStack.Count == 0 ? "cur" : "")" @onclick="() => GoLevel(0)">🏠 Hauptseite</button>
                    @RenderFolders(_profile.Root, 1)
                </div>
            </div>

            <div class="se-detail">
                <div class="se-canvas-head">
                    <strong>Anordnung (Raster ziehen)</strong>
                    <button class="se-crumb2" @onclick="() => GoLevel(0)">@_profile.Name</button>
                    @for (var d = 0; d < _levelStack.Count; d++)
                    {
                        var depth = d;
                        <span class="se-sep2">›</span>
                        <button class="se-crumb2" @onclick="() => GoLevel(depth + 1)">@_levelStack[depth].Label</button>
                    }
                </div>
                @{ var level = CurrentLevel(); ShowLayout.EnsureEdit(level); }
                <div class="se-canvas">
                    @foreach (var node in level)
                    {
                        <div class="se-ct @(node.Kind == NodeKind.Folder ? "folder" : "") @(node == _selected ? "sel" : "")"
                             data-id="@node.Id" data-x="@node.X" data-y="@node.Y" data-w="@node.W" data-h="@node.H"
                             @onclick="() => Select(node)"
                             style="grid-column:@(node.X + 1) / span @node.W; grid-row:@(node.Y + 1) / span @node.H; --c:@node.Color">
                            @if (node.Kind == NodeKind.Folder)
                            {
                                <span class="se-ct-fhead"><span>📂</span>@node.Label</span>
                                <span class="se-ct-ico fbody">@(string.IsNullOrEmpty(node.Icon) ? "📁" : node.Icon)</span>
                                <button class="se-ct-open" @onclick:stopPropagation="true" @onclick="() => EnterLevel(node)">öffnen ↳</button>
                            }
                            else
                            {
                                <span class="se-ct-ico">@(string.IsNullOrEmpty(node.Icon) ? "🔊" : node.Icon)</span>
                                <span class="se-ct-lbl">@node.Label</span>
                            }
                            <span class="se-ct-resize" title="Grösse ziehen"></span>
                        </div>
                    }
                </div>

                <p class="se-hint">Neue Kachel: mit der Maus auf freie Rasterfläche aufziehen, dann Ordner oder Song wählen.</p>
                <div class="se-add-tiles">
                    <button class="se-btn sm" @onclick="() => AddChild(CurrentLevel(), NodeKind.Sound)">+ Song</button>
                    <button class="se-btn sm" @onclick="() => AddChild(CurrentLevel(), NodeKind.Folder)">+ Ordner</button>
                </div>

                @if (_selected is not null)
                {
                    var n = _selected;
                    <div class="se-editwrap" @onmousedown="() => _downOnBackdrop = true" @onclick="OnWrapClick">
                    <div class="se-editcard" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true">
                    <button class="se-editclose" @onclick="AttemptClose">✕</button>
                    <div class="se-preview" style="--c:@n.Color">
                        <span class="se-pv-icon">@(string.IsNullOrEmpty(n.Icon) ? "🔊" : n.Icon)</span>
                        <span class="se-pv-label">@n.Label</span>
                        @if (!string.IsNullOrEmpty(n.Subtitle))
                        {
                            <span class="se-pv-sub">@n.Subtitle</span>
                        }
                    </div>

                    <div class="se-editbody">
                    <div class="se-col">
                    <div class="se-grid">
                        <label>Beschriftung <input @bind="n.Label" @bind:event="oninput" /></label>
                        <label>Untertitel (Song) <input @bind="n.Subtitle" @bind:event="oninput" /></label>
                        <div class="se-fieldcol">
                            <span class="se-lbl">Icon</span>
                            <button type="button" class="se-emoji-btn" @onclick="() => _emojiOpen = !_emojiOpen">
                                <span>@(string.IsNullOrEmpty(n.Icon) ? "＋" : n.Icon)</span> auswählen
                            </button>
                            @if (_emojiOpen)
                            {
                                <div class="se-emoji-pop">
                                    @foreach (var e in Emojis)
                                    {
                                        <button type="button" @onclick="@(() => { n.Icon = e; _emojiOpen = false; })">@e</button>
                                    }
                                    <button type="button" class="clear" @onclick="@(() => { n.Icon = null; _emojiOpen = false; })">✕</button>
                                </div>
                            }
                        </div>
                        <div class="se-fieldcol">
                            <span class="se-lbl">Farbe</span>
                            <button type="button" class="se-color-btn" @onclick="() => _colorOpen = !_colorOpen">
                                <span class="se-color-chip" style="background:@n.Color"></span> auswählen
                            </button>
                            @if (_colorOpen)
                            {
                                <div class="se-color-pop">
                                    @foreach (var c in Palette)
                                    {
                                        <button type="button" class="se-swatch @(string.Equals(n.Color, c, StringComparison.OrdinalIgnoreCase) ? "sel" : "")"
                                                style="background:@c" title="@c" @onclick="@(() => { n.Color = c; _colorOpen = false; })"></button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    </div>
                    <div class="se-col">

                    @if (n.Kind == NodeKind.Sound)
                    {
                        var song = CurrentSong(n);
                        <h3>Songs (@n.Songs.Count)</h3>
                        @if (n.Songs.Count > 1)
                        {
                            <div class="se-fieldcol">
                                <span class="se-lbl">Wiedergabe · Endlos-Loop bis Stopp</span>
                                <div class="se-src-tabs">
                                    <button type="button" class="@(!n.SongsRandom ? "active" : "")" @onclick="() => n.SongsRandom = false">🔁 Der Reihe nach</button>
                                    <button type="button" class="@(n.SongsRandom ? "active" : "")" @onclick="() => n.SongsRandom = true">🔀 Zufällig</button>
                                </div>
                            </div>
                        }
                        <div class="se-songlist">
                            @for (var i = 0; i < n.Songs.Count; i++)
                            {
                                var idx = i;
                                var sg = n.Songs[idx];
                                <div class="se-songrow @(sg == song ? "sel" : "")">
                                    <button type="button" class="se-songrow-main" @onclick="() => SelectSong(sg)">
                                        <span class="se-songrow-nr">@(idx + 1)</span>
                                        <span class="se-songrow-name">@SongEditLabel(sg)</span>
                                        <span class="se-songrow-cue">@Clock(sg.StartSec)@(sg.DurationSec is { } d ? " – " + Clock(d) : "")</span>
                                    </button>
                                    <button type="button" class="se-btn sm" title="hoch" @onclick="() => MoveSong(n, idx, -1)" disabled="@(idx == 0)">↑</button>
                                    <button type="button" class="se-btn sm" title="runter" @onclick="() => MoveSong(n, idx, 1)" disabled="@(idx == n.Songs.Count - 1)">↓</button>
                                    <button type="button" class="se-btn sm danger" title="entfernen" @onclick="() => RemoveSong(n, idx)" disabled="@(n.Songs.Count <= 1)">🗑</button>
                                </div>
                            }
                        </div>
                        <button type="button" class="se-btn sm" @onclick="() => AddSong(n)">+ Song hinzufügen</button>

                        <h4 class="se-songh">Song @(n.Songs.IndexOf(song) + 1) bearbeiten</h4>
                        <div class="se-src-tabs">
                            <button type="button" class="@(song.Kind == SoundKind.Local ? "active" : "")" @onclick="() => song.Kind = SoundKind.Local">🎵 Datei</button>
                            <button type="button" class="@(song.Kind == SoundKind.Spotify ? "active" : "")" @onclick="() => song.Kind = SoundKind.Spotify">🟢 Spotify</button>
                        </div>

                        @if (song.Kind == SoundKind.Local)
                        {
                            <div class="se-full">
                                <span class="se-lbl">Aktuelle Datei</span>
                                <div class="se-current">@FriendlyName(song.Ref)</div>
                            </div>
                            <label class="se-drop @(_uploading ? "busy" : "")">
                                <InputFile OnChange="e => OnUploadAsync(e, song)" accept="audio/*" />
                                <span>@(_uploading ? "Lädt hoch …" : "Datei ziehen oder klicken – ersetzt sofort")</span>
                            </label>
                        }
                        else
                        {
                            @if (Search.Configured)
                            {
                                <div class="se-search">
                                    <input class="se-search-in" @bind="_query" @bind:event="oninput" @onkeyup="OnSearchKey" placeholder="Song auf Spotify suchen …" />
                                    <button class="se-btn primary" @onclick="DoSearch">🔍 Suchen</button>
                                </div>
                            }
                            <label class="se-full">Spotify-Link, URL oder ID einfügen
                                <input value="@song.Ref" @onchange="e => ApplyPaste(e, song)"
                                       placeholder="https://open.spotify.com/… · spotify:track:… · oder nur die ID" />
                            </label>
                            @if (!Search.Configured)
                            {
                                <p class="se-muted">Suche inaktiv (Client-ID + Secret hinterlegen). Link einfügen geht trotzdem.</p>
                            }

                            @if (_trackInfo is { } ti && ShowSpotifyLink.Parse(song.Ref)?.Kind == "track")
                            {
                                <div class="se-trackcard">
                                    @if (!string.IsNullOrEmpty(ti.CoverUrl))
                                    {
                                        <img class="se-cover" src="@ti.CoverUrl" alt="" />
                                    }
                                    <div class="se-trackmeta">
                                        <div class="se-trackname">@ti.Name</div>
                                        <div class="se-trackartist">@ti.Artist</div>
                                        <div class="se-trackalbum">@ti.Album@(ti.DurationMs > 0 ? $" · {Mmss(ti.DurationMs / 1000)}" : "")</div>
                                    </div>
                                </div>
                            }
                            @if (_ctxInfo is { } ci)
                            {
                                <div class="se-trackcard">
                                    @if (!string.IsNullOrEmpty(ci.CoverUrl))
                                    {
                                        <img class="se-cover" src="@ci.CoverUrl" alt="" />
                                    }
                                    <div class="se-trackmeta">
                                        <div class="se-trackname">@(string.IsNullOrEmpty(ci.Name) ? ci.Kind : ci.Name)</div>
                                        <div class="se-trackartist">@(ci.Kind == "playlist" ? $"Playlist · {ci.TrackCount} Songs" : ci.Kind)@(string.IsNullOrEmpty(ci.Owner) ? "" : " · " + ci.Owner)</div>
                                    </div>
                                </div>
                            }

                            @if (IsContextRef(song.Ref))
                            {
                                <div class="se-fieldcol">
                                    <span class="se-lbl">Playlist-Reihenfolge</span>
                                    <div class="se-src-tabs">
                                        <button type="button" class="@(!song.Shuffle ? "active" : "")" @onclick="() => song.Shuffle = false">➡ Der Reihe nach</button>
                                        <button type="button" class="@(song.Shuffle ? "active" : "")" @onclick="() => song.Shuffle = true">🔀 Zufällig</button>
                                    </div>
                                </div>
                            }
                        }

                        <div class="se-timeline">
                            <div class="se-tl-track" title="Klicken/ziehen zum Einspringen">
                                <div class="se-tl-sel" style="left:@Pct(song.StartSec, TrackMax)%; width:@Pct(song.DurationSec ?? 0, TrackMax)%;"></div>
                                <div class="se-tl-mark start" style="left:@Pct(song.StartSec, TrackMax)%;" title="Cue"></div>
                                @if (song.DurationSec is { } dsec)
                                {
                                    <div class="se-tl-mark end" style="left:@Pct(song.StartSec + dsec, TrackMax)%;" title="Ende"></div>
                                }
                                <div class="se-tl-head @(_playing ? "on" : "")" style="left:@Pct(_playPos, TrackMax)%;"></div>
                            </div>
                            <div class="se-tl-times"><span>@Clock(_playPos)</span><span>@Mmss(TrackMax)</span></div>
                        </div>

                        <div class="se-grid">
                            <label>Cue-Start (m:ss.mmm)
                                <input value="@Clock(song.StartSec)" @onchange="e => SetCueText(e, song)" placeholder="0:00.000" />
                            </label>
                            <label>Länge (leer = ganzer Song)
                                <input value="@(song.DurationSec is { } dv ? Clock(dv) : "")" @onchange="e => SetLenText(e, song)" placeholder="ganzer Song" />
                            </label>
                        </div>

                        <div class="se-testrow">
                            <button class="se-btn primary" @onclick="() => PlayFullAsync(song)">▶ Abspielen</button>
                            <button class="se-btn" @onclick="() => PlayFromCueAsync(song)">▶ Abschnitt</button>
                            <button class="se-btn" @onclick="StopTest">⏹ Stopp</button>
                        </div>
                        <div class="se-testrow">
                            <button class="se-btn" @onclick="() => SetCueFromPos(song)">⤓ Position als Cue</button>
                            <button class="se-btn" @onclick="() => SetEndFromPos(song)">⤒ Position als Ende</button>
                        </div>
                        @if (_uploadError is { Length: > 0 })
                        {
                            <p class="se-err">@_uploadError</p>
                        }
                    }
                    else
                    {
                        <p class="se-muted">Ordner: mit „öffnen" (Raster) oder links reingehen, dann darin Kacheln anlegen.</p>
                    }
                    </div>
                    </div>
                    @if (_selectedIsNew && !IsTileValid(n))
                    {
                        <p class="se-warn">Bitte einen Song/eine Datei wählen. „Abbrechen" verwirft die neue Kachel.</p>
                    }
                    <div class="se-editfoot">
                        @if (_selectedIsNew)
                        {
                            <button class="se-btn sm" @onclick="CancelTile">Abbrechen</button>
                        }
                        <button class="se-btn sm danger se-editdel" @onclick="DeleteSelected">🗑 Kachel löschen</button>
                    </div>
                    </div>
                    </div>
                }

                @if (_askDiscard)
                {
                    <div class="se-choosewrap" @onclick="KeepEditing">
                        <div class="se-choosecard" @onclick:stopPropagation="true">
                            <h3>Kein Song gewählt</h3>
                            <p class="se-muted" style="margin:0 0 14px">Diese Kachel hat noch keinen Song/keine Datei.</p>
                            <div class="se-choosebtns">
                                <button class="se-btn" @onclick="DiscardTile">Verwerfen</button>
                                <button class="se-btn primary" @onclick="KeepEditing">Weiterbearbeiten</button>
                            </div>
                        </div>
                    </div>
                }

                @if (_searchOpen)
                {
                    <div class="se-searchwrap" @onclick="CloseSearch">
                        <div class="se-searchcard" @onclick:stopPropagation="true">
                            <div class="se-searchhead">
                                <input class="se-search-in" @bind="_query" @bind:event="oninput" @onkeyup="OnSearchKey" placeholder="Song auf Spotify suchen …" />
                                <button class="se-btn primary" @onclick="DoSearch">🔍 Suchen</button>
                                <button class="se-editclose" @onclick="CloseSearch">✕</button>
                            </div>
                            @if (_searching)
                            {
                                <p class="se-muted">Suche …</p>
                            }
                            @if (_searchError is { Length: > 0 })
                            {
                                <p class="se-err">@_searchError</p>
                            }
                            <div class="se-reslist">
                                @foreach (var t in _results)
                                {
                                    <div class="se-resrow">
                                        <img class="se-cover sm" src="@t.CoverUrl" alt="" />
                                        <div class="se-resmeta">
                                            <div class="se-trackname">@t.Name</div>
                                            <div class="se-trackartist">@t.Artist</div>
                                            <div class="se-trackalbum">@t.Album@(t.DurationMs > 0 ? $" · {Mmss(t.DurationMs / 1000)}" : "")</div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(t.PreviewUrl))
                                        {
                                            <button class="se-btn sm" title="Vorschau anhören" @onclick="() => PreviewAsync(t)">▶</button>
                                        }
                                        else
                                        {
                                            <span class="se-nopreview" title="Keine Vorschau verfügbar">–</span>
                                        }
                                        <button class="se-btn sm primary" @onclick="() => PickTrack(t)">Wählen</button>
                                    </div>
                                }
                                @if (!_searching && _results.Count == 0 && _searchError.Length == 0)
                                {
                                    <p class="se-muted">Keine Treffer.</p>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (_chooseKind)
                {
                    <div class="se-choosewrap" @onclick="CancelNewTile">
                        <div class="se-choosecard" @onclick:stopPropagation="true">
                            <h3>Neue Kachel</h3>
                            <div class="se-choosebtns">
                                <button class="se-btn" @onclick="() => CommitNewTile(NodeKind.Folder)">📁 Ordner</button>
                                <button class="se-btn primary" @onclick="() => CommitNewTile(NodeKind.Sound)">🔊 Song</button>
                            </div>
                            <button class="se-btn sm se-choosecancel" @onclick="CancelNewTile">Abbrechen</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<EditProfile> _profiles = new();
    private EditProfile? _profile;
    private EditButton? _selected;
    private string _status = "";
    private bool _showIo;
    private string _ioText = "";
    private string _ioError = "";
    private bool _emojiOpen;
    private bool _uploading;
    private string _uploadError = "";
    private readonly List<EditButton> _levelStack = new();
    private DotNetObjectReference<ShowAdminEditor>? _gridRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _gridRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("showGridInit", _gridRef);
    }

    public void Dispose() => _gridRef?.Dispose();

    [JSInvokable]
    public Task SetRect(string id, int x, int y, int w, int h)
    {
        var level = CurrentLevel();
        var n = level.FirstOrDefault(b => b.Id == id);
        if (n is null) return Task.CompletedTask;
        w = Math.Clamp(w, 1, ShowLayout.Cols);
        h = Math.Clamp(h, 1, ShowLayout.Rows);
        x = Math.Clamp(x, 0, ShowLayout.Cols - w);
        y = Math.Clamp(y, 0, ShowLayout.Rows - h);
        if (Overlaps(level, n, x, y, w, h)) return Task.CompletedTask;
        if (n.X == x && n.Y == y && n.W == w && n.H == h) return Task.CompletedTask;
        n.X = x; n.Y = y; n.W = w; n.H = h;
        return InvokeAsync(StateHasChanged);
    }

    private static bool Overlaps(List<EditButton> level, EditButton self, int x, int y, int w, int h)
    {
        foreach (var o in level)
        {
            if (o == self) continue;
            int ox = Math.Max(0, o.X), oy = Math.Max(0, o.Y);
            int ow = o.W <= 0 ? 3 : o.W, oh = o.H <= 0 ? 2 : o.H;
            if (x < ox + ow && x + w > ox && y < oy + oh && y + h > oy) return true;
        }
        return false;
    }

