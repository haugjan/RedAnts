    private List<string> CollectLocalRefs()
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        void Walk(List<EditButton> nodes)
        {
            foreach (var n in nodes)
            {
                foreach (var s in n.Songs)
                    if (s.Kind == SoundKind.Local && s.Ref.StartsWith("sounds/")) set.Add(s.Ref);
                if (n.Children.Count > 0) Walk(n.Children);
            }
        }
        foreach (var pr in _profiles) Walk(pr.Root);
        return set.ToList();
    }

    private static string ContentTypeFor(string path)
    {
        var ext = Path.GetExtension(path).ToLowerInvariant();
        return ext switch
        {
            ".mp3" => "audio/mpeg",
            ".wav" => "audio/wav",
            ".ogg" => "audio/ogg",
            ".m4a" or ".aac" => "audio/mp4",
            ".flac" => "audio/flac",
            _ => "application/octet-stream",
        };
    }

    private async Task ExportBundleAsync()
    {
        _ioBusy = true; _ioError = ""; _ioStatus = "";
        try
        {
            var refs = CollectLocalRefs();
            var missing = 0;
            var ms = new MemoryStream();
            using (var zip = new ZipArchive(ms, ZipArchiveMode.Create, true))
            {
                var json = JsonSerializer.Serialize(_profiles.Select(p => p.ToModel()).ToList(), ShowJson.Options);
                var je = zip.CreateEntry("profiles.json");
                await using (var w = new StreamWriter(je.Open())) { await w.WriteAsync(json); }

                foreach (var r in refs)
                {
                    var bytes = await Uploader.DownloadAsync(r);
                    if (bytes is null) { missing++; continue; }
                    var e = zip.CreateEntry(r);
                    await using var s = e.Open();
                    await s.WriteAsync(bytes);
                }
            }
            ms.Position = 0;
            using var streamRef = new DotNetStreamReference(ms);
            await JS.InvokeVoidAsync("showDownloadBytes", "soundboard-bundle.zip", streamRef);
            _ioStatus = $"Exportiert: {refs.Count - missing} Datei(en)" + (missing > 0 ? $", {missing} fehlten im Blob" : "") + ".";
        }
        catch (Exception ex) { _ioError = "Export fehlgeschlagen: " + ex.Message; }
        finally { _ioBusy = false; }
    }

    private async Task ImportBundleAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _ioBusy = true; _ioError = ""; _ioStatus = "";
        try
        {
            using var buffer = new MemoryStream();
            await file.OpenReadStream(200L * 1024 * 1024).CopyToAsync(buffer);
            buffer.Position = 0;
            using var zip = new ZipArchive(buffer, ZipArchiveMode.Read);

            var jsonEntry = zip.GetEntry("profiles.json");
            if (jsonEntry is null) { _ioError = "Kein profiles.json im ZIP gefunden."; return; }

            var uploaded = 0;
            foreach (var entry in zip.Entries)
            {
                if (!entry.FullName.StartsWith("sounds/") || entry.FullName.EndsWith("/")) continue;
                await using var es = entry.Open();
                await Uploader.UploadAtPathAsync(entry.FullName, es, ContentTypeFor(entry.FullName));
                uploaded++;
            }

            string text;
            using (var r = new StreamReader(jsonEntry.Open())) text = await r.ReadToEndAsync();
            var list = JsonSerializer.Deserialize<List<ShowProfile>>(text, ShowJson.Options);
            if (list is null || list.Count == 0) { _ioError = "profiles.json im ZIP ist ungültig."; return; }

            _profiles = list.Select(EditProfile.From).ToList();
            foreach (var p in _profiles) p.Root.RemoveAll(b => b.Panic);
            _profile = _profiles.First();
            _selected = null;
            _ioStatus = $"Bundle importiert: {uploaded} Datei(en) hochgeladen. Jetzt 💾 Speichern klicken.";
        }
        catch (Exception ex) { _ioError = "Import fehlgeschlagen: " + ex.Message; }
        finally { _ioBusy = false; }
    }

    private RenderFragment RenderNode(EditButton node, List<EditButton> siblings) =>
    @<div class="tn">
        <div class="tn-row @(node == _selected ? "sel" : "")">
            <button class="tn-label" @onclick="() => Select(node)">
                <span class="tn-ico">@(string.IsNullOrEmpty(node.Icon) ? (node.Kind == NodeKind.Folder ? "📁" : "🔊") : node.Icon)</span>
                <span>@node.Label</span>
                <span class="tn-kind">@(node.Kind == NodeKind.Folder ? "Ordner" : node.Songs.Count > 1 ? $"{node.Songs.Count} Songs" : "")</span>
            </button>
            <span class="tn-ctrl">
                <button title="Nach oben" @onclick="() => Move(node, siblings, -1)">↑</button>
                <button title="Nach unten" @onclick="() => Move(node, siblings, 1)">↓</button>
                <button title="Löschen" class="danger" @onclick="() => Delete(node, siblings)">🗑</button>
            </span>
        </div>
        @if (node.Kind == NodeKind.Folder)
        {
            <div class="tn-children">
                @foreach (var c in node.Children)
                {
                    @RenderNode(c, node.Children)
                }
                <div class="tn-add">
                    <button @onclick="() => AddChild(node.Children, NodeKind.Sound)">+ Song</button>
                    <button @onclick="() => AddChild(node.Children, NodeKind.Folder)">+ Ordner</button>
                </div>
            </div>
        }
    </div>;
}

