    private static string Mmss(int s) => $"{s / 60}:{s % 60:00}";

    private static string Clock(double sec)
    {
        if (sec < 0) sec = 0;
        var total = (int)Math.Round(sec * 1000);
        var ms = total % 1000; var s = total / 1000 % 60; var m = total / 60000;
        return $"{m}:{s:00}.{ms:000}";
    }

    private static double? ParseClock(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return null;
        var t = input.Trim().Replace(',', '.');
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var num = System.Globalization.NumberStyles.Float;
        if (t.Contains(':'))
        {
            var parts = t.Split(':', 2);
            if (int.TryParse(parts[0], num, inv, out var mm) && double.TryParse(parts[1], num, inv, out var ss))
                return mm * 60 + ss;
            return null;
        }
        return double.TryParse(t, num, inv, out var v) ? v : null;
    }

