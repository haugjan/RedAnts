    private bool _showCreate;
    private bool _creating;
    private TicketCategory _newCategory = TicketCategory.Adult;
    private decimal _newPrice;
    private PaymentSource _newPaymentSource = PaymentSource.Sponsoring;
    private BuyerType _newBuyerType = BuyerType.Private;
    private string _newFirstName = "";
    private string _newLastName = "";
    private string _newCompany = "";
    private string _newEmail = "";
    private string? _createError;

    private void OnNewPriceChanged()
    {
        _newPrice = decimal.Round(_newPrice, 2);
        var choices = PaymentSourceExtensions.AdminChoicesForPrice(_newPrice);
        if (!choices.Contains(_newPaymentSource)) _newPaymentSource = choices[0];
    }

    private static PaymentSource ClampPaymentSource(PaymentSource source, decimal price)
    {
        var choices = PaymentSourceExtensions.AdminChoicesForPrice(price);
        return choices.Contains(source) ? source : choices[0];
    }

    private void OpenCreate()
    {
        _newCategory = TicketCategory.Adult;
        _newPrice = 0m;
        _newPaymentSource = PaymentSourceExtensions.AdminChoicesForPrice(0m)[0];
        _newBuyerType = BuyerType.Private;
        _newFirstName = _newLastName = _newCompany = _newEmail = "";
        _createError = null;
        _showCreate = true;
    }
    private void CloseCreate() { _showCreate = false; _createError = null; }

    private async Task CreatePassAsync()
    {
        if (_creating) return;
        if (SelectedSeasonId <= 0) { _createError = "Es ist keine Saison gewählt."; return; }
        if (_newPrice < 0) { _createError = "Der Preis darf nicht negativ sein."; return; }
        _creating = true;
        _createError = null;
        try
        {
            var buyer = Buyer.Create(_newBuyerType, _newFirstName, _newLastName, _newCompany);
            var paymentSource = ClampPaymentSource(_newPaymentSource, _newPrice);
            var order = await OrderFactory.CreateAsync(buyer, Identity.Email,
                [new AdminOrderLine(OrderItemKind.SeasonPass, SelectedSeasonId, _newCategory, _newCategory.DisplayName(), 1, _newPrice)],
                Identity.Name, paymentSource);
            await Passes.SaveAsync(SeasonPass.Create(SelectedSeasonId, _newCategory, _newPrice, order.Id,
                buyer, Identity.Name, Identity.Email,
                email: string.IsNullOrWhiteSpace(_newEmail) ? null : _newEmail.Trim()));
            _showCreate = false;
            await ReloadPassesAsync();
        }
        catch (DomainException ex) { _createError = ex.Message; }
        finally { _creating = false; }
    }

    private SeasonPassListItem? _editing;
    private TicketCategory _editCategory;
    private decimal _editPrice;
    private TicketStatus _editStatus;
    private BuyerType _editBuyerType = BuyerType.Private;
    private string _editFirstName = "";
    private string _editLastName = "";
    private string _editCompany = "";
    private string _editEmail = "";
    private bool _saving;
    private string? _editError;

    private async Task OpenEdit(SeasonPassListItem pass)
    {
        _editing = pass;
        _editCategory = pass.Category;
        _editPrice = decimal.Round(pass.Price, 2);
        _editStatus = pass.Status;
        _editFirstName = _editLastName = _editCompany = "";
        _editEmail = pass.Email ?? "";
        _editBuyerType = BuyerType.Private;

        var current = await Passes.GetByUuidAsync(pass.Uuid);
        if (current?.Buyer is { } b)
        {
            _editBuyerType = b.Type;
            _editFirstName = b.FirstName ?? "";
            _editLastName = b.LastName ?? "";
            _editCompany = b.Company ?? "";
        }
        _editError = null;
    }

    private void CancelEdit() { _editing = null; _editError = null; }

    private async Task SaveEdit()
    {
        if (_editing is null || _saving) return;
        _saving = true;
        _editError = null;
        try
        {
            var pass = await Passes.GetByUuidAsync(_editing.Uuid);
            if (pass is null) { _editError = "Diese Saisonkarte wurde nicht gefunden."; return; }

            pass.Edit(_editCategory, _editPrice, _editStatus);
            pass.SetBuyer(Buyer.Create(_editBuyerType, _editFirstName, _editLastName, _editCompany));
            pass.SetEmail(_editEmail);
            await Passes.SaveAsync(pass);

            _editing = null;
            await ReloadPassesAsync();
        }
        catch (DomainException ex) { _editError = ex.Message; }
        finally { _saving = false; }
    }

    private SeasonPassListItem? _mailFor;
    private string _mailSubject = "";
    private string _mailBody = "";
    private bool _mailSending;
    private bool _mailSent;
    private string? _mailError;

    private void OpenMail(SeasonPassListItem p)
    {
        _mailFor = p;
        _mailSubject = Mailer.DefaultSubject;
        _mailBody = Mailer.DefaultBody;
        _mailSent = false;
        _mailError = null;
    }

    private void CloseMail() { if (!_mailSending) { _mailFor = null; _mailError = null; _mailSent = false; } }

    private async Task SendMail()
    {
        if (_mailFor is null || _mailSending || _mailSent) return;
        _mailSending = true;
        _mailError = null;
        _mailSent = false;
        try
        {
            var result = await SendToAsync(_mailFor, _mailSubject, _mailBody);
            if (!result.Success)
            {
                _mailError = result.Error ?? "E-Mail konnte nicht versendet werden.";
                return;
            }
            _mailSent = true;
            _mailSending = false;
            StateHasChanged();
            await Task.Delay(1400);
            _mailFor = null;
            _mailSent = false;
        }
        catch (Exception ex) { _mailError = ex.Message; }
        finally { _mailSending = false; }
    }

    private async Task<EmailSendResult> SendToAsync(SeasonPassListItem item, string subject, string body)
    {
        var pass = await Passes.GetByUuidAsync(item.Uuid);
        if (pass is null) return new EmailSendResult(false, "Diese Saisonkarte wurde nicht gefunden.");
        if (string.IsNullOrWhiteSpace(pass.Email)) pass.SetEmail(item.Email);
        return await Mailer.SendAsync(pass, item.CategoryName, subject, body);
    }

    private bool _showBulk;
    private string _bulkBundle = "";
    private string _bulkSubject = "";
    private string _bulkBody = "";
    private bool _bulkSending;
    private string? _bulkError;
    private BulkResult? _bulkResult;

    private sealed record BulkResult(int Enqueued, int Failed, IReadOnlyList<SeasonPassListItem> NoEmail);

    private List<SeasonPassListItem> BundleCards() =>
        _passes.Where(p => p.Status != TicketStatus.Cancelled && p.Reference == _bulkBundle).ToList();

    private int BundleWithEmail => BundleCards().Count(p => p.HasEmail);
    private int BundleWithoutEmail => BundleCards().Count(p => !p.HasEmail);

    private void OpenBulk()
    {
        _bulkBundle = Bundles().FirstOrDefault() ?? "";
        _bulkSubject = Mailer.DefaultSubject;
        _bulkBody = Mailer.DefaultBody;
        _bulkResult = null;
        _bulkError = null;
        _showBulk = true;
    }

    private void CloseBulk() { if (!_bulkSending) { _showBulk = false; _bulkError = null; _bulkResult = null; } }

    private async Task SendBulk()
    {
        if (_bulkSending || string.IsNullOrWhiteSpace(_bulkBundle)) return;
        _bulkSending = true;
        _bulkError = null;
        _bulkResult = null;
        try
        {
            var targets = BundleCards();
            var noEmail = targets.Where(p => !p.HasEmail).ToList();
            var enqueued = 0;
            var failed = 0;
            foreach (var p in targets.Where(p => p.HasEmail))
            {
                try
                {
                    var result = await SendToAsync(p, _bulkSubject, _bulkBody);
                    if (result.Success) enqueued++;
                    else failed++;
                }
                catch { failed++; }
            }
            _bulkResult = new BulkResult(enqueued, failed, noEmail);
        }
        catch (Exception ex) { _bulkError = ex.Message; }
        finally { _bulkSending = false; }
    }
