@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using RedAnts.Domain.Ticketing.Sales
@using RedAnts.Features.Ticketing.Email
@using RedAnts.Features.Ticketing.Ports
@inject ISeasonPassAdminReport Report
@inject ISeasonPasses Passes
@inject IAdminOrderFactory OrderFactory
@inject ISeasonPassMailer Mailer

<section class="ta-page">
    <h1 class="ta-page-title">Saisonkarten</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-toolbar">
            <div class="ta-toolbar-filters">
                <div class="ta-field">
                    <label class="ta-label" for="spSeasonSelect">Saison</label>
                    <select id="spSeasonSelect" class="ta-select" @bind="SelectedSeasonId" @bind:after="ReloadPassesAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="ta-toolbar-actions">
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_passes.Count == 0)" @onclick="OpenExport">
                    Export CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(SelectedSeasonId <= 0)" @onclick="OpenImport">
                    Import CSV
                </button>
                <button type="button" class="ta-btn ta-btn-ghost" disabled="@(_passes.Count == 0)" @onclick="OpenBulk"
                        title="Alle Karten eines Bundles per E-Mail versenden">Karten versenden</button>
                <button type="button" class="ta-btn ta-btn-primary" disabled="@(SelectedSeasonId <= 0)" @onclick="OpenCreate">
                    Saisonkarte erstellen
                </button>
            </div>
        </div>

        @if (_passes.Count == 0)
        {
            <div class="ta-placeholder">Für diese Saison sind keine Saisonkarten ausgestellt.</div>
        }
        else
        {
            <div class="ta-table-wrap">
                <table class="ta-table">
                    <thead>
                        <tr>
                            <th>Karten-Nr.</th>
                            <th class="ta-th-sort" @onclick='() => Sort("buyer")'>Käufer:in <span class="ta-sort-ind">@Ind("buyer")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("created")'>Erstellt <span class="ta-sort-ind">@Ind("created")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("bundle")'>Bundle <span class="ta-sort-ind">@Ind("bundle")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("category")'>Kategorie <span class="ta-sort-ind">@Ind("category")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("price")'>Preis <span class="ta-sort-ind">@Ind("price")</span></th>
                            <th class="ta-th-sort" @onclick='() => Sort("status")'>Status <span class="ta-sort-ind">@Ind("status")</span></th>
                            <th class="ta-num ta-th-sort" @onclick='() => Sort("visits")'>Event&shy;besuche <span class="ta-sort-ind">@Ind("visits")</span></th>
                            <th>Zahlung</th>
                            <th>Bestell-Nr.</th>
                            <th class="ta-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Sorted())
                        {
                            <tr>
                                <td>
                                    <span class="ta-ticketno">@AdminFormat.TicketNo(p.Uuid)</span>
                                    <a class="ta-qr-link" href="/ticket/for/@p.Uuid" target="_blank" rel="noopener" title="Online-Ticket" aria-label="Online-Ticket">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M17 14h.01M20 14v3M14 17h.01M17 20h3M20 20h.01"/></svg>
                                    </a>
                                </td>
                                <td class="ta-cell-name">
                                    @if (p.BuyerName is not null)
                                    {
                                        @p.BuyerName
                                        @if (p.BuyerType is { } bt) { <span class="ta-badge ta-badge-buyer">@bt.DisplayName()</span> }
                                    }
                                    else { <span class="ta-muted">—</span> }
                                    @if (p.HasEmail)
                                    {
                                        <div class="ta-addr-sub">@p.Email</div>
                                    }
                                    else
                                    {
                                        <span class="ta-noemail" title="Keine E-Mail hinterlegt">ohne E-Mail</span>
                                    }
                                </td>
                                <td title="@AdminFormat.CreatedTooltip(p.CreatedAt, p.CreatedByName, null, OnlineMarker(p))">@AdminFormat.CreatedShort(p.CreatedAt, p.CreatedByName, OnlineMarker(p))</td>
                                <td>@(string.IsNullOrEmpty(p.Reference) ? "–" : p.Reference)</td>
                                <td>
                                    <InlineSelectEdit TValue="TicketCategory" Value="p.Category" FieldLabel="Kategorie"
                                                      Options="CategoryOptions" Label="@(c => c.DisplayName())"
                                                      Save="@(v => SaveCategoryAsync(p, v))" />
                                </td>
                                <td class="ta-num">CHF @p.Price.ToString("N2")</td>
                                <td>
                                    <InlineSelectEdit TValue="TicketStatus" Value="p.Status" FieldLabel="Status"
                                                      Options="StatusOptions" Label="@StatusLabel"
                                                      Save="@(v => SaveStatusAsync(p, v))">
                                        <Display Context="st">
                                            <span class="ta-badge ta-badge-@st.ToString().ToLowerInvariant()">@StatusLabel(st)</span>
                                        </Display>
                                    </InlineSelectEdit>
                                </td>
                                <td class="ta-num">
                                    @if (p.EventVisits > 0)
                                    {
                                        <button type="button" class="ta-visits-link" @onclick="() => OpenVisits(p)">@p.EventVisits</button>
                                    }
                                    else
                                    {
                                        <span class="ta-muted">0</span>
                                    }
                                </td>
                                <td>@(p.PaymentState ?? "–")</td>
                                <td>@(p.OrderNumber ?? "–")</td>
                                <td class="ta-col-actions">
                                    <button type="button" class="ta-icon-btn" title="@(p.HasEmail ? "E-Mail senden" : "Keine E-Mail hinterlegt")" disabled="@(!p.HasEmail)" @onclick="() => OpenMail(p)">✉</button>
                                    <button type="button" class="ta-icon-btn" title="Bearbeiten" @onclick="() => OpenEdit(p)">✎</button>
                                    @if (Identity.IsAdmin)
                                    {
                                        <button type="button" class="ta-icon-btn ta-icon-btn-danger" title="Löschen" @onclick="() => _deleteTarget = p">🗑</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="ta-summary">@_passes.Count Saisonkarte@(_passes.Count == 1 ? "" : "n") · Total CHF @_passes.Sum(p => p.Price).ToString("N2")</p>
        }
    }
</section>

<style>
    .ta-noemail { display: inline-block; margin-left: 0.4rem; padding: 0.1rem 0.4rem; border-radius: 3px; background: #fff8e1; color: #7a5c00; border: 1px solid #e0b400; font-size: 0.72rem; font-weight: 700; white-space: nowrap; }
    .ta-textarea { min-height: 9rem; resize: vertical; font-family: inherit; line-height: 1.5; }
</style>

@if (_showCreate)
{
    <div class="ta-overlay" @onmousedown="CloseCreate">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Saisonkarte erstellen</h2>

            <div class="ta-field">
                <label class="ta-label" for="newSpBuyerType">Käufer:in</label>
                <select id="newSpBuyerType" class="ta-select" @bind="_newBuyerType">
                    <option value="@BuyerType.Private">Privatperson</option>
                    <option value="@BuyerType.Company">Firma</option>
                </select>
            </div>
            @if (_newBuyerType == BuyerType.Company)
            {
                <div class="ta-field">
                    <label class="ta-label" for="newSpCompany">Firmenname</label>
                    <input id="newSpCompany" class="ta-input" @bind="_newCompany" />
                </div>
            }
            else
            {
                <div class="ta-field">
                    <label class="ta-label" for="newSpFirstName">Vorname</label>
                    <input id="newSpFirstName" class="ta-input" @bind="_newFirstName" />
                </div>
                <div class="ta-field">
                    <label class="ta-label" for="newSpLastName">Nachname</label>
                    <input id="newSpLastName" class="ta-input" @bind="_newLastName" />
                </div>
            }

            <div class="ta-field">
                <label class="ta-label" for="newSpCategory">Kategorie</label>
                <select id="newSpCategory" class="ta-select" @bind="_newCategory">
                    @foreach (var c in Enum.GetValues<TicketCategory>())
                    {
                        <option value="@c">@c.DisplayName()</option>
                    }
                </select>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="newSpPrice">Preis (CHF)</label>
                <input id="newSpPrice" type="number" step="0.01" min="0" class="ta-input" @bind="_newPrice" @bind:after="OnNewPriceChanged" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newSpPaymentSource">Zahlart</label>
                <select id="newSpPaymentSource" class="ta-select" @bind="_newPaymentSource">
                    @foreach (var ps in PaymentSourceExtensions.AdminChoicesForPrice(_newPrice))
                    {
                        <option value="@ps">@ps.DisplayName()</option>
                    }
                </select>
            </div>
            <div class="ta-field">
                <label class="ta-label" for="newSpEmail">E-Mail (optional)</label>
                <input id="newSpEmail" class="ta-input" type="email" maxlength="200" placeholder="für den Kartenversand" @bind="_newEmail" />
            </div>

            @if (_createError is not null)
            {
                <p class="ta-modal-error">@_createError</p>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseCreate" disabled="@_creating">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="CreatePassAsync" disabled="@_creating">
                    @(_creating ? "Erstellt …" : "Erstellen")
                </button>
            </div>
        </div>
    </div>
}

@if (_editing is not null)
{
    <div class="ta-overlay" @onmousedown="CancelEdit">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Saisonkarte bearbeiten</h2>
            <p class="ta-modal-sub">Karten-Nr. @AdminFormat.TicketNo(_editing.Uuid)</p>

            <div class="ta-field">
                <label class="ta-label" for="editBuyerType">Käufer:in</label>
                <select id="editBuyerType" class="ta-select" @bind="_editBuyerType">
                    <option value="@BuyerType.Private">Privatperson</option>
                    <option value="@BuyerType.Company">Firma</option>
                </select>
            </div>
            @if (_editBuyerType == BuyerType.Company)
            {
                <div class="ta-field">
                    <label class="ta-label" for="editCompany">Firmenname</label>
                    <input id="editCompany" class="ta-input" @bind="_editCompany" />
                </div>
            }
            else
            {
                <div class="ta-field">
                    <label class="ta-label" for="editFirstName">Vorname</label>
                    <input id="editFirstName" class="ta-input" @bind="_editFirstName" />
                </div>
                <div class="ta-field">
                    <label class="ta-label" for="editLastName">Nachname</label>
                    <input id="editLastName" class="ta-input" @bind="_editLastName" />
                </div>
            }

            <div class="ta-field">
                <label class="ta-label" for="editCategory">Kategorie</label>
                <select id="editCategory" class="ta-select" @bind="_editCategory">
                    @foreach (var c in Enum.GetValues<TicketCategory>())
                    {
                        <option value="@c">@c.DisplayName()</option>
                    }
                </select>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="editPrice">Preis (CHF)</label>
                <input id="editPrice" type="number" step="0.01" min="0" class="ta-input" @bind="_editPrice" @bind:after="() => _editPrice = decimal.Round(_editPrice, 2)" />
            </div>

            <div class="ta-field">
                <label class="ta-label" for="editStatus">Status</label>
                <select id="editStatus" class="ta-select" @bind="_editStatus">
                    @foreach (var st in Enum.GetValues<TicketStatus>())
                    {
                        <option value="@st">@StatusLabel(st)</option>
                    }
                </select>
            </div>

            <div class="ta-field">
                <label class="ta-label" for="editEmail">E-Mail</label>
                <input id="editEmail" class="ta-input" type="email" maxlength="200" @bind="_editEmail" />
            </div>

            @if (_editError is not null)
            {
                <p class="ta-modal-error">@_editError</p>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CancelEdit" disabled="@_saving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SaveEdit" disabled="@_saving">
                    @(_saving ? "Speichert …" : "Speichern")
                </button>
            </div>
        </div>
    </div>
}

@if (_visitsPass is not null)
{
    <VisitsOverlay Uuid="_visitsPass.Uuid" Title="@(_visitsPass.BuyerName ?? AdminFormat.TicketNo(_visitsPass.Uuid))" OnClose="CloseVisits" />
}

@if (_deleteTarget is not null)
{
    <ConfirmDialog Title="Saisonkarte löschen"
                   Message="@($"Saisonkarte {AdminFormat.TicketNo(_deleteTarget.Uuid)} endgültig löschen? Das kann nicht rückgängig gemacht werden.")"
                   ConfirmLabel="Löschen" Danger="true" Busy="_deleteBusy" Error="@_deleteError"
                   OnConfirm="DeleteConfirmedAsync" OnCancel="CancelDelete" />
}

@if (_showImport)
{
    <div class="ta-overlay" @onmousedown="CloseImport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Saisonkarten importieren</h2>

            <div class="ta-field">
                <label class="ta-label">Saison</label>
                <div class="ta-readonly">@SelectedSeasonName</div>
            </div>

            <div class="ta-field">
                <label class="ta-label">CSV-Datei</label>
                <InputFile OnChange="OnImportFileAsync" accept=".csv,text/csv" />
                <p class="ta-hint">
                    Spalten: Bundle, Kategorie, Firma, Vorname, Nachname, Strasse, PLZ, Ort, Land, E-Mail, Telefon.
                    Pflicht: Bundle und Käufername (Firma oder Vor- und Nachname); übrige Felder optional.
                    <a href="/admin/season-passes/example.csv" target="_blank" rel="noopener">Beispieldatei herunterladen</a>
                </p>
            </div>

            @if (_importFileName is not null)
            {
                <div class="ta-parse">
                    <strong>@_importFileName</strong>: @_importRows.Count Zeile@(_importRows.Count == 1 ? "" : "n") erkannt.
                    @if (_importWarnings.Count > 0)
                    {
                        <ul class="ta-warnings">
                            @foreach (var w in _importWarnings) { <li>@w</li> }
                        </ul>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_importError)) { <div class="ta-error">@_importError</div> }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseImport" disabled="@_importSaving">Abbrechen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="RunImportAsync" disabled="@(_importSaving || _importRows.Count == 0)">
                    @(_importSaving ? "Wird importiert …" : $"{_importRows.Count} Saisonkarten importieren")
                </button>
            </div>
        </div>
    </div>
}

@if (_showExport)
{
    <div class="ta-overlay" @onmousedown="CloseExport">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Saisonkarten exportieren</h2>

            <div class="ta-field">
                <label class="ta-label" for="expBundle">Bundle</label>
                <select id="expBundle" class="ta-select" @bind="_exportBundle">
                    <option value="">Alle Saisonkarten dieser Saison</option>
                    @foreach (var b in Bundles())
                    {
                        <option value="@b">@b</option>
                    }
                </select>
            </div>

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseExport">Abbrechen</button>
                <a class="ta-btn ta-btn-primary" href="@ExportUrl" target="_blank" rel="noopener" @onclick="CloseExport">Herunterladen</a>
            </div>
        </div>
    </div>
}

@if (_showBulk)
{
    <div class="ta-overlay" @onmousedown="CloseBulk">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Karten versenden</h2>

            @if (_bulkResult is not null)
            {
                <div class="ta-flash">@_bulkResult.Enqueued Karte@(_bulkResult.Enqueued == 1 ? "" : "n") eingereiht@(_bulkResult.Failed > 0 ? $", {_bulkResult.Failed} fehlgeschlagen" : "").</div>
                @if (_bulkResult.NoEmail.Count > 0)
                {
                    <p class="ta-hint">@_bulkResult.NoEmail.Count Karte@(_bulkResult.NoEmail.Count == 1 ? "" : "n") ohne E-Mail übersprungen:</p>
                    <ul class="ta-warnings">
                        @foreach (var p in _bulkResult.NoEmail)
                        {
                            <li>@(p.BuyerName ?? "(ohne Name)") · @AdminFormat.TicketNo(p.Uuid)</li>
                        }
                    </ul>
                }
                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="CloseBulk">Schliessen</button>
                </div>
            }
            else if (!Bundles().Any())
            {
                <p class="ta-muted-text">Für diese Saison sind keine Bundles vorhanden.</p>
                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseBulk">Schliessen</button>
                </div>
            }
            else
            {
                <div class="ta-field">
                    <label class="ta-label" for="bulkBundle">Bundle</label>
                    <select id="bulkBundle" class="ta-select" @bind="_bulkBundle">
                        @foreach (var b in Bundles())
                        {
                            <option value="@b">@b</option>
                        }
                    </select>
                </div>
                <p class="ta-hint">@BundleWithEmail Karte@(BundleWithEmail == 1 ? "" : "n") mit E-Mail werden versendet · @BundleWithoutEmail ohne E-Mail werden übersprungen.</p>

                <div class="ta-field">
                    <label class="ta-label" for="bulkSubject">Betreff</label>
                    <input id="bulkSubject" class="ta-input" type="text" maxlength="200" @bind="_bulkSubject" />
                </div>
                <div class="ta-field">
                    <label class="ta-label" for="bulkBody">Text</label>
                    <textarea id="bulkBody" class="ta-input ta-textarea" @bind="_bulkBody"></textarea>
                    <p class="ta-hint">Platzhalter: {Name}, {Vorname}, {Nachname}, {Saison}. Markdown wird unterstützt. QR-Code, Online-Karte und PDF-Link werden je Karte angehängt.</p>
                </div>

                @if (!string.IsNullOrEmpty(_bulkError))
                {
                    <div class="ta-modal-error">@_bulkError</div>
                }

                <div class="ta-modal-actions">
                    <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseBulk" disabled="@_bulkSending">Abbrechen</button>
                    <button type="button" class="ta-btn ta-btn-primary" @onclick="SendBulk" disabled="@(_bulkSending || BundleWithEmail == 0)">
                        @(_bulkSending ? "Sendet …" : $"{BundleWithEmail} Karten senden")
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_mailFor is not null)
{
    <div class="ta-overlay" @onmousedown="CloseMail">
        <div class="ta-modal" @onmousedown:stopPropagation="true">
            <h2 class="ta-modal-title">Saisonkarte senden</h2>
            <p class="ta-modal-sub">@(_mailFor.BuyerName ?? AdminFormat.TicketNo(_mailFor.Uuid)) · @_mailFor.Email</p>

            <div class="ta-field">
                <label class="ta-label" for="spMailSubject">Betreff</label>
                <input id="spMailSubject" class="ta-input" type="text" maxlength="200" @bind="_mailSubject" />
            </div>
            <div class="ta-field">
                <label class="ta-label" for="spMailBody">Text</label>
                <textarea id="spMailBody" class="ta-input ta-textarea" @bind="_mailBody"></textarea>
                <p class="ta-hint">Platzhalter: {Name}, {Vorname}, {Nachname}, {Saison}. Markdown wird unterstützt (**fett**, Listen mit -, [Links](https://…)). QR-Code, Online-Karte und PDF-Link werden automatisch angehängt.</p>
            </div>

            @if (_mailSent)
            {
                <div class="ta-flash">E-Mail wurde in den Versand gegeben.</div>
            }
            @if (!string.IsNullOrEmpty(_mailError))
            {
                <div class="ta-modal-error">@_mailError</div>
            }

            <div class="ta-modal-actions">
                <button type="button" class="ta-btn ta-btn-ghost" @onclick="CloseMail" disabled="@_mailSending">Schliessen</button>
                <button type="button" class="ta-btn ta-btn-primary" @onclick="SendMail" disabled="@(_mailSending || _mailSent)">
                    @(_mailSent ? "Gesendet ✓" : _mailSending ? "Sendet …" : "Senden")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string AdminUser { get; set; } = "";
    [CascadingParameter] public AdminIdentity Identity { get; set; } = new("admin", null);

    [Inject] private ISeasons Seasons { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;
    [Inject] private IAdminTicketDeletion Deletion { get; set; } = default!;

    private SeasonPassListItem? _deleteTarget;
    private bool _deleteBusy;
    private string? _deleteError;

    private void CancelDelete() { _deleteTarget = null; _deleteError = null; }

    private async Task DeleteConfirmedAsync()
    {
        if (_deleteTarget is null) return;
        _deleteBusy = true;
        _deleteError = null;
        try
        {
            await Deletion.DeleteSeasonPassAsync(_deleteTarget.Uuid);
            _deleteTarget = null;
            await ReloadPassesAsync();
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _deleteBusy = false; }
    }

    private bool _loading = true;
    private IReadOnlyList<Season> _seasons = [];
    private IReadOnlyList<SeasonPassListItem> _passes = [];

    public int SelectedSeasonId { get; set; }

    private string _sortCol = "buyer";
    private bool _sortAsc = true;

    protected override async Task OnInitializedAsync()
    {
        _seasons = (await Seasons.GetAllAsync()).OrderByDescending(s => s.StartDate).ToList();
        SelectedSeasonId = AdminState.SelectedSeasonId is int id && _seasons.Any(s => s.Id == id)
            ? id
            : CurrentSeason(_seasons)?.Id ?? _seasons.FirstOrDefault()?.Id ?? 0;
        await ReloadPassesAsync();
        _loading = false;
    }

    private async Task ReloadPassesAsync()
    {
        AdminState.SelectedSeasonId = SelectedSeasonId > 0 ? SelectedSeasonId : null;
        _passes = SelectedSeasonId > 0 ? await Report.GetBySeasonAsync(SelectedSeasonId) : [];
    }

    private void Sort(string col) { _sortAsc = _sortCol == col ? !_sortAsc : true; _sortCol = col; }
    private string Ind(string col) => _sortCol == col ? (_sortAsc ? "▲" : "▼") : "";
    private IEnumerable<SeasonPassListItem> Sorted()
    {
        IEnumerable<SeasonPassListItem> q = _sortCol switch
        {
            "category" => _passes.OrderBy(p => p.Category),
            "price" => _passes.OrderBy(p => p.Price),
            "status" => _passes.OrderBy(p => p.Status),
            "visits" => _passes.OrderBy(p => p.EventVisits),
            "created" => _passes.OrderBy(p => p.CreatedAt),
            "bundle" => _passes.OrderBy(p => p.Reference ?? "￿"),
            _ => _passes.OrderBy(p => p.BuyerName ?? "￿"),
        };
        return _sortAsc ? q : q.Reverse();
    }

    private static Season? CurrentSeason(IReadOnlyList<Season> seasons)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return seasons.FirstOrDefault(s => s.StartDate <= today && today <= s.EndDate)
            ?? seasons.Where(s => s.StartDate <= today).MaxBy(s => s.StartDate);
    }

