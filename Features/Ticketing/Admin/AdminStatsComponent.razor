@code {
    [Parameter] public string AdminUser { get; set; } = "";

    [Inject] private ISeasons Seasons { get; set; } = default!;
    [Inject] private IEvents Events { get; set; } = default!;
    [Inject] private TicketingAdminState AdminState { get; set; } = default!;

    private bool _loading = true;
    private string _mode = "season";
    private IReadOnlyList<Season> _seasons = [];
    private List<Event> _events = [];
    private SeasonVisitStats? _season;
    private EventVisitStats? _event;
    private SalesStats? _sales;
    private VisitorOverview? _visitors;

    public int SelectedSeasonId { get; set; }
    public int SelectedEventId { get; set; }
    public string VisitorRange { get; set; } = "d30";

    protected override async Task OnInitializedAsync()
    {
        _seasons = (await Seasons.GetAllAsync()).OrderByDescending(s => s.StartDate).ToList();
        SelectedSeasonId = AdminState.SelectedSeasonId is int id && _seasons.Any(s => s.Id == id)
            ? id
            : CurrentSeason(_seasons)?.Id ?? _seasons.FirstOrDefault()?.Id ?? 0;

        await LoadEventsAsync();
        await ReloadSeasonAsync();
        if (_mode == "event") await ReloadEventAsync();
        await ReloadVisitorsAsync();
        _loading = false;
    }

    private Season? CurrentSeasonObj => _seasons.FirstOrDefault(s => s.Id == SelectedSeasonId);

    private async Task SetModeAsync(string mode)
    {
        if (_mode == mode) return;
        _mode = mode;
        if (_mode == "event") await ReloadEventAsync();
    }

    private async Task OnSeasonChangedAsync()
    {
        AdminState.SelectedSeasonId = SelectedSeasonId > 0 ? SelectedSeasonId : null;
        await LoadEventsAsync();
        await ReloadSeasonAsync();
        if (_mode == "event") await ReloadEventAsync();
    }

    private async Task LoadEventsAsync()
    {
        _events = SelectedSeasonId > 0
            ? (await Events.GetBySeasonAsync(SelectedSeasonId)).OrderBy(e => e.Date).ThenBy(e => e.StartTime).ToList()
            : [];

        if (_events.All(e => e.Id != SelectedEventId))
        {
            SelectedEventId = _events.Any(e => e.Id == AdminState.SelectedEventId)
                ? AdminState.SelectedEventId!.Value
                : _events.FirstOrDefault()?.Id ?? 0;
        }
    }

    private async Task ReloadSeasonAsync()
    {
        var ids = _events.Select(e => e.Id).ToList();
        var seasonStart = CurrentSeasonObj?.StartDate.ToDateTime(TimeOnly.MinValue) ?? DateTime.UtcNow;
        _season = await SeasonReport.GetAsync(SelectedSeasonId, ids, seasonStart);
        _sales = await SalesReport.GetSeasonAsync(SelectedSeasonId, ids);
    }

    private async Task ReloadEventAsync()
    {
        AdminState.SelectedEventId = SelectedEventId > 0 ? SelectedEventId : null;
        var ev = _events.FirstOrDefault(e => e.Id == SelectedEventId);
        _event = ev is null ? null : await EventReport.GetAsync(SelectedEventId, ev.Date.ToDateTime(ev.StartTime));
    }

    private async Task ReloadVisitorsAsync()
    {
        var (fromUtc, toExclusiveUtc) = ResolveVisitorRange();
        _visitors = await VisitorReport.GetAsync(fromUtc, toExclusiveUtc);
    }

    private (DateTime FromUtc, DateTime ToExclusiveUtc) ResolveVisitorRange()
    {
        var todayUtc = DateTime.UtcNow.Date;
        var range = VisitorRange ?? "d30";
        if (range.StartsWith('s') && int.TryParse(range[1..], out var seasonId))
        {
            var season = _seasons.FirstOrDefault(s => s.Id == seasonId);
            if (season is not null)
                return (season.StartDate.ToDateTime(TimeOnly.MinValue), season.EndDate.AddDays(1).ToDateTime(TimeOnly.MinValue));
        }
        var days = range.StartsWith('d') && int.TryParse(range[1..], out var d) ? Math.Clamp(d, 1, 365) : 30;
        return (todayUtc.AddDays(-(days - 1)), todayUtc.AddDays(1));
    }

    private string BarTitle(VisitorBucket b) => _visitors?.Bucket == StatBucket.Month
        ? $"{b.Start:MMMM yyyy}: {b.Views} Aufrufe, {b.Visitors} Besucher"
        : $"{b.Start:dd.MM.yyyy}: {b.Views} Aufrufe, {b.Visitors} Besucher";

    private string AxisLabel(DateOnly d) => _visitors?.Bucket == StatBucket.Month ? d.ToString("MMM yy") : d.ToString("dd.MM.");

    private static Season? CurrentSeason(IReadOnlyList<Season> seasons)
    {
        var today = SwissTime.Today;
        return seasons.FirstOrDefault(s => s.StartDate <= today && today <= s.EndDate)
            ?? seasons.Where(s => s.StartDate <= today).MaxBy(s => s.StartDate);
    }

    private static string TypeLabel(int t) => ((TicketType)t).DisplayName();
    private static string FreeLabel(int t) => ((FreeEntryType)t).DisplayName();
    private static string CatLabel(int c) => ((TicketCategory)c).DisplayName();
    private static bool CatPromo(int c) => ((TicketCategory)c).IsPromo();
    private static string RateClass(int redeemed, int issued)
    {
        if (issued == 0) return "";
        var r = redeemed * 100.0 / issued;
        return r >= 80 ? "hi" : r >= 65 ? "mid" : "lo";
    }
    private static int Rate(int redeemed, int issued) => issued == 0 ? 0 : (int)Math.Round(redeemed * 100.0 / issued);
}
