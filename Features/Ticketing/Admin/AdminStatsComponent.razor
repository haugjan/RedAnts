@using RedAnts.Domain.Ticketing.Sales
@inject IVisitorStatsReport VisitorReport
@inject ISalesStatsReport SalesReport
@inject ISeasonVisitStatsReport SeasonReport
@inject IEventVisitStatsReport EventReport

<section class="ta-page">
    <h1 class="ta-page-title">Statistik</h1>

    @if (_loading)
    {
        <p class="ta-muted-text">Wird geladen …</p>
    }
    else if (_seasons.Count == 0)
    {
        <div class="ta-placeholder">Es sind noch keine Saisons erfasst.</div>
    }
    else
    {
        <div class="ta-stat-head">
            <div class="tvs-modes">
                <button type="button" class="tvs-mode @(_mode == "season" ? "active" : "")"
                        @onclick='() => SetModeAsync("season")'>Ganze Saison</button>
                <button type="button" class="tvs-mode @(_mode == "event" ? "active" : "")"
                        @onclick='() => SetModeAsync("event")'>Einzelner Anlass</button>
            </div>
            <div class="tvs-filters">
                <div class="ta-field">
                    <select class="ta-select" @bind="SelectedSeasonId" @bind:after="OnSeasonChangedAsync">
                        @foreach (var s in _seasons)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                @if (_mode == "event")
                {
                    <div class="ta-field">
                        <select class="ta-select" disabled="@(_events.Count == 0)"
                                @bind="SelectedEventId" @bind:after="ReloadEventAsync">
                            @if (_events.Count == 0)
                            {
                                <option value="0">— keine Anlässe —</option>
                            }
                            else
                            {
                                @foreach (var e in _events)
                                {
                                    <option value="@e.Id">@e.Date.ToString("dd.MM.yyyy") · @e.Name</option>
                                }
                            }
                        </select>
                    </div>
                }
            </div>
        </div>

        @if (_mode == "season" && _season is not null && _sales is not null)
        {
            var soldTotal = _sales.EventTicketCount + _sales.FlexCount + _sales.PassCount;
            var revenue = _sales.EventTicketRevenue + _sales.FlexRevenue + _sales.PassRevenue;
            var eventBundleIssued = _season.References.Where(r => r.Kind == "Spielticket").Sum(r => r.Issued);
            var giftedTotal = _season.Flex.Gifted + eventBundleIssued + _season.Members.Total;

            <div class="ta-stat-block">
                <h2 class="ta-stat-title">Verkauf &amp; Ausgabe</h2>
                <p class="tvs-hint" style="margin:0 0 .8rem">Verkauft und gratis ausgegeben getrennt. Umsatz nur aus bezahlten Bestellungen.</p>
                <div class="ta-stat-tiles">
                    <div class="ta-stat-tile ta-stat-tile--accent"><div class="ta-stat-num">CHF @revenue.ToString("N2")</div><div class="ta-stat-lbl">Umsatz (bezahlt)</div></div>
                    <div class="ta-stat-tile"><div class="ta-stat-num">@soldTotal.ToString("N0")</div><div class="ta-stat-lbl">Verkaufte Tickets</div></div>
                    <div class="ta-stat-tile"><div class="ta-stat-num">@giftedTotal.ToString("N0")</div><div class="ta-stat-lbl">Verschenkt / Bundle (gratis)</div></div>
                </div>

                <h3 class="ta-stat-subtitle">Nach Tickettyp</h3>
                <div class="ta-table-wrap">
                    <table class="ta-table">
                        <thead><tr><th>Typ</th><th class="ta-num">Verkauft</th><th class="ta-num">Umsatz</th><th class="ta-num">Verschenkt/Bundle</th><th>Primäre Kennzahl</th></tr></thead>
                        <tbody>
                            <tr><td>@TypeLabel(0)</td><td class="ta-num">@_sales.EventTicketCount</td><td class="ta-num">CHF @_sales.EventTicketRevenue.ToString("N2")</td><td class="ta-num">@eventBundleIssued</td><td>Einlösequote / No-Show</td></tr>
                            <tr><td>@TypeLabel(1)</td><td class="ta-num">@_sales.FlexCount</td><td class="ta-num">CHF @_sales.FlexRevenue.ToString("N2")</td><td class="ta-num">@_season.Flex.Gifted</td><td>Einsatz (eingelöst/produziert)</td></tr>
                            <tr><td>@TypeLabel(2)</td><td class="ta-num">@_sales.PassCount</td><td class="ta-num">CHF @_sales.PassRevenue.ToString("N2")</td><td class="ta-num">—</td><td>Nutzungsgrad (Spiele/Karte)</td></tr>
                            <tr><td>@TypeLabel(3)</td><td class="ta-num">—</td><td class="ta-num">—</td><td class="ta-num">@_season.Members.Total</td><td>aktiv vs. passiv</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="tvs-grid" style="margin-top:1.4rem">
                    <div>
                        <h3 class="ta-stat-subtitle" style="margin-top:0">Vorverkaufskurve</h3>
                        @{ var maxPre = _season.Presale.Count == 0 ? 0 : _season.Presale.Max(b => b.Count); }
                        @if (maxPre == 0)
                        {
                            <div class="tvs-empty">Noch keine bezahlten Verkäufe erfasst.</div>
                        }
                        else
                        {
                            <div class="tvs-hist">
                                @foreach (var b in _season.Presale)
                                {
                                    var pct = (int)Math.Round(b.Count * 100.0 / maxPre);
                                    <div class="tvs-hist-col">
                                        <div class="tvs-hist-num">@b.Count</div>
                                        <div class="tvs-hist-bar-wrap"><div class="tvs-hist-bar" style="height:@(Math.Max(pct, b.Count > 0 ? 3 : 0))%"></div></div>
                                        <div class="tvs-hist-lbl">@b.Label</div>
                                    </div>
                                }
                            </div>
                            <p class="tvs-hint">Wochen vor Saisonstart, in denen bezahlt wurde.</p>
                        }
                    </div>
                    <div>
                        <h3 class="ta-stat-subtitle" style="margin-top:0">Kategorie-Split (verkauft)</h3>
                        @if (_season.SalesByCategory.Count == 0)
                        {
                            <div class="tvs-empty">Keine bezahlten Verkäufe.</div>
                        }
                        else
                        {
                            var maxCat = _season.SalesByCategory.Max(c => c.Count);
                            <div class="tvs-bars">
                                @foreach (var c in _season.SalesByCategory)
                                {
                                    var pct = (int)Math.Round(c.Count * 100.0 / maxCat);
                                    <div class="tvs-bar-row">
                                        <span class="tvs-bar-lbl">@CatLabel(c.Category)</span>
                                        <div class="tvs-bar-track"><div class="tvs-bar-fill @(CatPromo(c.Category) ? "promo" : "")" style="width:@(Math.Max(pct, 2))%"></div></div>
                                        <span class="tvs-bar-num">@c.Count.ToString("N0")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="ta-stat-block">
                <h2 class="ta-stat-title">Einlass &amp; Nutzung</h2>
                <p class="tvs-hint" style="margin:0 0 .8rem">Wer tatsächlich kam. Trennt eingelöst von produziert, zeigt die Auslastung der Mehrfach-Tickets.</p>
                <div class="ta-stat-tiles">
                    <div class="ta-stat-tile ta-stat-tile--accent"><div class="ta-stat-num">@_season.TotalVisits.ToString("N0")</div><div class="ta-stat-lbl">Einlässe total</div></div>
                    <div class="ta-stat-tile"><div class="ta-stat-num">@_season.Flex.Open.ToString("N0")</div><div class="ta-stat-lbl">Offene Flex (noch einlösbar)</div></div>
                    <div class="ta-stat-tile"><div class="ta-stat-num">@_season.Passes.Phantom.ToString("N0")</div><div class="ta-stat-lbl">Phantomkarten (0 Besuche)</div></div>
                    <div class="ta-stat-tile"><div class="ta-stat-num">@_season.Members.Active.ToString("N0")</div><div class="ta-stat-lbl">Mitglieder aktiv</div></div>
                </div>

                <div class="tvs-grid" style="margin-top:1.4rem">
                    <div>
                        <h3 class="ta-stat-subtitle" style="margin-top:0">Flexticket-Trichter</h3>
                        @{ var f = _season.Flex; var prod = Math.Max(f.Produced, 1); }
                        @if (f.Produced == 0)
                        {
                            <div class="tvs-empty">Keine Flextickets produziert.</div>
                        }
                        else
                        {
                            <div class="tvs-funnel">
                                <div class="tvs-frow"><span class="tvs-flabel">Produziert</span>
                                    <div class="tvs-fseg">
                                        <div class="tvs-fbar tvs-fsold" style="width:@(f.Sold * 100 / prod)%">verkauft @f.Sold</div>
                                        <div class="tvs-fbar tvs-fgift" style="width:@(f.Gifted * 100 / prod)%">verschenkt @f.Gifted</div>
                                    </div></div>
                                <div class="tvs-frow"><span class="tvs-flabel">Eingelöst</span>
                                    <div class="tvs-fbar tvs-fredeem" style="width:@(f.Redeemed * 100 / prod)%">@f.Redeemed (@Rate(f.Redeemed, f.Produced)%)</div></div>
                                <div class="tvs-frow"><span class="tvs-flabel">Offen</span>
                                    <div class="tvs-fbar tvs-fopen" style="width:@(f.Open * 100 / prod)%">@f.Open</div></div>
                            </div>
                            <div class="tvs-legend">
                                <span><i class="tvs-sw tvs-fsold"></i> verkauft</span>
                                <span><i class="tvs-sw tvs-fgift"></i> verschenkt/Bundle</span>
                                <span><i class="tvs-sw tvs-fredeem"></i> eingelöst</span>
                                <span><i class="tvs-sw tvs-fopen"></i> offen</span>
                            </div>
                        }
                    </div>
                    <div>
                        <h3 class="ta-stat-subtitle" style="margin-top:0">Saisonkarten-Nutzungsgrad <span class="tvs-hint">Ø @_season.Passes.AvgGames.ToString("F1") Spiele</span></h3>
                        @{ var maxU = _season.Passes.Buckets.Count == 0 ? 0 : _season.Passes.Buckets.Max(b => b.Count); }
                        @if (_season.Passes.PassCount == 0)
                        {
                            <div class="tvs-empty">Keine Saisonkarten erfasst.</div>
                        }
                        else
                        {
                            <div class="tvs-hist">
                                @foreach (var b in _season.Passes.Buckets)
                                {
                                    var pct = maxU == 0 ? 0 : (int)Math.Round(b.Count * 100.0 / maxU);
                                    var cls = b.Label == "0" ? "bad" : "";
                                    <div class="tvs-hist-col">
                                        <div class="tvs-hist-num">@b.Count</div>
                                        <div class="tvs-hist-bar-wrap"><div class="tvs-hist-bar @cls" style="height:@(Math.Max(pct, b.Count > 0 ? 3 : 0))%"></div></div>
                                        <div class="tvs-hist-lbl">@b.Label</div>
                                    </div>
                                }
                            </div>
                            <p class="tvs-hint">Besuchte Spiele je Saisonkarte.</p>
                        }
                    </div>
                </div>

                <div class="tvs-grid" style="margin-top:1.4rem">
                    <div>
                        <h3 class="ta-stat-subtitle" style="margin-top:0">Verteilung Besucherarten</h3>
                        @if (_season.TypeBreakdown.Count == 0)
                        {
                            <div class="tvs-empty">Keine Einlässe erfasst.</div>
                        }
                        else
                        {
                            var maxT = _season.TypeBreakdown.Max(t => t.Count);
                            <div class="tvs-bars">
                                @foreach (var t in _season.TypeBreakdown)
                                {
                                    var pct = (int)Math.Round(t.Count * 100.0 / maxT);
                                    <div class="tvs-bar-row"><span class="tvs-bar-lbl">@TypeLabel(t.TicketType)</span><div class="tvs-bar-track"><div class="tvs-bar-fill" style="width:@(Math.Max(pct, 2))%"></div></div><span class="tvs-bar-num">@t.Count.ToString("N0")</span></div>
                                }
                            </div>
                        }
                    </div>
                    <div>
                        <h3 class="ta-stat-subtitle" style="margin-top:0">Freikarten nach Typ</h3>
                        @if (_season.FreeEntryBreakdown.Count == 0)
                        {
                            <div class="tvs-empty">Keine Freikarten erfasst.</div>
                        }
                        else
                        {
                            var maxF = _season.FreeEntryBreakdown.Max(x => x.Count);
                            <div class="tvs-bars">
                                @foreach (var x in _season.FreeEntryBreakdown)
                                {
                                    var pct = (int)Math.Round(x.Count * 100.0 / maxF);
                                    <div class="tvs-bar-row"><span class="tvs-bar-lbl">@FreeLabel(x.FreeEntryType)</span><div class="tvs-bar-track"><div class="tvs-bar-fill promo" style="width:@(Math.Max(pct, 2))%"></div></div><span class="tvs-bar-num">@x.Count.ToString("N0")</span></div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="ta-stat-block">
                <h2 class="ta-stat-title">Referenzen &amp; Bundles</h2>
                <p class="tvs-hint" style="margin:0 0 .8rem">Sponsor-Linse: ausgegeben gegen eingelöst, sortiert nach Quote.</p>
                @if (_season.References.Count == 0)
                {
                    <div class="ta-placeholder">Für diese Saison sind keine Referenzen erfasst.</div>
                }
                else
                {
                    <div class="ta-table-wrap">
                        <table class="ta-table">
                            <thead><tr><th>Referenz</th><th>Typ</th><th>Kategorie</th><th class="ta-num">Ausgegeben</th><th class="ta-num">Eingelöst</th><th class="ta-num">Quote</th></tr></thead>
                            <tbody>
                                @foreach (var r in _season.References)
                                {
                                    <tr>
                                        <td>@r.Reference</td>
                                        <td>@r.Kind</td>
                                        <td>@CatLabel(r.Category)</td>
                                        <td class="ta-num">@r.Issued</td>
                                        <td class="ta-num">@r.Redeemed</td>
                                        <td class="ta-num"><span class="tvs-rate @RateClass(r.Redeemed, r.Issued)">@Rate(r.Redeemed, r.Issued) %</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else if (_mode == "event")
        {
            @if (SelectedEventId <= 0 || _event is null)
            {
                <div class="ta-placeholder">Bitte einen Anlass wählen.</div>
            }
            else if (_event.TotalVisits == 0 && _event.EventTicketsSold == 0)
            {
                <div class="ta-placeholder">Für diesen Anlass wurden noch keine Daten erfasst.</div>
            }
            else
            {
                var sale = _sales?.PerEvent.GetValueOrDefault(SelectedEventId);
                var presale = _event.PresaleSharePercent;

                <div class="ta-stat-block">
                    <h2 class="ta-stat-title">Verkauf &amp; Ausgabe</h2>
                    <div class="ta-stat-tiles">
                        <div class="ta-stat-tile ta-stat-tile--accent"><div class="ta-stat-num">CHF @((sale?.Revenue ?? 0m).ToString("N2"))</div><div class="ta-stat-lbl">Umsatz Spieltickets</div></div>
                        <div class="ta-stat-tile"><div class="ta-stat-num">@_event.EventTicketsSold.ToString("N0")</div><div class="ta-stat-lbl">Spieltickets verkauft</div></div>
                        <div class="ta-stat-tile"><div class="ta-stat-num">@(presale is int p ? $"{p}%" : "—")</div><div class="ta-stat-lbl">im Vorverkauf</div></div>
                        <div class="ta-stat-tile"><div class="ta-stat-num">@(presale is int q ? $"{100 - q}%" : "—")</div><div class="ta-stat-lbl">Tageskasse</div></div>
                    </div>
                </div>

                <div class="ta-stat-block">
                    <h2 class="ta-stat-title">Einlass &amp; Nutzung</h2>
                    <div class="ta-stat-tiles">
                        <div class="ta-stat-tile ta-stat-tile--accent"><div class="ta-stat-num">@_event.TotalVisits.ToString("N0")</div><div class="ta-stat-lbl">Besucher (Einlässe)</div></div>
                        <div class="ta-stat-tile"><div class="ta-stat-num">@_event.PeakInside.ToString("N0")</div><div class="ta-stat-lbl">Peak gleichzeitig@(_event.PeakAtLabel is null ? "" : $" · {_event.PeakAtLabel}")</div></div>
                        <div class="ta-stat-tile"><div class="ta-stat-num">@Rate(_event.EventTicketsRedeemed, _event.EventTicketsSold) %</div><div class="ta-stat-lbl">Einlösequote Spieltickets</div></div>
                        <div class="ta-stat-tile"><div class="ta-stat-num">@_event.NoShow.ToString("N0")</div><div class="ta-stat-lbl">No-Shows</div></div>
                    </div>

                    <h3 class="ta-stat-subtitle">Wann treffen die Besucher ein?</h3>
                    @{ var maxArr = _event.Arrivals.Count == 0 ? 0 : _event.Arrivals.Max(b => b.Count); }
                    @if (maxArr == 0)
                    {
                        <div class="tvs-empty">Keine gescannten Eintritte mit Zeitstempel vorhanden.</div>
                    }
                    else
                    {
                        <div class="tvs-hist">
                            @foreach (var b in _event.Arrivals)
                            {
                                var pct = (int)Math.Round(b.Count * 100.0 / maxArr);
                                <div class="tvs-hist-col">
                                    <div class="tvs-hist-num">@b.Count</div>
                                    <div class="tvs-hist-bar-wrap"><div class="tvs-hist-bar" style="height:@(Math.Max(pct, b.Count > 0 ? 3 : 0))%"></div></div>
                                    <div class="tvs-hist-lbl">@b.Label</div>
                                </div>
                            }
                        </div>
                        <p class="tvs-hint">Erster gescannter Eintritt je Besucher, relativ zum Anpfiff.</p>
                    }

                    <div class="tvs-grid" style="margin-top:1.4rem">
                        <div>
                            <h3 class="ta-stat-subtitle" style="margin-top:0">Besucherarten dieses Spiel</h3>
                            @if (_event.TypeBreakdown.Count == 0)
                            {
                                <div class="tvs-empty">Keine Einlässe erfasst.</div>
                            }
                            else
                            {
                                var maxT = _event.TypeBreakdown.Max(t => t.Count);
                                <div class="tvs-bars">
                                    @foreach (var t in _event.TypeBreakdown)
                                    {
                                        var pct = (int)Math.Round(t.Count * 100.0 / maxT);
                                        <div class="tvs-bar-row"><span class="tvs-bar-lbl">@TypeLabel(t.TicketType)</span><div class="tvs-bar-track"><div class="tvs-bar-fill" style="width:@(Math.Max(pct, 2))%"></div></div><span class="tvs-bar-num">@t.Count.ToString("N0")</span></div>
                                    }
                                </div>
                            }
                        </div>
                        <div>
                            <h3 class="ta-stat-subtitle" style="margin-top:0">Freikarten nach Typ</h3>
                            @if (_event.FreeEntryBreakdown.Count == 0)
                            {
                                <div class="tvs-empty">Keine Freikarten erfasst.</div>
                            }
                            else
                            {
                                var maxF = _event.FreeEntryBreakdown.Max(x => x.Count);
                                <div class="tvs-bars">
                                    @foreach (var x in _event.FreeEntryBreakdown)
                                    {
                                        var pct = (int)Math.Round(x.Count * 100.0 / maxF);
                                        <div class="tvs-bar-row"><span class="tvs-bar-lbl">@FreeLabel(x.FreeEntryType)</span><div class="tvs-bar-track"><div class="tvs-bar-fill promo" style="width:@(Math.Max(pct, 2))%"></div></div><span class="tvs-bar-num">@x.Count.ToString("N0")</span></div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        <div class="ta-stat-block">
            <h2 class="ta-stat-title">Website-Zugriffe</h2>
            <div class="ta-stat-head">
                <p class="tvs-hint" style="margin:0">Seitenaufrufe und Besucher der Ticketseite, Bots herausgefiltert.</p>
                <div class="ta-field">
                    <select class="ta-select" @bind="VisitorRange" @bind:after="ReloadVisitorsAsync">
                        <option value="d7">Letzte 7 Tage</option>
                        <option value="d30">Letzte 30 Tage</option>
                        <option value="d90">Letzte 90 Tage</option>
                        <optgroup label="Ganze Saison">
                            @foreach (var s in _seasons)
                            {
                                <option value="s@(s.Id)">@s.Name</option>
                            }
                        </optgroup>
                    </select>
                </div>
            </div>

            @if (_visitors is null || _visitors.TotalViews == 0)
            {
                <div class="ta-placeholder">Im gewählten Zeitraum wurden noch keine Aufrufe erfasst.</div>
            }
            else
            {
                <div class="ta-stat-tiles">
                    <div class="ta-stat-tile ta-stat-tile--accent"><div class="ta-stat-num">@_visitors.TotalViews.ToString("N0")</div><div class="ta-stat-lbl">Seitenaufrufe</div></div>
                    <div class="ta-stat-tile"><div class="ta-stat-num">@_visitors.TotalVisitors.ToString("N0")</div><div class="ta-stat-lbl">Besucher (geschätzt)</div></div>
                    <div class="ta-stat-tile ta-stat-tile--muted"><div class="ta-stat-num">@_visitors.BotViews.ToString("N0")</div><div class="ta-stat-lbl">Bot-Aufrufe (ausgefiltert)</div></div>
                </div>

                var maxViews = _visitors.Series.Count == 0 ? 0 : _visitors.Series.Max(d => d.Views);
                <div class="ta-chart" role="img" aria-label="Seitenaufrufe im Zeitverlauf">
                    @foreach (var d in _visitors.Series)
                    {
                        var pct = maxViews == 0 ? 0 : (int)Math.Round(d.Views * 100.0 / maxViews);
                        <div class="ta-chart-col" title="@BarTitle(d)"><div class="ta-chart-bar" style="height:@(Math.Max(pct, d.Views > 0 ? 3 : 0))%"></div></div>
                    }
                </div>
                <div class="ta-chart-axis">
                    <span>@AxisLabel(_visitors.Series.First().Start)</span>
                    <span>@(_visitors.Bucket == StatBucket.Month ? "pro Monat" : "pro Tag")</span>
                    <span>@AxisLabel(_visitors.Series.Last().Start)</span>
                </div>

                @if (_visitors.TopPages.Count > 0)
                {
                    <h3 class="ta-stat-subtitle">Meistbesuchte Seiten</h3>
                    <div class="ta-table-wrap">
                        <table class="ta-table">
                            <thead><tr><th>Seite</th><th class="ta-num">Aufrufe</th><th class="ta-num">Besucher</th></tr></thead>
                            <tbody>
                                @foreach (var pg in _visitors.TopPages)
                                {
                                    <tr><td><code class="ta-uuid">@pg.Path</code></td><td class="ta-num">@pg.Views.ToString("N0")</td><td class="ta-num">@pg.Visitors.ToString("N0")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }
</section>

<style>
    .ta-stat-block { background: #fff; border: 1px solid var(--ta-border); border-radius: 4px; padding: 1.25rem 1.25rem 1.5rem; margin-bottom: 1.5rem; }
    .ta-stat-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .ta-stat-title { font-size: 1.15rem; font-weight: 700; margin: 0 0 0.2rem; color: var(--ta-ink); }
    .ta-stat-subtitle { font-size: 0.95rem; font-weight: 700; margin: 1.5rem 0 0.6rem; color: var(--ta-ink); }
    .ta-stat-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 0.75rem; }
    .ta-stat-tile { background: #f6f7fb; border: 1px solid var(--ta-border); border-radius: 4px; padding: 0.9rem 1rem; }
    .ta-stat-tile--accent { background: #1b264f; border-color: #1b264f; }
